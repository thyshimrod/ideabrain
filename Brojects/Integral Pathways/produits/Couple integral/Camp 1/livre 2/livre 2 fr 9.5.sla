        <PAGE PAGEXPOS="100.001" PAGEYPOS="87327.0876141734" PAGEWIDTH="595.275590551181" PAGEHEIGHT="841.889763779528" BORDERLEFT="56.6929133858268" BORDERRIGHT="42.5196850393701" BORDERTOP="40" BORDERBOTTOM="40" NUM="197" NAM="" MNAM="Normal gauche" Size="A4" Orientation="0" LEFT="0" PRESET="0" VerticalGuides="" HorizontalGuides="" AGhorizontalAutoGap="0" AGverticalAutoGap="0" AGhorizontalAutoCount="0" AGverticalAutoCount="0" AGhorizontalAutoRefer="0" AGverticalAutoRefer="0" AGSelection="0 0 0 0" pageEffectDuration="1" pageViewDuration="1" effectType="0" Dm="0" M="0" Di="0"/>
        <PAGE PAGEXPOS="695.276590551181" PAGEYPOS="87327.0876141734" PAGEWIDTH="595.275590551181" PAGEHEIGHT="841.889763779528" BORDERLEFT="56.6929133858268" BORDERRIGHT="42.5196850393701" BORDERTOP="40" BORDERBOTTOM="40" NUM="198" NAM="" MNAM="Normal droite" Size="A4" Orientation="0" LEFT="0" PRESET="0" VerticalGuides="" HorizontalGuides="" AGhorizontalAutoGap="0" AGverticalAutoGap="0" AGhorizontalAutoCount="0" AGverticalAutoCount="0" AGhorizontalAutoRefer="0" AGverticalAutoRefer="0" AGSelection="0 0 0 0" pageEffectDuration="1" pageViewDuration="1" effectType="0" Dm="0" M="0" Di="0"/>
        <PAGE PAGEXPOS="100.001" PAGEYPOS="88208.9773779529" PAGEWIDTH="595.275590551181" PAGEHEIGHT="841.889763779528" BORDERLEFT="56.6929133858268" BORDERRIGHT="42.5196850393701" BORDERTOP="40" BORDERBOTTOM="40" NUM="199" NAM="" MNAM="Normal gauche" Size="A4" Orientation="0" LEFT="0" PRESET="0" VerticalGuides="" HorizontalGuides="" AGhorizontalAutoGap="0" AGverticalAutoGap="0" AGhorizontalAutoCount="0" AGverticalAutoCount="0" AGhorizontalAutoRefer="0" AGverticalAutoRefer="0" AGSelection="0 0 0 0" pageEffectDuration="1" pageViewDuration="1" effectType="0" Dm="0" M="0" Di="0"/>
        <PAGE PAGEXPOS="695.276590551181" PAGEYPOS="88208.9773779529" PAGEWIDTH="595.275590551181" PAGEHEIGHT="841.889763779528" BORDERLEFT="56.6929133858268" BORDERRIGHT="42.5196850393701" BORDERTOP="40" BORDERBOTTOM="40" NUM="200" NAM="" MNAM="Normal droite" Size="A4" Orientation="0" LEFT="0" PRESET="0" VerticalGuides="" HorizontalGuides="" AGhorizontalAutoGap="0" AGverticalAutoGap="0" AGhorizontalAutoCount="0" AGverticalAutoCount="0" AGhorizontalAutoRefer="0" AGverticalAutoRefer="0" AGSelection="0 0 0 0" pageEffectDuration="1" pageViewDuration="1" effectType="0" Dm="0" M="0" Di="0"/>
        <FRAMEOBJECT InID="32219" XPOS="0.141732283464567" YPOS="0.141732283464567" OwnPage="-1" ItemID="188744448" PTYPE="5" WIDTH="295.263379417221" HEIGHT="1" FRTYPE="0" CLIPEDIT="0" ROT="359.914137254786" PWIDTH="0.283464566929134" PCOLOR="bordeaux" SHADE="0" PCOLOR2="bordeaux" PLINEART="1" path="" isInline="1" gXpos="0.000212398164265437" gYpos="0.58421000042182" gWidth="295.263472667556" gHeight="0.725942124737742" LAYER="0"/>
        <FRAMEOBJECT InID="18752" XPOS="0.141732283464567" YPOS="0.141732283464567" OwnPage="-1" ItemID="189232528" PTYPE="5" WIDTH="295.263379417221" HEIGHT="1" FRTYPE="0" CLIPEDIT="0" ROT="359.914137254786" PWIDTH="0.283464566929134" PCOLOR="bordeaux" SHADE="0" PCOLOR2="bordeaux" PLINEART="1" path="" isInline="1" gXpos="0.000212398164265437" gYpos="0.58421000042182" gWidth="295.263472667556" gHeight="0.725942124737742" LAYER="0"/>
        <FRAMEOBJECT InID="23027" XPOS="0.141732283464567" YPOS="0.141732283464567" OwnPage="-1" ItemID="202779136" PTYPE="5" WIDTH="295.263379417221" HEIGHT="1" FRTYPE="0" CLIPEDIT="0" ROT="359.914137254786" PWIDTH="0.283464566929134" PCOLOR="bordeaux" SHADE="0" PCOLOR2="bordeaux" PLINEART="1" path="" isInline="1" gXpos="0.000212398164265437" gYpos="0.58421000042182" gWidth="295.263472667556" gHeight="0.725942124737742" LAYER="0"/>
        <PAGEOBJECT XPOS="751.969503937008" YPOS="2705.35533070866" OwnPage="6" ItemID="189852864" PTYPE="4" WIDTH="497.166026688036" HEIGHT="763.388032123197" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" copath="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" gXpos="751.969503937008" gYpos="2705.35533070866" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab FONT="Garamond Regular"/>
                <ITEXT FONT="Garamond Regular" CH="Dans un premier livre, Hors Jeu, je suis parti d'une idée simple. Beaucoup de tensions de couple ressemblent à des désaccords, alors qu'elles fonctionnent comme des jeux : des scénarios répétés, avec trois rôles, que l'on rejoue sans s'en rendre compte chaque fois qu'une dispute éclate à propos des tâches ménagères, d'un retour tardif ou d'un appel un peu trop insistant de la belle-mère. Ce livre s'adressait à ceux qui reconnaissaient leurs propres disputes dans ses pages."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab FONT="Garamond Regular"/>
                <ITEXT FONT="Garamond Regular" CH="Depuis, plusieurs lecteurs m'ont dit, chacun à sa façon, à peu près la même chose : « Je me suis reconnu dans beaucoup de pages, sauf que chez nous, on ne se dispute presque jamais. » Cette remarque est revenue assez souvent pour que je m'y arrête. C'est d'elle qu'est né ce livre."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab FONT="Garamond Regular"/>
                <ITEXT FONT="Garamond Regular" CH="Vous vous reconnaîtrez peut-être dans l'une de ces situations : un dimanche bien organisé, un soutien reçu avec gratitude, une semaine remplie d'activités que chacun apprécie de son côté, une décision raisonnable prise à deux, sans un mot plus haut que l'autre. Il n'y a rien à redire. Et pourtant, le soir, juste avant de vous endormir, vous avez parfois l'impression qu'il manque quelque chose, sans savoir quoi."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab FONT="Garamond Regular"/>
                <ITEXT FONT="Garamond Regular" CH="La plupart des outils de communication de couple sont conçus pour traiter une difficulté précise : le conflit. Ils apprennent à désamorcer une dispute, à sortir du triangle victime-persécuteur-sauveur, à se faire entendre quand le ton monte. C'est précieux, et *Hors Jeu* s'y consacrait déjà. Mais ces outils ne servent que lorsqu'il y a un conflit. Or un couple peut cesser de se disputer tout en continuant de fonctionner selon des rôles fixes. Ces rôles sont simplement devenus plus discrets : personne ne perd ouvertement, et chacun se sent même plutôt bien traité. Avec les années, les deux partenaires laissent pourtant de moins en moins de place à leur rencontre."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab FONT="Garamond Regular"/>
                <ITEXT FONT="Garamond Regular" CH="C'est pour cela que l'absence de conflit ne suffit pas à dire qu'un couple va bien. Elle peut aussi être le signe d'un couple si bien réglé que les deux partenaires ne se rencontrent plus vraiment."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab FONT="Garamond Regular"/>
                <ITEXT FONT="Garamond Regular" CH="Ce livre avance pas à pas, volontairement. Il commence par quatre scènes : quatre couples saisis dans un moment ordinaire, racontés de l'intérieur, sans étiquette ni jugement. Chaque scène se termine par une question, puis par un décryptage qui montre ce qui s'est joué en dessous. J'ai voulu que vous puissiez vous reconnaître avant que la théorie arrive."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab FONT="Garamond Regular"/>
                <ITEXT FONT="Garamond Regular" CH="Ensuite seulement, je donne un nom à ce que vous aurez vu. J'utilise pour cela l'égogramme, une carte de cinq voix intérieures, plus fine que le triangle du premier livre. Elle permet de voir comment, dans un couple, deux positions s'ajustent l'une à l'autre jusqu'à former ce que j'appelle un couplage. Un questionnaire vous aidera à repérer le vôtre. Viendra alors une question plus inconfortable : pourquoi le fait de comprendre ne suffit pas à changer. Il existe un écart réel entre ce que l'on comprend et ce que l'on parvient à faire autrement, et cet écart n'est pas une faute. Je regarderai aussi ce que ce fonctionnement produit avec le temps, sur une année, sur dix ans, et chez les enfants quand il y en a."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab FONT="Garamond Regular"/>
                <ITEXT FONT="Garamond Regular" CH="La dernière partie du livre aborde une question que l'on traite moins souvent. Que se passe-t-il quand l'un des deux change vraiment, grandit ou s'affirme, alors que le couple continue de fonctionner selon l'accord d'avant ? Je crois que ce changement n'a pas échoué. Mais le couple a ses propres règles, que personne n'a jamais écrites, et elles n'ont pas changé en même temps que lui. Je considère le couple comme une troisième entité, à côté des deux partenaires, et je montrerai comment renégocier ses règles en partant de ce qui est important pour chacun. Viennent ensuite des portes de sortie, adaptées à chaque façon de fonctionner à deux. Le dernier chapitre regarde enfin ce qui se passe quand l'un des deux change en profondeur, et pourquoi un couple doit parfois revoir ses accords bien plus d'une fois au cours de sa vie."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab FONT="Garamond Regular"/>
                <ITEXT FONT="Garamond Regular" CH="Si rien en vous ne se reconnaît dans les pages qui suivent, ce livre n'est probablement pas pour vous en ce moment, et il n'y a aucune raison de forcer la lecture. Si une de ces situations résonne, même légèrement, il y a là une piste à explorer. Vous n'y trouverez pas de recette. Vous y trouverez une façon de voir ce qui, chez vous, est devenu une habitude que l'on ne remet plus en question, et des propositions concrètes pour choisir à nouveau, à votre rythme, plutôt que de reconduire ce qui s'est installé sans que personne l'ait vraiment décidé."/>
                <trail PARENT="BODY"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="751.969503937008" YPOS="3587.24509448819" OwnPage="8" ItemID="142554560" PTYPE="4" WIDTH="497.166026688036" HEIGHT="763.388032123197" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" copath="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" gXpos="751.969503937008" gYpos="2705.35533070866" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Chapitre 1 — Quatre scènes"/>
                <trail PARENT="Titre"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="751.969503937008" YPOS="4469.13485826772" OwnPage="10" ItemID="142543232" PTYPE="4" WIDTH="497.166026688036" HEIGHT="763.388032123197" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" copath="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" gXpos="751.969503937008" gYpos="2705.35533070866" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Scène 1 — Le dimanche bien géré"/>
                <para PARENT="scene_page_subtitle"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Il est 9h. Sophie a déjà sorti le planning de la semaine. Les activités des enfants, le rendez-vous chez le dentiste mercredi, les courses à faire avant 11h parce que l'après-midi c'est le match de foot de Théo. Marc acquiesce, reprend son café, note mentalement ce qu'il doit faire."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="La matinée s'organise sans friction. Chacun sait ce qu'il a à faire. Les enfants sont levés, habillés, petit-déjeuner pris. La maison tourne. À midi, tout est en ordre. Sophie coche les cases dans sa tête. Marc a géré les courses, rempli le frigo, sorti les poubelles."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="L'après-midi, le match. Le soir, un film. Ils se couchent à une heure raisonnable. Marc s'endort rapidement. Sophie regarde le plafond quelques minutes, pas anxieuse, juste éveillée. Elle ne pense à rien de précis. Elle se demande vaguement si c'est ça, un bon dimanche. Elle décide que oui. Elle ferme les yeux."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Tout s'est passé comme prévu. Alors pourquoi cette question, juste avant de s'endormir ?"/>
                <para PARENT="narration"/>
                <para PARENT="BODY"/>
                <para PARENT="scene_page_subtitle"/>
                <ITEXT CH="Décryptage"/>
                <para PARENT="scene_page_subtitle"/>
                <para PARENT="scene_page_subtitle"/>
                <tab/>
                <ITEXT CH="À première vue, ce dimanche est réussi. Tout a été fait, dans les temps, sans dispute ni reproche. Si Sophie avait crié ou si Marc avait boudé, on saurait où regarder. Des outils comme le triangle de Karpman aideraient à comprendre qui joue quel rôle. Ici, il n'y a pas de conflit, donc ces outils n'ont rien à analyser."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Commençons par une question simple : pour qui ce dimanche a-t-il été organisé ? Pour les enfants, bien sûr, et pour que la semaine démarre sans difficulté. Mais peut-être aussi pour que le couple corresponde à l'image d'une famille qui fonctionne bien : efficace, calme, sans drame. Le genre de famille dont on se dit, de l'extérieur, « ils ont l'air bien organisés »."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Cette organisation a de vraies qualités. Elle évite les oublis, les tensions et les disputes sur qui devait faire quoi. Si le couple l'a construite ainsi, c'est parce qu'elle marche."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="La difficulté vient de ce qu'elle laisse de côté. Quand tout est prévu, il reste peu de place pour l'imprévu : une idée qui change le programme, une envie d'improviser, un moment où l'on décide ensemble, sur le moment, de ce qu'on va faire. Or le besoin de vivre des choses non planifiées ne disparaît pas parce qu'on ne lui fait plus de place. Il arrive qu'on le retrouve ailleurs. Quelqu'un se met à beaucoup investir dans le sport, dans un projet professionnel, ou dans une nouvelle passion qui occupe les soirées et les week-ends. Ce n'est pas une fuite consciente. C'est souvent la seule place qu'on a trouvée pour ce besoin, en dehors du couple."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="On peut aussi faire une hypothèse un peu plus inconfortable. Ce dimanche parfaitement organisé est peut-être déjà une façon de combler un manque, avant même de l'avoir ressenti. Bien tenir la maison, bien gérer la famille, donner l'image d'un couple qui fonctionne : tout cela occupe le temps et l'énergie. On peut s'installer dans ce surinvestissement bien avant une éventuelle crise de la quarantaine, simplement au fil des semaines."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Et Marc ? Dans cette scène, on le voit surtout suivre : il acquiesce, il note ce qu'il doit faire, il le fait, puis il s'endort vite. On ne sait pas ce qu'il aurait aimé faire de ce dimanche, et personne ne le lui demande. Ce qu'il ne dit pas est aussi important que la question de Sophie. Nous y reviendrons."/>
                <para PARENT="BODY"/>
                <para/>
                <tab/>
                <ITEXT CH="Pour certains couples, ce type de dimanche est exactement ce qu'ils recherchent, et il n'y a pas de raison de le remettre en cause. Mais si la question de Sophie vous parle, gardez-la en tête : les trois scènes suivantes l'abordent sous d'autres angles."/>
                <trail PARENT="BODY"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="751.969503937008" YPOS="5351.02462204724" OwnPage="12" ItemID="142557392" PTYPE="4" WIDTH="497.166026688036" HEIGHT="763.388032123197" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" copath="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" gXpos="751.969503937008" gYpos="2705.35533070866" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Scène 3 — La semaine bien remplie"/>
                <para PARENT="scene_page_subtitle"/>
                <para/>
                <tab/>
                <ITEXT CH="Lundi, Inès a son cours de yoga à 19h. Julien reste avec les enfants, commande une pizza, regarde un match en replay. Mardi, c'est Julien qui a foot, le petit tournoi entre collègues qu'il ne rate jamais. Inès profite de la soirée pour avancer sur le projet déco du salon, celui qu'elle a en tête depuis des mois. Mercredi, dîner chez Camille et Hugo, entre amis. Ils rient beaucoup, Julien raconte une anecdote de boulot qui fait mouche, Inès se sent légère."/>
                <para PARENT="narration"/>
                <para PARENT="narration"/>
                <tab/>
                <ITEXT CH="Jeudi, Inès part courir tôt, avant que la maison se réveille : dix kilomètres, son rituel de la semaine. Julien, lui, passe la soirée dans le garage à finir l'étagère qu'il a commencée le week-end dernier. Vendredi, chacun récupère un peu. Samedi, nouveau cours de yoga pour Inès, nouveau match pour Julien. L'après-midi, ils s'y mettent à deux sur la déco. Vingt minutes à choisir une couleur de peinture, avant que les enfants ne les interrompent."/>
                <para PARENT="narration"/>
                <para PARENT="narration"/>
                <tab/>
                <ITEXT CH="Dimanche soir, Julien a préparé le dîner. Il a testé une recette repérée sur Instagram, un curry qu'il voulait faire depuis un moment. Inès goûte, sourit."/>
                <para PARENT="narration"/>
                <tab/>
                <ITEXT CH="— Il est bon. T'as aimé le faire ?"/>
                <para PARENT="narration"/>
                <tab/>
                <ITEXT CH="— Ouais, c'était sympa."/>
                <para PARENT="narration"/>
                <para PARENT="narration"/>
                <tab/>
                <ITEXT CH="Rien de plus. Ils débarrassent, chacun de son côté de la table. Les enfants couchés, Julien retourne cinq minutes sur son téléphone, Inès feuillette un magazine déco. Ils se couchent à peu près en même temps. Julien s'endort vite, satisfait de sa semaine : le sport, le curry réussi, l'étagère terminée. Inès reste éveillée un instant de plus. Elle repasse la semaine dans sa tête. Le yoga, la course, le dîner chez Camille, le projet déco qui avance. Une bonne semaine, se dit-elle. Pleine. Vivante, même."/>
                <para PARENT="narration"/>
                <para PARENT="narration"/>
                <tab/>
                <ITEXT CH="Alors pourquoi cette sensation, juste avant de fermer les yeux, qu'il manque quelque chose, sans qu'elle sache quoi ?"/>
                <para PARENT="narration"/>
                <para/>
                <ITEXT CH="Décryptage"/>
                <para PARENT="scene_page_subtitle"/>
                <para PARENT="scene_page_subtitle"/>
                <tab/>
                <ITEXT CH="À première vue, ce couple a tout pour aller bien. Inès et Julien ne s'ennuient pas. Ils ont des passions, des amis, des projets et de l'énergie. Beaucoup de conseils sur le couple recommandent d'ailleurs exactement cela : garder ses propres activités, ne pas s'oublier dans la relation, préserver son indépendance. De ce point de vue, ils font les choses bien."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Pourtant, regardons ce que cette semaine a réellement contenu. Du yoga, du foot, un dîner entre amis, une course à pied, un projet déco, du bricolage. Beaucoup d'activités, et beaucoup de plaisir, mais presque toujours chacun de son côté. Entre Inès et Julien eux-mêmes, il y a eu quelques phrases échangées en passant, et vingt minutes à deux devant des nuanciers de peinture, interrompues par les enfants."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Chez Sophie et Marc, la journée était si organisée qu'il restait peu de place pour la spontanéité. Ici, c'est différent. La spontanéité et l'envie sont bien présentes, mais elles se dirigent vers d'autres terrains que le couple : le sport, les amis, les projets personnels. Chacun a trouvé un endroit où il se sent pleinement lui-même, et cet endroit n'inclut pas l'autre."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="On pourrait appeler cela de l'autonomie, et c'en est en partie. Il existe pourtant deux sortes d'autonomie. La première vient compléter le couple : chacun revient de ses activités avec quelque chose à partager, et ce qu'il vit à l'extérieur nourrit ce qui se passe à deux. La seconde finit par remplacer le couple : chacun trouve ailleurs tout ce dont il a besoin, si bien que les moments à deux deviennent ce qui reste quand tout le reste est fait. Personne ne l'a décidé. Cela s'est installé petit à petit, parce que chaque activité, prise séparément, est un bon choix."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Le yoga ou le foot ne sont donc pas en cause. Ce qui manque, c'est un moment où Inès et Julien choisissent de se retrouver tous les deux, sans objectif, sans tâche à accomplir, juste pour le plaisir d'être ensemble. Pas une soirée en amoureux planifiée comme une case à cocher, mais quelque chose de plus simple, comme l'un qui dit à l'autre « viens, on fait un truc tous les deux »."/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="C'est sans doute ce qu'Inès sent sans arriver à le formuler. Sa semaine a été pleine d'activités, mais elle a contenu très peu de vrais moments de rencontre avec Julien."/>
                <para PARENT="BODY"/>
                <para/>
                <ITEXT CH="Si cette répartition vous convient à tous les deux, il n'y a aucune raison de la changer. Mais si la sensation d'Inès vous dit quelque chose, la question à vous poser est simple : à quand remonte le dernier moment que vous avez choisi de passer à deux, sans autre but que d'être ensemble ?"/>
                <trail/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="751.969503937008" YPOS="6232.91438582677" OwnPage="14" ItemID="142546064" PTYPE="4" WIDTH="497.166026688036" HEIGHT="763.388032123197" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" copath="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" gXpos="751.969503937008" gYpos="2705.35533070866" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Chapitre 2 — Ce que vous avez déjà reconnu"/>
                <trail PARENT="Titre"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="751.969503937008" YPOS="7114.8041496063" OwnPage="16" ItemID="142560224" PTYPE="4" WIDTH="497.166026688036" HEIGHT="763.388032123197" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" copath="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" gXpos="751.969503937008" gYpos="2705.35533070866" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="2.1 — Avant d'aller plus loin"/>
                <para PARENT="scene_page_subtitle"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Si vous vous êtes reconnu dans l'une de ces scènes, je voudrais commencer par une chose : cela ne veut pas dire que vous avez laissé faire ou que vous n'avez rien vu. Un dimanche bien tenu, un soutien donné sans compter, une semaine remplie d'activités qui font du bien, une décision prise raisonnablement à deux, tout cela demande de l'attention, de l'énergie et une vraie envie de bien faire, jour après jour. On n'arrive pas à ce niveau de fluidité par hasard. On y arrive parce qu'on a jugé que c'était important, et qu'on a mis du soin à le construire."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="C'est pour cela que ce chapitre demande un peu de délicatesse. Il ne s'agit pas de juger votre façon de fonctionner. Elle marche, et souvent plutôt bien. Il s'agit de regarder comment elle s'est installée, et si elle vous laisse encore le choix. Avec le temps, une façon de faire peut devenir la seule option disponible, sans que personne l'ait vraiment décidé. Tout est réglé, connu par cœur, au point qu'on n'a plus besoin de se parler. Je comprends aussi qu'on hésite à regarder cela de près. Remettre en question une organisation qui fonctionne peut rouvrir une discussion qu'on croyait close, ou réveiller un inconfort qu'on avait mis des années à apaiser."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT FONT="Trebuchet MS Regular" FONTSIZE="7.5" CH="R"/>
                <ITEXT CH="eprenons Sophie, dans la première scène. Elle est peut-être organisée de nature, c'est possible. Mais je ne crois pas que cela explique tout. Mon hypothèse est la suivante : au début, il y a sans doute eu des flottements. Des dimanches où personne ne savait qui devait s'occuper de quoi, des désaccords sur les priorités, des frictions autour des enfants. Au fil des essais, le couple a trouvé ce qui marchait le mieux : qui fait les courses, qui accompagne Théo au foot, à quelle heure tout doit être terminé pour que l'après-midi se passe bien. Chaque ajustement a amélioré le précédent, jusqu'à une organisation presque parfaite, efficace, économe en énergie et sans friction. Et peut-être aussi, discrètement, une vitrine : celle d'un couple qui a l'air de bien s'en sortir. C'est cette construction progressive qui m'intéresse, plus que le caractère de Sophie. Car une organisation aussi rodée finit par laisser peu de place au reste : une émotion qui déborde, une envie soudaine, le désir de vivre ce dimanche autrement, juste pour voir."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Ce chapitre va vous aider à voir les règles du jeu que vous suivez sans y penser, parce qu'elles vous servent bien depuis longtemps. Certaines de ces règles vous conviennent parfaitement, et il n'y a aucune raison de les changer parce qu'elles ont maintenant un nom. D'autres méritent d'être regardées de plus près : elles sont peut-être devenues si automatiques que vous ne savez plus faire autrement, alors que faire autrement, de temps en temps, vous ferait du bien."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Une précaution, enfin, qui vaut pour tout le livre. Ce que nous allons explorer concerne d'abord vous et votre propre regard. Si l'une de ces pages vous donne envie de changer, ce changement vous appartient. Je vous encourage à commencer par ce que vous pouvez faire vous-même : vos habitudes, votre façon de voir, ce qui compte vraiment pour vous. Vous pourrez ensuite en parler à votre partenaire et regarder tout cela ensemble, avec curiosité, et même avec un peu d'amusement. Mais si vous reconnaissez l'autre dans ces pages, la tentation sera de vouloir le changer, lui, en premier. C'est compréhensible, et c'est presque toujours une erreur. Une relation se vit à deux, mais le changement commence toujours par soi, même quand c'est inconfortable."/>
                <trail PARENT="BODY"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="751.969503937008" YPOS="7996.69391338582" OwnPage="18" ItemID="142548896" PTYPE="4" WIDTH="497.166026688036" HEIGHT="763.388032123197" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" copath="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" gXpos="751.969503937008" gYpos="2705.35533070866" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="224202208" BACKITEM="224210704"/>
        <PAGEOBJECT XPOS="751.969503937008" YPOS="8878.58367716535" OwnPage="20" ItemID="142563056" PTYPE="4" WIDTH="497.166026688036" HEIGHT="763.388032123197" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" copath="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" gXpos="751.969503937008" gYpos="2705.35533070866" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="224199376" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="2.3 — Les scènes relues"/>
                <para PARENT="scene_page_subtitle"/>
                <para PARENT="BODY"/>
                <ITEXT CH="Sophie et Marc"/>
                <para PARENT="scene_page_subtitle"/>
                <para PARENT="scene_page_subtitle"/>
                <tab/>
                <ITEXT CH="Revenons au moment où Sophie, les yeux fermés, se dit que c'était un bon dimanche. Elle vient de décider que oui. Pourtant, quelque chose reste encore une seconde avant qu'elle s'endorme. Ce n'est ni une inquiétude ni un regret, plutôt l'impression qu'il y a quelque chose, sans qu'elle puisse dire quoi."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Pour regarder ce qui se joue derrière, je vous propose deux pistes. Je les appelle des portes, parce qu'on peut les ouvrir l'une après l'autre, et chacun s'arrêtera sur celle qui lui parle le plus."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="La première porte concerne Marc. Qu'est-ce que sa position lui apporte, à lui ? Il acquiesce, il note, il exécute. On pourrait y voir un simple manque d'initiative. Mais on peut aussi y voir un endroit confortable. Quand on exécute un plan, on ne porte pas le poids de la décision. On ne risque pas de mal choisir l'activité, de mal évaluer le temps, et de s'entendre dire, même gentiment, que ça n'allait pas. Suivre un programme qu'on n'a pas eu à concevoir a quelque chose de reposant. Marc ne le formulerait sans doute pas ainsi, parce que reconnaître qu'il s'y sent bien reviendrait à admettre qu'il préfère ne pas tenir les rênes."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="La deuxième porte concerne Sophie. Qu'est-ce que sa position lui coûte, sans qu'elle s'en rende compte ? Organiser, c'est aussi porter. Porter la question de ce qui se passerait si, un dimanche, elle ne le faisait pas. La matinée s'organiserait-elle quand même ? Quelqu'un d'autre prendrait-il le relais ? Une peur discrète peut se cacher derrière cette position : la peur du vide qui s'installerait si elle lâchait le fil, ne serait-ce qu'un instant. C'est peut-être cette peur, plus qu'un vrai goût pour l'organisation, qui la maintient à sa place. Ce changement de regard m'intéresse. Et si, au fond, ce qui motive Sophie, c'était le contrôle, parce qu'il répond à un besoin de sécurité, celui de savoir que tout sera fait ?"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Ces deux portes se répondent. Le confort que Marc trouve à exécuter donne à Sophie une raison de plus de rester celle qui décide, puisque personne d'autre ne semble vouloir ce rôle. Et la constance de Sophie dans l'organisation donne à Marc une raison de plus de ne jamais s'y essayer, puisque tout fonctionne très bien sans lui. Chacun renforce la position de l'autre, sans l'avoir décidé, et avec le temps, aucun des deux ne pense plus qu'il pourrait en être autrement."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="La question qui flotte chez Sophie ce soir-là ne correspond pas forcément à un manque qu'elle pourrait nommer facilement. C'est peut-être une part d'elle qui sent qu'un besoin a été mis de côté, sans savoir lequel, pour que la journée reste aussi fluide."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="Un aparté sur la recherche d'efficacité"/>
                <para PARENT="bold element"/>
                <para PARENT="bold element"/>
                <tab/>
                <ITEXT CH="J'aimerais faire ici un aparté. C'est une observation que j'ai faite chez des couples que j'ai accompagnés, et aussi autour de moi. Je l'appelle la recherche d'efficacité. Quand une routine se met en place et se rode au fil du temps, elle répond à ce besoin. On finit par connaître le temps qu'il faut pour chaque chose, le bon moment pour la faire, le bon chemin, les bons outils, les bons produits."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Il peut être intéressant de questionner cela, et de se demander : qu'est-ce qui m'a donné envie de tout optimiser ? Les réponses sont nombreuses. Elles dépendent de plusieurs choses : de l'endroit où en est la personne dans son propre développement, avec ses valeurs et ce à quoi elle aspire à ce moment de sa vie ; de sa personnalité, avec ses peurs, ses élans et ses réflexes ; et de la place qu'elle accorde à ce qu'on attend d'elle socialement."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Derrière ce grand besoin d'efficacité, je retrouve souvent une ou plusieurs de ces quatre motivations. Elles ne s'excluent pas : chez une même personne, deux ou trois peuvent se mélanger."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="La première est un besoin de contrôle. Quand tout est prévu, on sait ce qui va se passer, et cette prévisibilité rassure. L'anxiété baisse, parce qu'il reste moins de place pour l'imprévu, l'oubli ou le désordre. Dans un couple, cela peut ressembler au planning du dimanche de Sophie, au menu de la semaine fixé d'avance, ou à la liste de courses toujours dans le même ordre. Il n'y a rien de mal à cela. Mais quand le contrôle sert surtout à calmer une inquiétude, il devient difficile de le relâcher, même pour une soirée, parce que relâcher fait revenir l'inquiétude. La question à se poser est alors simple : si je laissais une partie de la journée sans plan, qu'est-ce que je ressentirais ?"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="La deuxième est un besoin d'économiser son énergie. Ce que je ne dépense pas d'un côté, je peux le consacrer à autre chose. Si je fais la vaisselle en cinq minutes, j'ai vingt minutes de plus pour lire. C'est une logique saine, et beaucoup de couples très occupés en ont besoin pour tenir, entre le travail, les enfants et les obligations. Mais il vaut la peine de regarder où va l'énergie ainsi gagnée. Si elle sert à se retrouver à deux, l'efficacité est au service du couple. Si elle part toujours ailleurs, dans le travail, les écrans ou les activités de chacun, l'efficacité finit par libérer du temps pour tout, sauf pour la relation. La question devient : ce temps que nous gagnons, qu'en faisons-nous, et ensemble ou chacun de son côté ?"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="La troisième est le désir d'être vu d'une certaine façon par les autres. Une maison bien tenue, des enfants à l'heure, des vacances bien organisées, un couple qui a l'air de bien s'en sortir : tout cela renvoie une image. On peut tenir à cette image pour de bonnes raisons. Elle peut venir de l'envie de faire mieux que ce qu'on a connu enfant, de la fierté de ce qu'on a construit, ou du regard de la famille et des amis. Le risque est que cette image devienne plus importante que ce que le couple vit vraiment. On continue alors à bien faire les choses pour qu'elles aient l'air réussies, même quand elles ne procurent plus beaucoup de plaisir. La question à se poser ici : si personne ne nous voyait, organiserions-nous nos journées de la même façon ?"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="La quatrième motivation est la plus discrète : l'efficacité peut aussi être une forme de fuite. Quand chaque moment est rempli, utile, organisé, il ne reste pas de temps vide. Or c'est souvent dans ces moments vides que remontent les questions qu'on préfère éviter : est-ce que je suis heureux ? est-ce que quelque chose me manque ? est-ce que ça va vraiment, entre nous ? Rester occupé permet de ne pas se poser ces questions, ni avec soi-même ni avec son partenaire. Ce n'est presque jamais un choix conscient. On se dit simplement qu'il y a toujours quelque chose à faire. La question, ici, est peut-être la plus inconfortable : à quand remonte la dernière fois où je me suis laissé un moment sans rien à faire, et qu'est-ce qui est venu à ce moment-là ?"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Je suis toujours curieux de cette efficacité. Et je la mets toujours en regard de qui est la personne et de ce qu'elle essaie de faire. Il n'y a là aucun jugement. Chacun agit du mieux qu'il peut, avec ses croyances, ses bonnes intentions et ses modèles. Mais décoder ce qui se cache derrière permet parfois d'en prendre conscience, et de reprendre la main sur ce qui se passe, plutôt que de laisser un mode automatique diriger notre vie."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="Thomas et Claire"/>
                <para PARENT="scene_page_subtitle"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Revenons à Claire, plus tard dans la soirée, en train de ranger la cuisine. Elle a un plan pour parler à sa sœur, elle a remercié Thomas, la soirée s'est bien passée. Et pourtant elle se sent lasse, sans savoir pourquoi."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Ce qui frappe d'abord, quand on relit la scène, c'est la vitesse de l'échange. Il ne se passe que quelques phrases entre le moment où Claire raccroche, la gorge serrée, et celui où elle se lève pour se servir un verre d'eau, apparemment apaisée. Il n'y a pas eu de temps pour que Claire dise ce qu'elle ressentait, ni pour que Thomas le lui demande."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="La première porte concerne Claire. Qu'est-ce que sa position lui apporte ? En acceptant la solution de Thomas, elle n'a pas besoin de rester avec ce qu'elle ressent. L'émotion est vite rangée derrière un plan d'action, et la soirée peut reprendre normalement. Elle n'a pas non plus à chercher ce qu'elle voudrait vraiment, ni à le dire, ce qui demande un effort et comporte un risque : celui de ne pas être comprise, ou de vexer Thomas qui voulait bien faire. Dire merci est plus simple. Cela garde la soirée agréable et évite toute tension. Pour quelqu'un qui a appris tôt qu'il valait mieux ne pas faire de vagues, c'est une façon très efficace de se protéger."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="La deuxième porte concerne Thomas. Qu'est-ce que sa position lui apporte, et qu'est-ce qu'elle lui évite ? Proposer une solution permet de se sentir utile, et c'est agréable. Il y a aussi une autre raison, moins visible. Voir quelqu'un qu'on aime triste, sans pouvoir rien y faire, est inconfortable. Rester simplement à côté de Claire, l'écouter sans rien résoudre, demanderait à Thomas de supporter ce sentiment d'impuissance. Trouver vite une solution est une façon de sortir de cet inconfort. En aidant, Thomas soulage aussi un peu sa propre tension."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Ces deux positions se renforcent l'une l'autre. Chaque fois que Claire remercie, Thomas reçoit la confirmation que sa façon d'aider est la bonne, et il recommencera la prochaine fois. Chaque fois que Thomas propose une solution aussi vite, Claire a encore moins l'occasion de découvrir ce dont elle aurait besoin, et encore moins de raisons de le dire. Ni l'un ni l'autre ne fait rien de mal. Mais à force, Thomas devient celui qui règle les problèmes, et Claire celle qui reçoit les solutions, sans que l'un ou l'autre ait vraiment choisi ce partage."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="La lassitude de Claire s'explique peut-être ainsi. Ce n'est pas un reproche envers Thomas. C'est le signe qu'une partie de ce qu'elle vivait ce soir-là, sa peine, sa fatigue face à cette histoire de famille, n'a trouvé aucune place dans l'échange."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="Inès et Julien"/>
                <para PARENT="scene_page_subtitle"/>
                <para PARENT="scene_page_subtitle"/>
                <tab/>
                <ITEXT CH="Revenons à Inès, ce dimanche soir, au moment où elle repasse sa semaine dans sa tête. Le yoga, la course, le dîner chez Camille, le projet déco qui avance. Une bonne semaine, pleine, vivante même. Et pourtant, l'impression qu'il manque quelque chose."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Dans cette scène, personne ne pilote et personne ne suit. Inès et Julien fonctionnent de la même façon : chacun remplit sa semaine de ce qui lui fait plaisir, de son côté. C'est ce qui rend ce couple différent des deux précédents."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="La première porte concerne ce que cette organisation leur apporte, à tous les deux. Chacun a une grande liberté. Il n'a pas besoin de négocier ses activités, de se mettre d'accord sur un programme, ni de faire des compromis sur ses envies. Il n'y a presque aucune occasion de conflit, puisque les chemins se croisent peu. Chacun se sent pleinement lui-même, reconnu par ses amis, satisfait de ce qu'il fait. Vu de l'extérieur comme de l'intérieur, cela ressemble à un couple équilibré, où chacun respecte l'espace de l'autre."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="La deuxième porte concerne ce que cette organisation leur évite. Proposer quelque chose à l'autre, « viens, on fait un truc tous les deux », demande de prendre un petit risque. L'autre peut dire non, ou dire oui sans enthousiasme. Et si l'on se retrouve à deux sans activité, il faut savoir quoi se dire et quoi partager. On peut aussi découvrir qu'on n'a plus grand-chose en commun en dehors des enfants et de la maison, ce qui est inconfortable. Une semaine remplie d'activités séparées évite de se confronter à ces questions. Personne n'est rejeté, personne n'est déçu, et personne n'a à vérifier ce qui reste entre eux quand il n'y a rien d'autre à faire."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Ces deux portes se renforcent aussi. Plus chacun trouve ailleurs ce dont il a besoin, moins il ressent le besoin de l'autre. Et moins ils passent de temps à deux, moins ils ont de choses à partager, ce qui rend chaque moment ensemble un peu plus difficile à lancer. Il devient alors plus simple de s'inscrire à une activité de plus que de proposer une soirée à deux. Personne ne l'a décidé, mais chaque semaine pleine rend la suivante encore un peu plus séparée."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Le manque qu'Inès ressent ce soir-là ne vient donc pas d'un manque d'activités ou de plaisir. Il vient peut-être de tout ce que cette organisation lui permet de ne pas vivre : un moment avec Julien qui ne serait ni utile ni organisé, juste partagé."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="Léa et Antoine"/>
                <para PARENT="scene_page_subtitle"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Revenons à Léa, trois semaines plus tard, devant le miroir de la salle de bains. Elle ne sait plus depuis quand ils n'ont pas eu un moment rien qu'à eux. Elle ne ressent ni manque criant ni frustration, seulement un silence."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Dans cette scène, Léa et Antoine parlent tous les deux depuis la même voix, celle qui analyse et qui décide. Mais ils n'y jouent pas le même rôle. C'est Léa qui propose de mettre le sujet de côté, et Antoine qui valide presque aussitôt."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="La première porte concerne Antoine. Il accepte tout de suite. Il est fatigué, lui aussi, et la proposition de Léa le soulage. Elle lui évite aussi de se poser une question : est-ce que ces moments à deux lui manquent ? Il ne se l'est pas demandé, et rien ne l'y obligeait. Si la réponse avait été oui, il aurait dû le dire, donc s'opposer à une proposition sage faite par une compagne épuisée. "/>
                <tab/>
                <ITEXT CH="Il aurait pris le risque de passer pour celui qui insiste. En répondant « c'est raisonnable », il évite ce désaccord. Cette réponse lui apporte un dernier avantage, plus discret : c'est Léa qui a proposé de mettre ces moments de côté. Si l'un des deux le regrette un jour, ce ne sera pas lui qui l'aura décidé."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="La deuxième porte concerne Léa. Qu'est-ce que sa position lui apporte, et qu'est-ce qu'elle lui évite ? En proposant elle-même de mettre le sujet de côté, elle reprend la main sur un sujet qui la met peut-être mal à l'aise. Il est plus facile de parler de fatigue et de planning que de dire « ça me manque » ou « j'ai peur qu'on s'éloigne ». Le manque devient un problème d'organisation, et un problème d'organisation peut se régler par une décision. Léa évite ainsi de demander un moment à deux dont elle n'est pas sûre qu'Antoine ait envie, et le risque d'un refus. Son soulagement, à la fin de la conversation, s'explique en partie ainsi."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Ces deux positions se renforcent. Chaque décision raisonnable prise ensemble confirme au couple qu'il sait se parler et régler ses problèmes calmement, ce qui est vrai. Mais elle rend aussi un peu plus difficile la conversation suivante sur ce qu'on ressent, parce que parler d'émotions semblerait moins raisonnable que ce qu'ils savent si bien faire. Peu à peu, la voix qui organise prend toute la place dans leurs échanges, et la voix qui dirait « ça me manque » trouve de moins en moins l'occasion de s'exprimer."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Le silence que Léa ressent devant le miroir vient peut-être de là. Le manque existe toujours, mais leurs conversations ne lui laissent plus de place pour être dit."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="Ce que ces quatre relectures ont en commun"/>
                <para PARENT="scene_page_subtitle"/>
                <para PARENT="scene_page_subtitle"/>
                <tab/>
                <ITEXT CH="Les quatre scènes sont très différentes : un dimanche organisé, une soirée de soutien, une semaine pleine d'activités, une décision prise calmement à deux. Pourtant, quand on les relit avec les deux portes, on y retrouve à chaque fois les mêmes éléments."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="D'abord, personne ne fait rien de mal. Sophie organise pour que la semaine démarre bien. Thomas aide Claire parce qu'il la voit triste. Inès et Julien respectent la liberté de l'autre. Léa et Antoine tiennent compte de leur fatigue. Chacun agit pour de bonnes raisons, et souvent par attention pour l'autre ou pour la famille. C'est pour cela que ces situations sont si difficiles à voir de l'intérieur : comme il n'y a rien à se reprocher, rien ne pousse à s'arrêter pour regarder ce qui se passe."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Ensuite, chaque position apporte quelque chose à celui qui l'occupe, et lui évite quelque chose de plus inconfortable. Marc n'a pas à porter le poids des décisions, et Sophie n'a pas à affronter ce qui se passerait si elle lâchait le fil. Claire n'a pas à rester avec sa peine, et Thomas n'a pas à supporter son impuissance. Inès et Julien n'ont pas à risquer une proposition refusée, ni à découvrir ce qu'ils ont encore à partager. Antoine n'a pas à défendre une envie, et Léa n'a pas à demander. Ce que chacun évite touche presque toujours à la relation : une peur, un désaccord, un refus possible, un sentiment d'impuissance."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Enfin, dans chaque couple, les deux positions se renforcent. Ce que fait l'un donne à l'autre une raison de plus de continuer comme avant. Aucun des deux n'a choisi ce partage, et aucun des deux ne pourrait le produire seul. C'est la répétition de ces échanges, semaine après semaine, qui finit par leur donner une forme stable."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Une scène se distingue pourtant des autres. Chez Sophie et Marc, chez Thomas et Claire et chez Léa et Antoine, chacun a besoin de l'autre pour tenir sa place. Sophie ne peut organiser que parce que Marc suit. Thomas ne peut aider que parce que Claire accepte. La proposition de Léa ne devient une décision que parce qu'Antoine la valide. Chez Inès et Julien, c'est différent. Chacun remplit sa semaine sans avoir besoin de l'autre. Leurs deux positions existent séparément. La section suivante revient sur cette différence et lui donne un nom."/>
                <trail PARENT="BODY"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="751.969503937008" YPOS="9760.47344094488" OwnPage="22" ItemID="142551728" PTYPE="4" WIDTH="497.166026688036" HEIGHT="763.388032123197" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" copath="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" gXpos="751.969503937008" gYpos="2705.35533070866" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="224213536" BACKITEM="224199376"/>
        <PAGEOBJECT XPOS="751.969503937008" YPOS="10642.3632047244" OwnPage="24" ItemID="142565888" PTYPE="4" WIDTH="497.166026688036" HEIGHT="763.388032123197" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" copath="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" gXpos="751.969503937008" gYpos="2705.35533070866" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="2.4 — Le couplage"/>
                <para PARENT="scene_page_subtitle"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Je propose d'appeler couplage ce qui se répète dans ces quatre scènes. Un couplage est une façon d'échanger qui s'est répétée tant de fois entre deux personnes qu'elle est devenue leur façon habituelle de faire. Il met en jeu deux positions, celle de l'un et celle de l'autre, qui se sont ajustées au fil du temps. On pourrait décrire Sophie comme quelqu'un qui a un Parent Normatif développé, et Marc comme quelqu'un qui a un Enfant Adapté disponible. Ce serait exact, mais incomplet, car ni l'un ni l'autre n'aurait pu produire seul ce dimanche bien tenu. Pour comprendre ce qui se passe, il faut regarder les deux positions ensemble."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="En 2.3, nous avons vu ce que chaque position apporte à celui qui l'occupe et ce qu'elle lui évite. C'est ce qui fait durer un couplage. Eric Berne a décrit un mécanisme proche, qu'il appelle un jeu psychologique : un échange qui se répète entre deux personnes parce qu'il rapporte quelque chose à chacune, sans qu'aucune en ait vraiment conscience. Chez Berne, ces jeux finissent souvent mal, par un reproche ou une dispute. Les couplages dont parle ce livre sont plus calmes, mais ils tiennent pour la même raison. Tant que chacun y trouve son compte, personne n'a de raison d'en sortir. Cela a pourtant un coût. Rester à sa place parce qu'on craint ce qui arriverait si on la quittait, ce n'est pas la même chose que la choisir. Avec le temps, une position qu'on n'a pas choisie devient souvent pesante. On continue de la tenir parce qu'on ne sait plus faire autrement, et non parce qu'elle nous convient."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Un couplage ne naît pas toujours d'un accord. Il commence parfois par un désaccord. Au début de la vie commune, chacun a sa façon de faire, et ces façons se heurtent. On explique, on négocie, on se fâche parfois. Ces frictions demandent beaucoup d'énergie. Peu à peu, l'un des deux cesse d'expliquer et fait les choses lui-même, parce que c'est plus rapide. L'autre cesse de discuter et le laisse faire, parce que c'est plus calme. Personne ne l'a décidé, mais à chaque fois, chacun renforce un peu plus son rôle. Au bout d'un moment, la répartition est acquise. Ce n'est pas forcément celle que chacun aurait choisie, mais elle fonctionne, et la remettre en question obligerait à revivre les discussions qu'on a voulu laisser derrière soi. On finit donc par l'accepter telle qu'elle est. L'inconfort ne disparaît pas pour autant. Avant, il se voyait dans la relation, sous forme de désaccords et de tensions. Maintenant, chacun le garde pour soi, comme une insatisfaction discrète qu'il n'exprime plus."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Un couplage n'a pas besoin de deux voix différentes. Léa et Antoine parlent tous les deux depuis l'Adulte. Mais c'est presque toujours elle qui propose et lui qui valide, et cette répartition suffit à créer un couplage."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Les quatre scènes montrent deux formes de couplage. Dans la première, les deux positions dépendent l'une de l'autre. C'est le cas chez Sophie et Marc, chez Thomas et Claire, et chez Léa et Antoine. Chacun tient son rôle si bien que personne ne pense à faire autrement. Essayer paraîtrait même risqué, puisque tout fonctionne. J'appelle cette forme un couplage fort. Dans la seconde, chacun a aussi trouvé son rôle, mais les deux rôles se jouent séparément. C'est le cas d'Inès et Julien. Sans se l'être dit, chacun laisse l'autre satisfaire ses besoins de son côté. J'appelle cette forme un couplage lâche."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Cette distinction prépare une idée que je développerai au chapitre 6 : le couple forme une troisième entité, distincte des deux personnes qui le composent, et elle a ses propres besoins. Dans un couplage fort, chacun met de côté une partie de ses besoins pour que le couple et la famille fonctionnent au mieux. Dans un couplage lâche, c'est l'inverse. Chacun prend soin de ses propres besoins, mais personne ne s'occupe vraiment de ceux du couple, qui reçoit alors trop peu pour rester un lieu de partage."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="La question utile n'est donc plus de savoir quel est mon état du moi dominant. Elle devient : quel couplage mon couple a-t-il installé, fort ou lâche, et quelle position est-ce que j'y occupe ?"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Les quatre scènes ne montrent que quelques couplages. Il en existe d'autres, tout aussi courants. La section suivante en propose une carte plus complète."/>
                <trail PARENT="BODY"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="751.969503937008" YPOS="11524.2529685039" OwnPage="26" ItemID="142568720" PTYPE="4" WIDTH="497.166026688036" HEIGHT="763.388032123197" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" copath="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" gXpos="751.969503937008" gYpos="2705.35533070866" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="224216368"/>
        <PAGEOBJECT XPOS="751.969503937008" YPOS="1823.46556692913" OwnPage="4" ItemID="142571552" PTYPE="4" WIDTH="497.166026688036" HEIGHT="763.388032123197" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" copath="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" gXpos="751.969503937008" gYpos="2705.35533070866" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
