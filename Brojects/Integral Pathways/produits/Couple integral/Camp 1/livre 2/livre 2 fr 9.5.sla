        </PAGEOBJECT>
        <PAGEOBJECT XPOS="751.969503937008" YPOS="12406.1427322835" OwnPage="28" ItemID="240990432" PTYPE="4" WIDTH="497.166026688036" HEIGHT="763.388032123197" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" copath="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" gXpos="751.969503937008" gYpos="2705.35533070866" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Chapitre 3 — Où en êtes-vous, vous ?"/>
                <trail PARENT="Titre"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="751.969503937008" YPOS="13288.032496063" OwnPage="30" ItemID="241015920" PTYPE="4" WIDTH="497.166026688036" HEIGHT="763.388032123197" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" copath="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" gXpos="751.969503937008" gYpos="2705.35533070866" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="3.1 — Pourquoi ce diagnostic n'en est pas un"/>
                <para PARENT="scene_page_subtitle"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Les deux chapitres précédents vous ont peut-être déjà donné une intuition. Une scène vous a semblé familière, ou un mot comme Parent Nourricier ou Enfant Adapté vous a fait penser à une situation précise. Dans ce chapitre, je vous propose d'aller plus loin, en partant cette fois de votre couple plutôt que de ceux des scènes."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Avant de commencer, je voudrais préciser ce que ce chapitre n'est pas. Ce n'est pas un test qui vous attribuerait un profil ou une catégorie une fois pour toutes. Un couple ne fonctionne pas de la même façon dans tous les domaines. Vous pouvez reconnaître un couplage pour tout ce qui touche à l'argent, et un autre, très différent, pour ce qui touche aux enfants ou à la famille élargie. C'est normal, et cela ne dit rien d'inquiétant sur votre couple."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Ce chapitre n'est pas non plus un outil pour analyser votre partenaire. Comme un couplage se joue toujours à deux, vous allez forcément repérer aussi des comportements chez la personne avec qui vous vivez. J'ai vu, chez des couples que j'ai accompagnés, la tentation de se dire à ce moment-là : « c'est exactement ce que fait mon conjoint, il faudrait qu'il lise ça. » C'est compréhensible, et cela part souvent d'une bonne intention. Mais cet exercice n'est utile que si vous l'utilisez pour vous regarder vous-même : la part que vous prenez dans le couplage, ce que vous y apportez et ce que vous en retirez peut-être sans le savoir. Le reste ne vous appartient pas."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Enfin, si vous reconnaissez un couplage qui vous ressemble et que cela vous met mal à l'aise, ce n'est pas un signal d'alarme. Ce malaise montre simplement que vous commencez à voir une part de votre couple que vous ne regardiez pas jusque-là. Pour l'instant, le livre ne vous demande rien de plus que de continuer à regarder."/>
                <trail PARENT="BODY"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="751.969503937008" YPOS="14169.9222598425" OwnPage="32" ItemID="241004592" PTYPE="4" WIDTH="497.166026688036" HEIGHT="763.388032123197" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" copath="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" gXpos="751.969503937008" gYpos="2705.35533070866" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="224224864"/>
        <PAGEOBJECT XPOS="751.969503937008" YPOS="15051.812023622" OwnPage="34" ItemID="241018752" PTYPE="4" WIDTH="497.166026688036" HEIGHT="763.388032123197" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" copath="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" gXpos="751.969503937008" gYpos="2705.35533070866" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="224227696"/>
        <PAGEOBJECT XPOS="751.969503937008" YPOS="15933.7017874016" OwnPage="36" ItemID="241007424" PTYPE="4" WIDTH="497.166026688036" HEIGHT="763.388032123197" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" copath="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" gXpos="751.969503937008" gYpos="2705.35533070866" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="3.5 — Savoir ne suffit pas"/>
                <para PARENT="scene_page_subtitle"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Vous savez maintenant reconnaître votre couplage. Vous l'avez retrouvé dans plusieurs situations concrètes : les décisions du quotidien, l'argent, les tensions, les moments de creux. Vous avez peut-être aussi commencé à voir ce que votre position vous apporte."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Une question se pose alors : maintenant que vous savez, qu'est-ce qui change ?"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Tout de suite, pas grand-chose. Des couples peuvent décrire leur fonctionnement avec beaucoup de précision, dire qui fait quoi, depuis quand et pourquoi, puis refaire exactement la même chose le week-end suivant. La compréhension a pourtant fait son travail : elle a rendu visible ce qui ne l'était pas. Mais voir un fonctionnement ne suffit pas à le changer."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Cela peut surprendre. Dans beaucoup de domaines, comprendre un problème permet de le corriger. Quand on sait pourquoi une machine tombe en panne, on remplace la pièce, et la panne disparaît. Un couple ne fonctionne pas ainsi. Vous pouvez savoir précisément pourquoi vous prenez toujours les décisions, ou pourquoi vous suivez toujours, et continuer à le faire chaque dimanche."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Un couplage est une habitude que les deux partenaires répètent depuis des années sans y penser. Une habitude de ce genre ne disparaît pas quand on la nomme. Elle commence à changer le jour où l'on choisit de faire autrement, une fois, en acceptant l'inconfort que ce choix provoque presque toujours au début."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Le chapitre suivant s'intéresse à cette difficulté. Il cherche à comprendre pourquoi, même quand on voit clairement ce que coûte un fonctionnement, une partie de nous continue de préférer ce qu'elle connaît, même inconfortable, à ce qui pourrait le remplacer. Ce mécanisme ne dépend ni de la volonté ni du courage, et il vaut la peine de le regarder de près avant de parler des moyens d'en sortir."/>
                <trail PARENT="BODY"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="751.969503937008" YPOS="16815.5915511811" OwnPage="38" ItemID="241010256" PTYPE="4" WIDTH="497.166026688036" HEIGHT="763.388032123197" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" copath="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" gXpos="751.969503937008" gYpos="2705.35533070866" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Chapitre 4 — Ce qui résiste, même quand on a compris"/>
                <trail PARENT="Titre"/>
            </StoryText>
        </PAGEOBJECT>
