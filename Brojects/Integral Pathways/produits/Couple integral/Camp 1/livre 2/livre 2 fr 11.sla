        <PAGEOBJECT XPOS="142.52068503937" YPOS="28280.158480315" OwnPage="63" ItemID="243265296" PTYPE="4" WIDTH="497.166026688036" HEIGHT="763.388032123197" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" copath="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" gXpos="737.796275590551" gYpos="5351.02462204724" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="247192416" BACKITEM="247183920"/>
        <PAGEOBJECT XPOS="142.52068503937" YPOS="29162.0482440945" OwnPage="65" ItemID="243270960" PTYPE="4" WIDTH="497.166026688036" HEIGHT="763.388032123197" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" copath="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" gXpos="737.796275590551" gYpos="5351.02462204724" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="247181088" BACKITEM="247192416"/>
        <PAGEOBJECT XPOS="142.52068503937" YPOS="30043.938007874" OwnPage="67" ItemID="243262464" PTYPE="4" WIDTH="497.166026688036" HEIGHT="763.388032123197" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" copath="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" gXpos="737.796275590551" gYpos="5351.02462204724" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
