        <PAGEOBJECT XPOS="820.005668664204" YPOS="6570.06747620375" OwnPage="14" ItemID="214361456" PTYPE="5" WIDTH="295.263379417221" HEIGHT="1" FRTYPE="0" CLIPEDIT="0" ROT="359.914137254786" PWIDTH="0.283464566929134" PCOLOR="bordeaux" SHADE="0" PCOLOR2="bordeaux" PLINEART="1" path="" gXpos="644.257267089402" gYpos="13984.2400195108" gWidth="0" gHeight="0" LAYER="0"/>
        <PAGEOBJECT XPOS="820.005668664204" YPOS="6609.06747620375" OwnPage="14" ItemID="248460656" PTYPE="5" WIDTH="295.263379417221" HEIGHT="1" FRTYPE="0" CLIPEDIT="0" ROT="359.914137254786" PWIDTH="0.283464566929134" PCOLOR="bordeaux" SHADE="0" PCOLOR2="bordeaux" PLINEART="1" path="" gXpos="644.257267089402" gYpos="14023.2400195108" gWidth="0" gHeight="0" LAYER="0"/>
        <PAGEOBJECT XPOS="821.005668664204" YPOS="7510.95723998328" OwnPage="16" ItemID="248463376" PTYPE="5" WIDTH="295.263379417221" HEIGHT="1" FRTYPE="0" CLIPEDIT="0" ROT="359.914137254786" PWIDTH="0.283464566929134" PCOLOR="bordeaux" SHADE="0" PCOLOR2="bordeaux" PLINEART="1" path="" gXpos="1240.53285764058" gYpos="14043.2400195108" gWidth="0" gHeight="0" LAYER="0"/>
        <PAGEOBJECT XPOS="821.005668664204" YPOS="7561.95723998328" OwnPage="16" ItemID="215666432" PTYPE="5" WIDTH="295.263379417221" HEIGHT="1" FRTYPE="0" CLIPEDIT="0" ROT="359.914137254786" PWIDTH="0.283464566929134" PCOLOR="bordeaux" SHADE="0" PCOLOR2="bordeaux" PLINEART="1" path="" gXpos="1240.53285764058" gYpos="14094.2400195108" gWidth="0" gHeight="0" LAYER="0"/>
        <PAGEOBJECT XPOS="864.005668664204" YPOS="13901.18558644" OwnPage="30" ItemID="215669152" PTYPE="5" WIDTH="295.263379417221" HEIGHT="1" FRTYPE="0" CLIPEDIT="0" ROT="359.914137254786" PWIDTH="0.283464566929134" PCOLOR="bordeaux" SHADE="0" PCOLOR2="bordeaux" PLINEART="1" path="" gXpos="1283.53285764058" gYpos="15777.4037990385" gWidth="0" gHeight="0" LAYER="0"/>
        <PAGEOBJECT XPOS="143.1978503937" YPOS="14421.7446415581" OwnPage="31" ItemID="215671872" PTYPE="2" WIDTH="490.9285519476" HEIGHT="370.628318584069" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="0.54664943743963" LOCALSCY="0.54664943743963" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="0" RATIO="1" Pagenumber="0" PFILE="liste couplage.png" PRFILE="Embedded sRGB built-in" IRENDER="0" EPROF="Embedded sRGB built-in" COMPRESSIONQUALITY="0" path="M0 0 L490.929 0 L490.929 370.628 L0 370.628 L0 0 Z" copath="M0 0 L490.929 0 L490.929 370.628 L0 370.628 L0 0 Z" gXpos="143.1978503937" gYpos="14421.7446415581" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1"/>
        <PAGEOBJECT XPOS="146.920353982301" YPOS="17754.4589471813" OwnPage="39" ItemID="202896368" PTYPE="2" WIDTH="472.778761061947" HEIGHT="215.362831858407" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="0.554904649133741" LOCALSCY="0.554904649133741" LOCALX="0" LOCALY="-3.5527136788005e-15" LOCALROT="0" PICART="1" SCALETYPE="0" RATIO="1" Pagenumber="0" PFILE="resultat_quizz.png" PRFILE="Embedded sRGB built-in" IRENDER="0" EPROF="Embedded sRGB built-in" path="M0 0 L472.779 0 L472.779 215.363 L0 215.363 L0 0 Z" copath="M0 0 L472.779 0 L472.779 215.363 L0 215.363 L0 0 Z" gXpos="146.920353982301" gYpos="17754.4589471813" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1"/>
        <PAGEOBJECT XPOS="751.969503937008" YPOS="36217.1663543307" OwnPage="82" ItemID="247206576" PTYPE="4" WIDTH="497.166026688036" HEIGHT="763.388032123197" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" copath="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" gXpos="751.969503937008" gYpos="5351.02462204725" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Les autres couplages"/>
                <para PARENT="scene_page_subtitle"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Les quatre couplages qui suivent n'ont pas de scène dans ce livre. Je ne vous proposerai donc pas d'accord pour chacun d'eux. Un accord ne peut venir que de vos propres besoins, et je ne les connais pas. Je vous propose plutôt des pistes pour les explorer."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="Avant de les lire, rappelons ce que les quatre couples de ces deux chapitres ont en commun. D'un couple à "/>
                <tab/>
                <ITEXT CH="l'autre, les conversations ne se ressemblent pas, mais on y retrouve le même chemin. Celui qui commence part de lui-même : ce qu'il a remarqué, ce qu'il ressent, ce qui est important pour lui. Il explique pourquoi il n'a rien dit pendant si longtemps, ce qui permet à l'autre de ne pas se sentir accusé. Il écoute ensuite ce qui compte pour l'autre, au lieu de chercher à le convaincre. Et l'accord qu'ils trouvent engage les deux, répond aux besoins nommés, et prévoit dès le départ qu'il sera imparfait et qu'on en reparlera."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Les pistes qui suivent servent à préparer la première partie de ce chemin : savoir ce qui se joue pour vous avant d'en parler."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <para/>
                <ITEXT CH="Quand l'un pose les règles et que l'autre les conteste"/>
                <para PARENT="scene_page_subtitle"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="La règle du couple : l'un décide, l'autre conteste presque tout, et la dispute est devenue une habitude."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="Ce que chaque position protège peut-être : celui qui pose les règles s'assure que les choses seront faites, et évite de se sentir seul face aux responsabilités. Celui qui conteste garde le sentiment d'exister et de compter, et évite de disparaître derrière les décisions de l'autre."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="Pour trouver ce qui est important pour vous"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="Si vous posez les règles : qu'est-ce qui m'inquiète quand une décision n'est pas prise ? De quoi aurais-je besoin pour moins porter seul ?"/>
                <para PARENT="BODY"/>
                <ITEXT CH="Si vous contestez : quand je dis non, qu'est-ce que je défends vraiment ? M'arrive-t-il d'être d'accord sans le dire ?"/>
                <para PARENT="BODY"/>
                <ITEXT CH="Pour commencer la conversation : « Je me rends compte que nos discussions finissent souvent en désaccord, et j'y prends ma part. J'aimerais comprendre ce qui se joue pour moi, et pour toi. »"/>
                <trail PARENT="BODY"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="751.969503937008" YPOS="37099.0561181103" OwnPage="84" ItemID="247209408" PTYPE="4" WIDTH="497.166026688036" HEIGHT="763.388032123197" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" copath="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" gXpos="751.969503937008" gYpos="5351.02462204725" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Quand chacun décide seul dans son domaine"/>
                <para PARENT="scene_page_subtitle"/>
                <para PARENT="BODY"/>
                <ITEXT CH="La règle du couple : après une période de négociation, chacun a son domaine, et on ne décide presque plus rien à deux."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="Ce que chaque position protège peut-être : la tranquillité retrouvée après les désaccords du début, le sentiment d'être compétent dans son domaine, et le fait de ne pas avoir à se mettre d'accord."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="Pour trouver ce qui est important pour vous"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="Quelles décisions aimerais-je prendre à deux ?"/>
                <para PARENT="BODY"/>
                <ITEXT CH="Qu'est-ce que je crains si nous recommençons à décider ensemble ?"/>
                <para PARENT="BODY"/>
                <ITEXT CH="Dans mon domaine, est-ce que je me sens plutôt libre, ou plutôt seul ?"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="Pour commencer la conversation : « Notre répartition fonctionne bien, et je ne veux pas revenir aux disputes du début. Mais je me rends compte qu'on ne décide plus grand-chose ensemble, et parfois, ça me manque. »"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="Une fois ces questions explorées, vous aurez une idée plus claire de ce qui est important pour vous. C'est seulement à ce moment que l'accord peut se construire, à deux, à partir de vos besoins et de ceux de votre partenaire, comme l'ont fait les couples de ce chapitre."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="Ce chemin n'est pas simple. Il demande de savoir ce que l'on ressent, de le dire, et d'entendre l'autre dire quelque chose de différent. Vous ne réussirez sans doute pas la première conversation. Ce n'est pas grave. Ce qui compte, c'est que la règle de votre couple soit enfin devenue un sujet dont vous pouvez parler ensemble."/>
                <trail PARENT="BODY"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="751.969503937008" YPOS="37980.9458818898" OwnPage="86" ItemID="254875376" PTYPE="4" WIDTH="497.166026688036" HEIGHT="763.388032123197" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" copath="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" gXpos="751.969503937008" gYpos="5351.02462204725" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <ITEXT CH="Chapitre 8 — Quand l'un des deux"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <ITEXT CH=" change en profondeur"/>
                <trail PARENT="Titre" ALIGN="1"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="751.969503937008" YPOS="38862.8356456693" OwnPage="88" ItemID="254869712" PTYPE="4" WIDTH="497.166026688036" HEIGHT="763.388032123197" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" copath="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" gXpos="751.969503937008" gYpos="5351.02462204725" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Deux ans ont passé. Un samedi matin, Sophie enfile sa veste dans l'entrée. Depuis la rentrée, elle chante dans une chorale, le samedi de dix heures à midi. Elle n'en a pas parlé longtemps à l'avance. Un soir, elle a simplement dit à Marc qu'elle s'était inscrite."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Beaucoup de choses ont changé depuis l'après-midi où Marc avait proposé de prendre en charge un dimanche par mois. Sophie a commencé à voir une thérapeute, après une période où elle se sentait épuisée sans comprendre pourquoi. Elle ne prévoit plus tout. Elle a refusé, pour la première fois, le déjeuner mensuel chez la mère de Marc. Elle dit plus souvent « j'ai envie » et « je n'ai pas envie ». Elle a l'air plus légère, et parfois aussi plus loin."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Marc a d'abord été content. Il aimait ses dimanches à lui, et voir Sophie respirer lui faisait du bien. Puis quelque chose a commencé à le gêner, sans qu'il sache le nommer. Elle pose des questions qu'elle ne posait pas. Elle emploie des mots qu'il ne connaît pas. Quand il s'agace, elle lui demande ce qu'il ressent, et il a l'impression d'être observé."/>
                <para PARENT="narration"/>
                <para PARENT="narration"/>
                <tab/>
                <ITEXT CH="Ce samedi-là, Théo réclame des crêpes, Lina a perdu une chaussure de foot, et Sophie dit au revoir depuis la porte."/>
                <para PARENT="narration"/>
                <para PARENT="narration"/>
                <tab/>
                <ITEXT CH="— Tu rentres pour midi ?"/>
                <para PARENT="narration"/>
                <para PARENT="narration"/>
                <tab/>
                <ITEXT CH="— Midi et demi. On va boire un café après."/>
                <para PARENT="narration"/>
                <para PARENT="narration"/>
                <tab/>
                <ITEXT CH="La porte se referme. Marc retrouve la chaussure sous le canapé, fait les crêpes, emmène Théo au foot. Tout se passe bien. Le soir, quand les enfants sont couchés, il dit pourtant une phrase qu'il n'avait pas prévu de dire."/>
                <para PARENT="narration"/>
                <para PARENT="narration"/>
                <tab/>
                <ITEXT CH="— J'ai l'impression que tu n'as plus besoin de nous."/>
                <para PARENT="narration"/>
                <para PARENT="narration"/>
                <tab/>
                <ITEXT CH="Sophie le regarde. Elle ne répond pas tout de suite."/>
                <para PARENT="narration"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Elle a fait exactement ce que ce livre propose : partir d'elle, retrouver ce qui est important pour elle, choisir au lieu de tenir un rôle. Alors pourquoi ce changement inquiète-t-il autant celui qui vit à côté d'elle ?"/>
                <para PARENT="narration blue"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Jusqu'ici, ce livre a surtout regardé des changements limités : une règle à renégocier, une conversation à oser, un moment à créer. Ce chapitre regarde une situation plus large. Il arrive que l'un des deux change en profondeur, parce qu'il traverse une épreuve, suit une thérapie ou s'engage dans un chemin personnel. Il ne change alors pas seulement une habitude. Il change en partie sa façon d'être au monde, et donc sa façon d'être en couple. Ce chapitre regarde ce que vit celui qui change, ce que vit celui qui reste, et ce qui peut les aider à continuer ensemble, ou, parfois, à se séparer sans se détruire."/>
                <trail PARENT="BODY"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="751.969503937008" YPOS="39744.7254094489" OwnPage="90" ItemID="254878208" PTYPE="4" WIDTH="497.166026688036" HEIGHT="763.388032123197" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" copath="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" gXpos="751.969503937008" gYpos="5351.02462204725" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="254917856"/>
        <PAGEOBJECT XPOS="751.969503937008" YPOS="40626.6151732284" OwnPage="92" ItemID="254881040" PTYPE="4" WIDTH="497.166026688036" HEIGHT="763.388032123197" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" copath="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" gXpos="751.969503937008" gYpos="5351.02462204725" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="254920688" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Quand les chemins se séparent"/>
                <para PARENT="scene_page_subtitle"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Le psychiatre américain M. Scott Peck a publié en 1978 Le Chemin le moins fréquenté, un livre consacré à l'amour et à la croissance personnelle. Il y fait une distinction qui éclaire bien ce que vit Marc."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="La première chose dont parle Peck, c'est l'état amoureux du début. Quand on tombe amoureux, on a l'impression de ne faire qu'un avec l'autre. Les différences semblent sans importance. Tout paraît facile, et l'on a le sentiment que cela durera toujours. Pour Peck, cet état est temporaire, et il finit toujours. Tôt ou tard, chacun redevient lui-même, avec ses habitudes, ses besoins et ses limites. Ce n'est pas un échec. C'est l'évolution normale de toute relation."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="La seconde chose, c'est l'amour. Peck le définit comme la volonté de faire un effort pour favoriser sa propre croissance et celle de l'autre. Dans cette définition, l'amour n'est pas d'abord un sentiment. C'est un choix, que l'on renouvelle, et qui demande du travail : de l'attention, de l'écoute, des efforts pour comprendre l'autre tel qu'il devient. Cet amour-là peut continuer bien après que l'état amoureux a disparu."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Peck met en garde contre ce qu'il appelle le mythe de l'amour romantique : l'idée que le sentiment du début devrait durer toute la vie, et que s'il s'affaiblit, c'est qu'on s'est trompé de partenaire. Ce mythe fait beaucoup de dégâts, parce qu'il pousse à chercher dans le couple d'aujourd'hui ce qu'on a vécu au début."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Peck explique enfin que grandir oblige à renoncer à certaines choses : des habitudes, des attachements, des images de soi ou de sa vie qui ne correspondent plus à la réalité. Ce renoncement ressemble à un deuil. Il s'accompagne souvent d'une période de tristesse, voire de dépression. Peck y voit moins une maladie qu'un signal : le signe qu'une ancienne façon de vivre ne fonctionne plus, et qu'il faut la laisser partir."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="J'en tire une hypothèse sur certaines séparations. Elles surviennent quand l'un des deux reste attaché à l'image du couple qu'ils formaient au début, sans avoir fait le deuil de ce couple-là. On l'entend dans une phrase qui revient souvent : « Je ne comprends pas. On s'aimait, on était passionnés, et je l'aime toujours. Pourquoi on ne peut plus être heureux comme avant ? » Pendant ce temps, la vie a continué. Chacun a changé de métier, ou de façon de voir son travail. Les enfants sont arrivés. Il y a eu des épreuves, des maladies, des deuils. Chacun est aujourd'hui très différent de celui qu'il était au moment de la rencontre. Celui qui reste attaché à l'image du début cherche un couple qui n'existe plus. Et l'autre a le sentiment qu'on lui demande d'être quelqu'un qu'il n'est plus."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="La nostalgie de Marc peut être le début de ce deuil. S'il peut dire ce qu'il regrette, et accepter que leur couple prenne une autre forme, ce regret devient un passage. S'il reste accroché à ce qu'ils étaient, la nostalgie risque de se transformer peu à peu en amertume, et en reproche adressé à Sophie d'avoir changé."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Il arrive aussi qu'aucun accord ne soit possible. Malgré les conversations et la bonne volonté des deux, les besoins de chacun sont devenus trop différents pour tenir dans un même couple. Se séparer n'est pas alors un échec de l'un ou de l'autre. C'est parfois la façon la plus honnête de reconnaître que chacun a changé. Même dans ce cas, ce que ce livre propose reste utile : partir de soi, dire ce qui est important pour soi, écouter ce qui l'est pour l'autre. Une séparation peut se faire dans le respect de ce qui a été vécu, surtout quand il y a des enfants."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Je voudrais ajouter ici quelque chose de plus personnel. Dans mon propre couple, ces dernières années, nous avons fait un gros travail sur nous-mêmes, chacun de son côté, et parfois ensemble. En trois ans, nous avons redéfini au moins cinq fois ce que nous attendions l'un de l'autre et de notre couple. Nous avons appris à le faire en sachant que nos attentes changeaient en même temps que nous. Certaines de ces renégociations ont été simples. D'autres ont demandé des discussions dures, où nous avons remis en question nos façons de fonctionner : par exemple, une rigidité de ma part sur les règles, ou des attentes pour nos soirées que nous ne formulions pas. La peur de ne plus être utile, celle que ressent Marc, a été pour nous une expérience vraiment difficile. Je ne la décris donc pas de l'extérieur."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="C'est aussi pour cela que je crois qu'un couple qui accepte de faire le deuil de son ancien accord peut en construire un nouveau. Il ne retrouvera pas le couple du début. Il trouvera peut-être une autre forme, qui correspond mieux à ce que chacun est devenu. Et il devra sans doute recommencer plusieurs fois, parce que chacun continuera de changer. C'est ce mouvement que ce livre a essayé de décrire : sortir d'un accord qu'on n'a jamais vraiment choisi, pour choisir, ensemble, celui qui nous ressemble aujourd'hui, en sachant qu'il faudra le choisir à nouveau demain."/>
                <trail PARENT="BODY"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="751.969503937008" YPOS="41508.5049370079" OwnPage="94" ItemID="254872544" PTYPE="4" WIDTH="497.166026688036" HEIGHT="763.388032123197" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" copath="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" gXpos="751.969503937008" gYpos="5351.02462204725" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <ITEXT CH="Conclusion"/>
                <trail PARENT="Titre" ALIGN="1"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="751.969503937008" YPOS="42390.3947007874" OwnPage="96" ItemID="254895200" PTYPE="4" WIDTH="497.166026688036" HEIGHT="763.388032123197" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" copath="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" gXpos="751.969503937008" gYpos="5351.02462204725" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="255113312" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Quatre petits moments"/>
                <para PARENT="scene_page_subtitle"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Ce livre a commencé par quatre petits moments. Sophie, les yeux fermés, se dit que c'était un bon dimanche, et quelque chose reste encore une seconde avant qu'elle s'endorme. Claire range la cuisine, et elle se sent lasse sans savoir pourquoi. Inès repasse sa semaine dans sa tête, et elle a l'impression qu'il manque quelque chose. Léa, devant le miroir, ne sait plus depuis quand ils n'ont pas eu un moment à eux."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Aucun de ces moments n'était un problème. Personne ne s'était disputé, personne n'avait fait de mal à personne. C'étaient des sensations légères, faciles à oublier le lendemain. Je crois pourtant qu'elles méritent qu'on s'y arrête. Elles sont souvent le seul signe visible d'un couple qui fonctionne bien, mais selon des règles que plus personne n'a vraiment choisies."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="Le chemin que nous avons parcouru"/>
                <para PARENT="scene_page_subtitle"/>
                <para PARENT="scene_page_subtitle"/>
                <para PARENT="scene_page_subtitle"/>
                <tab/>
                <ITEXT CH="Pour comprendre ce qui se jouait dans ces scènes, nous avons d'abord utilisé l'égogramme de John Dusay et ses cinq voix intérieures : le Parent Normatif, le Parent Nourricier, l'Adulte, l'Enfant Adapté et l'Enfant Libre. Aucune n'est meilleure qu'une autre. Chacune est utile, et chacune peut devenir une prison quand elle prend toute la place."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Nous avons vu ensuite que, dans un couple, deux positions finissent par s'ajuster l'une à l'autre. J'ai appelé cela un couplage. Il est fort quand les deux positions dépendent l'une de l'autre, comme chez Sophie et Marc, chez Thomas et Claire, ou chez Léa et Antoine. Il est lâche quand chacun tient sa place de son côté, comme chez Inès et Julien. Un couplage commence parfois par une friction. On négocie, on se fatigue, puis chacun prend sa place pour que les discussions s'arrêtent. L'inconfort ne disparaît pas pour autant : il quitte la relation et se loge à l'intérieur de chacun."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Nous avons vu aussi pourquoi un couplage dure. Chaque position apporte quelque chose à celui qui l'occupe, et lui évite quelque chose de plus inconfortable : prendre une décision, rester avec sa peine, risquer un refus, dire « tu me manques ». Le biais de statu quo fait paraître le changement plus risqué qu'il ne l'est. Et comprendre ne suffit pas à changer, parce qu'une partie de ce que l'on comprend reste encore trop proche de nous pour que nous puissions la regarder de l'extérieur."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Nous avons regardé ce que ce fonctionnement produit avec le temps : une fragilité au bout d'un an, une énergie épuisée au bout de dix ans, et chez les enfants, un modèle de couple qu'ils emporteront avec eux."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Enfin, nous avons découvert le personnage principal de ce livre, celui qu'on ne voit pas : le couple lui-même. À côté de vous et de votre partenaire, il existe une troisième entité, avec ses propres règles, que personne n'a jamais écrites. Quand l'un des deux change, ces règles tendent à le ramener à son ancienne place. Pour qu'elles évoluent, il faut en parler, en partant de soi, en écoutant ce qui compte pour l'autre, et en construisant ensemble un accord qui réponde aux besoins des deux. Et il faut accepter de recommencer, parce que chacun continue de changer, et que la vie autour du couple change aussi."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="Grandir seul, ou grandir aussi à deux"/>
                <para PARENT="scene_page_subtitle"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Robert Kegan nous a accompagnés à plusieurs moments de ce livre. Pour lui, grandir à l'âge adulte consiste à pouvoir regarder de l'extérieur ce qui, jusque-là, nous guidait sans que nous le voyions. Ce que ce livre propose est exactement cela, appliqué au couple. Les règles de votre couple vous guidaient sans que vous les voyiez. En les nommant, vous pouvez commencer à les regarder, à en parler, et à les choisir."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Kegan décrit aussi le passage de l'esprit socialisé, où ce que l'on fait dépend beaucoup des attentes des autres, à l'esprit auteur de soi, où l'on décide davantage à partir de ses propres valeurs. C'est le chemin qu'a commencé Sophie au chapitre 8. Ce passage est précieux. Mais il comporte un risque, que je vois souvent dans le développement personnel : à force de se concentrer sur soi, on oublie de regarder ce qui nous relie aux autres. On travaille sur ses besoins, ses limites et ses aspirations, et l'on découvre un jour que la relation n'a pas suivi. Kegan décrit d'ailleurs une étape au-delà, plus rare, où l'on reconnaît les limites de sa propre façon de voir et où l'on s'ouvre davantage à celle des autres. Grandir ne veut pas seulement dire devenir plus autonome. Cela veut dire aussi devenir capable de faire de la place à l'autre, tel qu'il est devenu lui aussi."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Je crois donc que chacun est libre de se développer comme il le souhaite. Mais cette liberté s'accompagne d'une responsabilité : regarder ce que ce développement change dans la relation, et prendre soin aussi bien de l'autre que du couple lui-même. Faire grandir la relation, l'aider à s'adapter aux changements de chacun, devrait faire partie de toute démarche de développement personnel menée par quelqu'un qui vit en couple."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="Les questions à se poser"/>
                <para PARENT="scene_page_subtitle"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="Si, chez vous, tout fonctionne bien, et que vous ressentez pourtant une forme de vide, voici les questions que je vous propose de vous poser, un jour où rien ne presse."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT FONT="EB Garamond Bold" CH="Questions pour commencer"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="- Qu'est-ce qui est important pour moi, aujourd'hui ?"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="- À quoi est-ce que j'aspire, pour moi et pour notre couple ?"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="- Qu'est-ce qui me fait peur à l'idée de changer quelque chose dans nos habitudes ?"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="- Qu'est-ce qui me fait peur à l'idée d'en parler à l'autre ?"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="- Pourquoi n'ai-je rien dit jusqu'ici ?"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="- Est-ce que ce que nous avons construit à un moment de notre vie est encore adapté à celle d'aujourd'hui ?  Les enfants ont grandi, mon travail a changé, j'ai changé."/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="- Et notre couple, de quoi aurait-il besoin, en ce moment ?"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Les réponses viendront peut-être lentement. Quand elles seront assez claires, vous pourrez en parler à la personne avec qui vous vivez. Commencez par vous : ce que vous avez remarqué, ce que vous ressentez, ce qui est important pour vous. Écoutez ensuite ce qui compte pour elle. Cherchez ensemble un accord qui tienne compte des deux, qui engage les deux, et dont vous pourrez reparler. La première conversation sera sans doute maladroite. Celles qui suivront le seront un peu moins."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="Une dynamique qui soude le couple"/>
                <para PARENT="scene_page_subtitle"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Je l'ai raconté au chapitre 8 : dans mon propre couple, nous avons redéfini nos attentes au moins cinq fois en trois ans. Certaines de ces conversations ont été simples, d'autres ont été dures. Elles nous ont obligés à remettre en question nos façons de fonctionner, et parfois à affronter des peurs que nous n'avions jamais dites. Ce que j'en retiens, c'est qu'à partir du moment où l'on comprend que le couple est une entité à part entière, qui mérite notre attention, quelque chose change. Chaque conversation de ce type rapproche un peu plus les deux partenaires, parce qu'elle leur montre qu'ils peuvent changer sans se perdre."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="C'est peut-être la promesse la plus importante de ce livre. Quand le couple sait revoir ses accords, chacun a la possibilité, et même l'autorisation, de changer autant qu'il en a besoin. Changer n'est plus une menace pour la relation, puisque la relation peut changer avec lui. Le couple cesse d'être une organisation qu'on maintient. Il devient une relation que deux personnes font évoluer ensemble, tout au long de leur vie, et qui les relie d'autant plus solidement qu'elles ont appris à le choisir à nouveau."/>
                <trail PARENT="BODY"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="751.969503937008" YPOS="43272.284464567" OwnPage="98" ItemID="254883872" PTYPE="4" WIDTH="497.166026688036" HEIGHT="763.388032123197" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" copath="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" gXpos="751.969503937008" gYpos="5351.02462204725" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="255113312"/>
        <PAGEOBJECT XPOS="751.969503937008" YPOS="44154.1742283465" OwnPage="100" ItemID="254892368" PTYPE="4" WIDTH="497.166026688036" HEIGHT="763.388032123197" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" copath="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" gXpos="751.969503937008" gYpos="5351.02462204725" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <ITEXT CH="ANNEXES"/>
                <trail PARENT="Titre" ALIGN="1"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="751.969503937008" YPOS="45036.063992126" OwnPage="102" ItemID="254898032" PTYPE="4" WIDTH="497.166026688036" HEIGHT="763.388032123197" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" copath="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" gXpos="751.969503937008" gYpos="5351.02462204725" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="255110480" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="ANNEXE 1 : AVOIR LA CONVERSATION"/>
                <para PARENT="scene_page_subtitle" ALIGN="1"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Cette fiche reprend les étapes que nous avons vues aux chapitres 6 et 7. Elle ne remplace pas la lecture de ces chapitres. Elle sert à préparer une vraie conversation, au moment où vous en aurez besoin. Vous pouvez la remplir seul, par écrit, avant d'en parler à votre partenaire."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="Avant la conversation : préparer de son côté"/>
                <para PARENT="scene_page_subtitle"/>
                <para PARENT="scene_page_subtitle"/>
                <ITEXT CH="1. Repérer la règle du couple"/>
                <para PARENT="book_subtitle"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Commencez par décrire la façon de faire que vous aimeriez faire évoluer, comme la décrirait un témoin, sans juger ni l'un ni l'autre. Trois questions peuvent vous aider (chapitre 6) :"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="- Qu'est-ce que nous faisons toujours de la même façon, sans jamais en avoir parlé ?"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="- Qui serait surpris, ou mal à l'aise, si l'un de nous arrêtait de le faire ?"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="- Qu'est-ce que chacun de nous a mis de côté pour que cela continue de fonctionner ?"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Écrivez la règle avec « nous » : « Quand j'ai de la peine, nous faisons comme ceci. » « Le dimanche, c'est toujours moi qui organise, et toi qui suis. »"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="2. Ce que je ressens, et ce qui est important pour moi"/>
                <para PARENT="book_subtitle"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Notez ce que vous ressentez quand cette règle s'applique : fatigue, solitude, ennui, tristesse, inquiétude. Puis cherchez le besoin qui se trouve derrière."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Attention à un piège fréquent. Beaucoup de « besoins » que l'on formule spontanément sont en réalité des attentes envers l'autre : « j'ai besoin que tu me reconnaisses », « j'ai besoin que tu m'écoutes », « j'ai besoin que tu t'impliques ». Formulés ainsi, ils désignent ce que l'autre ne fait pas, et ils deviennent vite des reproches. Celui qui les exprime se met en position de victime, et l'autre se sent accusé. C'est le triangle que décrivait Hors Jeu."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Un besoin profond parle de vous. Il existe indépendamment de ce que fait votre partenaire, et vous pourriez le ressentir avec n'importe qui. Voici quelques besoins de ce type :"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="- "/>
                <ITEXT FONT="EB Garamond Bold" FCOLOR="bordeaux" CH="Le lien"/>
                <ITEXT CH=" : se sentir relié, en contact avec l'autre."/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="- "/>
                <ITEXT FONT="EB Garamond Bold" FCOLOR="bordeaux" CH="L'appartenance"/>
                <ITEXT CH=" : sentir que l'on fait partie d'un couple, et pas seulement d'une organisation."/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="- "/>
                <ITEXT FONT="EB Garamond Bold" FCOLOR="bordeaux" CH="La liberté"/>
                <ITEXT CH=" : disposer d'un espace pour soi."/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="- "/>
                <ITEXT FONT="EB Garamond Bold" FCOLOR="bordeaux" CH="La sérénité"/>
                <ITEXT CH=" : se sentir en paix, sans tension permanente."/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="- "/>
                <ITEXT FONT="EB Garamond Bold" FCOLOR="bordeaux" CH="La légèreté"/>
                <ITEXT CH=" : retrouver du jeu, du rire, de l'imprévu."/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="- "/>
                <ITEXT FONT="EB Garamond Bold" FCOLOR="bordeaux" CH="L'authenticité"/>
                <ITEXT CH=" : pouvoir être soi-même, dire ce que l'on vit."/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="- "/>
                <ITEXT FONT="EB Garamond Bold" FCOLOR="bordeaux" CH="La contribution"/>
                <ITEXT CH=" : sentir que l'on apporte quelque chose."/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="- "/>
                <ITEXT FONT="EB Garamond Bold" FCOLOR="bordeaux" CH="L'évolution"/>
                <ITEXT CH=" : pouvoir changer, apprendre, grandir."/>
                <para PARENT="BODY"/>
                <tab/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Pour vérifier que vous avez trouvé un besoin, et non une attente, posez-vous cette question : puis-je l'exprimer sans dire ce que l'autre devrait faire ? « J'ai besoin de me sentir reliée à toi » passe ce test. « J'ai besoin que tu m'écoutes » ne le passe pas. Il exprime une demande, qui viendra plus tard dans la conversation, une fois le besoin dit."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Prenez le temps de trouver le bon besoin. Une demande est plus juste quand elle découle d'un besoin précis (chapitre 7, Inès et Julien)."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="3. Pourquoi je n'ai rien dit jusqu'ici"/>
                <para PARENT="book_subtitle"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Cette question est souvent la plus difficile. Qu'est-ce que cette règle vous apportait ? Qu'est-ce qu'elle vous évitait ? Une décision à prendre, une émotion à vivre, un refus possible, un désaccord ? La réponse vous permettra de prendre votre part de la règle, au lieu de laisser l'autre la porter seul."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="4. Ce que l'autre apporte, et ce dont il a peut-être besoin"/>
                <para PARENT="book_subtitle"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Notez ce que votre partenaire fait de bien dans cette règle, et ce qu'il risque de ressentir quand vous en parlerez. Il pourrait avoir peur de perdre sa place, de ne plus être utile, d'être jugé, ou de perdre sa liberté. Penser à ces peurs à l'avance vous aidera à les accueillir au lieu de les combattre."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="5. Une première proposition, petite et négociable"/>
                <para PARENT="book_subtitle"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Imaginez une première proposition modeste, qui réponde à votre besoin sans en ignorer d'autres. Gardez-la ouverte : elle servira de point de départ, et l'autre pourra la modifier."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="6. Choisir le moment"/>
                <para PARENT="book_subtitle"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Évitez de lancer cette conversation au milieu d'une situation tendue. Choisissez un moment calme, où vous avez du temps et où aucun des deux n'est pris par l'émotion du moment (chapitre 6)."/>
                <trail PARENT="BODY"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="751.969503937008" YPOS="45917.9537559056" OwnPage="104" ItemID="254889536" PTYPE="4" WIDTH="497.166026688036" HEIGHT="763.388032123197" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" copath="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" gXpos="751.969503937008" gYpos="5351.02462204725" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Pendant la conversation"/>
                <para PARENT="scene_page_subtitle"/>
                <para PARENT="BODY"/>
                <ITEXT CH="Les étapes de la conversation"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="- Annoncer le sujet sans inquiéter : « J'aimerais te parler de quelque chose. Ce n'est pas un reproche. »"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="- Décrire la règle du couple, avec « nous » plutôt qu'avec « tu »."/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="- Dire ce que vous ressentez et le besoin qui est derrière, puis seulement ensuite votre demande."/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="- Expliquer pourquoi vous n'avez rien dit, et ce que l'ancienne règle vous apportait aussi."/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="- Reconnaître ce que l'autre apporte."/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="- Demander ce qui est important pour lui, et l'écouter jusqu'au bout."/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="- Chercher ensemble un accord qui réponde aux besoins des deux."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="Quelques points d'attention, tirés des couples de ce livre :"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="- Ne pas rassurer trop vite. « Tout va bien entre nous » peut revenir à dire à l'autre que ce qu'il ressent n'a pas lieu d'être (Inès et Julien)."/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="- Laisser des silences. Si vous remplissez chaque silence, l'autre n'a pas le temps de trouver ce qu'il pense (Léa et Antoine)."/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="- Ne pas arriver avec une solution toute faite. Une proposition présentée comme une décision devient vite une exigence (Sophie et Marc)."/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="- Ne pas demander à l'autre de lâcher prise sur commande. Une peur ne disparaît pas parce qu'on le demande. Cherchez plutôt un petit pas à sa portée (Sophie)."/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="- Repérer quand vous reproduisez l'ancienne règle. On peut traiter un manque comme un problème d'organisation, ou une émotion comme une décision raisonnable, sans s'en rendre compte (Léa et Antoine)."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="L'accord"/>
                <para PARENT="scene_page_subtitle"/>
                <para PARENT="scene_page_subtitle"/>
                <ITEXT CH="Un accord tient mieux quand il remplit quatre conditions :"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="- Il engage les deux. Chacun fait un pas, et pas seulement celui à qui l'on demande de changer."/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="- Il répond aux besoins nommés. Chaque action correspond à un besoin dit pendant la conversation."/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="- Il prévoit l'imparfait. Vous convenez dès le départ qu'il ne sera pas tenu parfaitement, et que ce ne sera pas un échec."/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="- Il comporte un moyen simple de vérifier. Une question à se poser régulièrement, par exemple « est-ce qu'on s'est sentis proches ? », et un moment pour en reparler."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="Après la conversation"/>
                <para PARENT="scene_page_subtitle"/>
                <para PARENT="scene_page_subtitle"/>
                <tab/>
                <ITEXT CH="Attendez-vous à des retours en arrière. Un soir de fatigue suffit pour revenir à l'ancienne façon de faire (chapitre 6). Quand cela arrive, vous pouvez le remarquer ensemble, sans reproche : « On avait dit qu'on essayait autrement. »"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Reparlez de l'accord au moment que vous avez prévu. Gardez ce qui fonctionne, ajustez le reste. Et reprenez la conversation chaque fois que l'un de vous change, ou que votre vie change : les enfants grandissent, le travail évolue, une épreuve survient (chapitre 8)."/>
                <trail PARENT="BODY"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="751.969503937008" YPOS="46799.8435196851" OwnPage="106" ItemID="254886704" PTYPE="4" WIDTH="497.166026688036" HEIGHT="763.388032123197" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" copath="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" gXpos="751.969503937008" gYpos="5351.02462204725" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="255118976" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Annexe 2 — Glossaire"/>
                <para PARENT="scene_page_subtitle" ALIGN="1"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT FONT="EB Garamond Bold" CH="Adulte"/>
                <ITEXT CH=". L'une des cinq voix de l'égogramme. Elle rassemble les informations, compare les options et décide à partir de la réalité. Elle devient un problème quand elle décide seule, sans laisser de place à ce que chacun ressent (chapitre 2)."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT FONT="EB Garamond Bold" CH="Analyse transactionnelle"/>
                <ITEXT CH=". Approche fondée par le psychiatre Eric Berne à la fin des années 1950. Elle décrit la personnalité à partir de plusieurs états du moi, et les échanges entre deux personnes à partir des transactions entre ces états (chapitre 2)."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT FONT="EB Garamond Bold" CH="Biais de statu quo"/>
                <ITEXT CH=". Tendance à préférer une situation connue, même insatisfaisante, à un changement dont on ne connaît pas le résultat. Décrit par William Samuelson et Richard Zeckhauser en 1988 (chapitre 4)."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT FONT="EB Garamond Bold" CH="Besoin"/>
                <ITEXT CH=". Au sens de la communication non violente, ce qui est important pour soi, de façon universelle et indépendante du comportement d'une autre personne : le lien, la liberté, la sérénité, la légèreté. À distinguer de la demande (annexe 1)."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT FONT="EB Garamond Bold" CH="Communication non violente"/>
                <ITEXT CH=". Méthode proposée par Marshall Rosenberg. Elle distingue quatre éléments : décrire ce qui se passe sans jugement, dire ce que l'on ressent, nommer le besoin qui se trouve derrière, et formuler une demande que l'autre reste libre d'accepter (chapitre 6)."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT FONT="EB Garamond Bold" CH="Couplage"/>
                <ITEXT CH=". Façon d'échanger qui s'est répétée tant de fois entre deux personnes qu'elle est devenue leur façon habituelle de faire. Il met en jeu deux positions, qui se sont ajustées l'une à l'autre au fil du temps (chapitre 2)."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT FONT="EB Garamond Bold" CH="Couplage fort"/>
                <ITEXT CH=". Couplage dans lequel les deux positions dépendent l'une de l'autre : chacun a besoin de l'autre pour tenir sa place. Exemples : Sophie et Marc, Thomas et Claire, Léa et Antoine (chapitre 2)."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT FONT="EB Garamond Bold" CH="Couplage lâche"/>
                <ITEXT CH=". Couplage dans lequel les deux positions existent séparément : chacun tient sa place de son côté. Exemple : Inès et Julien (chapitre 2)."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT FONT="EB Garamond Bold" CH="Demande"/>
                <ITEXT CH=". Proposition concrète faite à l'autre pour nourrir un besoin. Elle reste une demande tant que l'autre peut la refuser. Si ce n'est plus le cas, elle devient une exigence (chapitre 6, annexe 1)."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT FONT="EB Garamond Bold" CH="Deux portes"/>
                <ITEXT CH=". Méthode de lecture utilisée au chapitre 2 pour comprendre un couplage. La première porte regarde ce que chaque position apporte à celui qui l'occupe. La seconde regarde ce qu'elle lui évite. On observe ensuite comment les deux positions se renforcent l'une l'autre."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT FONT="EB Garamond Bold" CH="Égogramme"/>
                <ITEXT CH=". Représentation proposée par John Dusay dans les années 1970. Elle montre combien d'énergie une personne met dans chacune des cinq voix intérieures (chapitre 2)."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT FONT="EB Garamond Bold" CH="Enfant Adapté"/>
                <ITEXT CH=". L'une des cinq voix de l'égogramme. Elle s'ajuste, accepte, évite de faire des vagues. Elle a deux formes : soumise, qui se conforme, et rebelle, qui s'oppose (chapitre 2)."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT FONT="EB Garamond Bold" CH="Enfant Libre"/>
                <ITEXT CH=". L'une des cinq voix de l'égogramme. Elle est spontanée et joueuse, elle a des envies et vit sans calculer (chapitre 2)."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT FONT="EB Garamond Bold" CH="Esprit auteur de soi"/>
                <ITEXT CH=". Étape du développement adulte décrite par Robert Kegan, où l'on décide davantage à partir de ses propres valeurs que des attentes des autres (chapitres 7 et 8, conclusion)."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT FONT="EB Garamond Bold" CH="Esprit socialisé"/>
                <ITEXT CH=". Étape du développement adulte décrite par Robert Kegan, où la valeur que l'on s'accorde dépend beaucoup du regard et des attentes des autres (chapitre 4)."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT FONT="EB Garamond Bold" CH="Homéostasie familiale"/>
                <ITEXT CH=". Tendance d'une famille ou d'un couple à revenir à son fonctionnement habituel, même quand ce fonctionnement ne convient plus. Notion proposée par le psychiatre Don Jackson en 1957 (chapitre 6)."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT FONT="EB Garamond Bold" CH="Hypothèse de constance"/>
                <ITEXT CH=". Idée de John Dusay selon laquelle chacun dispose d'une quantité d'énergie psychique à peu près stable, répartie entre les cinq voix. Si l'une en prend beaucoup, il en reste moins pour les autres (chapitres 2 et 5)."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT FONT="EB Garamond Bold" CH="Jeu psychologique."/>
                <ITEXT CH=" Pour Eric Berne, échange qui se répète entre deux personnes parce qu'il rapporte quelque chose à chacune, sans qu'aucune en ait vraiment conscience (chapitre 2)."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT FONT="EB Garamond Bold" CH="Mythe de l'amour romantique"/>
                <ITEXT CH=". Expression de M. Scott Peck pour désigner l'idée que le sentiment amoureux du début devrait durer toute la vie (chapitre 8)."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT FONT="EB Garamond Bold" CH="Parent Normatif"/>
                <ITEXT CH=". L'une des cinq voix de l'égogramme. Elle pose un cadre, fixe des règles et dit ce qui doit être fait. Elle devient un problème quand le cadre devient trop serré (chapitre 2)."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT FONT="EB Garamond Bold" CH="Parent Nourricier"/>
                <ITEXT CH=". L'une des cinq voix de l'égogramme. Elle prend soin, console, aide. Elle devient un problème quand elle aide trop vite, avant que l'autre ait pu dire ce dont il a besoin (chapitre 2)."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT FONT="EB Garamond Bold" CH="Renégociation"/>
                <ITEXT CH=". Conversation dans laquelle deux partenaires revoient une règle de leur couple, en partant chacun de ce qui est important pour lui, et construisent ensemble un nouvel accord (chapitres 6 et 7, annexe 1)."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT FONT="EB Garamond Bold" CH="Sujet et objet"/>
                <ITEXT CH=". Distinction de Robert Kegan. Ce qui est « sujet » nous guide sans que nous le voyions, parce que c'est à travers lui que nous regardons le monde. Ce qui est « objet » peut être observé, nommé et choisi. Grandir consiste à faire passer peu à peu certaines choses du sujet vers l'objet (chapitre 4)."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT FONT="EB Garamond Bold" CH="Transaction"/>
                <ITEXT CH=". Pour Eric Berne, l'unité de base d'un échange : un message envoyé depuis un état du moi, et une réponse donnée depuis un état du moi chez l'autre (chapitre 2)."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT FONT="EB Garamond Bold" CH="Triangle dramatique"/>
                <ITEXT CH=". Modèle de Stephen Karpman, utilisé dans Hors Jeu. Il décrit trois rôles que l'on peut jouer dans un conflit : Persécuteur, Victime et Sauveur (introduction)."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT FONT="EB Garamond Bold" CH="Troisième entité"/>
                <ITEXT CH=". Le couple lui-même, considéré à côté des deux partenaires. Il a ses propres règles, que personne n'a écrites, et ses propres besoins, comme le temps partagé et la place pour que chacun évolue (chapitre 6)."/>
                <trail PARENT="BODY"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="751.969503937008" YPOS="47681.7332834646" OwnPage="108" ItemID="254912192" PTYPE="4" WIDTH="497.166026688036" HEIGHT="763.388032123197" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" copath="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" gXpos="751.969503937008" gYpos="5351.02462204725" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="255107648" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Annexe 3 — Pour aller plus loin"/>
                <para PARENT="scene_page_subtitle" ALIGN="1"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="Voici les auteurs sur lesquels je me suis appuyé dans ce livre. Pour chacun, j'indique l'ouvrage principal et ce que j'en ai retenu."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT FONT="EB Garamond Bold" CH="Eric Berne"/>
                <ITEXT CH=", "/>
                <ITEXT FONT="EB Garamond Italic" CH="Des jeux et des hommes"/>
                <ITEXT CH=" (1964 ; traduction française chez Stock)."/>
                <para PARENT="BODY"/>
                <ITEXT CH="Berne est le fondateur de l'analyse transactionnelle. Je lui dois l'idée que nous parlons depuis plusieurs états du moi, la notion de transaction, et celle de jeu psychologique : un échange qui se répète parce qu'il rapporte quelque chose à chacun. C'est aussi chez lui que l'on trouve, pour chaque jeu, la façon d'en sortir. Le chapitre 7 s'en inspire."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT FONT="EB Garamond Bold" CH="Stephen Karpman"/>
                <ITEXT CH=", "/>
                <ITEXT FONT="EB Garamond Italic" CH="« Fairy Tales and Script Drama Analysis », Transactional Analysis Bulletin"/>
                <ITEXT CH=" (1968)."/>
                <para PARENT="BODY"/>
                <ITEXT CH="L'article où Karpman présente le triangle dramatique : Persécuteur, Victime, Sauveur. Il était au cœur de Hors Jeu. Dans ce livre, il sert de point de départ, et de rappel quand un besoin se transforme en reproche."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT FONT="EB Garamond Bold" CH="John Dusay"/>
                <ITEXT CH=", "/>
                <ITEXT FONT="EB Garamond Italic" CH="« Egograms and the Constancy Hypothesis », Transactional Analysis Journal"/>
                <ITEXT CH=" (1972), puis Egograms (1977)."/>
                <para PARENT="BODY"/>
                <ITEXT CH="Dusay a proposé l'égogramme et ses cinq voix, ainsi que l'hypothèse de constance. Toute la carte des couplages du chapitre 2 repose sur son travail."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT FONT="EB Garamond Bold" CH="William Samuelson et Richard Zeckhauser"/>
                <ITEXT CH=", "/>
                <ITEXT FONT="EB Garamond Italic" CH="« Status Quo Bias in Decision Making »"/>
                <ITEXT CH=", Journal of Risk and Uncertainty (1988)."/>
                <para PARENT="BODY"/>
                <ITEXT CH="L'article qui décrit le biais de statu quo. Je l'utilise au chapitre 4 pour expliquer pourquoi Marc renonce à la brocante avant même de la proposer."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT FONT="EB Garamond Bold" CH="Daniel Kahneman et Amos Tversky"/>
                <ITEXT CH=", "/>
                <ITEXT FONT="EB Garamond Italic" CH="« Prospect Theory », Econometrica"/>
                <ITEXT CH=" (1979). Pour un accès plus simple : Daniel Kahneman, Système 1 / Système 2 (traduction française chez Flammarion)."/>
                <para PARENT="BODY"/>
                <ITEXT CH="Leurs travaux montrent qu'une perte possible pèse plus lourd dans notre esprit qu'un gain de même importance. C'est le principe qui se cache derrière le biais de statu quo."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT FONT="EB Garamond Bold" CH="Robert Kegan"/>
                <ITEXT CH=", "/>
                <ITEXT FONT="EB Garamond Italic" CH="The Evolving Self (1982) et In Over Our Heads (1994)"/>
                <ITEXT CH="."/>
                <para PARENT="BODY"/>
                <ITEXT CH="Kegan décrit le développement des adultes comme un passage progressif de ce qui est « sujet » à ce qui est « objet ». Je lui emprunte cette distinction, ainsi que les notions d'esprit socialisé et d'esprit auteur de soi (chapitres 4, 7, 8 et conclusion). À ma connaissance, ses livres principaux ne sont pas traduits en français."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT FONT="EB Garamond Bold" CH="Albert Bandura"/>
                <ITEXT CH=", "/>
                <ITEXT FONT="EB Garamond Italic" CH="L'Apprentissage social "/>
                <ITEXT CH="(1977 ; traduction française chez Mardaga)."/>
                <para PARENT="BODY"/>
                <ITEXT CH="Bandura a montré que les enfants apprennent beaucoup en observant les adultes. Je m'appuie sur lui au chapitre 5, pour parler de ce que les enfants apprennent du couple de leurs parents."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT FONT="EB Garamond Bold" CH="Don D. Jackson"/>
                <ITEXT CH=", "/>
                <ITEXT FONT="EB Garamond Italic" CH="« The Question of Family Homeostasis »"/>
                <ITEXT CH=", Psychiatric Quarterly Supplement (1957). Voir aussi Paul Watzlawick, Janet Beavin et Don Jackson, Une logique de la communication (1967 ; traduction française au Seuil)."/>
                <para PARENT="BODY"/>
                <ITEXT CH="Jackson a décrit la tendance des familles à revenir à leur équilibre habituel, même quand l'un de leurs membres change. Cette idée explique, au chapitre 6, pourquoi Claire et Thomas reprennent leur ancienne façon de faire au bout d'une semaine."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT FONT="EB Garamond Bold" CH="Marshall B. Rosenberg"/>
                <ITEXT CH=","/>
                <ITEXT FONT="EB Garamond Italic" CH=" Les mots sont des fenêtres (ou bien ce sont des murs)"/>
                <ITEXT CH=" (traduction française aux éditions La Découverte)."/>
                <para PARENT="BODY"/>
                <ITEXT CH="L'ouvrage de référence sur la communication non violente. Je lui emprunte la distinction entre observation, sentiment, besoin et demande, qui structure les conversations des chapitres 6 et 7 et la fiche pratique de l'annexe 1."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT FONT="EB Garamond Bold" CH="M. Scott Peck"/>
                <ITEXT CH=", "/>
                <ITEXT FONT="EB Garamond Italic" CH="Le Chemin le moins fréquenté "/>
                <ITEXT CH="(1978 ; traduction française chez Robert Laffont)."/>
                <para PARENT="BODY"/>
                <ITEXT CH="Peck distingue l'état amoureux du début, qui finit toujours, et l'amour, qui demande un travail. Il décrit aussi le renoncement nécessaire pour grandir. Je m'appuie sur lui au chapitre 8, pour parler des couples qui restent attachés à l'image de leurs débuts."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT FONT="EB Garamond Bold" CH="Pascal Ogil"/>
                <ITEXT CH=", "/>
                <ITEXT FONT="EB Garamond Italic" CH="Hors Jeu"/>
                <ITEXT CH="."/>
                <para PARENT="BODY"/>
                <ITEXT CH="Mon premier livre, consacré aux jeux et au triangle dramatique dans les disputes de couple. Celui-ci en est la suite, pour les couples qui ne se disputent presque jamais."/>
                <trail PARENT="BODY"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="751.969503937008" YPOS="48563.6230472442" OwnPage="110" ItemID="254909360" PTYPE="4" WIDTH="497.166026688036" HEIGHT="763.388032123197" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" copath="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" gXpos="751.969503937008" gYpos="5351.02462204725" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <trail/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="751.969503937008" YPOS="49445.5128110237" OwnPage="112" ItemID="254900864" PTYPE="4" WIDTH="497.166026688036" HEIGHT="763.388032123197" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" copath="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" gXpos="751.969503937008" gYpos="5351.02462204725" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
