            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="142.52068503937" YPOS="3587.24509448819" OwnPage="7" ItemID="190557936" PTYPE="4" WIDTH="497.166026688036" HEIGHT="763.388032123197" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" copath="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" gXpos="737.796275590551" gYpos="2705.35533070866" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="189586496"/>
        <PAGEOBJECT XPOS="142.52068503937" YPOS="4469.13485826772" OwnPage="9" ItemID="190560752" PTYPE="4" WIDTH="497.166026688036" HEIGHT="763.388032123197" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" copath="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" gXpos="737.796275590551" gYpos="2705.35533070866" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <trail/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="751.969503937008" YPOS="5351.02462204724" OwnPage="12" ItemID="190563568" PTYPE="4" WIDTH="497.166026688036" HEIGHT="763.388032123197" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" copath="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" gXpos="1347.24509448819" gYpos="2705.35533070866" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="305481904" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Scène 2 — Ce qu'il fallait dire"/>
                <para PARENT="scene_page_subtitle"/>
                <para/>
                <tab/>
                <para PARENT="narration"/>
                <ITEXT CH="Claire raccroche le téléphone. Sa sœur encore, et cette histoire avec leur mère qui s'éternise, qui revient, qui ne se résout jamais vraiment. Elle a la gorge serrée."/>
                <para PARENT="narration"/>
                <para PARENT="narration"/>
                <tab/>
                <ITEXT CH="Thomas la voit depuis le canapé. « Ça va ? » Claire raconte, en quelques phrases hachées."/>
                <para PARENT="narration"/>
                <para PARENT="narration"/>
                <tab/>
                <ITEXT CH="Thomas se redresse. « Tu devrais dire clairement à ta sœur que tu ne veux plus être au milieu. C'est votre mère qui crée le problème en vous mettant en compétition. La prochaine fois que ta sœur t'appelle pour ça, pose une limite, direct. » Il enchaîne, propose une formulation, presque fier d'avoir vu juste si rapidement."/>
                <para PARENT="narration"/>
                <para PARENT="narration"/>
                <tab/>
                <ITEXT CH="« Ouais, t'as raison », dit Claire. Elle sourit même, un peu. « Merci, c'est clair, dit comme ça. » Elle se lève, va se servir un verre d'eau."/>
                <para PARENT="narration"/>
                <para PARENT="narration"/>
                <tab/>
                <ITEXT CH="Thomas se sent utile. Il a aidé, vite et bien. Claire allume la télé. La soirée continue, normale, agréable même. Personne n'est contrarié."/>
                <para PARENT="narration"/>
                <para PARENT="narration"/>
                <tab/>
                <ITEXT CH="Plus tard, en rangeant la cuisine, Claire repense à l'appel. Elle a maintenant un plan pour sa sœur. Elle ne sait pas pourquoi elle se sent quand même un peu lasse."/>
                <para PARENT="narration"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Thomas a eu raison. Claire l'a même remercié. Alors pourquoi cette lassitude, qui n'a pas de quoi s'accrocher ?"/>
                <para PARENT="narration blue"/>
                <para PARENT="BODY"/>
                <para PARENT="scene_page_subtitle"/>
                <para PARENT="scene_page_subtitle"/>
                <ITEXT CH="Décryptage"/>
                <para PARENT="scene_page_subtitle"/>
                <para PARENT="scene_page_subtitle"/>
                <para PARENT="scene_page_subtitle"/>
                <tab/>
                <ITEXT CH="À première vue, cette soirée se passe bien. Thomas a écouté Claire, il a réagi vite et il lui a proposé une solution concrète. Claire l'a remercié. Il n'y a eu ni dispute ni reproche. Si on devait noter cet échange, il serait plutôt bon, et c'est pour cela qu'il est difficile d'y voir un problème."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Comparons avec un couple qui se dispute dans la même situation. L'un propose des solutions, l'autre les rejette parce qu'il ne se sent pas écouté, et le ton monte. C'est désagréable, mais au moins le problème est visible : quelqu'un exprime qu'il n'a pas reçu ce qu'il attendait. Chez Thomas et Claire, personne n'exprime rien de tel, donc personne ne peut s'en apercevoir."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Thomas a fait ce qu'il sait bien faire : il a cherché à régler le problème. C'est une vraie qualité, et dans beaucoup de situations c'est exactement ce qu'il faut. Mais quand quelqu'un vient de raccrocher la gorge serrée, son premier besoin n'est pas forcément une solution. C'est souvent d'abord d'être écouté et compris dans ce qu'il ressent. La solution peut venir ensuite."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Claire, de son côté, a accepté la solution de Thomas. Ce n'était peut-être pas ce dont elle avait besoin, mais elle ne s'en est pas rendu compte sur le moment. Pour refuser, il aurait fallu qu'elle sache ce qu'elle voulait à la place. Ce n'est pas facile quand on a encore la gorge serrée. Et c'est encore plus difficile face à quelqu'un qui vient de vouloir nous aider : dire « ce n'est pas ça que j'attendais » pourrait le blesser. Alors elle a dit merci, et la soirée a continué."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="C'est ce qui explique la lassitude de Claire en fin de soirée. Elle ne peut rien reprocher à Thomas, puisqu'il a été gentil et efficace. Pourtant, ce qu'elle avait besoin de partager est resté sans réponse. Le sujet a été traité comme un problème à résoudre, et ce qu'elle ressentait est passé à côté."/>
                <para PARENT="BODY"/>
                <para/>
                <tab/>
                <ITEXT CH="Dans cette scène, chacun fait un geste bienveillant : Thomas aide, Claire accueille l'aide avec gratitude. C'est justement parce que les deux comportements ont l'air bienveillants que ni l'un ni l'autre ne voit la distance qui s'installe entre eux."/>
                <trail PARENT="BODY"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="751.969503937008" YPOS="7114.8041496063" OwnPage="16" ItemID="90372032" PTYPE="4" WIDTH="497.166026688036" HEIGHT="763.388032123197" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" copath="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" gXpos="1347.24509448819" gYpos="3587.24509448819" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="305490400" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Scène 4 — La décision raisonnable"/>
                <para PARENT="scene_page_subtitle"/>
                <para PARENT="scene_page_subtitle"/>
                <para PARENT="narration"/>
                <para PARENT="narration"/>
                <tab/>
                <ITEXT CH="Ils sont installés dans le canapé, un dimanche après-midi, le café encore chaud. Léa a proposé qu'ils fassent le point. Pas sur un sujet précis, juste « faire le point », comme ils le font une fois par mois depuis qu'ils ont lu ensemble un article sur la communication de couple."/>
                <para PARENT="narration"/>
                <para PARENT="narration"/>
                <ITEXT CH="— On n'a quasiment pas de moments à nous en ce moment, dit Léa. Entre le boulot, les enfants, ta mère qui va pas bien..."/>
                <para PARENT="narration"/>
                <ITEXT CH="— Je sais. C'est chaud en ce moment."/>
                <para PARENT="narration"/>
                <ITEXT CH="— On devrait peut-être... je sais pas, se dire qu'on met ça de côté un moment. Le temps que ça se tasse. Pas la peine de se mettre la pression."/>
                <para PARENT="narration"/>
                <para PARENT="narration"/>
                <tab/>
                <ITEXT CH="Antoine réfléchit deux secondes, hoche la tête."/>
                <para PARENT="narration"/>
                <ITEXT CH="— Ouais. Franchement, c'est raisonnable. On est tous les deux crevés, ça sert à rien de forcer un truc qui doit pas être forcé."/>
                <para PARENT="narration"/>
                <ITEXT CH="— Voilà. Et de toute façon, dès que ta mère va mieux, dès que le trimestre de Lucas se calme, on pourra reprendre un rythme."/>
                <para PARENT="narration"/>
                <ITEXT CH="— Exactement. On se dit ça alors. On lâche la pression sur ce plan-là pour l'instant."/>
                <para PARENT="narration"/>
                <para PARENT="narration"/>
                <tab/>
                <ITEXT CH="Léa sourit, soulagée. Antoine attrape la télécommande, propose de regarder la suite de leur série. Ils passent une soirée agréable, tranquille, comme d'habitude. Le sujet ne revient pas."/>
                <para PARENT="narration"/>
                <para PARENT="narration"/>
                <tab/>
                <ITEXT CH="Trois semaines plus tard, un soir, en se brossant les dents, Léa réalise qu'elle ne saurait pas dire depuis quand ils n'ont pas eu un moment rien qu'à eux. Elle ne ressent rien de précis en y pensant, ni manque criant, ni frustration. Juste une sorte de silence, dans un endroit qu'elle ne regarde plus vraiment."/>
                <para PARENT="narration"/>
                <para PARENT="narration"/>
                <para PARENT="narration"/>
                <tab/>
                <ITEXT CH="Ils avaient pris une décision raisonnable, d'un commun accord, sans une once de conflit. Alors pourquoi ce silence a-t-il un poids ?"/>
                <para PARENT="narration blue"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="Décryptage"/>
                <para PARENT="scene_page_subtitle"/>
                <para PARENT="scene_page_subtitle"/>
                <para PARENT="scene_page_subtitle"/>
                <tab/>
                <ITEXT CH="À première vue, Léa et Antoine font exactement ce qu'on recommande aux couples. Ils se parlent régulièrement, ils posent un constat commun, ils prennent une décision ensemble, sans pression et sans rancœur. C'est le genre d'échange qu'on donnerait en exemple dans un atelier de communication. Le triangle de Karpman n'y trouverait aucun rôle à repérer : personne n'accuse, personne ne se plaint, personne ne sauve l'autre."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Regardons pourtant ce que cette conversation a réellement produit. Officiellement, ils ont mis un sujet de côté « le temps que ça se tasse ». Dans les faits, ils ont arrêté leurs moments à deux sans fixer de moment pour les reprendre. Surtout, ni l'un ni l'autre n'a dit ce que cela représentait pour lui. Personne n'a dit « ça me manque », « je me sens seule » ou « j'ai peur qu'on s'éloigne ». Ils ont parlé de fatigue, de planning et de priorités, c'est-à-dire avec des mots de gestion. Les mots du désir et du manque sont restés absents."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="C'est là que se trouve la difficulté. Dans cette discussion, seule la partie de chacun qui analyse et organise a pris la parole. Cette partie est très utile : elle permet de regarder la situation en face et de prendre des décisions adaptées. Mais quand elle décide seule, sans laisser de place à ce que chacun ressent ou à ce qu'il craint, ses décisions sont raisonnables plutôt qu'équilibrées. Et une décision raisonnable est très difficile à contester. Qui irait s'opposer à une décision sage et mesurée ?"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="C'est pour cela que cette scène est encore plus difficile à repérer que les précédentes. Un couple qui se dispute sait au moins qu'il a un problème. Léa et Antoine, eux, ont l'impression d'en avoir réglé un, alors qu'ils l'ont seulement mis de côté."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Le silence que Léa ressent trois semaines plus tard ne vient donc pas d'un manque de communication. Ils ont beaucoup parlé, et justement de ce sujet. Il vient de ce que la conversation n'a pas abordé : ce que chacun ressentait vraiment face à cette distance."/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Pour certains couples, ce type de décision reste ponctuel. On le reprend dès que la charge retombe, et il n'y a rien de plus à en dire. Mais si le « on en reparlera quand ça ira mieux » revient chez vous plus souvent qu'il ne se réalise, il vaut la peine de vous demander ce que vos décisions raisonnables vous évitent de dire."/>
                <trail PARENT="BODY"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="142.52068503937" YPOS="8878.58367716536" OwnPage="19" ItemID="90383360" PTYPE="4" WIDTH="497.166026688036" HEIGHT="763.388032123197" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" copath="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" gXpos="737.796275590551" gYpos="4469.13485826772" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <trail/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="142.52068503937" YPOS="9760.47344094488" OwnPage="21" ItemID="90386192" PTYPE="4" WIDTH="497.166026688036" HEIGHT="763.388032123197" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" copath="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" gXpos="737.796275590551" gYpos="4469.13485826772" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="200728592" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Les cinq voix intérieures"/>
                <para PARENT="scene_page_subtitle"/>
                <para PARENT="scene_page_subtitle"/>
                <ITEXT CH="D'où vient cette carte"/>
                <para PARENT="scene_page_subtitle"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Le vocabulaire que j'utilise dans ce chapitre n'a pas été inventé pour ce livre. Il vient d'Eric Berne, un psychiatre américain formé à la psychanalyse dans les années 1940. Berne s'en est éloigné parce qu'il la trouvait trop abstraite pour être utile en séance : on y parlait du ça, du moi et du surmoi, des notions qu'un patient ne pouvait ni observer ni nommer lui-même."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Berne était parti d'une observation beaucoup plus concrète. En écoutant ses patients, il voyait une même personne changer de voix, de posture et de vocabulaire au cours d'une même séance. Un homme de trente-cinq ans pouvait, le temps d'une phrase, parler avec l'intonation et les mots d'un enfant de sept ans. À la phrase suivante, il prenait un ton sévère, presque emprunté à l'un de ses parents. Plutôt que d'y voir un symptôme à interpréter, Berne a pris cette observation au sérieux. Son hypothèse est simple : nous avons en nous plusieurs états du moi, chacun avec ses pensées, ses émotions et ses comportements, et nous passons de l'un à l'autre selon les situations, le plus souvent sans nous en rendre compte."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="C'est de cette intuition qu'est née l'analyse transactionnelle, à la fin des années 1950. Berne a d'abord décrit trois états : le Parent, l'Adulte et l'Enfant. C'est ce modèle que j'utilisais dans Hors Jeu, avec le triangle dramatique de Stephen Karpman, un autre élève de Berne. Pour ce livre, j'ai besoin d'une carte plus fine. En analyse transactionnelle, on distingue en effet deux façons d'être Parent (normatif ou nourricier) et deux façons d'être Enfant (adapté ou libre). Cela donne cinq états. Dans les années 1970, John Dusay, lui aussi proche de Berne, a proposé une manière simple de les représenter : l'égogramme, un graphique qui montre combien d'énergie une personne met dans chacun de ces cinq états. C'est cet outil que j'utilise ici. Il permet de distinguer des comportements que le modèle à trois états mettait dans le même sac. Sophie qui organise et Thomas qui aide Claire relèveraient tous deux du Parent. Ce sont pourtant deux mouvements très différents, et l'égogramme permet de le voir."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="Aucune voix n'est meilleure qu'une autre"/>
                <para PARENT="scene_page_subtitle"/>
                <para PARENT="scene_page_subtitle"/>
                <tab/>
                <ITEXT CH="Il n'y a pas de hiérarchie entre ces cinq états. Aucun n'est plus mûr, plus sain ou plus souhaitable que les autres. Chacun répond à une fonction utile, parfois indispensable. Un couple qui fonctionne bien n'a pas gardé une seule bonne voix en éliminant les quatre autres. C'est un couple où les cinq peuvent circuler selon ce que la situation demande, sans que l'un ou l'autre reste figé dans une seule."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Ces positions ne sont pas innées non plus. On les apprend très tôt, en observant ce qui fonctionnait dans sa famille : ce qui attirait l'attention, ce qui évitait les conflits, ce qui permettait de se sentir en sécurité ou aimé. Un enfant qui a grandi dans une maison où l'ordre était la condition de la paix développera souvent un Parent Normatif solide à l'âge adulte. Un enfant qui a compris très jeune que s'ajuster aux attentes des autres lui évitait des conflits ou lui garantissait de l'affection développera souvent un Enfant Adapté très disponible. Ce ne sont pas des défauts de caractère. Ce sont des stratégies apprises, qui ont été utiles à un moment de notre histoire et qui continuent de servir, parfois bien au-delà du contexte où elles étaient nécessaires."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="Une question de contexte, pas une identité"/>
                <para PARENT="scene_page_subtitle"/>
                <para PARENT="scene_page_subtitle"/>
                <tab/>
                <ITEXT CH="Il faut aussi éviter de s'enfermer dans une case en se disant « "/>
                <ITEXT FONT="EB Garamond Italic" CH="je suis un Parent Normatif "/>
                <ITEXT CH="» ou « "/>
                <ITEXT FONT="EB Garamond Italic" CH="je suis un Enfant Adapté"/>
                <ITEXT CH=" ». Chacun a sans doute une ou deux positions préférées, vers lesquelles il glisse le plus facilement. Mais ces positions changent selon le contexte, parfois de façon très nette. Une personne peut se montrer très docile face à son supérieur, incapable de contester une consigne qui la dérange, puis s'opposer le soir même à presque toutes les propositions de son partenaire. Ce sont deux expressions du même état, l'Enfant Adapté, qui peut se soumettre ou se rebeller selon l'interlocuteur. Pour comprendre sa position dans le couple, il faut donc regarder ce qui se passe dans le couple, sans supposer que ce qui est vrai ailleurs l'est aussi à la maison."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="Une question d'énergie"/>
                <para PARENT="scene_page_subtitle"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Dusay a aussi formulé ce qu'il appelle l'hypothèse de constance. Chacun de nous disposerait d'une quantité d'énergie psychique à peu près stable, qui se répartit entre les cinq états. Si l'un d'eux en prend une grande part, il en reste moins pour les autres. Concrètement, une personne qui met beaucoup d'énergie dans son Parent Normatif, c'est-à-dire dans l'organisation, le contrôle et la bonne tenue des choses, en a moins pour son Enfant Libre : l'élan, le jeu, l'imprévu. Ce n'est pas qu'elle refuse ces choses par principe. C'est qu'elle n'a plus, sur le moment, la ressource intérieure pour les vivre."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Cette idée est plutôt encourageante. Si la répartition de l'énergie n'est pas figée, elle peut évoluer. Quand on choisit, petit à petit, de mettre un peu plus d'énergie dans son Enfant Libre, l'énergie consacrée jusque-là au Parent Normatif ou à l'Enfant Adapté diminue d'autant, et le comportement s'assouplit de façon observable. Il n'est pas nécessaire de renoncer à ces positions ni de les combattre. C'est ce déplacement progressif, plutôt qu'une rupture brutale, qui guidera les propositions de la fin de ce livre."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="Les transactions : ce qui circule entre deux personnes"/>
                <para PARENT="scene_page_subtitle"/>
                <para PARENT="scene_page_subtitle"/>
                <tab/>
                <ITEXT CH="Berne appelle transaction l'unité de base d'un échange : un message envoyé depuis un état du moi, et une réponse donnée depuis un état du moi chez l'autre. Une transaction ne se limite pas à son contenu. Elle contient aussi une invitation, souvent implicite, adressée à une position précise chez l'autre."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Quand Thomas propose une solution toute prête à Claire depuis son Parent Nourricier, il ne lui transmet pas seulement une information utile. Il invite, sans le savoir, son Enfant Adapté, celui qui accueille avec reconnaissance ce qu'on lui offre. Si Claire avait répondu depuis son Adulte, par exemple en disant « je n'ai pas besoin d'une solution, j'ai besoin que tu m'écoutes », l'échange aurait pris une tout autre direction."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="C'est le cœur de ce que ce livre veut montrer. La plupart du temps, nous ne choisissons pas consciemment l'état depuis lequel nous parlons, ni l'invitation que nous adressons à l'autre. Et l'autre répond le plus souvent à cette invitation sans l'avoir choisi non plus. Ces échanges, répétés des centaines de fois, finissent par donner sa forme à une relation, bien plus que n'importe quelle décision prise une fois pour toutes."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="Les cinq états, en détail"/>
                <para PARENT="scene_page_subtitle"/>
                <para PARENT="scene_page_subtitle"/>
                <tab/>
                <ITEXT FONT="EB Garamond Bold" FCOLOR="bordeaux" CH="Le Parent Normatif"/>
                <ITEXT CH=". C'est la voix qui pose un cadre, fixe des règles et dit ce qui doit être fait, et dans quel ordre. Elle part souvent d'une bonne intention : protéger, sécuriser, clarifier. Un parent qui demande à son adolescent de rentrer avant minuit, de ne pas boire et de se méfier des inconnus ne fait rien de problématique. Ce sont des règles de protection, qu'on peut discuter. Elles peuvent quand même provoquer chez celui qui les reçoit l'une des deux réactions habituelles face à une règle : se soumettre ou se rebeller."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Les choses changent quand le cadre devient trop serré. L'adolescent n'a plus le droit de sortir, il doit travailler davantage, voir moins de monde, et aucune de ces règles ne se discute plus. L'intention reste la même, protéger. Mais la pression sur l'autre devient si forte qu'elle appelle presque toujours une réaction de même intensité : un ressentiment qui couve, ou une révolte ouverte. Dans la première scène, Sophie reste du côté sain : organiser un dimanche pour que la semaine démarre bien n'écrase personne. Les choses basculeraient le jour où le moindre écart au planning deviendrait une menace plutôt qu'une possibilité."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT FONT="EB Garamond Bold" FCOLOR="bordeaux" CH="Le Parent Nourricier"/>
                <ITEXT CH=". Consoler un enfant qui tombe, apporter une soupe à un proche malade, écouter un ami qui traverse une mauvaise passe et lui suggérer une piste : tout cela relève d'un Parent Nourricier en bonne santé. C'est une voix généreuse, et la plupart des couples en ont besoin pour durer."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Elle devient un problème quand elle va trop vite. Un parent qui continue de tout faire à la place de son enfant devenu grand, et qui répond à chaque besoin avant même qu'il soit exprimé, finit par l'empêcher d'apprendre à se débrouiller seul. Thomas est déjà un peu de ce côté-là : il propose une solution avant d'avoir demandé à Claire comment elle se sentait. Un "/>
                <ITEXT FONT="EB Garamond Bold" CH="Parent Nourricier"/>
                <ITEXT CH=" plus équilibré aurait commencé par cette question. Répété pendant des années, ce petit excès peut produire un couple où l'un reçoit des solutions avant d'avoir eu le temps de savoir lui-même ce dont il a besoin."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT FONT="EB Garamond Bold" FCOLOR="bordeaux" CH="L'Adulte"/>
                <ITEXT CH=". Fixer un budget ensemble, comparer deux devis, vérifier qu'un projet est réaliste compte tenu du temps disponible : c'est exactement ce dont un couple a besoin pour ne pas avancer à l'aveugle. L'Adulte rassemble les informations, compare les options et décide à partir de la réalité plutôt que d'un réflexe appris."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="La difficulté apparaît quand "/>
                <ITEXT FONT="EB Garamond Bold" CH="l'Adulte"/>
                <ITEXT CH=" décide seul, sans laisser de place à ce que chacun ressent. Deux personnes peuvent se mettre d'accord sur un tableau de tâches ménagères parfaitement équilibré sans qu'aucune ne dise ce que cette répartition remue vraiment chez elle : une charge mentale plus lourde que ce que le tableau montre, ou le manque de reconnaissance pour ce qui est déjà fait. L'accord est raisonnable, mais les vraies questions n'ont pas été abordées. C'est ce qui se passe entre Léa et Antoine : leur décision de mettre un sujet de côté « le temps que ça se tasse » est un bon accord, et c'est pour cela qu'elle est difficile à contester. Avec le temps, un couple qui fonctionne ainsi apprend à tout décider en laissant de côté ce que chaque décision évite de dire, jusqu'à ce que le sujet reporté disparaisse des conversations sans avoir jamais été traité."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT FONT="EB Garamond Bold" FCOLOR="bordeaux" CH="L'Enfant Adapté"/>
                <ITEXT CH=". C'est la voix qui s'ajuste, qui accepte, qui évite de faire des vagues. Berne lui voit deux formes. La forme "/>
                <ITEXT FONT="EB Garamond Bold" CH="soumise"/>
                <ITEXT CH=" se conforme. La forme "/>
                <ITEXT FONT="EB Garamond Bold" CH="rebelle"/>
                <ITEXT CH=" s'oppose. Dans les deux cas, la réaction vient plus d'un réflexe que d'un choix réfléchi, appris très tôt face à une autorité. Décaler ses vacances pour tenir compte d'une contrainte de l'autre, ou faire un pas de côté pour préserver la relation, sont des usages tout à fait sains de cette voix."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="La forme "/>
                <ITEXT FONT="EB Garamond Bold" CH="soumise"/>
                <ITEXT CH=" devient un problème quand elle ne sert plus à s'ajuster mais à s'effacer : dire oui avant même de savoir ce qu'on ressent, accumuler des concessions qu'on ne nomme jamais, jusqu'à perdre le contact avec ce qu'on aurait voulu. Marc en donne un exemple très discret. Il acquiesce, reprend son café, note ce qu'il doit faire. À ce stade, ce n'est pas grave. Mais si ce même geste se répète chaque dimanche pendant des années, Marc risque de ne plus savoir, un jour, ce qu'il aurait envie de faire de son propre dimanche si on le lui demandait vraiment. Claire, dans la deuxième scène, va encore plus vite : elle remercie Thomas avant même d'avoir senti ce qu'elle aurait voulu recevoir. Une fois, cela ne pose aucun problème. Si cela se répète, cela peut devenir la seule réponse qu'elle sait donner."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT FONT="EB Garamond Bold" FCOLOR="bordeaux" CH="L'Enfant Libre"/>
                <ITEXT CH=". C'est la voix spontanée et joueuse, celle qui a envie et qui vit sans calculer. Elle propose une sortie improvisée un soir de semaine, elle rit d'une bêtise, elle permet à un couple de se surprendre encore. Sans elle, un couple s'assèche vite."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Une personne peut avoir un Enfant Libre très présent sans que cela abîme son couple, à condition que cette énergie se tourne aussi, de temps en temps, vers l'autre. La difficulté apparaît quand elle ne s'exprime plus jamais dans le couple, et toujours ailleurs : dans le sport, les amitiés, les projets personnels. Inès et Julien n'ont pas un Enfant Libre en excès ou en manque. Ils ont chacun un Enfant Libre bien vivant, mais qui s'exprime en dehors du couple. Personne ne l'a décidé. Peu à peu, chacun a trouvé ailleurs ce qui lui faisait plaisir, et le couple est devenu le seul endroit où cette énergie ne passe plus."/>
                <trail PARENT="BODY"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="142.52068503937" YPOS="10642.3632047244" OwnPage="23" ItemID="90374864" PTYPE="4" WIDTH="497.166026688036" HEIGHT="763.388032123197" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" copath="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" gXpos="737.796275590551" gYpos="4469.13485826772" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="200728592"/>
        <PAGEOBJECT XPOS="142.52068503937" YPOS="11524.2529685039" OwnPage="25" ItemID="90389024" PTYPE="4" WIDTH="497.166026688036" HEIGHT="763.388032123197" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" copath="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" gXpos="737.796275590551" gYpos="4469.13485826771" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="215625744" BACKITEM="200733952"/>
        <PAGEOBJECT XPOS="142.52068503937" YPOS="12406.1427322835" OwnPage="27" ItemID="90380528" PTYPE="4" WIDTH="497.166026688036" HEIGHT="763.388032123197" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" copath="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" gXpos="737.796275590551" gYpos="4469.13485826771" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="305504560" BACKITEM="215625744"/>
        <PAGEOBJECT XPOS="751.969503937008" YPOS="13288.032496063" OwnPage="30" ItemID="90377696" PTYPE="4" WIDTH="497.166026688036" HEIGHT="763.388032123197" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" copath="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" gXpos="1347.24509448819" gYpos="4469.13485826771" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="199224080" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="La carte des couplages"/>
                <para PARENT="scene_page_subtitle"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Les quatre couplages des scènes ne sont pas les seuls possibles. Je les ai choisis parce qu'ils reviennent souvent et qu'ils se prêtaient bien à une scène. Mais avec cinq voix, les combinaisons sont plus nombreuses. Je vous en propose quelques autres, parce que vous vous reconnaîtrez peut-être dans l'une d'elles plutôt que dans les quatre scènes."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Je reprends la distinction du 2.4. Dans un couplage fort, les deux positions dépendent l'une de l'autre : chacun a besoin de l'autre pour tenir sa place. Dans un couplage lâche, les deux positions existent séparément : chacun tient sa place de son côté."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="Du côté des couplages forts"/>
                <para PARENT="scene_page_subtitle"/>
                <para PARENT="scene_page_subtitle"/>
                <tab/>
                <ITEXT CH="Sophie et Marc associent un Parent Normatif et un Enfant Adapté soumis. Le Parent Normatif peut aussi rencontrer un Enfant Adapté rebelle. Dans ce cas, l'autre ne suit pas : il conteste presque chaque règle et chaque décision. Il ne le fait pas parce que la règle est mauvaise. Il le fait parce que s'opposer est la seule façon qu'il a trouvée d'exister face à celui qui décide. Ce couplage tient aussi solidement que celui de Sophie et Marc, mais il tient par la dispute plutôt que par l'accord. Ces disputes ne disent pas grand-chose de l'état du couple. Elles sont devenues une habitude, aussi prévisible qu'un dimanche bien organisé."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Deux Parents Nourriciers peuvent aussi se rencontrer. Chacun prend soin de l'autre et devance ses besoins avant même qu'il les exprime. De l'extérieur, ce couple paraît très uni, et il l'est souvent. La difficulté est que chacun met son énergie à donner, et que personne ne demande jamais à recevoir. Avec le temps, chacun sait très bien s'occuper de l'autre, mais ne sait plus dire ce dont il a besoin lui-même."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="Du côté des couplages lâches"/>
                <para PARENT="scene_page_subtitle"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Inès et Julien associent deux Enfants Libres, qui vivent chacun leurs envies de leur côté. Un autre couplage lâche réunit un Enfant Libre et un Enfant Adapté. Le premier propose, improvise, cherche de la légèreté. Le second reste prudent : il est disponible, mais rarement partant. Il ne refuse pas franchement. Il répond plus tard, ou sans enthousiasme, ou propose autre chose. Avec le temps, le premier propose de moins en moins, et le second n'attend plus qu'on lui propose quoi que ce soit. Chacun finit par vivre ses envies de son côté."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Deux Parents Normatifs peuvent aussi se retrouver face à face, chacun voulant tenir le cadre à sa façon. Au début, les deux positions s'affrontent sans cesse, dans une négociation permanente sur qui décide de quoi. Le couple peut ensuite se répartir les domaines. L'un s'occupe des enfants, l'autre des finances, et chacun décide seul dans le sien sans intervenir dans celui de l'autre. À partir de là, le couplage devient lâche, puisque chaque position tient sans l'autre. Vu de l'extérieur, cela ressemble à une répartition efficace des tâches. Mais cette répartition leur permet aussi de ne jamais avoir à se mettre d'accord."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="Un moment pour vous"/>
                <para PARENT="scene_page_subtitle"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Avant de continuer, je vous propose de vous poser deux questions, sans chercher la bonne réponse."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="La première : dans votre couple, est-ce que chacun tient presque toujours le même rôle face à l'autre ? L'un organise et l'autre suit, l'un aide et l'autre reçoit, l'un propose et l'autre valide. Ou est-ce que chacun vit surtout de son côté, occupé et plutôt bien, mais rarement avec l'autre ?"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="La seconde : était-ce déjà comme ça au début ? Si ce n'est pas le cas, essayez de vous rappeler comment c'était avant que les rôles se fixent, et ce que vous avez cessé de discuter ou de demander pour que les choses deviennent plus simples."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Vous vous reconnaîtrez peut-être un peu dans les deux formes, selon les sujets et les périodes. C'est normal. À ce stade, il suffit de commencer à remarquer comment les choses se passent chez vous."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="Cette carte ne contient pas tous les couplages possibles entre cinq voix. Elle présente ceux qui me semblent les plus courants. Dans chacun, chaque partenaire trouve un bénéfice qu'il ne voit pas, et le couple a l'air de bien fonctionner : on s'entend bien, on est efficaces, rien ne pose problème. Ce fonctionnement a pourtant un prix. Quand tout est réglé d'avance, il reste peu de place pour changer, pour évoluer ensemble ou pour être surpris par l'autre. Une question reste ouverte, et nous la retrouverons plus loin dans ce livre. Que devient ce couplage si bien rodé le jour où survient un événement inattendu : une maladie, un enfant qui va mal, ou l'un des deux qui change plus vite que l'autre ?"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="Récapitulatif des couplages"/>
                <para PARENT="scene_page_subtitle"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="Ce qui vous attend maintenant"/>
                <para PARENT="scene_page_subtitle"/>
                <para PARENT="scene_page_subtitle"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Vous avez lu quatre scènes, découvert cinq voix intérieures et parcouru une carte des couplages. Vous avez peut-être déjà reconnu un trait de votre propre couple : un rôle que vous tenez sans y penser, ou une réponse que vous donnez presque automatiquement."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Le chapitre suivant vous propose d'aller plus loin, en vous concentrant cette fois sur vous. Il ne contient pas de nouvelle scène. Il vous propose une série de questions pour repérer le couplage dans lequel vous vivez, la position que vous y occupez, et ce que cette position vous apporte peut-être sans que vous le sachiez. À la fin de ce chapitre, vous verrez plus clairement comment fonctionne votre couple. Les pistes pour faire autrement viendront plus loin dans le livre. Pour l'instant, il s'agit seulement de voir clairement, avant de penser à changer quoi que ce soit."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="751.969503937008" YPOS="14169.9222598426" OwnPage="32" ItemID="90397520" PTYPE="4" WIDTH="497.166026688036" HEIGHT="763.388032123197" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" copath="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" gXpos="1347.24509448819" gYpos="4469.13485826771" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="199224080"/>
        <PAGEOBJECT XPOS="142.52068503937" YPOS="15933.7017874016" OwnPage="35" ItemID="90400352" PTYPE="4" WIDTH="497.166026688036" HEIGHT="763.388032123197" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" copath="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" gXpos="737.796275590551" gYpos="5351.02462204724" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <trail/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="142.52068503937" YPOS="16815.5915511811" OwnPage="37" ItemID="90394688" PTYPE="4" WIDTH="497.166026688036" HEIGHT="763.388032123197" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" copath="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" gXpos="737.796275590551" gYpos="5351.02462204724" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="243299280" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Le repérage par les signes"/>
                <para PARENT="scene_page_subtitle"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Pour chacune des six situations suivantes, choisissez la réponse qui ressemble le plus à ce qui se passe chez vous, la plupart du temps. Ne cherchez pas la réponse idéale, ni celle que vous aimeriez donner. Choisissez celle qui correspond le mieux à ce qui se produit réellement."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Les réponses sont désignées par des lettres. Ne leur cherchez pas de sens pour l'instant, vous le découvrirez à la section suivante. Répondez à chaque situation pour elle-même, sans regarder vos réponses précédentes, et notez simplement la lettre choisie."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="1. Les décisions du quotidien"/>
                <para PARENT="scene_page_subtitle"/>
                <ITEXT CH="Un week-end à organiser, un repas à préparer, des courses à faire avant que le frigo soit vide."/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="F. Chacun a ses activités et son rythme. Le week-end se remplit sans que vous ayez besoin de vous consulter beaucoup."/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="A. L'un de vous deux sait presque toujours ce qu'il faut faire, dans quel ordre et pour quelle heure. L'autre suit, sans vraiment se demander s'il ferait autrement."/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="H. Chacun a son domaine. L'un s'occupe des repas, l'autre des sorties, et aucun n'intervient dans le domaine de l'autre."/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Z. Cela dépend des fois. Parfois c'est vous qui prenez les devants, parfois c'est l'autre."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="2. L'argent"/>
                <para PARENT="scene_page_subtitle"/>
                <ITEXT CH="Une dépense importante à décider, un budget à revoir, une priorité sur laquelle vous n'êtes pas sûrs d'être d'accord."/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="H. L'un de vous deux gère les comptes, l'autre ne s'en mêle pas. Chacun décide seul dans les domaines qui sont les siens."/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="C. L'un de vous deux propose un chiffre ou une répartition, et l'autre valide presque toujours, même quand il aurait pu avoir un autre avis s'il avait pris le temps d'y réfléchir."/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="E. Chacun pense d'abord à ce qui ferait plaisir à l'autre : un cadeau, une dépense pour son confort. Il est plus rare que l'un dise ce dont lui-même a envie."/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Z. Cela dépend des sujets. Il n'y a pas de rôle fixe entre vous sur les questions d'argent."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="3. Les enfants (si vous n'avez pas d'enfants, passez à la situation suivante)"/>
                <para PARENT="scene_page_subtitle"/>
                <ITEXT CH="Une règle à poser, un désaccord sur l'éducation, une décision qui les concerne."/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="D. Quand l'un de vous deux pose une règle, l'autre la discute presque toujours, même quand il n'est pas vraiment en désaccord sur le fond."/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="E. Chacun cherche à soulager l'autre : se lever la nuit, prendre une corvée, le laisser souffler. Aucun des deux ne demande vraiment d'aide."/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="A. L'un de vous deux fixe le cadre : les horaires, les limites, ce qui est permis. L'autre s'aligne, même s'il aurait peut-être posé une limite différente."/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Z. Cela change selon les sujets, et vous vous ajustez au cas par cas."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="4. La famille élargie"/>
                <para PARENT="scene_page_subtitle"/>
                <ITEXT CH="Un appel difficile, une tension avec un parent ou un beau-parent, une situation où il faut prendre position."/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="B. L'un de vous deux écoute, puis propose vite une solution ou une position à adopter. L'autre accepte, remercie, et la conversation s'arrête là."/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="D. Quand l'un prend position, l'autre le conteste presque toujours, et la discussion porte plus sur qui a raison que sur la situation elle-même."/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="C. Vous en parlez calmement. L'un propose une position raisonnable, l'autre l'approuve, et le sujet est considéré comme réglé."/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Z. Cela dépend des situations et de qui est le plus concerné sur le moment."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="5. Une tension entre vous"/>
                <para PARENT="scene_page_subtitle"/>
                <ITEXT CH="Une remarque mal reçue, un reproche qui monte, une irritation."/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="G. L'un de vous deux essaie de détendre l'atmosphère, par une blague ou une proposition. L'autre reste sur la réserve et attend que cela passe."/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="E. Chacun s'excuse vite et cherche à prendre soin de l'autre. La tension retombe, mais aucun des deux n'a dit ce dont il avait besoin."/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="B. L'un de vous deux rassure tout de suite et propose une façon d'arranger les choses. L'autre accepte, sans vraiment dire ce qui l'a blessé."/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Z. Cela varie. Parfois la tension s'exprime, parfois elle retombe, sans que l'un de vous tienne toujours le même rôle."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="6. Un moment de creux"/>
                <para PARENT="scene_page_subtitle"/>
                <ITEXT CH="Une période où vous passez peu de temps à deux, sans que rien de grave ne se soit passé."/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="C. L'un de vous deux propose de faire le point. Vous prenez ensemble une décision raisonnable, par exemple attendre que les choses se calment, et le sujet ne revient pas avant longtemps."/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="G. L'un de vous deux propose régulièrement un moment ensemble. L'autre est d'accord sur le principe, mais trouve souvent une raison de remettre à plus tard. Avec le temps, les propositions se font plus rares."/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="F. Ni l'un ni l'autre ne relance vraiment. Chacun continue de son côté, occupé et plutôt satisfait de sa semaine."/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Z. Cela arrive rarement, ou alors c'est tantôt l'un, tantôt l'autre qui relance."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="Vous avez maintenant une lettre par situation. La section suivante vous explique ce qu'elles désignent."/>
                <trail PARENT="BODY"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="142.52068503937" YPOS="17697.4813149606" OwnPage="39" ItemID="90391856" PTYPE="4" WIDTH="497.166026688036" HEIGHT="763.388032123197" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" copath="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" gXpos="737.796275590551" gYpos="5351.02462204724" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="247155600" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Le nom de ce que vous avez repéré"/>
                <para PARENT="scene_page_subtitle"/>
                <para PARENT="BODY"/>
                <ITEXT CH="Voici ce que désignent les lettres."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Regardez maintenant vos six réponses ensemble. Chaque couplage n'était proposé que dans deux ou trois situations. Une lettre qui revient deux fois est donc déjà un signe."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Si une même lettre revient au moins deux fois, ce couplage s'est sans doute installé chez vous au-delà d'un seul domaine. Il est devenu votre façon habituelle de fonctionner à deux, quel que soit le sujet. C'est celui qui vous concerne le plus directement, et c'est sur lui que je vous propose de vous arrêter dans la suite de ce chapitre."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Si aucune lettre ne revient, par exemple A pour les décisions du quotidien, C pour l'argent et G pour les moments de creux, votre couple fonctionne différemment selon les domaines. Aucun couplage unique ne s'est installé partout. Dans ce cas, vous pouvez lire la suite du livre domaine par domaine, en commençant par celui qui vous pèse le plus."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Si vous avez choisi Z dans la plupart des situations, aucun rôle ne semble s'être figé au point de devenir automatique. Ce livre vous concerne peut-être moins directement. Un couplage peut quand même exister dans un domaine que ces six situations n'ont pas abordé, comme l'intimité, le travail ou les amis."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Prenons un exemple. Hélène vit avec Bruno depuis quinze ans. Elle a répondu A pour les décisions du quotidien, C pour l'argent, A pour les enfants, C pour la famille élargie, E pour les tensions, et Z pour les moments de creux."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Deux lettres reviennent chacune deux fois : A et C. En regardant la clé, Hélène voit apparaître deux couplages différents. Le premier, A, associe un Parent Normatif et un Enfant Adapté soumis. Il concerne le quotidien et les enfants. Le second, C, associe deux Adultes, dont l'un propose et l'autre valide. Il concerne l'argent et la famille élargie."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Le questionnaire ne dit pas quelle place Hélène occupe dans chacun de ces couplages. C'est à elle de le chercher. Pour le quotidien et les enfants, la réponse vient vite : c'est elle qui organise, et Bruno suit. Pour l'argent et la famille élargie, elle hésite davantage. Puis elle se rend compte que c'est presque toujours Bruno qui propose, et elle qui approuve. Elle n'y avait jamais pensé."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Hélène découvre ainsi qu'elle n'occupe pas la même position partout. À la maison, elle décide. Sur l'argent, elle suit. Nous l'avons vu au chapitre 2 : une position dépend du contexte, et personne n'est seulement « celui qui organise » ou « celui qui suit ». Cette découverte lui permet aussi de mieux comprendre Bruno. Il n'est pas quelqu'un qui suit en toutes circonstances. Il suit dans les domaines où elle a pris la main, et il décide dans ceux où elle s'est mise en retrait."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Reste à savoir par où commencer. Hélène se pose une question simple : lequel de ces deux couplages me pèse le plus aujourd'hui ? Pour elle, c'est le premier. Elle se sent fatiguée de tout porter à la maison. L'argent, en revanche, ne la gêne pas pour l'instant. C'est donc sur le quotidien qu'elle choisit de s'arrêter dans la suite de ce chapitre."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Ce que vous venez de nommer n'est pas un verdict. C'est l'état actuel d'un fonctionnement qui s'est construit avec le temps, souvent pour de bonnes raisons. La section suivante vous aide à voir ce que ce couplage vous apporte, à vous. Plus loin dans le livre, nous verrons s'il y a des raisons d'en sortir, et comment."/>
                <trail PARENT="BODY"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="142.52068503937" YPOS="18579.3710787402" OwnPage="41" ItemID="243245472" PTYPE="4" WIDTH="497.166026688036" HEIGHT="763.388032123197" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" copath="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" gXpos="737.796275590551" gYpos="5351.02462204724" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Ce que ce couplage vous apporte, à vous"/>
                <para PARENT="scene_page_subtitle"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Vous savez maintenant comment nommer ce qui se passe chez vous. Il reste à comprendre pourquoi cela tient."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Les quatre scènes l'ont montré : un couplage dure parce que chacun des deux y trouve son compte. Ce bénéfice est discret, et celui qui en profite le voit rarement. Je vous propose de chercher le vôtre, celui que vous retirez vous-même de votre position."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Si vous êtes plutôt celui qui organise, qui aide ou qui propose, demandez-vous ce que cette position vous évite. Peut-être de vous demander ce qui se passerait si vous arrêtiez, ne serait-ce qu'une fois. Peut-être le risque que les choses ne se fassent pas comme vous l'auriez voulu, ou pas du tout. Peut-être aussi le plaisir de vous sentir utile, voire indispensable. C'est un sentiment agréable, et il ne donne pas très envie que l'autre prenne le relais."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Si vous êtes plutôt celui qui suit, qui reçoit ou qui valide, demandez-vous ce que cette position vous épargne. D'abord le poids de la décision, et le risque de vous tromper. Peut-être aussi le fait de ne jamais avoir à savoir précisément ce que vous voulez, puisque la question ne vous est presque jamais posée. Cela peut être une façon efficace de vous protéger d'un inconfort plus grand : celui de prendre position, de demander quelque chose ou de risquer un désaccord."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Si vous tenez tous les deux la même position, parce que chacun prend soin de l'autre, que chacun vit de son côté ou que chacun décide seul dans son domaine, la question se pose autrement. Demandez-vous ce que cet équilibre vous évite à tous les deux. Ce peut être une conversation difficile : dire ce dont on a besoin, faire une proposition qui pourrait être refusée, ou se mettre d'accord sur un sujet où l'on ne l'est pas."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Dans tous les cas, une autre question peut vous aider : était-ce déjà ainsi au début ? Si ce n'est pas le cas, qu'est-ce que vous n'avez plus eu envie de revivre ? Expliquer encore, négocier, vous disputer ? Votre position actuelle vous protège peut-être de cela."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Revenons à Hélène, qui a choisi de regarder le quotidien, là où c'est elle qui organise. Elle se demande d'abord ce que cette position lui évite. La première réponse qui lui vient est simple : si elle n'organise pas, rien ne se fait. Puis elle s'arrête, parce que ce n'est pas tout à fait vrai. L'an dernier, quand elle est partie une semaine pour son travail, Bruno a tenu la maison seul. Les choses se sont faites autrement, mais elles se sont faites."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Elle cherche alors plus loin. Sa position lui apporte le sentiment que tout est sous contrôle, et une certaine fierté : à la maison, on peut compter sur elle. Elle lui évite de voir les choses se faire autrement qu'elle ne l'aurait voulu, et de devoir l'accepter sans rien dire. Hélène se rend compte qu'elle préfère tout faire elle-même plutôt que de laisser Bruno faire à sa façon."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Elle se pose ensuite la question des débuts. Quand ils ont emménagé ensemble, ils se partageaient davantage les tâches. Elle se souvient de disputes sur le linge, les repas, les courses oubliées. Peu à peu, elle a repris tout ce qui posait problème, pour que les disputes s'arrêtent. Ce partage n'a jamais été décidé entre eux. Il s'est installé."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Hélène ne sait pas encore ce qu'elle voudrait changer. Mais elle voit maintenant que sa fatigue ne vient pas seulement de Bruno. Elle vient aussi d'une règle qu'ils ont construite à deux, et dans laquelle elle a longtemps trouvé son compte."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Je ne peux pas répondre à votre place, parce que la réponse dépend de votre histoire. Je vous propose plutôt une question à garder avec vous dans les jours qui viennent, à des moments ordinaires de votre vie de couple : qu'est-ce que je risquerais si je changeais de position, ne serait-ce qu'une fois ?"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Ne vous fiez pas trop à une réponse qui viendrait tout de suite. Sur ce sujet, les réponses les plus justes mettent souvent du temps à apparaître."/>
                <trail PARENT="BODY"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="142.52068503937" YPOS="19461.2608425197" OwnPage="43" ItemID="243248304" PTYPE="4" WIDTH="497.166026688036" HEIGHT="763.388032123197" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" copath="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" gXpos="737.796275590551" gYpos="5351.02462204724" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
