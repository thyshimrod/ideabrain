        <PAGEOBJECT XPOS="751.969503937008" YPOS="29162.0482440945" OwnPage="66" ItemID="247181088" PTYPE="4" WIDTH="497.166026688036" HEIGHT="763.388032123197" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" copath="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" gXpos="751.969503937008" gYpos="5351.02462204724" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="243270960"/>
        <PAGEOBJECT XPOS="751.969503937008" YPOS="30043.938007874" OwnPage="68" ItemID="247200912" PTYPE="4" WIDTH="497.166026688036" HEIGHT="763.388032123197" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" copath="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" gXpos="751.969503937008" gYpos="5351.02462204724" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Chapitre 7 — Les portes de sortie"/>
                <trail PARENT="Titre"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="751.969503937008" YPOS="30925.8277716535" OwnPage="70" ItemID="247198080" PTYPE="4" WIDTH="497.166026688036" HEIGHT="763.388032123197" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" copath="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" gXpos="751.969503937008" gYpos="5351.02462204724" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Le chapitre précédent a montré, avec Claire et Thomas, comment renégocier une règle du couple. Chaque couplage appelle pourtant une conversation différente. Ce qu'il faut changer, qui peut faire le premier pas et ce que chacun risque varient d'un couple à l'autre. Dans ce chapitre, je reprends les quatre couples des scènes, puis les couplages de la carte qu'aucune scène n'a montrés. Pour Thomas et Claire, dont la conversation a été racontée au chapitre 6, je me limite à ce que chacun peut faire de son côté."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Je parle de portes de sortie, au pluriel, parce qu'il n'y a pas une seule bonne façon de faire. Chaque porte est une possibilité, pas une consigne. Et comme dans tout ce livre, elles concernent votre propre position. Si vous reconnaissez votre partenaire dans l'une de ces pages, vous aurez peut-être envie de lui tendre le livre. Je vous propose plutôt de vous demander ce que vous, vous pourriez proposer."/>
                <trail PARENT="BODY"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="751.969503937008" YPOS="31807.7175354331" OwnPage="72" ItemID="247195248" PTYPE="4" WIDTH="497.166026688036" HEIGHT="763.388032123197" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" copath="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" gXpos="751.969503937008" gYpos="5351.02462204724" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="243279456" BACKITEM="243285120"/>
        <PAGEOBJECT XPOS="751.969503937008" YPOS="32689.6072992126" OwnPage="74" ItemID="247189584" PTYPE="4" WIDTH="497.166026688036" HEIGHT="763.388032123197" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" copath="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" gXpos="751.969503937008" gYpos="5351.02462204724" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Thomas et Claire : ce qui se joue chaque jour"/>
                <para PARENT="scene_page_subtitle"/>
                <para/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="La conversation de Thomas et Claire a été racontée au chapitre 6, et je n'y reviens pas. Leur accord est clair : Thomas demande avant de proposer, et Claire dit ce dont elle a besoin. Mais un accord de ce type ne tient pas grâce à une seule conversation. Il tient grâce à de petits gestes répétés, que chacun peut faire de son côté."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Pour Thomas, la difficulté se joue en quelques secondes. Quand Claire raconte quelque chose de difficile, l'envie de proposer une solution arrive très vite, presque avant qu'elle ait fini sa phrase. Sa porte peut être de remarquer ce moment, et d'attendre un peu avant de parler. Il peut aussi se demander ce qu'il ressent, lui, en la voyant triste. S'il reconnaît son propre inconfort, il aura moins besoin de le faire disparaître en réglant le problème. Et il peut, de temps en temps, dire simplement ce qu'il ressent : « ça me fait de la peine de te voir comme ça ». Cette phrase ne résout rien. Mais elle montre à Claire qu'il est avec elle."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Pour Claire, la difficulté est d'une autre nature. Elle a l'habitude de raconter les faits, l'appel, ce que sa sœur a dit, ce que sa mère a fait, et de laisser de côté ce qu'elle ressent. Thomas répond alors aux faits, avec une solution. Sa porte peut être de commencer par ce qu'elle vit, « je suis épuisée par cette histoire », avant de raconter ce qui s'est passé. Les conseils de Thomas gardent aussi leur place. Quand l'un d'eux l'aide vraiment, Claire peut l'accueillir et le lui dire."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Ces gestes sont discrets. Mais ce sont eux qui permettent, jour après jour, à la nouvelle règle de remplacer peu à peu l'ancienne."/>
                <trail PARENT="BODY"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="751.969503937008" YPOS="33571.4970629921" OwnPage="76" ItemID="247212240" PTYPE="4" WIDTH="497.166026688036" HEIGHT="763.388032123197" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" copath="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" gXpos="751.969503937008" gYpos="5351.02462204724" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="243276624" BACKITEM="243287952"/>
