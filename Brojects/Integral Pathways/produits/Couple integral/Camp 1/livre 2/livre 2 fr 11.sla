            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="751.969503937008" YPOS="25634.4891889764" OwnPage="58" ItemID="264743152" PTYPE="4" WIDTH="497.166026688036" HEIGHT="763.388032123197" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" copath="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" gXpos="751.969503937008" gYpos="5351.02462204724" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <para PARENT="Titre"/>
                <para PARENT="Titre"/>
                <para PARENT="Titre"/>
                <para PARENT="Titre"/>
                <para PARENT="Titre"/>
                <para PARENT="Titre"/>
                <para PARENT="Titre"/>
                <para PARENT="Titre"/>
                <para PARENT="Titre"/>
                <para PARENT="Titre"/>
                <para PARENT="Titre"/>
                <para PARENT="Titre"/>
                <para PARENT="Titre"/>
                <para PARENT="Titre"/>
                <para PARENT="Titre"/>
                <para PARENT="Titre"/>
                <para PARENT="Titre"/>
                <para PARENT="Titre" ALIGN="1"/>
                <ITEXT CH="Chapitre 6 — Le « nous » "/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <ITEXT CH="et la renégociation"/>
                <trail PARENT="Titre" ALIGN="1"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="751.969503937008" YPOS="26516.3789527559" OwnPage="60" ItemID="264751648" PTYPE="4" WIDTH="497.166026688036" HEIGHT="763.388032123197" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" copath="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" gXpos="751.969503937008" gYpos="5351.02462204724" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="246433072" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Quand l'un bouge"/>
                <para PARENT="scene_page_subtitle" ALIGN="1"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Un mar­di soir, Claire rac­croche après un nou­vel ap­pel de sa sœur. Tou­jours la même his­toire avec leur mère. Tho­mas la voit re­ve­nir dans le sa­lon et pose son té­lé­phone."/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <tab/>
                <ITEXT CH="— En­core elle ? Écoute, je pense que tu de­vrais…"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <tab/>
                <ITEXT CH="— At­tends, dit Claire. Ce soir, je n'ai pas be­soin d'une so­lu­tion. J'ai be­soin que tu m'écoutes."/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Tho­mas s'ar­rête. Il ne dit rien pen­dant quelques se­condes, puis ré­pond « d'ac­cord », un peu sur­pris, un peu vexé aus­si. Claire com­mence à ra­con­ter. Elle parle de la fa­tigue, de l'im­pres­sion d'être tou­jours prise entre les deux, de la co­lère qu'elle n'ose pas mon­trer à sa mère. Tho­mas écoute. Il hoche la tête, ne sait pas trop quoi faire de ses mains, et se re­tient deux fois de pro­po­ser quelque chose. Claire s'ar­rête plus tôt qu'elle ne l'au­rait vou­lu, parce qu'elle sent qu'il est mal à l'aise. La soi­rée re­prend, mais elle est moins lé­gère que d'ha­bi­tude."/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <ITEXT CH="Une se­maine plus tard, la sœur rap­pelle. Claire est épui­sée par sa jour­née. Tho­mas pro­pose un plan, comme avant. Claire n'a pas l'éner­gie de lui re­dire ce qu'elle lui a dit le mar­di pré­cé­dent. Elle le re­mer­cie. La soi­rée se passe bien, et cha­cun est un peu sou­la­gé."/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Rien de ce qui s'est pas­sé ce mar­di-là n'était un échec. Claire a osé dire ce qu'elle res­sen­tait, et Tho­mas a fait l'ef­fort de l'écou­ter. Mais au bout d'une se­maine, cha­cun a re­pris sa place, et au­cun des deux ne l'a dé­ci­dé."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Pour com­prendre ce re­tour, il faut re­gar­der ce que ce chan­ge­ment a de­man­dé à cha­cun. Pour Tho­mas, écou­ter sans pro­po­ser de so­lu­tion l'a lais­sé face au sen­ti­ment d'im­puis­sance dont nous avons par­lé au cha­pitre 2. Il ne sa­vait plus com­ment ai­der, et il ne sa­vait pas non plus s'il fai­sait bien. Pour Claire, la nou­velle fa­çon de faire a aus­si été plus exi­geante. Il lui a fal­lu sa­voir ce qu'elle res­sen­tait, le dire, et voir Tho­mas mal à l'aise pen­dant qu'elle le di­sait. L'an­cienne fa­çon de faire coû­tait moins sur le mo­ment, à l'un comme à l'autre. Il suf­fi­sait d'un soir de fa­tigue pour y re­ve­nir."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Ce re­tour à l'équi­libre ha­bi­tuel a été ob­ser­vé bien avant ce livre. Dans les an­nées 1950, le psy­chiatre amé­ri­cain Don Jack­son tra­vaillait avec des pa­tients et leurs fa­milles. Il avait re­mar­qué que lors­qu'un pa­tient al­lait mieux, la fa­mille ré­agis­sait sou­vent de fa­çon à ra­me­ner l'an­cien équi­libre, et qu'il ar­ri­vait même qu'un autre membre de la fa­mille aille plus mal. En 1957, il a ap­pe­lé ce phé­no­mène l'ho­méo­sta­sie fa­mi­liale. Le mot vient de la bio­lo­gie, où il dé­signe la fa­çon dont un or­ga­nisme main­tient sa tem­pé­ra­ture ou son taux de sucre dans le sang à peu près constants. Ap­pli­qué à une fa­mille ou à un couple, il dé­signe la ten­dance d'un groupe à re­ve­nir à son fonc­tion­ne­ment ha­bi­tuel, même quand ce fonc­tion­ne­ment ne convient plus à per­sonne."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Ce qui me pa­raît im­por­tant dans cette idée, c'est qu'elle ne dé­signe pas de cou­pable. Tho­mas n'a pas em­pê­ché Claire de chan­ger. Claire n'a pas man­qué de cou­rage. Ils ont tous les deux contri­bué au re­tour en ar­rière, cha­cun pour ses propres rai­sons, et sans s'en rendre compte. C'est sou­vent ce qui dé­cou­rage le plus ce­lui qui a es­sayé de bou­ger. Il a l'im­pres­sion d'avoir fait un ef­fort pour rien, ou que l'autre ne veut pas chan­ger. En réa­li­té, le couple a fait ce que font la plu­part des couples : il est re­ve­nu vers ce qu'il connais­sait."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Une ques­tion reste ou­verte. Si Claire a chan­gé sa fa­çon de ré­pondre, pour­quoi le couple n'a-t-il pas sui­vi ? Je crois que la ré­ponse tient à ce­ci : Claire a chan­gé sa propre po­si­tion, mais per­sonne n'a mo­di­fié l'ac­cord sur le­quel leur couple fonc­tion­nait de­puis des an­nées."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Trois en­ti­tés : vous, l'autre et le couple"/>
                <para PARENT="scene_page_subtitle" ALIGN="1"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="On pense sou­vent le couple à tra­vers ses deux oc­cu­pants seule­ment. Je pré­fère en dis­tin­guer trois. Il y a vous, avec vos be­soins, votre his­toire, votre rythme propre. Il y a votre par­te­naire, avec les siens. Et il y a le couple lui-même, une troi­sième en­ti­té, avec ses propres règles, presque ja­mais énon­cées à voix haute, qui se sont for­mées peu à peu au fil des mil­liers d'échanges dont parle ce livre."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Ce « nous » n'est pas la simple ad­di­tion du « je » et du « tu ». So­phie et Marc, sans ja­mais s'as­seoir un jour pour en dé­ci­der for­mel­le­ment, ont un « nous » qui a tran­ché de­puis long­temps : c'est elle qui pi­lote le di­manche, lui qui exé­cute. Au­cun contrat n'a été si­gné. Mais es­sayez, un di­manche or­di­naire, d'in­ver­ser les rôles sans pré­ve­nir, et vous sen­ti­rez à quel point ce « nous » a des règles bien réelles, sim­ple­ment ja­mais mises en mots."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Chez Tho­mas et Claire, la règle est tout aus­si claire et tout aus­si im­pli­cite : quand Claire a de la peine, Tho­mas pro­pose une so­lu­tion, et Claire le re­mer­cie. Ce mar­di soir, Claire a chan­gé sa fa­çon de ré­pondre. Mais la règle elle-même n'a ja­mais été dis­cu­tée entre eux. Comme per­sonne ne l'avait re­mise en ques­tion, il a suf­fi d'un soir de fa­tigue pour qu'ils la suivent de nou­veau, tous les deux."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="C'est ce troi­sième ac­teur qu'on ou­blie le plus sou­vent quand on es­saie de chan­ger quelque chose dans un couple. On tra­vaille sur soi, en thé­ra­pie, en coa­ching, dans la lec­ture. On pro­gresse, par­fois vite. Et on est sur­pris, presque bles­sé, de dé­cou­vrir que le couple n'a pas bou­gé au même rythme, comme si ses règles étaient res­tées les mêmes pen­dant que vous, vous aviez chan­gé. Ce que l'un a com­pris ne mo­di­fie pas, à lui seul, les règles que les deux suivent en­semble. Pour les mo­di­fier, il faut en par­ler ex­pli­ci­te­ment, ce qui sup­pose une conver­sa­tion que beau­coup de couples n'ont ja­mais eu l'oc­ca­sion, ou le cou­rage, d'avoir. C'est de cette conver­sa­tion que parle la suite de ce cha­pitre."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ce que le « nous » contient"/>
                <para PARENT="scene_page_subtitle" ALIGN="1"/>
                <para PARENT="style_TDM" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Cette troi­sième en­ti­té est dif­fi­cile à sai­sir, et je com­prends qu'elle puisse pa­raître abs­traite. Quand on re­garde un couple, on voit deux per­sonnes. Le « nous » n'a ni corps ni voix. On ne peut le voir qu'à tra­vers ses ef­fets : les règles que les deux par­te­naires suivent sans les avoir choi­sies en­semble, et sans même sa­voir qu'elles existent."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Une com­pa­rai­son peut ai­der. Une as­so­cia­tion a des sta­tuts écrits. Ils disent qui dé­cide, com­ment, et ce qui se passe en cas de désac­cord. Un couple n'a pas de sta­tuts écrits, mais il fonc­tionne quand même se­lon des règles. Elles sont sim­ple­ment plus dif­fi­ciles à voir, parce que per­sonne ne les a ja­mais ré­di­gées. Elles se sont fixées au fil des an­nées, échange après échange, sou­vent pour mettre fin à une fric­tion, comme nous l'avons vu au cha­pitre 2."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Pour rendre ces règles vi­sibles, je vous pro­pose trois ques­tions. La pre­mière : qu'est-ce que nous fai­sons tou­jours de la même fa­çon, sans ja­mais en avoir par­lé ? La deuxième : qui se­rait sur­pris, ou mal à l'aise, si l'un de nous ar­rê­tait de le faire ? La troi­sième : qu'est-ce que cha­cun de nous a mis de cô­té pour que ce­la conti­nue de fonc­tion­ner ?"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Ap­pli­quées aux quatre couples de ce livre, ces ques­tions font ap­pa­raître quatre règles dif­fé­rentes. Chez So­phie et Marc, la règle est que So­phie or­ga­nise et que Marc suit. Chez Tho­mas et Claire, quand l'un a de la peine, l'autre pro­pose une so­lu­tion et le pre­mier re­mer­cie. Chez Inès et Ju­lien, cha­cun vit ses en­vies de son cô­té, et per­sonne ne de­mande rien à l'autre. Chez Léa et An­toine, on dé­cide rai­son­na­ble­ment, et on ne parle pas de ce qu'on res­sent. Au­cun de ces couples n'a écrit sa règle. Pour­tant, cha­cun la res­pecte avec beau­coup de constance."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Le « nous » a aus­si ses propres be­soins, dis­tincts de ceux de chaque par­te­naire. Il a be­soin de temps par­ta­gé, de mo­ments où les deux se ren­contrent vrai­ment, d'un par­tage des rôles que cha­cun trouve juste, et d'une place pour que cha­cun puisse évo­luer. Nous avons vu au cha­pitre 2 ce qui se passe quand ces be­soins sont mal ser­vis. Dans un cou­plage fort, cha­cun met de cô­té une par­tie de ses propres be­soins pour que le couple fonc­tionne, et le « nous » prend presque toute la place. Dans un cou­plage lâche, cha­cun prend soin de ses propres be­soins, et le couple re­çoit trop peu pour res­ter un lieu de par­tage."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Dis­tin­guer ces trois en­ti­tés a une consé­quence pra­tique très im­por­tante. Si je ne tra­vaille que sur moi, je change seul, et le couple me ra­mène à mon an­cienne place, comme Claire l'a vé­cu. Si je de­mande à l'autre de chan­ger, ma de­mande de­vient vite un re­proche : « tu pro­poses tou­jours des so­lu­tions », « tu ne m'écoutes pas ». Par­ler du « nous » ouvre une troi­sième voie. Je peux dire « notre fa­çon de faire quand j'ai de la peine ne me convient plus », plu­tôt que « ta fa­çon de faire ne me convient pas ». La règle de­vient un su­jet que nous re­gar­dons en­semble, et l'autre n'a plus be­soin de se dé­fendre."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="On a ten­dance à vou­loir chan­ger l'autre, parce que ce qui se passe ne nous convient pas. C'est com­pré­hen­sible : ce que l'on voit, ce sont ses com­por­te­ments à lui. Pour­tant, le plus sou­vent, ce qui ne nous convient pas tient moins à l'autre en tant que per­sonne qu'à la fa­çon dont nous fonc­tion­nons en­semble. Ce qu'il faut faire évo­luer, c'est donc plu­tôt la troi­sième en­ti­té, c'est-à-dire nos ac­cords. Et ce­la vaut que je change moi-même ou non. Il ar­rive qu'au­cun des deux n'ait chan­gé, et que l'ac­cord ne convienne plus sim­ple­ment parce que la vie au­tour a chan­gé : les en­fants ont gran­di, le tra­vail n'est plus le même, la fa­tigue s'est ins­tal­lée."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Si je change, je ne peux pas réel­le­ment faire chan­ger mon par­te­naire. Il reste libre de sa fa­çon d'être, de son rythme et de ses propres be­soins. En re­vanche, je peux pro­po­ser de faire évo­luer nos ac­cords, pour qu'ils cor­res­pondent mieux à ce que je suis de­ve­nu et à ce à quoi j'as­pire au­jour­d'hui."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Claire ne peut pas faire de Tho­mas quel­qu'un qui écoute na­tu­rel­le­ment sans pro­po­ser de so­lu­tion. Elle peut en re­vanche lui pro­po­ser une nou­velle règle com­mune : quand l'un de nous a de la peine, l'autre com­mence par lui de­man­der ce dont il a be­soin. Concrè­te­ment, ce­la peut te­nir en une ques­tion simple : « Tu veux un conseil, ou tu veux que je t'écoute ? » Cette ques­tion ne de­mande pas à Tho­mas de de­ve­nir quel­qu'un d'autre. Elle lui donne un re­père pour ai­der au­tre­ment, et elle laisse à Claire la pos­si­bi­li­té de dire ce qui l'ai­de­rait sur le mo­ment."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Cette pro­po­si­tion com­porte pour­tant un risque. Si Claire la pré­sente comme une règle que Tho­mas doit ap­pli­quer, elle de­vient vite une exi­gence. Tho­mas se re­trouve alors avec une consigne de plus à res­pec­ter, et la moindre fois où il l'ou­blie peut de­ve­nir un nou­veau re­proche. On au­rait seule­ment rem­pla­cé une an­cienne règle par une nou­velle, sans que rien n'ait vrai­ment été dis­cu­té entre eux."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Pour que cette règle de­vienne un vé­ri­table ac­cord, Claire doit elle aus­si s'en­ga­ger. Elle s'en­gage à pou­voir ar­rê­ter Tho­mas quand il part vers une so­lu­tion, en lui di­sant sim­ple­ment : « Là, j'ai­me­rais plu­tôt que tu m'écoutes. » Elle s'en­gage aus­si à lui ex­pli­quer pour­quoi. Ce n'est pas un re­jet de ce qu'il pro­pose. Elle a sou­vent be­soin, pour com­men­cer, de sou­tien et d'écoute, et elle re­con­naît en même temps qu'il sait pro­po­ser des choses qui l'aident vrai­ment. Ses conseils ont leur place, sim­ple­ment pas tou­jours en pre­mier."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Claire peut aus­si re­con­naître que Tho­mas n'a pas tou­jours la ca­pa­ci­té d'écou­ter long­temps. Voir quel­qu'un qu'il aime en dif­fi­cul­té le met mal à l'aise, et cher­cher une so­lu­tion est sa fa­çon de faire dis­pa­raître le pro­blème, et ce ma­laise avec lui. Le lui dire, sans le lui re­pro­cher, peut le ras­su­rer sur ce qui compte sans doute beau­coup pour lui : se sen­tir utile. Écou­ter Claire est une autre fa­çon de lui être utile, et pas une fa­çon de l'être moins."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Un ac­cord de ce type en­gage donc les deux par­te­naires. Tho­mas s'en­gage à de­man­der avant de pro­po­ser. Claire s'en­gage à dire ce dont elle a be­soin, à l'ar­rê­ter avec bien­veillance quand ce n'est pas le bon mo­ment, et à re­con­naître ce qu'il lui ap­porte. Au­cun des deux ne de­mande à l'autre de chan­ger de na­ture. Ils mo­di­fient en­semble une règle de leur couple."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Un ac­cord que per­sonne n'a si­gné"/>
                <para PARENT="scene_page_subtitle" ALIGN="1"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Re­ve­nons à l'ac­cord que Tho­mas et Claire sui­vaient avant ce mar­di soir. Per­sonne ne l'a ja­mais pro­po­sé ni ac­cep­té. Il s'est ins­tal­lé au dé­but de leur his­toire, sans doute parce qu'il ar­ran­geait cha­cun d'eux : Tho­mas se sen­tait utile, et Claire n'avait pas à res­ter avec sa peine. Pen­dant des an­nées, il leur a conve­nu, au moins en ap­pa­rence."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Au­jour­d'hui, Claire a chan­gé. Elle sait mieux ce dont elle a be­soin quand elle a de la peine, et elle a com­men­cé à le dire. Mais l'ac­cord n'a pas bou­gé. Le couple conti­nue donc de fonc­tion­ner se­lon une règle qui ne cor­res­pond plus à ce que Claire veut. Si elle n'en parle pas, il conti­nue­ra ain­si, même si Tho­mas ne change rien, et même si cette règle ne convient plus vrai­ment à per­sonne. C'est ce que j'ap­pelle un ac­cord que plus per­sonne n'a vrai­ment si­gné : une règle qui tient seule­ment parce que per­sonne ne l'a re­mise en ques­tion."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="C'est pour­quoi, quand l'un des deux change, l'ac­cord doit être re­né­go­cié, même si l'autre ne change pas. Si­non, ce­lui qui a chan­gé vit se­lon des règles qui ne lui res­semblent plus. L'in­con­fort dont nous avons par­lé au cha­pitre 2 re­vient alors. Il ne se voit pas dans la re­la­tion, puisque per­sonne ne se dis­pute, mais cha­cun le garde pour soi."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Rou­vrir cet ac­cord fait peur, et on com­prend pour­quoi. Nous avons vu au cha­pitre 4 qu'on craint de perdre ce qu'on connaît, no­tam­ment la tran­quilli­té ob­te­nue le jour où l'on a ces­sé de né­go­cier. Pro­po­ser de dis­cu­ter d'une règle an­cienne, c'est prendre le risque de re­ve­nir à la fric­tion des dé­buts. La dif­fé­rence, cette fois, tient à la fa­çon d'en par­ler. Au dé­but, les règles se sont fixées par es­sais, par er­reurs et par fa­tigue, sans ja­mais être nom­mées. Au­jour­d'hui, elles peuvent être dis­cu­tées ou­ver­te­ment, en sa­chant ce que cha­cun y ap­porte et ce que cha­cun y cherche. C'est ce qui rend cette conver­sa­tion dif­fé­rente des dis­putes d'au­tre­fois."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="La conver­sa­tion de re­né­go­cia­tion"/>
                <para PARENT="scene_page_subtitle" ALIGN="1"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Une conver­sa­tion de ce type ne s'im­pro­vise pas au mi­lieu d'une soi­rée dif­fi­cile. Le mar­di où Claire a dit « j'ai be­soin que tu m'écoutes », elle ve­nait de rac­cro­cher, elle avait la gorge ser­rée, et Tho­mas a été pris par sur­prise. C'était un pre­mier pas im­por­tant, mais ce n'était pas en­core une re­né­go­cia­tion. Pour dis­cu­ter d'une règle du couple, il vaut mieux choi­sir un mo­ment calme, où au­cun des deux n'est pris par l'émo­tion de la si­tua­tion elle-même."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Pour construire cette conver­sa­tion, je m'ap­puie sur la com­mu­ni­ca­tion non vio­lente, une mé­thode pro­po­sée par le psy­cho­logue amé­ri­cain Mar­shall Ro­sen­berg à par­tir des an­nées 1960. Ro­sen­berg pro­pose de dis­tin­guer quatre élé­ments quand on veut dire quelque chose d'im­por­tant à quel­qu'un. D'abord, dé­crire ce qui se passe, comme pour­rait le dé­crire un té­moin, sans ju­ge­ment. En­suite, dire ce que l'on res­sent. Puis nom­mer le be­soin qui se trouve der­rière ce sen­ti­ment. En­fin, for­mu­ler une de­mande pré­cise, que l'autre reste libre d'ac­cep­ter ou non."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Pour une re­né­go­cia­tion dans le couple, j'ajoute trois élé­ments à ces quatre étapes. Le pre­mier consiste à dé­crire la règle du couple, et pas seule­ment le com­por­te­ment de l'autre : « quand j'ai de la peine, nous fai­sons comme ce­ci ». Le deuxième consiste à ex­pli­quer pour­quoi on a gar­dé cette règle si long­temps, alors qu'elle ne nous conve­nait pas. Le troi­sième consiste à re­con­naître ce que l'autre ap­porte, et ce dont lui-même a be­soin."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Voi­ci à quoi pour­rait res­sem­bler cette conver­sa­tion entre Claire et Tho­mas, un sa­me­di ma­tin, au­tour d'un ca­fé."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="— J'ai­me­rais te par­ler de quelque chose, dit Claire. Pas de ma sœur. De nous. Tu as un mo­ment ?"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <ITEXT CH="— Oui… Qu'est-ce qui se passe ?"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <ITEXT CH="— Rien de grave. Je re­pen­sais à mar­di der­nier, et à hier soir. Quand j'ai de la peine, on fait presque tou­jours la même chose. Je te ra­conte, tu me pro­poses une so­lu­tion, et je te re­mer­cie. On fonc­tionne comme ça de­puis des an­nées, et sou­vent tes idées m'aident vrai­ment."/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <ITEXT CH="— Mais ?"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <ITEXT CH="— Mais je me rends compte que je res­sors sou­vent de ces mo­ments un peu seule, et fa­ti­guée. Ce dont j'ai be­soin d'abord, c'est de sen­tir que tu es là, que tu en­tends ce que je vis. Les so­lu­tions viennent après. Et par­fois, je n'en ai pas be­soin du tout."/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <ITEXT CH="Tho­mas se tait un mo­ment."/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <ITEXT CH="— Tu au­rais pu me le dire avant. Ça fait com­bien de temps ?"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <ITEXT CH="— Long­temps. Et pour être hon­nête, ça m'ar­ran­geait aus­si. Quand tu me don­nais une so­lu­tion, je n'avais pas à res­ter avec ce que je res­sen­tais. On pas­sait à autre chose, et la soi­rée re­pre­nait. C'était plus confor­table pour moi aus­si, sur le mo­ment. C'est seule­ment après que je me sen­tais seule. Tu n'as rien fait de mal. On a fait ça à deux."/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <ITEXT CH="— Je veux juste t'ai­der. Quand je te vois comme ça, je ne sais pas quoi faire."/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <ITEXT CH="— Je sais. Et ça compte beau­coup pour moi que tu veuilles m'ai­der. M'écou­ter, c'est aus­si m'ai­der. Ce que je te pro­pose, c'est qu'on es­saie quelque chose. Quand j'ai de la peine, tu me de­mandes : « Tu veux un conseil, ou tu veux que je t'écoute ? » Et de mon cô­té, si tu pars trop vite vers une so­lu­tion, je te le dis, gen­ti­ment, sans que ce soit un re­proche."/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <ITEXT CH="— Et si je n'y ar­rive pas ? Si je n'ar­rive pas à juste écou­ter ?"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <ITEXT CH="— Alors tu me le dis aus­si. On n'est pas obli­gés d'y ar­ri­ver tout de suite."/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <ITEXT CH="— D'ac­cord. On es­saie."/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Re­li­sons cette conver­sa­tion. Claire com­mence par dé­crire la règle du couple : « on fait presque tou­jours la même chose ». Elle ne dit pas « tu me pro­poses tou­jours des so­lu­tions », ce qui au­rait mis Tho­mas en ac­cu­sa­tion. Elle parle d'une fa­çon de faire qu'ils par­tagent, et elle re­con­naît tout de suite ce qu'elle lui doit : « sou­vent tes idées m'aident vrai­ment »."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Elle dit en­suite ce qu'elle res­sent, « un peu seule, et fa­ti­guée ». Der­rière ce sen­ti­ment, il y a un be­soin pro­fond : le lien, le fait de se sen­tir re­liée à Tho­mas quand elle tra­verse quelque chose de dif­fi­cile. Ce qu'elle for­mule, « sen­tir que tu es là, que tu en­tends ce que je vis », dé­coule de ce be­soin. Elle ne de­mande pas à Tho­mas de de­vi­ner. Elle dit ce qui est im­por­tant pour elle, ce qu'elle n'avait ja­mais fait. La de­mande pré­cise vien­dra en­suite, quand elle pro­po­se­ra une nou­velle fa­çon de faire."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Quand Tho­mas de­mande pour­quoi elle ne l'a pas dit plus tôt, Claire ne se dé­fend pas, et elle ne le rend pas res­pon­sable. Elle re­con­naît que l'an­cienne règle l'ar­ran­geait aus­si : la so­lu­tion de Tho­mas lui per­met­tait de ne pas res­ter avec sa peine. Cette phrase est im­por­tante. Elle montre à Tho­mas que la règle a été construite à deux, et qu'il n'a pas à por­ter seul ce qui ne fonc­tion­nait pas."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Je fais aus­si l'hy­po­thèse que cette ha­bi­tude vient de plus loin que leur couple. Les ap­pels de la sœur de Claire portent sur leur mère. Il est pos­sible que, dans cette fa­mille, on ait ap­pris très tôt à al­ler mieux vite, à ne pas s'at­tar­der sur la tris­tesse et à re­mer­cier ce­lui qui pro­pose une so­lu­tion. Nous avons vu au cha­pitre 2 que les po­si­tions s'ap­prennent ain­si, dans la fa­mille d'ori­gine. Claire n'a pas be­soin d'en par­ler à Tho­mas ce sa­me­di ma­tin. Mais le sa­voir peut l'ai­der à com­prendre pour­quoi cette règle lui a pa­ru si na­tu­relle pen­dant si long­temps."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Tho­mas, lui, ex­prime son propre be­soin : il veut ai­der, et il ne sait pas quoi faire quand il la voit triste. Claire l'en­tend, et elle le ras­sure sur ce qui compte pour lui : il reste utile, sim­ple­ment d'une autre fa­çon."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Vient alors la de­mande. Elle est pré­cise, et elle en­gage les deux. Tho­mas po­se­ra une ques­tion avant de pro­po­ser quoi que ce soit, et Claire l'ar­rê­te­ra avec dou­ceur s'il part trop vite vers une so­lu­tion. En­fin, Tho­mas peut dire ce qui se­ra dif­fi­cile pour lui, et Claire ac­cepte que l'ac­cord ne soit pas te­nu par­fai­te­ment dès le dé­but. C'est ce qui fait de cette de­mande une pro­po­si­tion plu­tôt qu'une exi­gence."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Cette conver­sa­tion n'est pas un mo­dèle à ré­ci­ter. Dans la réa­li­té, elle se­ra sans doute plus hé­si­tante, plus mal­adroite, peut-être in­ter­rom­pue. Mais elle montre ce qui la dis­tingue d'une dis­pute ou d'un re­proche : on y parle de la règle du couple, de ce que cha­cun res­sent et de ce dont cha­cun a be­soin, et on y construit en­semble une nou­velle règle, que les deux peuvent ac­cep­ter."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Une conver­sa­tion qui se ré­pète"/>
                <para PARENT="scene_page_subtitle" ALIGN="1"/>
                <tab/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Trois se­maines plus tard, la sœur de Claire rap­pelle. Quand Claire re­vient dans le sa­lon, Tho­mas la re­garde, hé­site, puis de­mande, un peu mal­adroi­te­ment :"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <tab/>
                <ITEXT CH="— Tu veux… un conseil, ou que je t'écoute ?"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Claire sou­rit, parce que la ques­tion sonne en­core un peu comme une phrase ap­prise."/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <tab/>
                <ITEXT CH="— Que tu m'écoutes."/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Elle ra­conte. Au bout de quelques mi­nutes, Tho­mas com­mence une phrase par « tu sais ce que tu pour­rais faire ». Claire pose la main sur son bras : « Là, j'ai­me­rais juste que tu m'écoutes. » Il s'ar­rête, un peu frus­tré, mais il s'ar­rête. Plus tard dans la soi­rée, c'est elle qui lui de­mande ce qu'il en pense. Il lui pro­pose une idée, et cette fois, elle a en­vie de l'en­tendre."/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Tout ne se pas­se­ra pas tou­jours ain­si. Cer­tains soirs, la fa­tigue l'em­por­te­ra, Tho­mas pro­po­se­ra un plan, et Claire le re­mer­cie­ra, comme avant. L'ho­méo­sta­sie dont par­lait Don Jack­son ne dis­pa­raît pas après une seule conver­sa­tion. La dif­fé­rence, c'est que la règle a main­te­nant été nom­mée. Quand ils re­tombent dans l'an­cienne fa­çon de faire, ils peuvent le re­mar­quer, et en par­ler sans re­proche : « On avait dit qu'on es­sayait au­tre­ment. » Une règle dont on a par­lé peut être re­prise. Une règle dont per­sonne n'a ja­mais par­lé ne peut même pas être vue."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Il fau­dra aus­si du temps à Tho­mas. Nous avons vu au cha­pitre 4 que les deux par­te­naires avancent ra­re­ment au même rythme. Claire a com­men­cé à chan­ger avant cette conver­sa­tion. Tho­mas, lui, dé­couvre la ques­tion en même temps qu'il es­saie d'y ré­pondre. Celle qui a bou­gé la pre­mière doit ac­cep­ter que l'autre ait be­soin de plus de temps, et que la nou­velle règle soit d'abord ap­pli­quée de fa­çon im­par­faite. Avec le temps, Tho­mas au­ra peut-être lui aus­si une de­mande à faire : par exemple, que Claire lui dise dès le dé­but si elle a be­soin d'écoute, pour qu'il n'ait pas à de­vi­ner. L'ac­cord évo­lue­ra en­core."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="C'est la prin­ci­pale le­çon de ce cha­pitre. Re­né­go­cier les ac­cords du couple n'est pas une conver­sa­tion qu'on a une fois pour toutes. C'est une conver­sa­tion qu'on re­prend chaque fois que l'un des deux change, ou que la vie au­tour d'eux change."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Chaque couple de ce livre au­rait be­soin d'une conver­sa­tion de ce type, mais pas de la même. Ce que Claire et Tho­mas ont à re­né­go­cier ne res­semble pas à ce que So­phie et Marc, Inès et Ju­lien, ou Léa et An­toine au­raient à se dire. Chaque cou­plage a ses propres fa­çons d'en sor­tir. C'est l'ob­jet du cha­pitre 8. Avant ce­la, le cha­pitre sui­vant s'ar­rête sur un do­maine où les règles du couple sont par­ti­cu­liè­re­ment dif­fi­ciles à nom­mer : le dé­sir et l'in­ti­mi­té."/>
                <trail PARENT="BODY" ALIGN="3"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="751.969503937008" YPOS="27398.2687165354" OwnPage="62" ItemID="264740320" PTYPE="4" WIDTH="497.166026688036" HEIGHT="763.388032123197" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" copath="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" gXpos="751.969503937008" gYpos="5351.02462204724" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="246430240" BACKITEM="246433072"/>
        <PAGEOBJECT XPOS="751.969503937008" YPOS="28280.158480315" OwnPage="64" ItemID="264754480" PTYPE="4" WIDTH="497.166026688036" HEIGHT="763.388032123197" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" copath="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" gXpos="751.969503937008" gYpos="5351.02462204724" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="246421744" BACKITEM="246430240"/>
        <PAGEOBJECT XPOS="751.969503937008" YPOS="29162.0482440945" OwnPage="66" ItemID="264757312" PTYPE="4" WIDTH="497.166026688036" HEIGHT="763.388032123197" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" copath="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" gXpos="751.969503937008" gYpos="5351.02462204724" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="246421744"/>
        <PAGEOBJECT XPOS="751.969503937008" YPOS="34453.3868267716" OwnPage="78" ItemID="264760144" PTYPE="4" WIDTH="497.166026688036" HEIGHT="763.388032123197" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" copath="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" gXpos="751.969503937008" gYpos="9760.47344094488" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
