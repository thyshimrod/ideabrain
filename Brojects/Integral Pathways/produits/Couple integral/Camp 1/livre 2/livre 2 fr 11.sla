        </PAGEOBJECT>
        <PAGEOBJECT XPOS="751.969503937008" YPOS="46799.8435196851" OwnPage="106" ItemID="344434560" PTYPE="4" WIDTH="497.166026688036" HEIGHT="763.388032123197" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" copath="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" gXpos="751.969503937008" gYpos="14169.9222598426" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <ITEXT CH="Chapitre 10 — Quand un seul des "/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <ITEXT CH="deux bouge"/>
                <trail PARENT="Titre" ALIGN="1"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="751.969503937008" YPOS="47681.7332834646" OwnPage="108" ItemID="344428896" PTYPE="4" WIDTH="497.166026688036" HEIGHT="763.388032123197" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" copath="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" gXpos="751.969503937008" gYpos="14169.9222598426" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="344417568" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <tab/>
                <ITEXT CH="Dans les cha­pitres pré­cé­dents, les quatre couples fi­nissent par se par­ler. L'un com­mence, l'autre écoute, et l'ac­cord qu'ils trouvent en­gage les deux. Il est pour­tant pro­bable que vous li­siez ce livre seul, et que la per­sonne avec qui vous vi­vez n'ait au­cune en­vie d'en par­ler, ou pas main­te­nant. Ce cha­pitre est consa­cré à cette si­tua­tion : ce qui se passe quand un seul des deux par­te­naires veut faire bou­ger la règle du couple, et ce qu'il peut faire de son cô­té."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Char­lotte et Da­vid : le livre sur la table de nuit"/>
                <para PARENT="scene_page_subtitle" ALIGN="1"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Char­lotte et Da­vid vivent en­semble de­puis douze ans. Leur fille, Jeanne, a neuf ans. Dans leur couple, c'est Char­lotte qui pro­pose. Un week-end à la mer, un concert, un cours de danse le jeu­di soir. Da­vid ré­pond qu'on ver­ra, que ce n'est pas le bon mo­ment, que c'est un peu cher en ce mo­ment. Il ne re­fuse presque ja­mais fran­che­ment. Il re­pousse, et la pro­po­si­tion fi­nit par être ou­bliée. C'est le cou­plage En­fant Libre / En­fant Adap­té du cha­pitre 3. De­puis un an ou deux, Char­lotte pro­pose moins. Elle s'est ins­crite seule à la danse."/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Au prin­temps, Char­lotte lit un livre sur le couple. Dans un cha­pitre, elle re­con­naît leur fonc­tion­ne­ment presque mot pour mot : l'un pro­pose, l'autre reste pru­dent, et cha­cun fi­nit par re­non­cer. Elle se sent sou­la­gée. Ce qu'elle vit a un nom, et d'autres couples le vivent aus­si. Un soir, elle pose le livre sur la table de nuit de Da­vid, avec un marque-page au cha­pitre en ques­tion."/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Trois se­maines plus tard, le livre est tou­jours là. Le marque-page n'a pas bou­gé."/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <tab/>
                <ITEXT CH="— Tu l'as com­men­cé ? de­mande Char­lotte un soir, en se cou­chant."/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <tab/>
                <ITEXT CH="— Pas eu le temps."/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <tab/>
                <ITEXT CH="— Tu pour­rais au moins lire le cha­pitre que j'ai mar­qué. Ce n'est pas long."/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Da­vid pose son té­lé­phone."/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <tab/>
                <ITEXT CH="— Pour­quoi ? Il y a un pro­blème ?"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <tab/>
                <ITEXT CH="— C'est exac­te­ment nous. Moi qui pro­pose, toi qui dis tou­jours « on ver­ra »."/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <tab/>
                <ITEXT CH="— Donc le pro­blème, c'est moi."/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <tab/>
                <ITEXT CH="— Je n'ai pas dit ça."/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <tab/>
                <ITEXT CH="— Tu m'as mis un livre sur ma table de nuit pour que je com­prenne ce qui ne va pas chez moi."/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <ITEXT CH="Char­lotte ne ré­pond pas. Da­vid éteint la lu­mière. Le len­de­main, le livre est ran­gé sur l'éta­gère du sa­lon."/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="scene_page_subtitle" ALIGN="1"/>
                <para PARENT="scene_page_subtitle" ALIGN="1"/>
                <para PARENT="scene_page_subtitle" ALIGN="1"/>
                <para PARENT="scene_page_subtitle" ALIGN="1"/>
                <para PARENT="scene_page_subtitle" ALIGN="1"/>
                <para PARENT="scene_page_subtitle" ALIGN="1"/>
                <ITEXT CH="Ce que le livre a dit à la place de Char­lotte"/>
                <para PARENT="scene_page_subtitle" ALIGN="1"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Re­li­sons cette scène. Char­lotte a dé­cou­vert quelque chose d'im­por­tant pour elle, et elle a vou­lu le par­ta­ger. Son in­ten­tion est sin­cère. Mais elle a confié au livre ce qu'elle n'osait pas dire elle-même. Le marque-page di­sait à Da­vid : « lis ce­ci, et tu com­pren­dras ce que tu dois chan­ger ». Char­lotte n'a pas par­lé de ce qu'elle res­sent quand ses pro­po­si­tions res­tent sans ré­ponse, ni de ce qui lui manque. Elle a trans­mis une de­mande sans le be­soin qui la porte, et Da­vid l'a re­çue comme un diag­nos­tic."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="On peut re­mar­quer autre chose. Le livre est de­ve­nu une pro­po­si­tion de plus. Char­lotte a pro­po­sé une lec­ture, Da­vid l'a re­pous­sée à plus tard, et Char­lotte a fi­ni par re­non­cer. Sans le vou­loir, ils ont re­joué leur règle avec l'ob­jet qui de­vait les ai­der à en sor­tir."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="J'ai évo­qué au cha­pitre 3 la ten­ta­tion, chez des couples que j'ai ac­com­pa­gnés, de se dire : « c'est exac­te­ment ce que fait mon conjoint, il fau­drait qu'il lise ça ». Cette ten­ta­tion se com­prend. Quand on trouve en­fin des mots pour ce que l'on vit, on a en­vie que l'autre les en­tende. Mais ces mots, c'est vous qui les avez cher­chés, au mo­ment où vous en aviez be­soin. L'autre n'a rien de­man­dé. Et un livre qui dé­crit les deux po­si­tions d'un cou­plage de­vient, entre les mains d'un seul, un ou­til pour ana­ly­ser ce­lui qui ne l'a pas lu."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="La ques­tion change alors de na­ture. Tant que Char­lotte se de­mande com­ment ame­ner Da­vid à lire, à com­prendre ou à chan­ger, elle at­tend de lui le pre­mier pas. Elle peut se po­ser une autre ques­tion, qui ne dé­pend que d'elle : quelle est ma part dans cette règle, et qu'est-ce que je peux y chan­ger dès main­te­nant ?"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ce qui reste pos­sible seul"/>
                <para PARENT="scene_page_subtitle" ALIGN="1"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Nous avons vu au cha­pitre 6 que chan­ger seul sa fa­çon de faire ne suf­fit pas. Claire avait de­man­dé à Tho­mas de l'écou­ter plu­tôt que de lui pro­po­ser une so­lu­tion, et une se­maine plus tard, cha­cun avait re­pris sa place. Per­sonne ne peut mo­di­fier seul un ac­cord qui s'est construit à deux. Il reste pour­tant un tra­vail que l'on peut faire seul, et qui pré­pare tout le reste : com­prendre sa propre part dans la règle du couple."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Char­lotte com­mence par une ques­tion simple. Que se passe-t-il pour moi, au mo­ment où je pro­pose ? En y re­pen­sant, elle re­marque que ses pro­po­si­tions ar­rivent tou­jours com­plètes. Elle a choi­si le concert, re­gar­dé les ho­raires, com­pa­ré les prix. Il ne reste à Da­vid qu'à dire oui ou non. Elle se rend compte qu'en pro­cé­dant ain­si, elle garde la main sur ce qu'ils font en­semble, et qu'elle ne lui a pas de­man­dé de­puis long­temps ce dont il au­rait en­vie, lui."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Elle se pose en­suite une deuxième ques­tion. Qu'est-ce que je res­sens quand Da­vid ré­pond « on ver­ra » ? La ré­ponse lui vient vite : elle se sent de trop, comme si ses en­vies étaient une charge pour lui. C'est cette sen­sa­tion qu'elle évite de­puis un an ou deux en pro­po­sant moins. Elle com­prend alors qu'elle par­ti­cipe, elle aus­si, au fonc­tion­ne­ment de leur couple. Ce fonc­tion­ne­ment, per­sonne ne l'a ja­mais énon­cé : Char­lotte pro­pose, Da­vid re­pousse, et la pro­po­si­tion fi­nit par être ou­bliée. Quand Char­lotte cesse de pro­po­ser sans rien dire, elle ne fait que fran­chir la der­nière étape de ce fonc­tion­ne­ment, celle où l'on re­nonce."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Char­lotte se de­mande en­suite ce qu'elle cherche à tra­vers ces sor­ties. Sa pre­mière ré­ponse est que Da­vid dise oui plus sou­vent. Mais cette ré­ponse dé­crit seule­ment ce qu'elle at­tend de lui. En re­gar­dant de plus près ce qu'elle pro­pose, elle re­marque autre chose. Les concerts, les week-ends à la mer dé­ci­dés le ven­dre­di soir, c'est ce qu'ils fai­saient quand ils se sont ren­con­trés. À cette époque, elle avait le sen­ti­ment qu'ils construi­saient quelque chose à deux, qu'ils par­ta­geaient des dé­cou­vertes et des sou­ve­nirs. Sans s'en rendre compte, elle es­saie de re­trou­ver le couple de leurs dé­buts."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Or douze ans ont pas­sé. Jeanne est née, Da­vid a pris un poste avec plus de res­pon­sa­bi­li­tés, et il dit sou­vent qu'il aime ses sa­me­dis à la mai­son. Char­lotte elle-même n'a plus tout à fait les mêmes en­vies. Ce qu'ils ai­maient vivre en­semble au dé­but ne cor­res­pond peut-être plus à ce qu'ils sont de­ve­nus. Et ils n'en ont ja­mais re­par­lé. Ils ne se sont ja­mais de­man­dé ce qu'ils vou­laient en­core vivre à deux, et ce que cha­cun pré­fé­rait vivre de son cô­té."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Der­rière ses pro­po­si­tions, il y a donc un be­soin qui ne dé­pend ni d'un concert ni d'une plage : se sen­tir re­liée à Da­vid par des mo­ments qu'ils ont choi­sis en­semble. Ce be­soin est tou­jours là, même si la forme que pre­naient ces mo­ments il y a douze ans ne convient sans doute plus."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Char­lotte re­marque aus­si qu'un week-end sans rien de pré­vu la met mal à l'aise. Quand le sa­me­di s'an­nonce vide, elle cherche presque aus­si­tôt une sor­tie à pro­po­ser. Une par­tie de ses pro­po­si­tions sert peut-être à rem­plir ce vide. Ce ma­laise lui ap­par­tient. Da­vid ne peut pas le ré­gler à sa place, et elle peut s'y in­té­res­ser de son cô­té."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Reste une der­nière ques­tion, la plus dif­fi­cile. Pour­quoi n'a-t-elle ja­mais de­man­dé di­rec­te­ment à Da­vid ce qu'ils veulent vivre en­semble au­jour­d'hui ? En y pen­sant, Char­lotte sent qu'elle a peur de la ré­ponse. Da­vid pour­rait lui dire qu'il est très bien comme ça. Elle pour­rait dé­cou­vrir qu'ils n'ont plus en­vie des mêmes choses. Par­ler de leur couple, c'est prendre le risque d'être re­je­tée, de re­mettre en ques­tion ce qui sem­blait ac­quis, et peut-être de de­voir chan­ger. Pro­po­ser un concert était beau­coup moins ris­qué. Si Da­vid re­fu­sait, il re­fu­sait un concert. C'est ce qui rend si dif­fi­cile la conver­sa­tion sur la troi­sième en­ti­té dont nous avons par­lé au cha­pitre 6 : elle touche à ce que cha­cun craint le plus de perdre."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Ce tra­vail l'amène aus­si à re­gar­der la po­si­tion de Da­vid au­tre­ment. Elle ne sait pas ce qui se passe pour lui quand il ré­pond « on ver­ra ». Elle peut seule­ment faire des hy­po­thèses. Peut-être qu'une pro­po­si­tion dé­jà toute pré­pa­rée ne lui laisse au­cune place, et que re­pous­ser est sa seule fa­çon d'avoir son mot à dire. Peut-être qu'il a peur, lui aus­si, de ce qu'une vraie conver­sa­tion pour­rait ré­vé­ler. Char­lotte garde ces hy­po­thèses pour elle. Elle ne s'en sert pas pour ex­pli­quer Da­vid à sa place, comme le fai­sait le livre po­sé sur la table de nuit. Elles lui rap­pellent seule­ment qu'elle ne connaît qu'une moi­tié de leur fonc­tion­ne­ment."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Au terme de ce tra­vail, rien n'a en­core chan­gé entre eux. Mais Char­lotte sait mieux ce qui lui manque, ce qui lui ap­par­tient, et ce qui lui fait peur. Elle sait aus­si que la ques­tion qu'elle veut po­ser à Da­vid concerne leur couple, et plus seule­ment leurs sor­ties."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ou­vrir la conver­sa­tion"/>
                <para PARENT="scene_page_subtitle" ALIGN="1"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Un sa­me­di après-mi­di, Jeanne est chez une amie, et rien n'est pré­vu. Char­lotte sent re­ve­nir le ma­laise ha­bi­tuel, et avec lui l'en­vie de cher­cher une sor­tie. Cette fois, elle va s'as­seoir à cô­té de Da­vid, qui lit dans le ca­na­pé."/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <tab/>
                <ITEXT CH="— Je peux te par­ler de quelque chose ? Ce n'est pas un re­proche."/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Da­vid pose son livre. Il a l'air mé­fiant."/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <tab/>
                <ITEXT CH="— Je re­pen­sais au livre que j'avais mis sur ta table de nuit. Je n'au­rais pas dû faire ça comme ça. Je crois que je vou­lais qu'il te dise à ma place quelque chose que je n'osais pas te dire."/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <tab/>
                <ITEXT CH="— Quoi ?"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <tab/>
                <ITEXT CH="— Que nous deux, ça me manque. Les mo­ments où on fai­sait des choses en­semble, juste pour le plai­sir."/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="— Tu veux dire qu'on s'en­nuie."/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <tab/>
                <ITEXT CH="— Je parle de moi. Je me rends compte que je te pro­pose tou­jours les mêmes choses qu'au dé­but, les concerts, la mer. Ce n'est peut-être plus ce dont tu as en­vie. Je ne te l'ai ja­mais de­man­dé."/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Da­vid reste si­len­cieux un mo­ment."/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <tab/>
                <ITEXT CH="— Je ne sais pas trop. J'aime bien nos sa­me­dis tran­quilles. Mes se­maines sont lourdes en ce mo­ment. Et quand tu ar­rives avec un concert dé­jà choi­si, j'ai l'im­pres­sion que si je dis non, je vais te dé­ce­voir. Alors je dis « on ver­ra »."/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Char­lotte sent un pin­ce­ment. Elle a en­vie de lui ex­pli­quer qu'elle ne se­rait pas dé­çue, qu'elle pro­pose seule­ment. Elle se re­tient."/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <tab/>
                <ITEXT CH="— Je ne sa­vais pas. Mer­ci de me le dire."/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <tab/>
                <ITEXT CH="— Et tu at­tends quoi de moi, là ?"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <tab/>
                <ITEXT CH="— Rien tout de suite. J'avais peur d'en par­ler. Peur que tu me dises que tout va bien comme ça, ou qu'on dé­couvre qu'on n'a plus en­vie des mêmes choses. J'ai­me­rais qu'on se de­mande, tous les deux, ce qu'on a en­core en­vie de vivre en­semble, et ce que cha­cun pré­fère vivre de son cô­té. Pas for­cé­ment au­jour­d'hui."/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Da­vid hoche la tête."/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <tab/>
                <ITEXT CH="— Je vais y ré­flé­chir."/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Il re­prend son livre. Char­lotte reste un mo­ment à cô­té de lui, puis va se faire un thé. Elle ne sait pas si cette conver­sa­tion a ser­vi à quelque chose."/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ce qui a chan­gé dans la fa­çon de par­ler"/>
                <para PARENT="scene_page_subtitle" ALIGN="1"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Com­pa­rons cette conver­sa­tion à celle du livre po­sé sur la table de nuit. Char­lotte parle main­te­nant d'elle et de ce qui lui manque. Elle re­con­naît sa part, puis­qu'elle pro­pose tou­jours les mêmes choses sans lui de­man­der ce qu'il vou­drait. Elle ex­plique pour­quoi elle n'a rien dit pen­dant si long­temps : elle avait peur de la ré­ponse. Et au lieu de pro­po­ser une sor­tie, elle pose une ques­tion qui concerne leur couple."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Da­vid com­mence par en­tendre un re­proche, « tu veux dire qu'on s'en­nuie ». Cette ré­ac­tion se com­prend. Quand on n'a pas par­lé du couple de­puis long­temps, je crois que la pre­mière phrase sur le su­jet sonne presque tou­jours comme une cri­tique. Char­lotte ne se dé­fend pas, et ne cherche pas à le convaincre. Elle ra­mène sim­ple­ment la conver­sa­tion à elle : « je parle de moi ». Da­vid peut alors dire quelque chose qu'il n'avait ja­mais dit. Son « on ver­ra » lui ser­vait à ne pas dé­ce­voir Char­lotte, et il a be­soin de calme après des se­maines char­gées. Char­lotte au­rait pu se jus­ti­fier. En le re­mer­ciant, elle lui montre que ce qu'il res­sent a sa place dans la conver­sa­tion."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Cette conver­sa­tion ne se ter­mine pas par un ac­cord. Da­vid n'est pas prêt, et il le dit à sa ma­nière : « je vais y ré­flé­chir ». C'est la si­tua­tion de ce cha­pitre. Un seul des deux a fait le che­min jus­qu'à la conver­sa­tion, et l'autre a be­soin de temps. Char­lotte n'a rien ob­te­nu de concret. Mais le su­jet existe main­te­nant entre eux : ils ont par­lé de leur couple, et pas seule­ment d'une sor­tie. Char­lotte doit aus­si sup­por­ter de ne pas sa­voir ce qui va suivre. Pour quel­qu'un qui rem­plit ses sa­me­dis pour évi­ter le vide, ce n'est pas le plus fa­cile."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="« Je vais y ré­flé­chir » peut res­sem­bler à « on ver­ra ». Ce sont les se­maines sui­vantes qui mon­tre­ront la dif­fé­rence."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Quand le couple ré­siste"/>
                <para PARENT="scene_page_subtitle" ALIGN="1"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Deux se­maines passent. Da­vid ne re­parle pas de la conver­sa­tion. Les jour­nées re­prennent leur cours, entre le tra­vail, Jeanne et les courses du sa­me­di. Char­lotte se sur­prend à guet­ter un signe, et rien ne vient."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Elle sent alors deux en­vies. La pre­mière est de lui de­man­der : « Alors, tu as ré­flé­chi ? » Elle voit vite où cette ques­tion mè­ne­rait. Ce qu'elle avait pré­sen­té comme une ques­tion ou­verte de­vien­drait une at­tente, et Da­vid se sen­ti­rait obli­gé de lui don­ner une ré­ponse. La se­conde en­vie est plus dis­crète. Un ven­dre­di soir, elle re­père un concert pour le len­de­main, et elle a dé­jà le mes­sage en tête : « J'ai pris deux places, ça te dit ? » Ou bien, à l'in­verse, elle pour­rait conclure que cette conver­sa­tion n'a ser­vi à rien, et ne plus rien pro­po­ser du tout."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Ces deux ré­ac­tions la ra­mè­ne­raient cha­cune à l'an­cien fonc­tion­ne­ment. Dans un cas, elle re­prend son rôle de celle qui pro­pose tout. Dans l'autre, elle re­prend ce­lui de celle qui re­nonce. C'est l'ho­méo­sta­sie dont par­lait Don Jack­son, et que nous avons vue au cha­pitre 6 avec Claire et Tho­mas : quand l'un des deux change, le couple tend à re­ve­nir vers ce qu'il connaît. Ici, c'est Char­lotte elle-même qui sent cette ten­ta­tion, parce que l'an­cien fonc­tion­ne­ment lui évi­tait l'at­tente et l'in­cer­ti­tude."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Char­lotte ne ré­serve pas les places. Ce sa­me­di-là, elle laisse l'après-mi­di sans pro­gramme, et le ma­laise du vide re­vient. Elle le re­marque, et va mar­cher seule une heure. Le soir, elle dit sim­ple­ment à Da­vid qu'elle a en­vie de sor­tir la se­maine sui­vante, et lui de­mande s'il a en­vie de quelque chose. Il ré­pond qu'il ne sait pas. Elle n'in­siste pas."/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Trois se­maines après la conver­sa­tion du ca­na­pé, un di­manche ma­tin, Da­vid pose son ca­fé."/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <tab/>
                <ITEXT CH="— J'ai re­pen­sé à ce que tu m'as dit. Je ne sais tou­jours pas trop ce que je veux. Mais il y a un truc qui me fe­rait plai­sir. Le di­manche ma­tin, avant que Jeanne se lève, on pour­rait al­ler prendre un ca­fé au mar­ché, tous les deux."/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Char­lotte sou­rit. Un ca­fé au mar­ché, c'est peu de chose. Mais c'est la pre­mière fois de­puis long­temps que Da­vid pro­pose quelque chose."/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ce qui a ren­du ce pas pos­sible"/>
                <para PARENT="scene_page_subtitle" ALIGN="1"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Il a fal­lu trois se­maines à Da­vid. Pen­dant des an­nées, per­sonne ne lui avait de­man­dé ce dont il avait en­vie, et il ne se l'était pas de­man­dé non plus. Trou­ver une ré­ponse prend du temps quand on a l'ha­bi­tude de dire « on ver­ra ». Si Char­lotte l'avait re­lan­cé, il au­rait sans doute cher­ché une ré­ponse pour lui faire plai­sir, et il au­rait de nou­veau ré­pon­du à une at­tente."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Ce pas a aus­si été pos­sible parce que Char­lotte a te­nu son propre chan­ge­ment sans en faire une exi­gence. Elle a ces­sé d'ar­ri­ver avec des sor­ties toutes prêtes. Elle a po­sé des ques­tions ou­vertes, et elle a ac­cep­té qu'elles res­tent un temps sans ré­ponse. Elle s'est oc­cu­pée elle-même de son ma­laise face au vide, au lieu de le confier à Da­vid. Rien de tout ce­la ne ga­ran­tis­sait que Da­vid fe­rait un pas. Mais ces chan­ge­ments lui ont lais­sé de la place."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Le ca­fé du di­manche ne règle pas tout. Char­lotte et Da­vid n'ont pas en­core par­lé en­semble de ce qu'ils veulent vivre à deux et de ce que cha­cun pré­fère vivre de son cô­té. Cette conver­sa­tion reste à avoir, et elle res­sem­ble­ra sans doute à celles des cha­pitres 6 et 8, où cha­cun parle de ses be­soins et où l'ac­cord en­gage les deux. La dif­fé­rence, c'est qu'ils sont main­te­nant deux à vou­loir l'avoir."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Il ar­rive aus­si que l'autre ne fasse pas de pas, ou pas avant long­temps. Dans ce cas, ce que Char­lotte a com­pris lui reste. Elle connaît mieux sa part dans leur fonc­tion­ne­ment, elle sait ce qui lui manque et ce qui lui ap­par­tient, et elle peut re­prendre la conver­sa­tion plus tard. Elle peut aus­si choi­sir de se faire ac­com­pa­gner, seule ou à deux, quand la conver­sa­tion semble im­pos­sible à ou­vrir sans aide."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ce que l'on peut faire seul"/>
                <para PARENT="scene_page_subtitle" ALIGN="1"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Si vous li­sez ce livre seul, l'his­toire de Char­lotte montre ce qui est à votre por­tée. Vous ne pou­vez pas chan­ger seul l'ac­cord de votre couple, puis­qu'il s'est construit à deux. Vous pou­vez en re­vanche com­prendre la part que vous y pre­nez, cher­cher le be­soin qui se trouve der­rière ce que vous at­ten­dez de l'autre, et re­gar­der en face ce qui vous fait peur dans la conver­sa­tion. Vous pou­vez en­suite par­ler de vous, avec vos propres mots, plu­tôt que de confier ce mes­sage à un livre. Et vous pou­vez te­nir ce chan­ge­ment dans la du­rée, sans le trans­for­mer en exi­gence, en lais­sant à l'autre le temps de trou­ver sa propre ré­ponse."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Rien de tout ce­la ne ga­ran­tit que l'autre fe­ra un pas. Mais c'est ce qui lui laisse la place de le faire."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Dans ce cha­pitre, Char­lotte a fait bou­ger une seule règle de son couple, en quelques se­maines. Il ar­rive aus­si que l'un des deux change plus pro­fon­dé­ment, sur plu­sieurs an­nées, dans sa fa­çon de voir sa vie et ce qu'il en at­tend. Le couple tout en­tier doit alors trou­ver une nou­velle place à cha­cun. C'est ce qui ar­rive à So­phie et Marc, dans le cha­pitre sui­vant."/>
                <trail PARENT="BODY" ALIGN="3"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="751.969503937008" YPOS="48563.6230472441" OwnPage="110" ItemID="344431728" PTYPE="4" WIDTH="497.166026688036" HEIGHT="763.388032123197" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" copath="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" gXpos="751.969503937008" gYpos="14169.9222598426" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="344414736" BACKITEM="344417568"/>
