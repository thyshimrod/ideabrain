            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="751.969503937008" YPOS="50327.4025748032" OwnPage="114" ItemID="254915024" PTYPE="4" WIDTH="497.166026688036" HEIGHT="763.388032123197" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" copath="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" gXpos="751.969503937008" gYpos="5351.02462204725" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <trail/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="751.969503937008" YPOS="51209.2923385828" OwnPage="116" ItemID="254906528" PTYPE="4" WIDTH="497.166026688036" HEIGHT="763.388032123197" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" copath="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" gXpos="751.969503937008" gYpos="5351.02462204725" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <trail/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="142.52068503937" YPOS="36217.1663543307" OwnPage="81" ItemID="254903696" PTYPE="4" WIDTH="497.166026688036" HEIGHT="763.388032123197" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" copath="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" gXpos="737.796275590551" gYpos="5351.02462204725" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="247203744"/>
        <PAGEOBJECT XPOS="142.52068503937" YPOS="37099.0561181103" OwnPage="83" ItemID="254929184" PTYPE="4" WIDTH="497.166026688036" HEIGHT="763.388032123197" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" copath="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" gXpos="737.796275590551" gYpos="5351.02462204725" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Quand chacun prend soin de l'autre, et que personne ne demande rien"/>
                <para PARENT="scene_page_subtitle"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="La règle du couple : chacun s'occupe de l'autre et devance ses besoins, mais personne ne demande rien pour lui-même."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="Ce que chaque position protège peut-être : ne pas peser sur l'autre, ne pas se sentir redevable, se sentir aimable parce qu'on est utile, et éviter qu'une demande soit refusée."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="Pour trouver ce qui est important pour vous"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="Quand ai-je demandé quelque chose pour moi, la dernière fois ?"/>
                <para PARENT="BODY"/>
                <ITEXT CH="Qu'est-ce que je m'interdis de demander, et pourquoi ?"/>
                <para PARENT="BODY"/>
                <ITEXT CH="Que ressens-je quand l'autre prend soin de moi sans que j'aie rien demandé ?"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="Pour commencer la conversation : « Je me rends compte que je ne te dis presque jamais ce dont j'ai besoin. Je crois que j'ai peur de peser. J'aimerais savoir si c'est pareil pour toi. »"/>
                <para PARENT="BODY"/>
                <para/>
                <para/>
                <para/>
                <para/>
                <ITEXT CH="Quand l'un propose et que l'autre reste prudent"/>
                <para PARENT="scene_page_subtitle"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="La règle du couple : l'un propose, l'autre hésite ou repousse à plus tard, et chacun finit par renoncer."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="Ce que chaque position protège peut-être : celui qui propose garde l'élan et la légèreté, mais évite peut-être de dire qu'il se sent rejeté. Celui qui hésite protège son rythme et sa sécurité, mais évite peut-être de dire ce dont il aurait réellement envie."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="Pour trouver ce qui est important pour vous"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="Si vous proposez : qu'est-ce que je ressens quand l'autre dit non ? Est-ce que je propose encore autant qu'avant ?"/>
                <para PARENT="BODY"/>
                <ITEXT CH="Si vous hésitez : qu'est-ce qui me retient au moment de dire oui ? De quoi aurais-je besoin pour en avoir envie ?"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="Pour commencer la conversation : « Je me rends compte qu'entre nous, les propositions tombent souvent à plat. Je ne crois pas que ce soit un manque d'envie, ni de ton côté ni du mien, et j'aimerais qu'on comprenne ce qui se passe. »"/>
                <trail PARENT="BODY"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="142.52068503937" YPOS="37980.9458818898" OwnPage="85" ItemID="254926352" PTYPE="4" WIDTH="497.166026688036" HEIGHT="763.388032123197" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" copath="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" gXpos="737.796275590551" gYpos="5351.02462204725" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <trail/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="142.52068503937" YPOS="38862.8356456693" OwnPage="87" ItemID="254923520" PTYPE="4" WIDTH="497.166026688036" HEIGHT="763.388032123197" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" copath="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" gXpos="737.796275590551" gYpos="5351.02462204725" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <trail/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="142.52068503937" YPOS="39744.7254094489" OwnPage="89" ItemID="254917856" PTYPE="4" WIDTH="497.166026688036" HEIGHT="763.388032123197" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" copath="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" gXpos="737.796275590551" gYpos="5351.02462204725" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="254878208" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Ce que Marc entend, ce que Sophie répond"/>
                <para PARENT="scene_page_subtitle"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="Sophie sent monter l'envie de se défendre. Elle ne le fait pas. Elle s'assoit à côté de lui."/>
                <para PARENT="narration"/>
                <para PARENT="narration"/>
                <ITEXT CH="— Qu'est-ce qui te fait dire ça ?"/>
                <para PARENT="narration"/>
                <para PARENT="narration"/>
                <ITEXT CH="— Je ne sais pas. Avant, tu avais besoin de moi pour plein de choses. Maintenant, tu as ta chorale, ta thérapie, tes amies. Tu décides des choses sans moi. Je suis content pour toi, vraiment. Mais je ne sais plus très bien à quoi je sers."/>
                <para PARENT="narration"/>
                <para PARENT="narration"/>
                <ITEXT CH="— Et ça te fait peur."/>
                <para PARENT="narration"/>
                <para PARENT="narration"/>
                <ITEXT CH="— Oui. Je me demande si un jour, tu ne vas pas te dire que tu serais mieux sans nous. Sans moi."/>
                <para PARENT="narration"/>
                <para PARENT="narration"/>
                <ITEXT CH="Sophie lui prend la main."/>
                <para PARENT="narration"/>
                <para PARENT="narration"/>
                <ITEXT CH="— Je ne veux pas partir, Marc. Je vous aime autant qu'avant. Peut-être même mieux, parce que je suis plus présente quand je suis là. Et ce matin, si j'ai pu aller chanter, c'est parce que toi, tu étais là. Tu as fait les crêpes, tu as retrouvé la chaussure de Lina, tu as emmené Théo au foot. Sans toi, je ne pourrais pas faire tout ça. Tu m'es utile. Autrement qu'avant, mais tu m'es utile."/>
                <para PARENT="narration"/>
                <para PARENT="narration"/>
                <ITEXT CH="— Je ne l'avais pas vu comme ça."/>
                <para PARENT="narration"/>
                <para PARENT="narration"/>
                <ITEXT CH="— Je ne te l'avais jamais dit."/>
                <para PARENT="narration"/>
                <para PARENT="narration"/>
                <ITEXT CH="Marc se tait un moment."/>
                <para PARENT="narration"/>
                <para PARENT="narration"/>
                <ITEXT CH="— Qu'est-ce qui a changé, pour toi ?"/>
                <para PARENT="narration"/>
                <para PARENT="narration"/>
                <ITEXT CH="— Je crois que pendant des années, j'organisais tout parce que j'avais peur. Peur de ne pas être une assez bonne mère, peur que tout s'écroule si je lâchais quelque chose. Je ne m'en rendais pas compte. Aujourd'hui, j'essaie de faire les choses parce que je les choisis. Je n'y arrive pas toujours. Parfois je reprends tout en main, parfois je m'éloigne trop. Je cherche encore l'équilibre."/>
                <para PARENT="narration"/>
                <para PARENT="narration"/>
                <ITEXT CH="— Et moi, dans tout ça ?"/>
                <para PARENT="narration"/>
                <para PARENT="narration"/>
                <ITEXT CH="— Je crois que ce n'est pas toi qui dois changer, et que ce n'est pas moi qui dois revenir en arrière. C'est notre façon de vivre ensemble qui ne nous va plus. On l'a construite à une époque où j'avais besoin de tout contrôler, et où toi, tu suivais. Je ne suis plus tout à fait la même. Il faut qu'on la revoie, tous les deux."/>
                <para PARENT="narration"/>
                <para PARENT="narration"/>
                <ITEXT CH="— Par où on commence ?"/>
                <para PARENT="narration"/>
                <para PARENT="narration"/>
                <ITEXT CH="— Peut-être par ce que toi, tu as envie de garder. Et par ce qui te ferait sentir que tu as ta place."/>
                <para PARENT="narration"/>
                <para PARENT="narration"/>
                <ITEXT CH="Marc réfléchit."/>
                <para PARENT="narration"/>
                <para PARENT="narration"/>
                <ITEXT CH="— J'aimerais qu'on ait encore des moments à nous. Pas seulement que tu partes et que je garde la maison."/>
                <para PARENT="narration"/>
                <para PARENT="narration"/>
                <ITEXT CH="— Tu as raison. Ça me manque aussi."/>
                <para PARENT="narration"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Relisons d'abord la phrase de Marc : « J'ai l'impression que tu n'as plus besoin de nous. » Elle est dure, et elle parle de l'autonomie nouvelle de Sophie. Derrière cette phrase, il y a une peur précise : ne plus avoir sa place. Pour beaucoup de gens, et souvent pour les hommes, se sentir utile est une façon de vérifier que le lien existe. Tant que Sophie avait besoin de lui pour exécuter le programme du dimanche, Marc pouvait constater, chaque semaine, qu'il comptait. Si elle n'a plus besoin de lui, la question suivante vient vite : veut-elle partir ? Dans l'ancienne règle de leur couple, la dépendance servait de lien de sécurité. L'autonomie de Sophie retire cette preuve, sans rien mettre à la place."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Sophie commence par écouter. Elle aurait pu se défendre, expliquer qu'elle a le droit de chanter le samedi. Elle demande plutôt ce qui fait dire cela à Marc, et elle nomme sa peur à sa place : « Et ça te fait peur. » Puis elle le rassure, avec des faits plutôt qu'avec de grandes déclarations. Elle ne veut pas partir. Elle les aime autant. Et elle lui montre que son rôle n'a pas disparu, qu'il a changé de forme : c'est parce que Marc s'occupe de tout en son absence qu'elle peut faire ces choses. Il reste utile, autrement."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Quand Marc lui demande ce qui a changé, Sophie revient sur ce qui la poussait à tout contrôler : la peur de ne pas être une assez bonne mère, la peur que tout s'écroule. Elle reconnaît aussi qu'elle n'a pas trouvé la réponse, et qu'elle cherche encore l'équilibre. Ce détail compte. Celui qui change peut facilement donner l'impression d'avoir tout compris, et l'autre se sent alors en retard, voire jugé. En disant qu'elle cherche encore, Sophie laisse à Marc une place à côté d'elle."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Enfin, le fait que Marc vienne vers elle, même avec une phrase dure, ouvre le moment de parler de ce qui doit changer. Sophie déplace la question. Ce n'est pas à Marc de devenir quelqu'un d'autre, ni à elle de redevenir celle qu'elle était. C'est leur façon de vivre ensemble qui doit évoluer. Nous retrouvons ici la troisième entité du chapitre 6. Les deux partenaires ont changé, ou sont en train de changer, mais les règles du couple sont restées celles d'avant. Et Marc fait son propre pas : il dit ce qu'il a envie de garder, des moments à eux deux."/>
                <trail PARENT="BODY"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="142.52068503937" YPOS="40626.6151732284" OwnPage="91" ItemID="254932016" PTYPE="4" WIDTH="497.166026688036" HEIGHT="763.388032123197" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" copath="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" gXpos="737.796275590551" gYpos="5351.02462204725" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Un accord construit pour une autre époque"/>
                <para PARENT="scene_page_subtitle"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Les règles d'un couple se forment dans un contexte précis. Celles de Sophie et Marc se sont installées quand les enfants étaient petits, que les journées étaient pleines, et que Sophie avait besoin de sentir que tout était sous contrôle. Dans ce contexte, leur accord avait du sens. Il leur a permis de tenir, et il leur a même apporté beaucoup de bonheur : des dimanches réussis, une famille qui fonctionnait, des enfants bien entourés."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Mais un contexte ne dure pas. Quand l'un des deux change, la troisième entité est mise sous tension, simplement parce que ses règles ont été construites par d'autres personnes, dans d'autres circonstances. Ces règles n'étaient pas mauvaises. Elles sont devenues dépassées."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Cette tension est d'autant plus difficile que l'un des deux peut rester attaché à l'ancien fonctionnement. Marc garde en mémoire une époque où tout marchait, où il savait quelle était sa place, et où il était heureux. Je crois que ce qu'il ressent ressemble à de la nostalgie : le regret d'un bonheur qui a réellement existé. Ce regret est légitime, et il mérite d'être entendu. Mais ce bonheur ne pouvait pas durer éternellement sous la même forme, parce que chacun évolue, que le couple le veuille ou non."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Les enfants en donnent l'exemple le plus visible. Un couple ne vit pas de la même façon avec un nouveau-né, avec des enfants qui vont à l'école, et avec des adolescents qui commencent à prendre leur indépendance. Les nuits courtes laissent place aux devoirs, aux activités, aux trajets. Puis viennent l'émancipation et le départ. À chaque étape, l'organisation de la famille change, parce qu'elle n'a pas le choix. Personne ne songerait à vivre avec un adolescent comme on vivait avec un bébé. Les règles du couple, en revanche, restent souvent celles de la première période, parce que personne n'a pensé à les revoir."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <tab/>
                <ITEXT CH="Le changement de Sophie rend visible une réalité qui existait déjà : leur accord appartenait à une autre époque de leur vie. Le revoir ne veut pas dire renier ce qu'ils ont vécu. Cela veut dire reconnaître que ce qui leur convenait hier ne leur convient plus forcément aujourd'hui, et chercher ensemble ce qui leur conviendrait maintenant. Marc n'a pas à renoncer à ce qu'il a aimé dans leur ancienne vie. Il peut dire ce qu'il en regrette, et chercher avec Sophie ce qui, de ce bonheur, peut continuer sous une autre forme."/>
                <trail PARENT="BODY"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="142.52068503937" YPOS="41508.5049370079" OwnPage="93" ItemID="254920688" PTYPE="4" WIDTH="497.166026688036" HEIGHT="763.388032123197" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" copath="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" gXpos="737.796275590551" gYpos="5351.02462204725" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="254881040"/>
