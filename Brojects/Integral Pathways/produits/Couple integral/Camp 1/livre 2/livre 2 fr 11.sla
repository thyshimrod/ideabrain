        <FRAMEOBJECT InID="27292" XPOS="0.141732283464567" YPOS="0.141732283464567" OwnPage="-1" ItemID="305501728" PTYPE="5" WIDTH="295.263379417221" HEIGHT="1" FRTYPE="0" CLIPEDIT="0" ROT="359.914137254786" PWIDTH="0.283464566929134" PCOLOR="bordeaux" SHADE="0" PCOLOR2="bordeaux" PLINEART="1" path="" isInline="1" gXpos="0.000212398164279648" gYpos="0.58421000042182" gWidth="295.263472667556" gHeight="0.725942124737742" LAYER="0"/>
