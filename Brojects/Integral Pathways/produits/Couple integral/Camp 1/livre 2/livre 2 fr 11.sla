        </PAGEOBJECT>
        <PAGEOBJECT XPOS="142.52068503937" YPOS="3587.24509448819" OwnPage="7" ItemID="225965600" PTYPE="4" WIDTH="497.166026688036" HEIGHT="763.388032123197" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" copath="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" gXpos="737.796275590551" gYpos="2705.35533070866" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="193808704"/>
        <PAGEOBJECT XPOS="142.52068503937" YPOS="4469.13485826772" OwnPage="9" ItemID="225968416" PTYPE="4" WIDTH="497.166026688036" HEIGHT="763.388032123197" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" copath="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" gXpos="737.796275590551" gYpos="2705.35533070866" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <trail/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="751.969503937008" YPOS="5351.02462204724" OwnPage="12" ItemID="206790672" PTYPE="4" WIDTH="497.166026688036" HEIGHT="763.388032123197" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" copath="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" gXpos="1347.24509448819" gYpos="2705.35533070866" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="335182048" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Scène 2 — Ce qu'il fal­lait dire"/>
                <para PARENT="scene_page_subtitle" ALIGN="1"/>
                <para ALIGN="3"/>
                <tab/>
                <para PARENT="narration" ALIGN="3"/>
                <ITEXT CH="Claire rac­croche le té­lé­phone. Sa sœur en­core, et cette his­toire avec leur mère qui s'éter­nise, qui re­vient, qui ne se ré­sout ja­mais vrai­ment. Elle a la gorge ser­rée."/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Tho­mas la voit de­puis le ca­na­pé. « Ça va ? » Claire ra­conte, en quelques phrases ha­chées."/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Tho­mas se re­dresse. « Tu de­vrais dire clai­re­ment à ta sœur que tu ne veux plus être au mi­lieu. C'est votre mère qui crée le pro­blème en vous met­tant en com­pé­ti­tion. La pro­chaine fois que ta sœur t'ap­pelle pour ça, pose une li­mite, di­rect. » Il en­chaîne, pro­pose une for­mu­la­tion, presque fier d'avoir vu juste si ra­pi­de­ment."/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <tab/>
                <ITEXT CH="« Ouais, t'as rai­son », dit Claire. Elle sou­rit même, un peu. « Mer­ci, c'est clair, dit comme ça. » Elle se lève, va se ser­vir un verre d'eau."/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Tho­mas se sent utile. Il a ai­dé, vite et bien. Claire al­lume la té­lé. La soi­rée conti­nue, nor­male, agréable même. Per­sonne n'est contra­rié."/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Plus tard, en ran­geant la cui­sine, Claire re­pense à l'ap­pel. Elle a main­te­nant un plan pour sa sœur. Elle ne sait pas pour­quoi elle se sent quand même un peu lasse."/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Tho­mas a eu rai­son. Claire l'a même re­mer­cié. Alors pour­quoi cette las­si­tude, qui n'a pas de quoi s'ac­cro­cher ?"/>
                <para PARENT="narration blue" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <ITEXT CH="Dé­cryp­tage"/>
                <para PARENT="scene_page_subtitle" ALIGN="1"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <tab/>
                <ITEXT CH="À pre­mière vue, cette soi­rée se passe bien. Tho­mas a écou­té Claire, il a ré­agi vite et il lui a pro­po­sé une so­lu­tion concrète. Claire l'a re­mer­cié. Il n'y a eu ni dis­pute ni re­proche. Si on de­vait no­ter cet échange, il se­rait plu­tôt bon, et c'est pour ce­la qu'il est dif­fi­cile d'y voir un pro­blème."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Com­pa­rons avec un couple qui se dis­pute dans la même si­tua­tion. L'un pro­pose des so­lu­tions, l'autre les re­jette parce qu'il ne se sent pas écou­té, et le ton monte. C'est désa­gréable, mais au moins le pro­blème est vi­sible : quel­qu'un ex­prime qu'il n'a pas re­çu ce qu'il at­ten­dait. Chez Tho­mas et Claire, per­sonne n'ex­prime rien de tel, donc per­sonne ne peut s'en aper­ce­voir."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Tho­mas a fait ce qu'il sait bien faire : il a cher­ché à ré­gler le pro­blème. C'est une vraie qua­li­té, et dans beau­coup de si­tua­tions c'est exac­te­ment ce qu'il faut. Mais quand quel­qu'un vient de rac­cro­cher la gorge ser­rée, son pre­mier be­soin n'est pas for­cé­ment une so­lu­tion. C'est sou­vent d'abord d'être écou­té et com­pris dans ce qu'il res­sent. La so­lu­tion peut ve­nir en­suite."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Claire, de son cô­té, a ac­cep­té la so­lu­tion de Tho­mas. Ce n'était peut-être pas ce dont elle avait be­soin, mais elle ne s'en est pas ren­du compte sur le mo­ment. Pour re­fu­ser, il au­rait fal­lu qu'elle sache ce qu'elle vou­lait à la place. Ce n'est pas fa­cile quand on a en­core la gorge ser­rée. Et c'est en­core plus dif­fi­cile face à quel­qu'un qui vient de vou­loir nous ai­der : dire « ce n'est pas ça que j'at­ten­dais » pour­rait le bles­ser. Alors elle a dit mer­ci, et la soi­rée a conti­nué."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="C'est ce qui ex­plique la las­si­tude de Claire en fin de soi­rée. Elle ne peut rien re­pro­cher à Tho­mas, puis­qu'il a été gen­til et ef­fi­cace. Pour­tant, ce qu'elle avait be­soin de par­ta­ger est res­té sans ré­ponse. Le su­jet a été trai­té comme un pro­blème à ré­soudre, et ce qu'elle res­sen­tait est pas­sé à cô­té."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para ALIGN="3"/>
                <tab/>
                <ITEXT CH="Dans cette scène, cha­cun fait un geste bien­veillant : Tho­mas aide, Claire ac­cueille l'aide avec gra­ti­tude. C'est jus­te­ment parce que les deux com­por­te­ments ont l'air bien­veillants que ni l'un ni l'autre ne voit la dis­tance qui s'ins­talle entre eux."/>
                <trail PARENT="BODY" ALIGN="3"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="751.969503937008" YPOS="7114.8041496063" OwnPage="16" ItemID="90344544" PTYPE="4" WIDTH="497.166026688036" HEIGHT="763.388032123197" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" copath="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" gXpos="1347.24509448819" gYpos="3587.24509448819" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="335179216" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Scène 4 — La dé­ci­sion rai­son­nable"/>
                <para PARENT="scene_page_subtitle" ALIGN="1"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Ils sont ins­tal­lés dans le ca­na­pé, un di­manche après-mi­di, le ca­fé en­core chaud. Léa a pro­po­sé qu'ils fassent le point. Pas sur un su­jet pré­cis, juste « faire le point », comme ils le font une fois par mois de­puis qu'ils ont lu en­semble un ar­ticle sur la com­mu­ni­ca­tion de couple."/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <ITEXT CH="— On n'a qua­si­ment pas de mo­ments à nous en ce mo­ment, dit Léa. Entre le bou­lot, les en­fants, ta mère qui va pas bien..."/>
                <para PARENT="narration" ALIGN="3"/>
                <ITEXT CH="— Je sais. C'est chaud en ce mo­ment."/>
                <para PARENT="narration" ALIGN="3"/>
                <ITEXT CH="— On de­vrait peut-être... je sais pas, se dire qu'on met ça de cô­té un mo­ment. Le temps que ça se tasse. Pas la peine de se mettre la pres­sion."/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <tab/>
                <ITEXT CH="An­toine ré­flé­chit deux se­condes, hoche la tête."/>
                <para PARENT="narration" ALIGN="3"/>
                <ITEXT CH="— Ouais. Fran­che­ment, c'est rai­son­nable. On est tous les deux cre­vés, ça sert à rien de for­cer un truc qui doit pas être for­cé."/>
                <para PARENT="narration" ALIGN="3"/>
                <ITEXT CH="— Voi­là. Et de toute fa­çon, dès que ta mère va mieux, dès que le tri­mestre de Lu­cas se calme, on pour­ra re­prendre un rythme."/>
                <para PARENT="narration" ALIGN="3"/>
                <ITEXT CH="— Exac­te­ment. On se dit ça alors. On lâche la pres­sion sur ce plan-là pour l'ins­tant."/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Léa sou­rit, sou­la­gée. An­toine at­trape la té­lé­com­mande, pro­pose de re­gar­der la suite de leur sé­rie. Ils passent une soi­rée agréable, tran­quille, comme d'ha­bi­tude. Le su­jet ne re­vient pas."/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Trois se­maines plus tard, un soir, en se bros­sant les dents, Léa réa­lise qu'elle ne sau­rait pas dire de­puis quand ils n'ont pas eu un mo­ment rien qu'à eux. Elle ne res­sent rien de pré­cis en y pen­sant, ni manque criant, ni frus­tra­tion. Juste une sorte de si­lence, dans un en­droit qu'elle ne re­garde plus vrai­ment."/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Ils avaient pris une dé­ci­sion rai­son­nable, d'un com­mun ac­cord, sans une once de conflit. Alors pour­quoi ce si­lence a-t-il un poids ?"/>
                <para PARENT="narration blue" ALIGN="1"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Dé­cryp­tage"/>
                <para PARENT="scene_page_subtitle" ALIGN="1"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <tab/>
                <ITEXT CH="À pre­mière vue, Léa et An­toine font exac­te­ment ce qu'on re­com­mande aux couples. Ils se parlent ré­gu­liè­re­ment, ils posent un constat com­mun, ils prennent une dé­ci­sion en­semble, sans pres­sion et sans ran­cœur. C'est le genre d'échange qu'on don­ne­rait en exemple dans un ate­lier de com­mu­ni­ca­tion. Le tri­angle de Karp­man n'y trou­ve­rait au­cun rôle à re­pé­rer : per­sonne n'ac­cuse, per­sonne ne se plaint, per­sonne ne sauve l'autre."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Re­gar­dons pour­tant ce que cette conver­sa­tion a réel­le­ment pro­duit. Of­fi­ciel­le­ment, ils ont mis un su­jet de cô­té « le temps que ça se tasse ». Dans les faits, ils ont ar­rê­té leurs mo­ments à deux sans fixer de mo­ment pour les re­prendre. Sur­tout, ni l'un ni l'autre n'a dit ce que ce­la re­pré­sen­tait pour lui. Per­sonne n'a dit « ça me manque », « je me sens seule » ou « j'ai peur qu'on s'éloigne ». Ils ont par­lé de fa­tigue, de plan­ning et de prio­ri­tés, c'est-à-dire avec des mots de ges­tion. Les mots du dé­sir et du manque sont res­tés ab­sents."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="C'est là que se trouve la dif­fi­cul­té. Dans cette dis­cus­sion, seule la par­tie de cha­cun qui ana­lyse et or­ga­nise a pris la pa­role. Cette par­tie est très utile : elle per­met de re­gar­der la si­tua­tion en face et de prendre des dé­ci­sions adap­tées. Mais quand elle dé­cide seule, sans lais­ser de place à ce que cha­cun res­sent ou à ce qu'il craint, ses dé­ci­sions sont rai­son­nables plu­tôt qu'équi­li­brées. Et une dé­ci­sion rai­son­nable est très dif­fi­cile à contes­ter. Qui irait s'op­po­ser à une dé­ci­sion sage et me­su­rée ?"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="C'est pour ce­la que cette scène est en­core plus dif­fi­cile à re­pé­rer que les pré­cé­dentes. Un couple qui se dis­pute sait au moins qu'il a un pro­blème. Léa et An­toine, eux, ont l'im­pres­sion d'en avoir ré­glé un, alors qu'ils l'ont seule­ment mis de cô­té."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Le si­lence que Léa res­sent trois se­maines plus tard ne vient donc pas d'un manque de com­mu­ni­ca­tion. Ils ont beau­coup par­lé, et jus­te­ment de ce su­jet. Il vient de ce que la conver­sa­tion n'a pas abor­dé : ce que cha­cun res­sen­tait vrai­ment face à cette dis­tance."/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Pour cer­tains couples, ce type de dé­ci­sion reste ponc­tuel. On le re­prend dès que la charge re­tombe, et il n'y a rien de plus à en dire. Mais si le « on en re­par­le­ra quand ça ira mieux » re­vient chez vous plus sou­vent qu'il ne se réa­lise, il vaut la peine de vous de­man­der ce que vos dé­ci­sions rai­son­nables vous évitent de dire."/>
                <trail PARENT="BODY" ALIGN="3"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="142.52068503937" YPOS="8878.58367716536" OwnPage="19" ItemID="90338880" PTYPE="4" WIDTH="497.166026688036" HEIGHT="763.388032123197" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" copath="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" gXpos="737.796275590551" gYpos="4469.13485826772" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <trail/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="142.52068503937" YPOS="9760.47344094488" OwnPage="21" ItemID="90333216" PTYPE="4" WIDTH="497.166026688036" HEIGHT="763.388032123197" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" copath="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" gXpos="737.796275590551" gYpos="4469.13485826772" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="194167584" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Les cinq voix in­té­rieures"/>
                <para PARENT="scene_page_subtitle" ALIGN="1"/>
                <para PARENT="scene_page_subtitle" ALIGN="1"/>
                <ITEXT CH="D'où vient cette carte"/>
                <para PARENT="scene_page_subtitle" ALIGN="1"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Le vo­ca­bu­laire que j'uti­lise dans ce cha­pitre n'a pas été in­ven­té pour ce livre. Il vient d'Eric Berne, un psy­chiatre amé­ri­cain for­mé à la psy­cha­na­lyse dans les an­nées 1940. Berne s'en est éloi­gné parce qu'il la trou­vait trop abs­traite pour être utile en séance : on y par­lait du ça, du moi et du sur­moi, des no­tions qu'un pa­tient ne pou­vait ni ob­ser­ver ni nom­mer lui-même."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Berne était par­ti d'une ob­ser­va­tion beau­coup plus concrète. En écou­tant ses pa­tients, il voyait une même per­sonne chan­ger de voix, de pos­ture et de vo­ca­bu­laire au cours d'une même séance. Un homme de trente-cinq ans pou­vait, le temps d'une phrase, par­ler avec l'in­to­na­tion et les mots d'un en­fant de sept ans. À la phrase sui­vante, il pre­nait un ton sé­vère, presque em­prun­té à l'un de ses pa­rents. Plu­tôt que d'y voir un symp­tôme à in­ter­pré­ter, Berne a pris cette ob­ser­va­tion au sé­rieux. Son hy­po­thèse est simple : nous avons en nous plu­sieurs états du moi, cha­cun avec ses pen­sées, ses émo­tions et ses com­por­te­ments, et nous pas­sons de l'un à l'autre se­lon les si­tua­tions, le plus sou­vent sans nous en rendre compte."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="C'est de cette in­tui­tion qu'est née l'ana­lyse tran­sac­tion­nelle, à la fin des an­nées 1950. Berne a d'abord dé­crit trois états : le Pa­rent, l'Adulte et l'En­fant. C'est ce mo­dèle que j'uti­li­sais dans Hors Jeu, avec le tri­angle dra­ma­tique de Ste­phen Karp­man, un autre élève de Berne. Pour ce livre, j'ai be­soin d'une carte plus fine. En ana­lyse tran­sac­tion­nelle, on dis­tingue en ef­fet deux fa­çons d'être Pa­rent (nor­ma­tif ou nour­ri­cier) et deux fa­çons d'être En­fant (adap­té ou libre). Ce­la donne cinq états. Dans les an­nées 1970, John Du­say, lui aus­si proche de Berne, a pro­po­sé une ma­nière simple de les re­pré­sen­ter : l'égo­gramme, un gra­phique qui montre com­bien d'éner­gie une per­sonne met dans cha­cun de ces cinq états. C'est cet ou­til que j'uti­lise ici. Il per­met de dis­tin­guer des com­por­te­ments que le mo­dèle à trois états met­tait dans le même sac. So­phie qui or­ga­nise et Tho­mas qui aide Claire re­lè­ve­raient tous deux du Pa­rent. Ce sont pour­tant deux mou­ve­ments très dif­fé­rents, et l'égo­gramme per­met de le voir."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Au­cune voix n'est meilleure qu'une autre"/>
                <para PARENT="scene_page_subtitle" ALIGN="1"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Il n'y a pas de hié­rar­chie entre ces cinq états. Au­cun n'est plus mûr, plus sain ou plus sou­hai­table que les autres. Cha­cun ré­pond à une fonc­tion utile, par­fois in­dis­pen­sable. Un couple qui fonc­tionne bien n'a pas gar­dé une seule bonne voix en éli­mi­nant les quatre autres. C'est un couple où les cinq peuvent cir­cu­ler se­lon ce que la si­tua­tion de­mande, sans que l'un ou l'autre reste fi­gé dans une seule."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Ces po­si­tions ne sont pas in­nées non plus. On les ap­prend très tôt, en ob­ser­vant ce qui fonc­tion­nait dans sa fa­mille : ce qui at­ti­rait l'at­ten­tion, ce qui évi­tait les conflits, ce qui per­met­tait de se sen­tir en sé­cu­ri­té ou ai­mé. Un en­fant qui a gran­di dans une mai­son où l'ordre était la condi­tion de la paix dé­ve­lop­pe­ra sou­vent un Pa­rent Nor­ma­tif so­lide à l'âge adulte. Un en­fant qui a com­pris très jeune que s'ajus­ter aux at­tentes des autres lui évi­tait des conflits ou lui ga­ran­tis­sait de l'af­fec­tion dé­ve­lop­pe­ra sou­vent un En­fant Adap­té très dis­po­nible. Ce ne sont pas des dé­fauts de ca­rac­tère. Ce sont des stra­té­gies ap­prises, qui ont été utiles à un mo­ment de notre his­toire et qui conti­nuent de ser­vir, par­fois bien au-de­là du contexte où elles étaient né­ces­saires."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Une ques­tion de contexte, pas une iden­ti­té"/>
                <para PARENT="scene_page_subtitle" ALIGN="1"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Il faut aus­si évi­ter de s'en­fer­mer dans une case en se di­sant « "/>
                <ITEXT FONT="EB Garamond Italic" CH="je suis un Pa­rent Nor­ma­tif "/>
                <ITEXT CH="» ou « "/>
                <ITEXT FONT="EB Garamond Italic" CH="je suis un En­fant Adap­té"/>
                <ITEXT CH=" ». Cha­cun a sans doute une ou deux po­si­tions pré­fé­rées, vers les­quelles il glisse le plus fa­ci­le­ment. Mais ces po­si­tions changent se­lon le contexte, par­fois de fa­çon très nette. Une per­sonne peut se mon­trer très do­cile face à son su­pé­rieur, in­ca­pable de contes­ter une consigne qui la dé­range, puis s'op­po­ser le soir même à presque toutes les pro­po­si­tions de son par­te­naire. Ce sont deux ex­pres­sions du même état, l'En­fant Adap­té, qui peut se sou­mettre ou se re­bel­ler se­lon l'in­ter­lo­cu­teur. Pour com­prendre sa po­si­tion dans le couple, il faut donc re­gar­der ce qui se passe dans le couple, sans sup­po­ser que ce qui est vrai ailleurs l'est aus­si à la mai­son."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Une ques­tion d'éner­gie"/>
                <para PARENT="scene_page_subtitle" ALIGN="1"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Du­say a aus­si for­mu­lé ce qu'il ap­pelle l'hy­po­thèse de constance. Cha­cun de nous dis­po­se­rait d'une quan­ti­té d'éner­gie psy­chique à peu près stable, qui se ré­par­tit entre les cinq états. Si l'un d'eux en prend une grande part, il en reste moins pour les autres. Concrè­te­ment, une per­sonne qui met beau­coup d'éner­gie dans son Pa­rent Nor­ma­tif, c'est-à-dire dans l'or­ga­ni­sa­tion, le contrôle et la bonne te­nue des choses, en a moins pour son En­fant Libre : l'élan, le jeu, l'im­pré­vu. Ce n'est pas qu'elle re­fuse ces choses par prin­cipe. C'est qu'elle n'a plus, sur le mo­ment, la res­source in­té­rieure pour les vivre."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Cette idée est plu­tôt en­cou­ra­geante. Si la ré­par­ti­tion de l'éner­gie n'est pas fi­gée, elle peut évo­luer. Quand on choi­sit, pe­tit à pe­tit, de mettre un peu plus d'éner­gie dans son En­fant Libre, l'éner­gie consa­crée jusque-là au Pa­rent Nor­ma­tif ou à l'En­fant Adap­té di­mi­nue d'au­tant, et le com­por­te­ment s'as­sou­plit de fa­çon ob­ser­vable. Il n'est pas né­ces­saire de re­non­cer à ces po­si­tions ni de les com­battre. C'est ce dé­pla­ce­ment pro­gres­sif, plu­tôt qu'une rup­ture bru­tale, qui gui­de­ra les pro­po­si­tions de la fin de ce livre."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Les tran­sac­tions : ce qui cir­cule entre deux per­sonnes"/>
                <para PARENT="scene_page_subtitle" ALIGN="1"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Berne ap­pelle tran­sac­tion l'uni­té de base d'un échange : un mes­sage en­voyé de­puis un état du moi, et une ré­ponse don­née de­puis un état du moi chez l'autre. Une tran­sac­tion ne se li­mite pas à son conte­nu. Elle contient aus­si une in­vi­ta­tion, sou­vent im­pli­cite, adres­sée à une po­si­tion pré­cise chez l'autre."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Quand Tho­mas pro­pose une so­lu­tion toute prête à Claire de­puis son Pa­rent Nour­ri­cier, il ne lui trans­met pas seule­ment une in­for­ma­tion utile. Il in­vite, sans le sa­voir, son En­fant Adap­té, ce­lui qui ac­cueille avec re­con­nais­sance ce qu'on lui offre. Si Claire avait ré­pon­du de­puis son Adulte, par exemple en di­sant « je n'ai pas be­soin d'une so­lu­tion, j'ai be­soin que tu m'écoutes », l'échange au­rait pris une tout autre di­rec­tion."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="C'est le cœur de ce que ce livre veut mon­trer. La plu­part du temps, nous ne choi­sis­sons pas consciem­ment l'état de­puis le­quel nous par­lons, ni l'in­vi­ta­tion que nous adres­sons à l'autre. Et l'autre ré­pond le plus sou­vent à cette in­vi­ta­tion sans l'avoir choi­si non plus. Ces échanges, ré­pé­tés des cen­taines de fois, fi­nissent par don­ner sa forme à une re­la­tion, bien plus que n'im­porte quelle dé­ci­sion prise une fois pour toutes."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Les cinq états, en dé­tail"/>
                <para PARENT="scene_page_subtitle" ALIGN="1"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <tab/>
                <ITEXT FONT="EB Garamond Bold" FCOLOR="bordeaux" CH="Le Pa­rent Nor­ma­tif"/>
                <ITEXT CH=". C'est la voix qui pose un cadre, fixe des règles et dit ce qui doit être fait, et dans quel ordre. Elle part sou­vent d'une bonne in­ten­tion : pro­té­ger, sé­cu­ri­ser, cla­ri­fier. Un pa­rent qui de­mande à son ado­les­cent de ren­trer avant mi­nuit, de ne pas boire et de se mé­fier des in­con­nus ne fait rien de pro­blé­ma­tique. Ce sont des règles de pro­tec­tion, qu'on peut dis­cu­ter. Elles peuvent quand même pro­vo­quer chez ce­lui qui les re­çoit l'une des deux ré­ac­tions ha­bi­tuelles face à une règle : se sou­mettre ou se re­bel­ler."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Les choses changent quand le cadre de­vient trop ser­ré. L'ado­les­cent n'a plus le droit de sor­tir, il doit tra­vailler da­van­tage, voir moins de monde, et au­cune de ces règles ne se dis­cute plus. L'in­ten­tion reste la même, pro­té­ger. Mais la pres­sion sur l'autre de­vient si forte qu'elle ap­pelle presque tou­jours une ré­ac­tion de même in­ten­si­té : un res­sen­ti­ment qui couve, ou une ré­volte ou­verte. Dans la pre­mière scène, So­phie reste du cô­té sain : or­ga­ni­ser un di­manche pour que la se­maine dé­marre bien n'écrase per­sonne. Les choses bas­cu­le­raient le jour où le moindre écart au plan­ning de­vien­drait une me­nace plu­tôt qu'une pos­si­bi­li­té."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT FONT="EB Garamond Bold" FCOLOR="bordeaux" CH="Le Pa­rent Nour­ri­cier"/>
                <ITEXT CH=". Conso­ler un en­fant qui tombe, ap­por­ter une soupe à un proche ma­lade, écou­ter un ami qui tra­verse une mau­vaise passe et lui sug­gé­rer une piste : tout ce­la re­lève d'un Pa­rent Nour­ri­cier en bonne san­té. C'est une voix gé­né­reuse, et la plu­part des couples en ont be­soin pour du­rer."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Elle de­vient un pro­blème quand elle va trop vite. Un pa­rent qui conti­nue de tout faire à la place de son en­fant de­ve­nu grand, et qui ré­pond à chaque be­soin avant même qu'il soit ex­pri­mé, fi­nit par l'em­pê­cher d'ap­prendre à se dé­brouiller seul. Tho­mas est dé­jà un peu de ce cô­té-là : il pro­pose une so­lu­tion avant d'avoir de­man­dé à Claire com­ment elle se sen­tait. Un "/>
                <ITEXT FONT="EB Garamond Bold" CH="Pa­rent Nour­ri­cier"/>
                <ITEXT CH=" plus équi­li­bré au­rait com­men­cé par cette ques­tion. Ré­pé­té pen­dant des an­nées, ce pe­tit ex­cès peut pro­duire un couple où l'un re­çoit des so­lu­tions avant d'avoir eu le temps de sa­voir lui-même ce dont il a be­soin."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT FONT="EB Garamond Bold" FCOLOR="bordeaux" CH="L'Adulte"/>
                <ITEXT CH=". Fixer un bud­get en­semble, com­pa­rer deux de­vis, vé­ri­fier qu'un pro­jet est réa­liste compte te­nu du temps dis­po­nible : c'est exac­te­ment ce dont un couple a be­soin pour ne pas avan­cer à l'aveugle. L'Adulte ras­semble les in­for­ma­tions, com­pare les op­tions et dé­cide à par­tir de la réa­li­té plu­tôt que d'un ré­flexe ap­pris."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="La dif­fi­cul­té ap­pa­raît quand "/>
                <ITEXT FONT="EB Garamond Bold" CH="l'Adulte"/>
                <ITEXT CH=" dé­cide seul, sans lais­ser de place à ce que cha­cun res­sent. Deux per­sonnes peuvent se mettre d'ac­cord sur un ta­bleau de tâches mé­na­gères par­fai­te­ment équi­li­bré sans qu'au­cune ne dise ce que cette ré­par­ti­tion re­mue vrai­ment chez elle : une charge men­tale plus lourde que ce que le ta­bleau montre, ou le manque de re­con­nais­sance pour ce qui est dé­jà fait. L'ac­cord est rai­son­nable, mais les vraies ques­tions n'ont pas été abor­dées. C'est ce qui se passe entre Léa et An­toine : leur dé­ci­sion de mettre un su­jet de cô­té « le temps que ça se tasse » est un bon ac­cord, et c'est pour ce­la qu'elle est dif­fi­cile à contes­ter. Avec le temps, un couple qui fonc­tionne ain­si ap­prend à tout dé­ci­der en lais­sant de cô­té ce que chaque dé­ci­sion évite de dire, jus­qu'à ce que le su­jet re­por­té dis­pa­raisse des conver­sa­tions sans avoir ja­mais été trai­té."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT FONT="EB Garamond Bold" FCOLOR="bordeaux" CH="L'En­fant Adap­té"/>
                <ITEXT CH=". C'est la voix qui s'ajuste, qui ac­cepte, qui évite de faire des vagues. Berne lui voit deux formes. La forme "/>
                <ITEXT FONT="EB Garamond Bold" CH="sou­mise"/>
                <ITEXT CH=" se conforme. La forme "/>
                <ITEXT FONT="EB Garamond Bold" CH="re­belle"/>
                <ITEXT CH=" s'op­pose. Dans les deux cas, la ré­ac­tion vient plus d'un ré­flexe que d'un choix ré­flé­chi, ap­pris très tôt face à une au­to­ri­té. Dé­ca­ler ses va­cances pour te­nir compte d'une contrainte de l'autre, ou faire un pas de cô­té pour pré­ser­ver la re­la­tion, sont des usages tout à fait sains de cette voix."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="La forme "/>
                <ITEXT FONT="EB Garamond Bold" CH="sou­mise"/>
                <ITEXT CH=" de­vient un pro­blème quand elle ne sert plus à s'ajus­ter mais à s'ef­fa­cer : dire oui avant même de sa­voir ce qu'on res­sent, ac­cu­mu­ler des conces­sions qu'on ne nomme ja­mais, jus­qu'à perdre le contact avec ce qu'on au­rait vou­lu. Marc en donne un exemple très dis­cret. Il ac­quiesce, re­prend son ca­fé, note ce qu'il doit faire. À ce stade, ce n'est pas grave. Mais si ce même geste se ré­pète chaque di­manche pen­dant des an­nées, Marc risque de ne plus sa­voir, un jour, ce qu'il au­rait en­vie de faire de son propre di­manche si on le lui de­man­dait vrai­ment. Claire, dans la deuxième scène, va en­core plus vite : elle re­mer­cie Tho­mas avant même d'avoir sen­ti ce qu'elle au­rait vou­lu re­ce­voir. Une fois, ce­la ne pose au­cun pro­blème. Si ce­la se ré­pète, ce­la peut de­ve­nir la seule ré­ponse qu'elle sait don­ner."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT FONT="EB Garamond Bold" FCOLOR="bordeaux" CH="L'En­fant Libre"/>
                <ITEXT CH=". C'est la voix spon­ta­née et joueuse, celle qui a en­vie et qui vit sans cal­cu­ler. Elle pro­pose une sor­tie im­pro­vi­sée un soir de se­maine, elle rit d'une bê­tise, elle per­met à un couple de se sur­prendre en­core. Sans elle, un couple s'as­sèche vite."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Une per­sonne peut avoir un En­fant Libre très pré­sent sans que ce­la abîme son couple, à condi­tion que cette éner­gie se tourne aus­si, de temps en temps, vers l'autre. La dif­fi­cul­té ap­pa­raît quand elle ne s'ex­prime plus ja­mais dans le couple, et tou­jours ailleurs : dans le sport, les ami­tiés, les pro­jets per­son­nels. Inès et Ju­lien n'ont pas un En­fant Libre en ex­cès ou en manque. Ils ont cha­cun un En­fant Libre bien vi­vant, mais qui s'ex­prime en de­hors du couple. Per­sonne ne l'a dé­ci­dé. Peu à peu, cha­cun a trou­vé ailleurs ce qui lui fai­sait plai­sir, et le couple est de­ve­nu le seul en­droit où cette éner­gie ne passe plus."/>
                <trail PARENT="BODY" ALIGN="3"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="142.52068503937" YPOS="10642.3632047244" OwnPage="23" ItemID="90347376" PTYPE="4" WIDTH="497.166026688036" HEIGHT="763.388032123197" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" copath="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" gXpos="737.796275590551" gYpos="4469.13485826772" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="194167584"/>
        <PAGEOBJECT XPOS="142.52068503937" YPOS="11524.2529685039" OwnPage="25" ItemID="90336048" PTYPE="4" WIDTH="497.166026688036" HEIGHT="763.388032123197" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" copath="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" gXpos="737.796275590551" gYpos="4469.13485826771" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="193848944" BACKITEM="194172944"/>
        <PAGEOBJECT XPOS="142.52068503937" YPOS="12406.1427322835" OwnPage="27" ItemID="90350208" PTYPE="4" WIDTH="497.166026688036" HEIGHT="763.388032123197" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" copath="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" gXpos="737.796275590551" gYpos="4469.13485826771" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="335187712" BACKITEM="193848944"/>
        <PAGEOBJECT XPOS="751.969503937008" YPOS="13288.032496063" OwnPage="30" ItemID="90353040" PTYPE="4" WIDTH="497.166026688036" HEIGHT="763.388032123197" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" copath="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" gXpos="1347.24509448819" gYpos="4469.13485826771" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="193857120" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="La carte des cou­plages"/>
                <para PARENT="scene_page_subtitle" ALIGN="1"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Les quatre cou­plages des scènes ne sont pas les seuls pos­sibles. Je les ai choi­sis parce qu'ils re­viennent sou­vent et qu'ils se prê­taient bien à une scène. Mais avec cinq voix, les com­bi­nai­sons sont plus nom­breuses. Je vous en pro­pose quelques autres, parce que vous vous re­con­naî­trez peut-être dans l'une d'elles plu­tôt que dans les quatre scènes."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Je re­prends la dis­tinc­tion du 2.4. Dans un cou­plage fort, les deux po­si­tions dé­pendent l'une de l'autre : cha­cun a be­soin de l'autre pour te­nir sa place. Dans un cou­plage lâche, les deux po­si­tions existent sé­pa­ré­ment : cha­cun tient sa place de son cô­té."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Du cô­té des cou­plages forts"/>
                <para PARENT="scene_page_subtitle" ALIGN="1"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <tab/>
                <ITEXT CH="So­phie et Marc as­so­cient un Pa­rent Nor­ma­tif et un En­fant Adap­té sou­mis. Le Pa­rent Nor­ma­tif peut aus­si ren­con­trer un En­fant Adap­té re­belle. Dans ce cas, l'autre ne suit pas : il conteste presque chaque règle et chaque dé­ci­sion. Il ne le fait pas parce que la règle est mau­vaise. Il le fait parce que s'op­po­ser est la seule fa­çon qu'il a trou­vée d'exis­ter face à ce­lui qui dé­cide. Ce cou­plage tient aus­si so­li­de­ment que ce­lui de So­phie et Marc, mais il tient par la dis­pute plu­tôt que par l'ac­cord. Ces dis­putes ne disent pas grand-chose de l'état du couple. Elles sont de­ve­nues une ha­bi­tude, aus­si pré­vi­sible qu'un di­manche bien or­ga­ni­sé."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Deux Pa­rents Nour­ri­ciers peuvent aus­si se ren­con­trer. Cha­cun prend soin de l'autre et de­vance ses be­soins avant même qu'il les ex­prime. De l'ex­té­rieur, ce couple pa­raît très uni, et il l'est sou­vent. La dif­fi­cul­té est que cha­cun met son éner­gie à don­ner, et que per­sonne ne de­mande ja­mais à re­ce­voir. Avec le temps, cha­cun sait très bien s'oc­cu­per de l'autre, mais ne sait plus dire ce dont il a be­soin lui-même."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Du cô­té des cou­plages lâches"/>
                <para PARENT="scene_page_subtitle" ALIGN="1"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Inès et Ju­lien as­so­cient deux En­fants Libres, qui vivent cha­cun leurs en­vies de leur cô­té. Un autre cou­plage lâche réunit un En­fant Libre et un En­fant Adap­té. Le pre­mier pro­pose, im­pro­vise, cherche de la lé­gè­re­té. Le se­cond reste pru­dent : il est dis­po­nible, mais ra­re­ment par­tant. Il ne re­fuse pas fran­che­ment. Il ré­pond plus tard, ou sans en­thou­siasme, ou pro­pose autre chose. Avec le temps, le pre­mier pro­pose de moins en moins, et le se­cond n'at­tend plus qu'on lui pro­pose quoi que ce soit. Cha­cun fi­nit par vivre ses en­vies de son cô­té."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Deux Pa­rents Nor­ma­tifs peuvent aus­si se re­trou­ver face à face, cha­cun vou­lant te­nir le cadre à sa fa­çon. Au dé­but, les deux po­si­tions s'af­frontent sans cesse, dans une né­go­cia­tion per­ma­nente sur qui dé­cide de quoi. Le couple peut en­suite se ré­par­tir les do­maines. L'un s'oc­cupe des en­fants, l'autre des fi­nances, et cha­cun dé­cide seul dans le sien sans in­ter­ve­nir dans ce­lui de l'autre. À par­tir de là, le cou­plage de­vient lâche, puisque chaque po­si­tion tient sans l'autre. Vu de l'ex­té­rieur, ce­la res­semble à une ré­par­ti­tion ef­fi­cace des tâches. Mais cette ré­par­ti­tion leur per­met aus­si de ne ja­mais avoir à se mettre d'ac­cord."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <ITEXT CH="Un mo­ment pour vous"/>
                <para PARENT="scene_page_subtitle" ALIGN="1"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Avant de conti­nuer, je vous pro­pose de vous po­ser deux ques­tions, sans cher­cher la bonne ré­ponse."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="La pre­mière : dans votre couple, est-ce que cha­cun tient presque tou­jours le même rôle face à l'autre ? L'un or­ga­nise et l'autre suit, l'un aide et l'autre re­çoit, l'un pro­pose et l'autre va­lide. Ou est-ce que cha­cun vit sur­tout de son cô­té, oc­cu­pé et plu­tôt bien, mais ra­re­ment avec l'autre ?"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="La se­conde : était-ce dé­jà comme ça au dé­but ? Si ce n'est pas le cas, es­sayez de vous rap­pe­ler com­ment c'était avant que les rôles se fixent, et ce que vous avez ces­sé de dis­cu­ter ou de de­man­der pour que les choses de­viennent plus simples."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Vous vous re­con­naî­trez peut-être un peu dans les deux formes, se­lon les su­jets et les pé­riodes. C'est nor­mal. À ce stade, il suf­fit de com­men­cer à re­mar­quer com­ment les choses se passent chez vous."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Cette carte ne contient pas tous les cou­plages pos­sibles entre cinq voix. Elle pré­sente ceux qui me semblent les plus cou­rants. Dans cha­cun, chaque par­te­naire trouve un bé­né­fice qu'il ne voit pas, et le couple a l'air de bien fonc­tion­ner : on s'en­tend bien, on est ef­fi­caces, rien ne pose pro­blème. Ce fonc­tion­ne­ment a pour­tant un prix. Quand tout est ré­glé d'avance, il reste peu de place pour chan­ger, pour évo­luer en­semble ou pour être sur­pris par l'autre. Une ques­tion reste ou­verte, et nous la re­trou­ve­rons plus loin dans ce livre. Que de­vient ce cou­plage si bien ro­dé le jour où sur­vient un évé­ne­ment in­at­ten­du : une ma­la­die, un en­fant qui va mal, ou l'un des deux qui change plus vite que l'autre ?"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ré­ca­pi­tu­la­tif des cou­plages"/>
                <para PARENT="scene_page_subtitle" ALIGN="1"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ce qui vous at­tend main­te­nant"/>
                <para PARENT="scene_page_subtitle" ALIGN="1"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Vous avez lu quatre scènes, dé­cou­vert cinq voix in­té­rieures et par­cou­ru une carte des cou­plages. Vous avez peut-être dé­jà re­con­nu un trait de votre propre couple : un rôle que vous te­nez sans y pen­ser, ou une ré­ponse que vous don­nez presque au­to­ma­ti­que­ment."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Le cha­pitre sui­vant vous pro­pose d'al­ler plus loin, en vous concen­trant cette fois sur vous. Il ne contient pas de nou­velle scène. Il vous pro­pose une sé­rie de ques­tions pour re­pé­rer le cou­plage dans le­quel vous vi­vez, la po­si­tion que vous y oc­cu­pez, et ce que cette po­si­tion vous ap­porte peut-être sans que vous le sa­chiez. À la fin de ce cha­pitre, vous ver­rez plus clai­re­ment com­ment fonc­tionne votre couple. Les pistes pour faire au­tre­ment vien­dront plus loin dans le livre. Pour l'ins­tant, il s'agit seule­ment de voir clai­re­ment, avant de pen­ser à chan­ger quoi que ce soit."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="751.969503937008" YPOS="14169.9222598426" OwnPage="32" ItemID="90341712" PTYPE="4" WIDTH="497.166026688036" HEIGHT="763.388032123197" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" copath="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" gXpos="1347.24509448819" gYpos="4469.13485826771" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="193857120"/>
        <PAGEOBJECT XPOS="142.52068503937" YPOS="15933.7017874016" OwnPage="35" ItemID="90358704" PTYPE="4" WIDTH="497.166026688036" HEIGHT="763.388032123197" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" copath="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" gXpos="737.796275590551" gYpos="5351.02462204724" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <trail/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="142.52068503937" YPOS="16815.5915511811" OwnPage="37" ItemID="90355872" PTYPE="4" WIDTH="497.166026688036" HEIGHT="763.388032123197" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" copath="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" gXpos="737.796275590551" gYpos="5351.02462204724" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="246458560" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Le re­pé­rage par les signes"/>
                <para PARENT="scene_page_subtitle" ALIGN="1"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Pour cha­cune des six si­tua­tions sui­vantes, choi­sis­sez la ré­ponse qui res­semble le plus à ce qui se passe chez vous, la plu­part du temps. Ne cher­chez pas la ré­ponse idéale, ni celle que vous ai­me­riez don­ner. Choi­sis­sez celle qui cor­res­pond le mieux à ce qui se pro­duit réel­le­ment."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Les ré­ponses sont dé­si­gnées par des lettres. Ne leur cher­chez pas de sens pour l'ins­tant, vous le dé­cou­vri­rez à la sec­tion sui­vante. Ré­pon­dez à chaque si­tua­tion pour elle-même, sans re­gar­der vos ré­ponses pré­cé­dentes, et no­tez sim­ple­ment la lettre choi­sie."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="1. Les dé­ci­sions du quo­ti­dien"/>
                <para PARENT="scene_page_subtitle" ALIGN="1"/>
                <ITEXT CH="Un week-end à or­ga­ni­ser, un re­pas à pré­pa­rer, des courses à faire avant que le fri­go soit vide."/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="F. Cha­cun a ses ac­ti­vi­tés et son rythme. Le week-end se rem­plit sans que vous ayez be­soin de vous consul­ter beau­coup."/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="A. L'un de vous deux sait presque tou­jours ce qu'il faut faire, dans quel ordre et pour quelle heure. L'autre suit, sans vrai­ment se de­man­der s'il fe­rait au­tre­ment."/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="H. Cha­cun a son do­maine. L'un s'oc­cupe des re­pas, l'autre des sor­ties, et au­cun n'in­ter­vient dans le do­maine de l'autre."/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Z. Ce­la dé­pend des fois. Par­fois c'est vous qui pre­nez les de­vants, par­fois c'est l'autre."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="2. L'ar­gent"/>
                <para PARENT="scene_page_subtitle" ALIGN="1"/>
                <ITEXT CH="Une dé­pense im­por­tante à dé­ci­der, un bud­get à re­voir, une prio­ri­té sur la­quelle vous n'êtes pas sûrs d'être d'ac­cord."/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="H. L'un de vous deux gère les comptes, l'autre ne s'en mêle pas. Cha­cun dé­cide seul dans les do­maines qui sont les siens."/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="C. L'un de vous deux pro­pose un chiffre ou une ré­par­ti­tion, et l'autre va­lide presque tou­jours, même quand il au­rait pu avoir un autre avis s'il avait pris le temps d'y ré­flé­chir."/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="E. Cha­cun pense d'abord à ce qui fe­rait plai­sir à l'autre : un ca­deau, une dé­pense pour son confort. Il est plus rare que l'un dise ce dont lui-même a en­vie."/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Z. Ce­la dé­pend des su­jets. Il n'y a pas de rôle fixe entre vous sur les ques­tions d'ar­gent."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="3. Les en­fants (si vous n'avez pas d'en­fants, pas­sez à la si­tua­tion sui­vante)"/>
                <para PARENT="scene_page_subtitle" ALIGN="1"/>
                <ITEXT CH="Une règle à po­ser, un désac­cord sur l'édu­ca­tion, une dé­ci­sion qui les concerne."/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="D. Quand l'un de vous deux pose une règle, l'autre la dis­cute presque tou­jours, même quand il n'est pas vrai­ment en désac­cord sur le fond."/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="E. Cha­cun cherche à sou­la­ger l'autre : se le­ver la nuit, prendre une cor­vée, le lais­ser souf­fler. Au­cun des deux ne de­mande vrai­ment d'aide."/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="A. L'un de vous deux fixe le cadre : les ho­raires, les li­mites, ce qui est per­mis. L'autre s'aligne, même s'il au­rait peut-être po­sé une li­mite dif­fé­rente."/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Z. Ce­la change se­lon les su­jets, et vous vous ajus­tez au cas par cas."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="4. La fa­mille élar­gie"/>
                <para PARENT="scene_page_subtitle" ALIGN="1"/>
                <ITEXT CH="Un ap­pel dif­fi­cile, une ten­sion avec un pa­rent ou un beau-pa­rent, une si­tua­tion où il faut prendre po­si­tion."/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="B. L'un de vous deux écoute, puis pro­pose vite une so­lu­tion ou une po­si­tion à adop­ter. L'autre ac­cepte, re­mer­cie, et la conver­sa­tion s'ar­rête là."/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="D. Quand l'un prend po­si­tion, l'autre le conteste presque tou­jours, et la dis­cus­sion porte plus sur qui a rai­son que sur la si­tua­tion elle-même."/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="C. Vous en par­lez cal­me­ment. L'un pro­pose une po­si­tion rai­son­nable, l'autre l'ap­prouve, et le su­jet est consi­dé­ré comme ré­glé."/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Z. Ce­la dé­pend des si­tua­tions et de qui est le plus concer­né sur le mo­ment."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="5. Une ten­sion entre vous"/>
                <para PARENT="scene_page_subtitle" ALIGN="1"/>
                <ITEXT CH="Une re­marque mal re­çue, un re­proche qui monte, une ir­ri­ta­tion."/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="G. L'un de vous deux es­saie de dé­tendre l'at­mo­sphère, par une blague ou une pro­po­si­tion. L'autre reste sur la ré­serve et at­tend que ce­la passe."/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="E. Cha­cun s'ex­cuse vite et cherche à prendre soin de l'autre. La ten­sion re­tombe, mais au­cun des deux n'a dit ce dont il avait be­soin."/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="B. L'un de vous deux ras­sure tout de suite et pro­pose une fa­çon d'ar­ran­ger les choses. L'autre ac­cepte, sans vrai­ment dire ce qui l'a bles­sé."/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Z. Ce­la va­rie. Par­fois la ten­sion s'ex­prime, par­fois elle re­tombe, sans que l'un de vous tienne tou­jours le même rôle."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="6. Un mo­ment de creux"/>
                <para PARENT="scene_page_subtitle" ALIGN="1"/>
                <ITEXT CH="Une pé­riode où vous pas­sez peu de temps à deux, sans que rien de grave ne se soit pas­sé."/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="C. L'un de vous deux pro­pose de faire le point. Vous pre­nez en­semble une dé­ci­sion rai­son­nable, par exemple at­tendre que les choses se calment, et le su­jet ne re­vient pas avant long­temps."/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="G. L'un de vous deux pro­pose ré­gu­liè­re­ment un mo­ment en­semble. L'autre est d'ac­cord sur le prin­cipe, mais trouve sou­vent une rai­son de re­mettre à plus tard. Avec le temps, les pro­po­si­tions se font plus rares."/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="F. Ni l'un ni l'autre ne re­lance vrai­ment. Cha­cun conti­nue de son cô­té, oc­cu­pé et plu­tôt sa­tis­fait de sa se­maine."/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Z. Ce­la ar­rive ra­re­ment, ou alors c'est tan­tôt l'un, tan­tôt l'autre qui re­lance."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Vous avez main­te­nant une lettre par si­tua­tion. La sec­tion sui­vante vous ex­plique ce qu'elles dé­si­gnent."/>
                <trail PARENT="BODY" ALIGN="3"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="142.52068503937" YPOS="17697.4813149606" OwnPage="39" ItemID="90361536" PTYPE="4" WIDTH="497.166026688036" HEIGHT="763.388032123197" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" copath="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" gXpos="737.796275590551" gYpos="5351.02462204724" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="264720496" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Le nom de ce que vous avez re­pé­ré"/>
                <para PARENT="scene_page_subtitle" ALIGN="1"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Voi­ci ce que dé­si­gnent les lettres."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Re­gar­dez main­te­nant vos six ré­ponses en­semble. Chaque cou­plage n'était pro­po­sé que dans deux ou trois si­tua­tions. Une lettre qui re­vient deux fois est donc dé­jà un signe."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Si une même lettre re­vient au moins deux fois, ce cou­plage s'est sans doute ins­tal­lé chez vous au-de­là d'un seul do­maine. Il est de­ve­nu votre fa­çon ha­bi­tuelle de fonc­tion­ner à deux, quel que soit le su­jet. C'est ce­lui qui vous concerne le plus di­rec­te­ment, et c'est sur lui que je vous pro­pose de vous ar­rê­ter dans la suite de ce cha­pitre."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Si au­cune lettre ne re­vient, par exemple A pour les dé­ci­sions du quo­ti­dien, C pour l'ar­gent et G pour les mo­ments de creux, votre couple fonc­tionne dif­fé­rem­ment se­lon les do­maines. Au­cun cou­plage unique ne s'est ins­tal­lé par­tout. Dans ce cas, vous pou­vez lire la suite du livre do­maine par do­maine, en com­men­çant par ce­lui qui vous pèse le plus."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Si vous avez choi­si Z dans la plu­part des si­tua­tions, au­cun rôle ne semble s'être fi­gé au point de de­ve­nir au­to­ma­tique. Ce livre vous concerne peut-être moins di­rec­te­ment. Un cou­plage peut quand même exis­ter dans un do­maine que ces six si­tua­tions n'ont pas abor­dé, comme l'in­ti­mi­té, le tra­vail ou les amis."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Pre­nons un exemple. Hé­lène vit avec Bru­no de­puis quinze ans. Elle a ré­pon­du A pour les dé­ci­sions du quo­ti­dien, C pour l'ar­gent, A pour les en­fants, C pour la fa­mille élar­gie, E pour les ten­sions, et Z pour les mo­ments de creux."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Deux lettres re­viennent cha­cune deux fois : A et C. En re­gar­dant la clé, Hé­lène voit ap­pa­raître deux cou­plages dif­fé­rents. Le pre­mier, A, as­so­cie un Pa­rent Nor­ma­tif et un En­fant Adap­té sou­mis. Il concerne le quo­ti­dien et les en­fants. Le se­cond, C, as­so­cie deux Adultes, dont l'un pro­pose et l'autre va­lide. Il concerne l'ar­gent et la fa­mille élar­gie."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Le ques­tion­naire ne dit pas quelle place Hé­lène oc­cupe dans cha­cun de ces cou­plages. C'est à elle de le cher­cher. Pour le quo­ti­dien et les en­fants, la ré­ponse vient vite : c'est elle qui or­ga­nise, et Bru­no suit. Pour l'ar­gent et la fa­mille élar­gie, elle hé­site da­van­tage. Puis elle se rend compte que c'est presque tou­jours Bru­no qui pro­pose, et elle qui ap­prouve. Elle n'y avait ja­mais pen­sé."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Hé­lène dé­couvre ain­si qu'elle n'oc­cupe pas la même po­si­tion par­tout. À la mai­son, elle dé­cide. Sur l'ar­gent, elle suit. Nous l'avons vu au cha­pitre 2 : une po­si­tion dé­pend du contexte, et per­sonne n'est seule­ment « ce­lui qui or­ga­nise » ou « ce­lui qui suit ». Cette dé­cou­verte lui per­met aus­si de mieux com­prendre Bru­no. Il n'est pas quel­qu'un qui suit en toutes cir­cons­tances. Il suit dans les do­maines où elle a pris la main, et il dé­cide dans ceux où elle s'est mise en re­trait."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Reste à sa­voir par où com­men­cer. Hé­lène se pose une ques­tion simple : le­quel de ces deux cou­plages me pèse le plus au­jour­d'hui ? Pour elle, c'est le pre­mier. Elle se sent fa­ti­guée de tout por­ter à la mai­son. L'ar­gent, en re­vanche, ne la gêne pas pour l'ins­tant. C'est donc sur le quo­ti­dien qu'elle choi­sit de s'ar­rê­ter dans la suite de ce cha­pitre."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Ce que vous ve­nez de nom­mer n'est pas un ver­dict. C'est l'état ac­tuel d'un fonc­tion­ne­ment qui s'est construit avec le temps, sou­vent pour de bonnes rai­sons. La sec­tion sui­vante vous aide à voir ce que ce cou­plage vous ap­porte, à vous. Plus loin dans le livre, nous ver­rons s'il y a des rai­sons d'en sor­tir, et com­ment."/>
                <trail PARENT="BODY" ALIGN="3"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="142.52068503937" YPOS="18579.3710787402" OwnPage="41" ItemID="246410416" PTYPE="4" WIDTH="497.166026688036" HEIGHT="763.388032123197" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" copath="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" gXpos="737.796275590551" gYpos="5351.02462204724" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Ce que ce cou­plage vous ap­porte, à vous"/>
                <para PARENT="scene_page_subtitle" ALIGN="1"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Vous sa­vez main­te­nant com­ment nom­mer ce qui se passe chez vous. Il reste à com­prendre pour­quoi ce­la tient."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Les quatre scènes l'ont mon­tré : un cou­plage dure parce que cha­cun des deux y trouve son compte. Ce bé­né­fice est dis­cret, et ce­lui qui en pro­fite le voit ra­re­ment. Je vous pro­pose de cher­cher le vôtre, ce­lui que vous re­ti­rez vous-même de votre po­si­tion."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Si vous êtes plu­tôt ce­lui qui or­ga­nise, qui aide ou qui pro­pose, de­man­dez-vous ce que cette po­si­tion vous évite. Peut-être de vous de­man­der ce qui se pas­se­rait si vous ar­rê­tiez, ne se­rait-ce qu'une fois. Peut-être le risque que les choses ne se fassent pas comme vous l'au­riez vou­lu, ou pas du tout. Peut-être aus­si le plai­sir de vous sen­tir utile, voire in­dis­pen­sable. C'est un sen­ti­ment agréable, et il ne donne pas très en­vie que l'autre prenne le re­lais."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Si vous êtes plu­tôt ce­lui qui suit, qui re­çoit ou qui va­lide, de­man­dez-vous ce que cette po­si­tion vous épargne. D'abord le poids de la dé­ci­sion, et le risque de vous trom­per. Peut-être aus­si le fait de ne ja­mais avoir à sa­voir pré­ci­sé­ment ce que vous vou­lez, puisque la ques­tion ne vous est presque ja­mais po­sée. Ce­la peut être une fa­çon ef­fi­cace de vous pro­té­ger d'un in­con­fort plus grand : ce­lui de prendre po­si­tion, de de­man­der quelque chose ou de ris­quer un désac­cord."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Si vous te­nez tous les deux la même po­si­tion, parce que cha­cun prend soin de l'autre, que cha­cun vit de son cô­té ou que cha­cun dé­cide seul dans son do­maine, la ques­tion se pose au­tre­ment. De­man­dez-vous ce que cet équi­libre vous évite à tous les deux. Ce peut être une conver­sa­tion dif­fi­cile : dire ce dont on a be­soin, faire une pro­po­si­tion qui pour­rait être re­fu­sée, ou se mettre d'ac­cord sur un su­jet où l'on ne l'est pas."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Dans tous les cas, une autre ques­tion peut vous ai­der : était-ce dé­jà ain­si au dé­but ? Si ce n'est pas le cas, qu'est-ce que vous n'avez plus eu en­vie de re­vivre ? Ex­pli­quer en­core, né­go­cier, vous dis­pu­ter ? Votre po­si­tion ac­tuelle vous pro­tège peut-être de ce­la."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Re­ve­nons à Hé­lène, qui a choi­si de re­gar­der le quo­ti­dien, là où c'est elle qui or­ga­nise. Elle se de­mande d'abord ce que cette po­si­tion lui évite. La pre­mière ré­ponse qui lui vient est simple : si elle n'or­ga­nise pas, rien ne se fait. Puis elle s'ar­rête, parce que ce n'est pas tout à fait vrai. L'an der­nier, quand elle est par­tie une se­maine pour son tra­vail, Bru­no a te­nu la mai­son seul. Les choses se sont faites au­tre­ment, mais elles se sont faites."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Elle cherche alors plus loin. Sa po­si­tion lui ap­porte le sen­ti­ment que tout est sous contrôle, et une cer­taine fier­té : à la mai­son, on peut comp­ter sur elle. Elle lui évite de voir les choses se faire au­tre­ment qu'elle ne l'au­rait vou­lu, et de de­voir l'ac­cep­ter sans rien dire. Hé­lène se rend compte qu'elle pré­fère tout faire elle-même plu­tôt que de lais­ser Bru­no faire à sa fa­çon."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Elle se pose en­suite la ques­tion des dé­buts. Quand ils ont em­mé­na­gé en­semble, ils se par­ta­geaient da­van­tage les tâches. Elle se sou­vient de dis­putes sur le linge, les re­pas, les courses ou­bliées. Peu à peu, elle a re­pris tout ce qui po­sait pro­blème, pour que les dis­putes s'ar­rêtent. Ce par­tage n'a ja­mais été dé­ci­dé entre eux. Il s'est ins­tal­lé."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Hé­lène ne sait pas en­core ce qu'elle vou­drait chan­ger. Mais elle voit main­te­nant que sa fa­tigue ne vient pas seule­ment de Bru­no. Elle vient aus­si d'une règle qu'ils ont construite à deux, et dans la­quelle elle a long­temps trou­vé son compte."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Je ne peux pas ré­pondre à votre place, parce que la ré­ponse dé­pend de votre his­toire. Je vous pro­pose plu­tôt une ques­tion à gar­der avec vous dans les jours qui viennent, à des mo­ments or­di­naires de votre vie de couple : qu'est-ce que je ris­que­rais si je chan­geais de po­si­tion, ne se­rait-ce qu'une fois ?"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Ne vous fiez pas trop à une ré­ponse qui vien­drait tout de suite. Sur ce su­jet, les ré­ponses les plus justes mettent sou­vent du temps à ap­pa­raître."/>
                <trail PARENT="BODY" ALIGN="3"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="142.52068503937" YPOS="19461.2608425197" OwnPage="43" ItemID="246401920" PTYPE="4" WIDTH="497.166026688036" HEIGHT="763.388032123197" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" copath="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" gXpos="737.796275590551" gYpos="5351.02462204724" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <trail/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="142.52068503937" YPOS="20343.1506062992" OwnPage="45" ItemID="246404752" PTYPE="4" WIDTH="497.166026688036" HEIGHT="763.388032123197" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" copath="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" gXpos="737.796275590551" gYpos="5351.02462204724" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <trail/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="142.52068503937" YPOS="21225.0403700788" OwnPage="47" ItemID="246399088" PTYPE="4" WIDTH="497.166026688036" HEIGHT="763.388032123197" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" copath="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" gXpos="737.796275590551" gYpos="5351.02462204724" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="264734656" BACKITEM="264728992"/>
        <PAGEOBJECT XPOS="142.52068503937" YPOS="22106.9301338583" OwnPage="49" ItemID="246413248" PTYPE="4" WIDTH="497.166026688036" HEIGHT="763.388032123197" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" copath="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" gXpos="737.796275590551" gYpos="5351.02462204724" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="264734656"/>
        <PAGEOBJECT XPOS="142.52068503937" YPOS="22988.8198976378" OwnPage="51" ItemID="246416080" PTYPE="4" WIDTH="497.166026688036" HEIGHT="763.388032123197" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" copath="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" gXpos="737.796275590551" gYpos="5351.02462204724" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <trail/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="142.52068503937" YPOS="23870.7096614173" OwnPage="53" ItemID="246418912" PTYPE="4" WIDTH="497.166026688036" HEIGHT="763.388032123197" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" copath="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" gXpos="737.796275590551" gYpos="5351.02462204724" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="264745984" BACKITEM="264726160"/>
