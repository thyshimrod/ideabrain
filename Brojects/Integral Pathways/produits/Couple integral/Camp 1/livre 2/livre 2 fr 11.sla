        <PAGEOBJECT XPOS="857.005668664204" YPOS="4687.28794864469" OwnPage="10" ItemID="248389664" PTYPE="5" WIDTH="295.263379417221" HEIGHT="1" FRTYPE="0" CLIPEDIT="0" ROT="359.914137254786" PWIDTH="0.283464566929134" PCOLOR="bordeaux" SHADE="0" PCOLOR2="bordeaux" PLINEART="1" path="" gXpos="681.257267089402" gYpos="12983.3502557313" gWidth="0" gHeight="0" LAYER="0"/>
