        <PAGEOBJECT XPOS="143.1978503937" YPOS="14447.2564525817" OwnPage="31" ItemID="219237024" PTYPE="2" WIDTH="490.9285519476" HEIGHT="370.628318584069" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="0.54664943743963" LOCALSCY="0.54664943743963" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="0" RATIO="1" Pagenumber="0" PFILE="liste couplage.png" PRFILE="Embedded sRGB built-in" IRENDER="0" EPROF="Embedded sRGB built-in" COMPRESSIONQUALITY="0" path="M0 0 L490.929 0 L490.929 370.628 L0 370.628 L0 0 Z" copath="M0 0 L490.929 0 L490.929 370.628 L0 370.628 L0 0 Z" gXpos="143.1978503937" gYpos="14447.2564525817" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1"/>
        <PAGEOBJECT XPOS="146.920353982301" YPOS="17754.4589471813" OwnPage="39" ItemID="264782800" PTYPE="2" WIDTH="472.778761061947" HEIGHT="215.362831858407" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="0.554904649133741" LOCALSCY="0.554904649133741" LOCALX="0" LOCALY="-3.5527136788005e-15" LOCALROT="0" PICART="1" SCALETYPE="0" RATIO="1" Pagenumber="0" PFILE="resultat_quizz.png" PRFILE="Embedded sRGB built-in" IRENDER="0" EPROF="Embedded sRGB built-in" path="M0 0 L472.779 0 L472.779 215.363 L0 215.363 L0 0 Z" copath="M0 0 L472.779 0 L472.779 215.363 L0 215.363 L0 0 Z" gXpos="146.920353982301" gYpos="17754.4589471813" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1"/>
        <PAGEOBJECT XPOS="751.969503937008" YPOS="40626.6151732284" OwnPage="92" ItemID="264771472" PTYPE="4" WIDTH="497.166026688036" HEIGHT="763.388032123197" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" copath="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" gXpos="751.969503937008" gYpos="9760.4734409449" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Les autres cou­plages"/>
                <para PARENT="scene_page_subtitle" ALIGN="1"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Les quatre cou­plages qui suivent n'ont pas de scène dans ce livre. Je ne vous pro­po­se­rai donc pas d'ac­cord pour cha­cun d'eux. Un ac­cord ne peut ve­nir que de vos propres be­soins, et je ne les connais pas. Je vous pro­pose plu­tôt des pistes pour les ex­plo­rer."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Avant de les lire, rap­pe­lons ce que les quatre couples de ces deux cha­pitres ont en com­mun. D'un couple à "/>
                <tab/>
                <ITEXT CH="l'autre, les conver­sa­tions ne se res­semblent pas, mais on y re­trouve le même che­min. Ce­lui qui com­mence part de lui-même : ce qu'il a re­mar­qué, ce qu'il res­sent, ce qui est im­por­tant pour lui. Il ex­plique pour­quoi il n'a rien dit pen­dant si long­temps, ce qui per­met à l'autre de ne pas se sen­tir ac­cu­sé. Il écoute en­suite ce qui compte pour l'autre, au lieu de cher­cher à le convaincre. Et l'ac­cord qu'ils trouvent en­gage les deux, ré­pond aux be­soins nom­més, et pré­voit dès le dé­part qu'il se­ra im­par­fait et qu'on en re­par­le­ra."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Les pistes qui suivent servent à pré­pa­rer la pre­mière par­tie de ce che­min : sa­voir ce qui se joue pour vous avant d'en par­ler."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para ALIGN="3"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <ITEXT CH="Quand l'un pose les règles et que l'autre les conteste"/>
                <para PARENT="scene_page_subtitle" ALIGN="1"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="La règle du couple : l'un dé­cide, l'autre conteste presque tout, et la dis­pute est de­ve­nue une ha­bi­tude."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Ce que chaque po­si­tion pro­tège peut-être : ce­lui qui pose les règles s'as­sure que les choses se­ront faites, et évite de se sen­tir seul face aux res­pon­sa­bi­li­tés. Ce­lui qui conteste garde le sen­ti­ment d'exis­ter et de comp­ter, et évite de dis­pa­raître der­rière les dé­ci­sions de l'autre."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Pour trou­ver ce qui est im­por­tant pour vous"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Si vous po­sez les règles : qu'est-ce qui m'in­quiète quand une dé­ci­sion n'est pas prise ? De quoi au­rais-je be­soin pour moins por­ter seul ?"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Si vous contes­tez : quand je dis non, qu'est-ce que je dé­fends vrai­ment ? M'ar­rive-t-il d'être d'ac­cord sans le dire ?"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Pour com­men­cer la conver­sa­tion : « Je me rends compte que nos dis­cus­sions fi­nissent sou­vent en désac­cord, et j'y prends ma part. J'ai­me­rais com­prendre ce qui se joue pour moi, et pour toi. »"/>
                <trail PARENT="BODY" ALIGN="3"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="751.969503937008" YPOS="41508.504937008" OwnPage="94" ItemID="264785632" PTYPE="4" WIDTH="497.166026688036" HEIGHT="763.388032123197" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" copath="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" gXpos="751.969503937008" gYpos="9760.4734409449" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Quand cha­cun dé­cide seul dans son do­maine"/>
                <para PARENT="scene_page_subtitle" ALIGN="1"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="La règle du couple : après une pé­riode de né­go­cia­tion, cha­cun a son do­maine, et on ne dé­cide presque plus rien à deux."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Ce que chaque po­si­tion pro­tège peut-être : la tran­quilli­té re­trou­vée après les désac­cords du dé­but, le sen­ti­ment d'être com­pé­tent dans son do­maine, et le fait de ne pas avoir à se mettre d'ac­cord."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Pour trou­ver ce qui est im­por­tant pour vous"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Quelles dé­ci­sions ai­me­rais-je prendre à deux ?"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Qu'est-ce que je crains si nous re­com­men­çons à dé­ci­der en­semble ?"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Dans mon do­maine, est-ce que je me sens plu­tôt libre, ou plu­tôt seul ?"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <tab/>
                <ITEXT CH="Pour com­men­cer la conver­sa­tion : « Notre ré­par­ti­tion fonc­tionne bien, et je ne veux pas re­ve­nir aux dis­putes du dé­but. Mais je me rends compte qu'on ne dé­cide plus grand-chose en­semble, et par­fois, ça me manque. »"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Une fois ces ques­tions ex­plo­rées, vous au­rez une idée plus claire de ce qui est im­por­tant pour vous. C'est seule­ment à ce mo­ment que l'ac­cord peut se construire, à deux, à par­tir de vos be­soins et de ceux de votre par­te­naire, comme l'ont fait les couples de ce cha­pitre."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ce che­min n'est pas simple. Il de­mande de sa­voir ce que l'on res­sent, de le dire, et d'en­tendre l'autre dire quelque chose de dif­fé­rent. Vous ne réus­si­rez sans doute pas la pre­mière conver­sa­tion. Ce n'est pas grave. Ce qui compte, c'est que la règle de votre couple soit en­fin de­ve­nue un su­jet dont vous pou­vez par­ler en­semble."/>
                <trail PARENT="BODY" ALIGN="3"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="751.969503937008" YPOS="42390.3947007875" OwnPage="96" ItemID="298332272" PTYPE="4" WIDTH="497.166026688036" HEIGHT="763.388032123197" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" copath="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" gXpos="751.969503937008" gYpos="9760.4734409449" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
