        <PAGEOBJECT XPOS="1214.0167480315" YPOS="7002.6740993659" OwnPage="14" ItemID="348753072" PTYPE="4" WIDTH="30.372632499477" HEIGHT="19.7522123893809" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L30.3726 0 L30.3726 19.7522 L0 19.7522 L0 0 Z" copath="M0 0 L30.3726 0 L30.3726 19.7522 L0 19.7522 L0 0 Z" gXpos="1214.0167480315" gYpos="3475.11504424779" gWidth="0" gHeight="0" ALIGN="2" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
