        <PAGEOBJECT XPOS="142.52068503937" YPOS="54736.8513937008" OwnPage="123" ItemID="359795488" PTYPE="4" WIDTH="497.166026688036" HEIGHT="763.388032123197" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" copath="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" gXpos="737.796275590551" gYpos="15051.8120236221" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <trail/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="751.969503937008" YPOS="54736.8513937008" OwnPage="124" ItemID="359812480" PTYPE="4" WIDTH="497.166026688036" HEIGHT="763.388032123197" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" copath="M0 0 L497.166 0 L497.166 763.388 L0 763.388 L0 0 Z" gXpos="751.969503937008" gYpos="15051.8120236221" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="359815312" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT LANGUAGE="fur" CH="Post­face — Ce que ce livre ne peut pas faire seul"/>
                <para PARENT="scene_page_subtitle"/>
                <para PARENT="Default Paragraph Style (2)"/>
                <para PARENT="Default Paragraph Style (2)"/>
                <tab LANGUAGE="fur"/>
                <ITEXT LANGUAGE="fur" CH="Avant de vous lais­ser, je vou­drais re­ve­nir sur la fa­çon dont j'ai ra­con­té les choses."/>
                <para PARENT="Default Paragraph Style (2)"/>
                <para PARENT="Default Paragraph Style (2)"/>
                <para PARENT="Default Paragraph Style (2)"/>
                <tab LANGUAGE="fur"/>
                <ITEXT LANGUAGE="fur" CH="Dans ce livre, les couples avancent vite. En quelques pages, Char­lotte com­prend sa part dans le fonc­tion­ne­ment de son couple, Ma­thieu re­con­naît la de­mande ca­chée der­rière le res­tau­rant du sa­me­di, Marc trouve les mots pour dire ce qui le gêne. J'ai choi­si de ra­con­ter ces che­mins de fa­çon ac­cé­lé­rée, pour que l'on puisse en voir les étapes. Dans la réa­li­té, cha­cune de ces étapes peut prendre des se­maines, des mois, par­fois des an­nées. Je le sais parce que je suis pas­sé par elles, dans mon propre couple, et parce que je les ai vues chez les per­sonnes que j'ac­com­pagne."/>
                <para PARENT="Default Paragraph Style (2)"/>
                <para PARENT="Default Paragraph Style (2)"/>
                <para PARENT="Default Paragraph Style (2)"/>
                <tab LANGUAGE="fur"/>
                <ITEXT LANGUAGE="fur" CH="Re­gar­der chez soi est dif­fi­cile. Nous avons presque tous ten­dance à re­gar­der d'abord chez l'autre, à re­pé­rer ce qu'il fait et ce qu'il de­vrait chan­ger. C'est plus confor­table. Se de­man­der quels sont ses propres be­soins, ses propres en­vies, ce qui va bien et ce qui va mal dans sa propre fa­çon de faire, de­mande un ef­fort d'une autre na­ture."/>
                <para PARENT="Default Paragraph Style (2)"/>
                <para PARENT="Default Paragraph Style (2)"/>
                <para PARENT="Default Paragraph Style (2)"/>
                <tab LANGUAGE="fur"/>
                <ITEXT LANGUAGE="fur" CH="Cet ef­fort touche sou­vent à la honte. Prendre conscience qu'une par­tie de soi n'est pas nour­rie, que l'on a be­soin de quelque chose et qu'on ne l'a ja­mais de­man­dé, peut faire naître de la honte : honte d'avoir des be­soins, honte de ne pas les avoir vus plus tôt, honte de de­voir les dire. Oser en par­ler à l'autre ajoute en­core une dif­fi­cul­té. Je crois que beau­coup de si­lences dans les couples tiennent à ce­la."/>
                <para PARENT="Default Paragraph Style (2)"/>
                <para PARENT="Default Paragraph Style (2)"/>
                <para PARENT="Default Paragraph Style (2)"/>
                <para PARENT="Default Paragraph Style (2)"/>
                <tab LANGUAGE="fur"/>
                <ITEXT LANGUAGE="fur" CH="D'autres choses entrent en jeu, plus an­ciennes que le couple lui-même. La théo­rie de l'at­ta­che­ment, née des tra­vaux du psy­chiatre John Bowl­by, dé­crit la fa­çon dont nous avons ap­pris, en­fants, à nous re­lier aux autres. Cer­tains d'entre nous ont dé­ve­lop­pé un at­ta­che­ment plu­tôt an­xieux. Pour eux, la peur du re­jet, la peur de l'aban­don ou la peur d'être ju­gé peuvent rendre très dif­fi­cile une conver­sa­tion où l'on prend le risque d'un re­fus. D'autres sup­portent mal l'in­sé­cu­ri­té ou le conflit, et pré­fèrent gar­der un ac­cord in­con­for­table plu­tôt que d'ou­vrir une dis­cus­sion qui pour­rait mal tour­ner. Ces peurs ne dis­pa­raissent pas à la lec­ture d'un livre."/>
                <para PARENT="Default Paragraph Style (2)"/>
                <para PARENT="Default Paragraph Style (2)"/>
                <tab LANGUAGE="fur"/>
                <ITEXT LANGUAGE="fur" CH="Je n'ai donc pas écrit un livre qui per­met­trait de tout ré­gler d'un coup. Lire ces pages et dé­ci­der de les ap­pli­quer telles quelles à votre couple ne suf­fi­ra sans doute pas. Nous avons vu au cha­pitre 4 que com­prendre un fonc­tion­ne­ment ne suf­fit pas à le chan­ger. Prendre conscience reste pour­tant une pre­mière étape, celle qui per­met d'al­ler ex­plo­rer le reste. Si ce livre vous a ap­por­té quelques prises de conscience, et s'il vous a don­né en­vie de re­gar­der ce qui se joue chez vous, il a rem­pli son rôle."/>
                <para PARENT="Default Paragraph Style (2)"/>
                <para PARENT="Default Paragraph Style (2)"/>
                <para PARENT="Default Paragraph Style (2)"/>
                <tab LANGUAGE="fur"/>
                <ITEXT LANGUAGE="fur" CH="Comme tout sys­tème hu­main, un couple se com­prend par plu­sieurs en­trées. Il y a la fa­çon dont les deux par­te­naires s'ajustent l'un à l'autre, dont j'ai par­lé ici. Il y a aus­si ce que cha­cun porte de son his­toire, et ce qu'il a peut-être à gué­rir ou à faire évo­luer en lui. Pour ce tra­vail-là, un ac­com­pa­gne­ment peut beau­coup ai­der, qu'il s'agisse d'un coa­ching, d'une thé­ra­pie in­di­vi­duelle ou d'une thé­ra­pie de couple. Avoir quel­qu'un à ses cô­tés per­met d'al­ler plus loin, et plus sû­re­ment, que seul face à un livre."/>
                <para PARENT="Default Paragraph Style (2)"/>
                <para PARENT="Default Paragraph Style (2)"/>
                <tab LANGUAGE="fur"/>
                <ITEXT LANGUAGE="fur" CH="J'ai l'in­ten­tion d'écrire sur ces autres en­trées : les types de per­son­na­li­té, la honte, et d'autres thèmes qui touchent di­rec­te­ment à la vie à deux. J'ai la convic­tion qu'une dif­fi­cul­té qui pa­raît énorme peut se désa­mor­cer peu à peu, en re­gar­dant plu­sieurs de ses as­pects et en avan­çant par pe­tits mor­ceaux, d'un cô­té puis de l'autre. C'est sou­vent ain­si qu'un chan­ge­ment de­vient du­rable."/>
                <para PARENT="Default Paragraph Style (2)"/>
                <para PARENT="Default Paragraph Style (2)"/>
            </StoryText>
        </PAGEOBJECT>
