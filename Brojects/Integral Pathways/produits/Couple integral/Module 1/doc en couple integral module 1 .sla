        <PAGEOBJECT XPOS="564.540452930109" YPOS="11776.0888941537" OwnPage="36" ItemID="444965360" PTYPE="2" WIDTH="312.309734513274" HEIGHT="230.424778761062" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="0.6" LOCALSCY="0.6" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" Pagenumber="0" PFILE="../../../../../../Users/Pascal/Downloads/besoinchap2.png" PRFILE="Embedded sRGB built-in" IRENDER="0" EPROF="Embedded sRGB built-in" path="M0 0 L312.31 0 L312.31 230.425 L0 230.425 L0 0 Z" copath="M0 0 L312.31 0 L312.31 230.425 L0 230.425 L0 0 Z" gXpos="564.540452930109" gYpos="11776.0888941537" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1"/>
