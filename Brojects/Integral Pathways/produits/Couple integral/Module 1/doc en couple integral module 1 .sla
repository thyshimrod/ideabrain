        <PAGEOBJECT XPOS="141.102992125985" YPOS="26106.8185325065" OwnPage="81" ItemID="274197680" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5193199080121" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="468780976"/>
        <PAGEOBJECT XPOS="560.630551181103" YPOS="26106.8185325065" OwnPage="82" ItemID="274186352" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5193199080121" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Sui­vi — 7 jours"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para ALIGN="3"/>
                <ITEXT CH="Chaque soir, 2 mi­nutes."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para ALIGN="3"/>
                <para ALIGN="3"/>
                <para ALIGN="3"/>
                <para ALIGN="3"/>
                <para ALIGN="3"/>
                <para ALIGN="3"/>
                <para ALIGN="3"/>
                <para ALIGN="3"/>
                <para ALIGN="3"/>
                <para ALIGN="3"/>
                <para ALIGN="3"/>
                <para ALIGN="3"/>
                <ITEXT CH="La ques­tion du soir :"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Lun­di : Au­jour­d'hui, qu'est-ce que l'ar­gent a re­pré­sen­té dans mes in­ter­ac­tions — au-de­là des chiffres ?"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Mar­di : Quand j'ai dé­pen­sé ou sur­veillé, qu'est-ce que je cher­chais vrai­ment ?"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Mer­cre­di : À quel mo­ment j'ai uti­li­sé l'ar­gent pour dire quelque chose que je n'ai pas dit avec des mots ?"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Jeu­di : Qu'est-ce que j'au­rais eu be­soin de de­man­der — ou d'of­frir — à la place ?"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ven­dre­di : Com­ment j'ai nour­ri mon En­fant Libre au­jour­d'hui — et qu'est-ce que ça a chan­gé dans ma re­la­tion à l'ar­gent ?"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Sa­me­di : Quelle croyance sur l'autre est-ce que cette scène est ve­nue confir­mer cette se­maine ?"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Di­manche : Si l'ar­gent n'était plus un ter­rain de pou­voir entre nous — à quoi res­sem­ble­rait cette conver­sa­tion ?"/>
                <trail PARENT="BODY" ALIGN="3"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="560.630551181103" YPOS="26742.093808097" OwnPage="84" ItemID="274211840" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5190049473811" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <ITEXT CH="Scène 5 — Les devoirs"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <ITEXT CH="&quot;Le mauvais parent&quot;"/>
                <trail PARENT="Titre" ALIGN="1"/>
            </StoryText>
            <PageItemAttributes>
                <ItemAttribute Name="tdm" Type="string" Value="Scène 5 — Les devoirs" Parameter="" Relationship="none" RelationshipTo="" AutoAddTo="none"/>
            </PageItemAttributes>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="141.102992125985" YPOS="26742.093808097" OwnPage="83" ItemID="274200512" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5190049473811" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Ver­sion duo — échange en 2 temps"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="À faire hors de tout dé­pas­se­ment ré­cent — au calme, 20 mi­nutes."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Temps 1 — Ce que l'ar­gent re­pré­sente (10 mi­nutes)"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Cha­cun com­plète ces phrases sé­pa­ré­ment, par écrit :"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="&quot;Dans notre couple, l'ar­gent re­pré­sente pour moi...&quot; &quot;Ce dont j'ai be­soin pour me sen­tir libre / en sé­cu­ri­té fi­nan­ciè­re­ment, c'est...&quot; &quot;Ce que je ne me suis ja­mais au­to­ri­sé — et que j'ai­me­rais pou­voir m'ac­cor­der — c'est...&quot;"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Puis on par­tage — cha­cun lit, l'autre écoute sans in­ter­rompre. L'ob­jec­tif n'est pas de se convaincre. C'est d'en­tendre ce que l'ar­gent re­pré­sente vrai­ment pour l'autre — au-de­là des chiffres."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Temps 2 — Un cadre qui res­pecte les deux (10 mi­nutes)"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Une seule ques­tion à ex­plo­rer en­semble :"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="&quot;Com­ment est-ce qu'on construit quelque chose qui te donne de la sé­cu­ri­té et qui me donne de la li­ber­té — en même temps ?&quot;"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Pas une règle im­po­sée. Une pro­po­si­tion construite à deux — qu'on peut ajus­ter, tes­ter, ré­vi­ser."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="La scène sui­vante entre dans un ter­rain plus dé­li­cat en­core — ce­lui de l'édu­ca­tion. Deux pa­rents, un en­fant qui ré­siste, et deux fa­çons d'ai­mer qui ne se parlent pas."/>
                <trail PARENT="scene_page_subtitle" ALIGN="1"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="560.630551181103" YPOS="27377.3690836876" OwnPage="86" ItemID="274214672" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5186899867502" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="La scène"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="DIALOGUE" ALIGN="3"/>
                <ITEXT CH="Sa­lon, 18h30. L'en­fant est à table avec ses de­voirs. Elle est à cô­té de lui, ten­due. Il rentre, pose ses af­faires."/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="DIALOGUE" ALIGN="3"/>
                <ITEXT CH="Elle : &quot;Il a en­core re­fu­sé de faire ses de­voirs. Ça fait une heure que je lutte.&quot;"/>
                <para PARENT="DIALOGUE" ALIGN="3"/>
                <ITEXT CH="Lui : &quot;Al­lez, on y va.&quot; (à l'en­fant, ton ferme) &quot;Tu poses ta ta­blette et tu t'y mets main­te­nant.&quot;"/>
                <para PARENT="DIALOGUE" ALIGN="3"/>
                <para PARENT="DIALOGUE" ALIGN="3"/>
                <ITEXT CH="L'en­fant s'exé­cute, bou­deur. Elle at­tend que l'en­fant soit hors de por­tée."/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="DIALOGUE" ALIGN="3"/>
                <ITEXT CH="Elle : &quot;Tu dé­barques et tu prends le des­sus comme ça — de­vant lui.&quot;"/>
                <para PARENT="DIALOGUE" ALIGN="3"/>
                <ITEXT CH="Lui : &quot;Il ne fai­sait rien. Tu étais en train de né­go­cier de­puis une heure.&quot;"/>
                <para PARENT="DIALOGUE" ALIGN="3"/>
                <ITEXT CH="Elle : &quot;Je ne né­go­cie pas. J'es­saie de com­prendre ce qui bloque.&quot;"/>
                <para PARENT="DIALOGUE" ALIGN="3"/>
                <ITEXT CH="Lui : &quot;Ce qui bloque, c'est qu'il n'y a pas de li­mite claire. Si tu poses la li­mite, il la res­pecte.&quot;"/>
                <para PARENT="DIALOGUE" ALIGN="3"/>
                <ITEXT CH="Elle : &quot;Et toi tu crois que l'au­to­ri­té froide, ça construit quoi ?&quot;"/>
                <para PARENT="DIALOGUE" ALIGN="3"/>
                <para PARENT="DIALOGUE" ALIGN="3"/>
                <ITEXT CH="Si­lence. L'en­fant re­vient cher­cher son ca­hier. Ils se taisent. Sou­rires de fa­çade."/>
                <para PARENT="narration" ALIGN="3"/>
                <ITEXT CH="Plus tard, une fois l'en­fant cou­ché :"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="DIALOGUE" ALIGN="3"/>
                <ITEXT CH="Lui : &quot;Je vou­lais juste t'ai­der.&quot;"/>
                <para PARENT="DIALOGUE" ALIGN="3"/>
                <ITEXT CH="Elle : &quot;Ce n'est pas comme ça que tu m'aides.&quot;"/>
                <para PARENT="DIALOGUE" ALIGN="3"/>
                <para PARENT="DIALOGUE" ALIGN="3"/>
                <para PARENT="DIALOGUE" ALIGN="3"/>
                <ITEXT CH="Tu te re­con­nais ?"/>
                <para PARENT="DIALOGUE" ALIGN="3"/>
                <ITEXT CH="Cette scène, je la vis : ja­mais · par­fois · sou­vent"/>
                <para PARENT="DIALOGUE" ALIGN="3"/>
                <para PARENT="DIALOGUE" ALIGN="3"/>
                <ITEXT CH="Dans cette scène, tu res­sembles plu­tôt à : ce­lui qui pose la li­mite · ce­lui qui cherche à com­prendre · les deux se­lon les mo­ments"/>
                <trail PARENT="DIALOGUE" ALIGN="3"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="141.102992125985" YPOS="27377.3690836876" OwnPage="85" ItemID="274203344" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5186899867502" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <trail/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="560.630551181103" YPOS="28012.6443592781" OwnPage="88" ItemID="274206176" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5183750261193" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="274217504"/>
        <PAGEOBJECT XPOS="141.102992125985" YPOS="28012.6443592781" OwnPage="87" ItemID="274217504" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5183750261193" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="274206176" BACKITEM="-1">
            <StoryText>
                <DefaultStyle LINESP="17"/>
                <ITEXT CH="Avant l'ana­lyse — une chose im­por­tante"/>
                <para PARENT="scene_page_subtitle" ALIGN="3" LINESP="17"/>
                <para PARENT="BODY" ALIGN="3" LINESP="17"/>
                <ITEXT CH="Si tu te re­con­nais dans cette scène, tu connais pro­ba­ble­ment ce que ça fait de te­nir un cap — et de le voir contour­né en trente se­condes."/>
                <para PARENT="BODY" ALIGN="3" LINESP="17"/>
                <para PARENT="BODY" ALIGN="3" LINESP="17"/>
                <ITEXT CH="Tu connais ce que c'est d'avoir ré­flé­chi à ta fa­çon de faire. Pas im­pro­vi­ser — choi­sir. Choi­sir de ne pas crier, de cher­cher ce qui bloque, d'es­sayer de com­prendre l'en­fant plu­tôt que de le for­cer. Et voir quel­qu'un ar­ri­ver, sans contexte, sans le che­min par­cou­ru, et ré­soudre la si­tua­tion à l'an­cienne — avec la fer­me­té qu'on avait pré­ci­sé­ment dé­ci­dé de mettre de cô­té. Et que ça marche. C'est ça, le plus dif­fi­cile à ava­ler."/>
                <para PARENT="BODY" ALIGN="3" LINESP="17"/>
                <para PARENT="BODY" ALIGN="3" LINESP="17"/>
                <ITEXT CH="Et tu connais peut-être aus­si l'autre cô­té : ren­trer dans une si­tua­tion ten­due, voir quel­qu'un qu'on aime épui­sé, un en­fant qui ré­siste, et sen­tir mon­ter ce ré­flexe — je peux ar­ran­ger ça. Vite. Sim­ple­ment. Avec ce qu'on connaît. Pas par mé­pris de ce que l'autre fai­sait — par en­vie sin­cère que ça s'ar­rête. Pour tout le monde. Y com­pris pour soi."/>
                <para PARENT="BODY" ALIGN="3" LINESP="17"/>
                <para PARENT="BODY" ALIGN="3" LINESP="17"/>
                <ITEXT CH="Ces deux po­si­tions sont hon­nêtes. Elles sont aus­si toutes les deux in­com­plètes."/>
                <para PARENT="BODY" ALIGN="3" LINESP="17"/>
                <para PARENT="BODY" ALIGN="3" LINESP="17"/>
                <ITEXT CH="Ce que ce book­let va te pro­po­ser, c'est de re­gar­der non pas qui a la meilleure mé­thode — cette ques­tion-là n'a pas de ré­ponse dans le mo­ment de ten­sion — mais ce que cha­cun ac­ti­vait vrai­ment dans cette scène, au-de­là de l'édu­ca­tion. Parce que c'est là que quelque chose peut chan­ger."/>
                <para PARENT="BODY" ALIGN="3" LINESP="17"/>
                <para PARENT="BODY" ALIGN="3" LINESP="17"/>
                <para PARENT="BODY" ALIGN="3" LINESP="17"/>
                <ITEXT CH="Ce qui se passe vrai­ment"/>
                <para PARENT="scene_page_subtitle" ALIGN="3" LINESP="17"/>
                <para PARENT="scene_page_subtitle" ALIGN="3" LINESP="17"/>
                <ITEXT CH="En sur­face, c'est une di­ver­gence sur com­ment faire faire les de­voirs. Ce qui se passe vrai­ment est beau­coup plus char­gé — et beau­coup plus an­cien."/>
                <para PARENT="BODY" ALIGN="3" LINESP="17"/>
                <para PARENT="BODY" ALIGN="3" LINESP="17"/>
                <ITEXT CH="Quand deux pa­rents s'af­frontent sur l'édu­ca­tion, ils dé­battent ra­re­ment de pé­da­go­gie. Ils dé­battent de ce qu'est un bon pa­rent. Et der­rière cette ques­tion-là, il y en a une autre, plus pro­fonde, que per­sonne ne for­mule : est-ce que je suis un bon pa­rent ? Et der­rière celle-là en­core : est-ce que je vaux quelque chose dans ce rôle qui compte plus que tout ?"/>
                <para PARENT="BODY" ALIGN="3" LINESP="17"/>
                <para PARENT="BODY" ALIGN="3" LINESP="17"/>
                <ITEXT CH="C'est pour ça que ces dis­putes-là blessent au­tant. Ce n'est pas le désac­cord sur les de­voirs qui fait mal. C'est l'im­pli­ca­tion im­pli­cite — ta fa­çon de faire est mau­vaise — qui touche quelque chose d'iden­ti­taire. Et quelque chose, sou­vent, de très an­cien."/>
                <para PARENT="BODY" ALIGN="3" LINESP="17"/>
                <para PARENT="BODY" ALIGN="3" LINESP="17"/>
                <para PARENT="BODY" ALIGN="3" LINESP="17"/>
                <ITEXT CH="Ce qui vient de plus loin"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3" LINESP="17"/>
                <ITEXT CH="Cha­cun ar­rive dans la pa­ren­ta­li­té avec une his­toire. Avec des images in­té­rio­ri­sées de ce qu'est un pa­rent — com­ment il pose les li­mites, com­ment il console, com­ment il exige, com­ment il est pré­sent. Ces images viennent de l'en­fance. Elles ne sont pas choi­sies. Elles sont là, ac­tives, sou­vent sans qu'on le sache."/>
                <para PARENT="BODY" ALIGN="3" LINESP="17"/>
                <para PARENT="BODY" ALIGN="3" LINESP="17"/>
                <ITEXT CH="Lui a peut-être gran­di dans un en­vi­ron­ne­ment où les règles claires étaient sy­no­nymes de sé­cu­ri­té. Où l'au­to­ri­té était de l'amour — pas de la froi­deur. Quand il pose la li­mite, il ne pense pas &quot;je prends le pou­voir.&quot; Il pense &quot;je pro­tège.&quot;"/>
                <para PARENT="BODY" ALIGN="3" LINESP="17"/>
                <para PARENT="BODY" ALIGN="3" LINESP="17"/>
                <ITEXT CH="Elle a peut-être gran­di dans un en­vi­ron­ne­ment où l'au­to­ri­té était ar­bi­traire, ou ab­sente, ou bles­sante. Où com­prendre ce qui se pas­sait pour l'en­fant était ce qui man­quait. Quand elle cherche ce qui bloque, elle ne pense pas &quot;je né­go­cie.&quot; Elle pense &quot;je vois.&quot;"/>
                <para PARENT="BODY" ALIGN="3" LINESP="17"/>
                <para PARENT="BODY" ALIGN="3" LINESP="17"/>
                <ITEXT CH="Ni l'un ni l'autre n'a tort. Ils re­pro­duisent — sou­vent sans le sa­voir — ce qu'ils ont re­çu, ou ce qu'ils au­raient vou­lu re­ce­voir. Et quand leurs deux his­toires se per­cutent sur le ter­rain des de­voirs d'un en­fant, c'est beau­coup plus que des de­voirs qui sont en jeu. jeu­ré­sence :"/>
                <trail PARENT="BODY" ALIGN="3" LINESP="17"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="141.102992125985" YPOS="28647.9196348687" OwnPage="89" ItemID="274220336" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5180600654883" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="274209008" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Les états du moi en pré­sence :"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ce qui est frap­pant : les deux opèrent de­puis le "/>
                <ITEXT FONT="Times New Roman Bold" CH="Pa­rent"/>
                <ITEXT CH=" — lui de­puis le "/>
                <ITEXT FONT="Times New Roman Bold" CH="Nor­ma­tif"/>
                <ITEXT CH=", elle de­puis le "/>
                <ITEXT FONT="Times New Roman Bold" CH="Nour­ri­cier"/>
                <ITEXT CH=". Deux formes d'amour pa­ren­tal. Deux fa­çons d'être un bon pa­rent. In­com­pa­tibles dans le mo­ment, pas dans le fond."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT FONT="Times New Roman Bold" CH="L'Adulte"/>
                <ITEXT CH=" est ab­sent des deux cô­tés. Il ne peut pas être là parce que la scène n'est plus sur les de­voirs. Elle est sur qui a rai­son d'ai­mer l'en­fant comme il l'aime."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Les po­si­tions de vie en pré­sence"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="En Ana­lyse Tran­sac­tion­nelle, une po­si­tion de vie est la convic­tion pro­fonde qu'on porte sur soi et sur l'autre — construite tôt, ra­re­ment consciente, tou­jours ac­tive dans les mo­ments de ten­sion."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Lui opère de­puis quelque chose qui res­semble à &quot;je suis OK — ce que tu fais ne l'est pas.&quot; Pas par mé­pris — par convic­tion que sa fa­çon est la bonne. C'est une po­si­tion de su­pé­rio­ri­té im­pli­cite qui trans­pa­raît dans l'in­ter­ven­tion non sol­li­ci­tée, dans &quot;si tu poses la li­mite, il la res­pecte.&quot;"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Elle glisse vers quelque chose qui res­semble à &quot;je fais de mon mieux — et tu viens me mon­trer que ce n'est pas as­sez.&quot; Une po­si­tion qui mêle la lé­gi­ti­mi­té de son ap­proche et la bles­sure d'être dis­cré­di­tée de­vant l'en­fant."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ces po­si­tions ne sont pas fi­gées. Elles bougent dans la scène — il glisse en &quot;je ne suis pas OK&quot; quand il dit &quot;je vou­lais juste t'ai­der&quot;, elle re­prend de la hau­teur quand elle chal­lenge son au­to­ri­té froide. Mais leur col­li­sion suf­fit à rendre la conver­sa­tion im­pos­sible."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Le tri­angle de Karp­man — le drame en trois actes"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="C'est ici que la scène ré­vèle toute sa mé­ca­nique. Ce qui est par­ti­cu­liè­re­ment sai­sis­sant dans cette confi­gu­ra­tion, c'est la vi­tesse à la­quelle les rôles bas­culent."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT FONT="Times New Roman Bold" CH="Acte 1 "/>
                <ITEXT CH="— avant qu'il rentre. Elle lutte de­puis une heure. Elle est épui­sée, dé­pas­sée, seule face à la ré­sis­tance de l'en­fant. Elle est en "/>
                <ITEXT FONT="Times New Roman Bold" CH="Vic­time"/>
                <ITEXT CH=" — pas au sens faible du terme, mais au sens tech­nique : elle su­bit une si­tua­tion qu'elle ne contrôle plus, et qu'elle porte seule."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT FONT="Times New Roman Bold" CH="Acte 2"/>
                <ITEXT CH=" — il rentre et in­ter­vient. Il voit la scène. Son ré­flexe est im­mé­diat — il entre en "/>
                <ITEXT FONT="Times New Roman Bold" CH="Sau­veur"/>
                <ITEXT CH=". Il prend le des­sus, pose la li­mite, ob­tient le ré­sul­tat. L'en­fant obéit. Lui a ré­pa­ré ce qui sem­blait cas­sé."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Mais quelque chose bas­cule alors. En de­ve­nant "/>
                <ITEXT FONT="Times New Roman Bold" CH="Sau­veur"/>
                <ITEXT CH=" de la si­tua­tion, il de­vient im­pli­ci­te­ment "/>
                <ITEXT FONT="Times New Roman Bold" CH="Per­sé­cu­teur"/>
                <ITEXT CH=" d'elle — il a court-cir­cui­té son au­to­ri­té, de­vant l'en­fant, sans lui de­man­der. Ce qu'il a vé­cu comme un sau­ve­tage, elle l'a vé­cu comme une hu­mi­lia­tion."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT FONT="Times New Roman Bold" CH="Acte 3"/>
                <ITEXT CH=" — le coup de théâtre. Elle contre-at­taque : &quot;tu dé­barques et tu prends le des­sus comme ça.&quot; Elle passe en "/>
                <ITEXT FONT="Times New Roman Bold" CH="Per­sé­cu­teur"/>
                <ITEXT CH=". Lui bas­cule en "/>
                <ITEXT FONT="Times New Roman Bold" CH="Vic­time"/>
                <ITEXT CH=" — il a es­sayé d'ai­der, il est cri­ti­qué pour ça. Et plus tard, &quot;je vou­lais juste t'ai­der&quot; dit exac­te­ment cette po­si­tion : je suis la vic­time de ta ré­ac­tion à mon aide."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Elle, qui était "/>
                <ITEXT FONT="Times New Roman Bold" CH="Vic­time"/>
                <ITEXT CH=" au dé­but, se re­trouve à la fin dans la po­si­tion in­con­for­table de celle qui a bles­sé quel­qu'un qui vou­lait bien faire. Le sen­ti­ment de culpa­bi­li­té est là, même s'il n'est pas nom­mé."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT FONT="Times New Roman Bold" CH="Vic­time"/>
                <ITEXT CH=" (elle) → "/>
                <ITEXT FONT="Times New Roman Bold" CH="Sau­veur"/>
                <ITEXT CH=" (lui) → "/>
                <ITEXT FONT="Times New Roman Bold" CH="Per­sé­cu­teur"/>
                <ITEXT CH=" im­pli­cite (lui) → "/>
                <ITEXT FONT="Times New Roman Bold" CH="Vic­time"/>
                <ITEXT CH=" (elle dis­cré­di­tée) → "/>
                <ITEXT FONT="Times New Roman Bold" CH="Per­sé­cu­teur"/>
                <ITEXT CH=" (elle qui at­taque) → "/>
                <ITEXT FONT="Times New Roman Bold" CH="Vic­time"/>
                <ITEXT CH=" (lui in­com­pris) → culpa­bi­li­té dif­fuse des deux cô­tés"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Le bé­né­fice ca­ché du drame"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ce tri­angle dure parce qu'il pro­tège quelque chose — chez cha­cun, dif­fé­rem­ment."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Pour lui : ob­te­nir un ré­sul­tat ra­pide évite d'avoir à en­trer dans ce qui se jouait de­puis une heure. Si ça fonc­tionne, c'est que c'était la bonne fa­çon. Et être ce­lui qui ré­sout dit quelque chose de ras­su­rant sur sa place dans ce foyer — il est utile, il compte."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Pour elle : nom­mer ce qui vient de se pas­ser pro­tège le sens de ce qu'elle construit. Lais­ser pas­ser sans rien dire, ce se­rait lais­ser in­va­li­der si­len­cieu­se­ment tout un che­min. La cri­tique n'est pas que de la co­lère — c'est une fa­çon de dire ce que je fais a une va­leur, même si tu ne l'as pas vu."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Les deux pro­tègent quelque chose de lé­gi­time. Et au­cun des deux ne pro­tège ce qui en au­rait le plus be­soin — l'es­pace entre eux, de­puis le­quel une vraie conver­sa­tion sur l'édu­ca­tion pour­rait avoir lieu."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Le jeu &quot;Tri­bu­nal&quot; — qui est le meilleur pa­rent ?"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ce que Berne ap­pelle &quot;Tri­bu­nal&quot; n'est pas un jeu de cruau­té. C'est un jeu de lé­gi­ti­mi­té — sou­vent in­cons­cient, tou­jours ré­vé­la­teur de ce qui n'a pas pu se dire au­tre­ment."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="La struc­ture : une dé­ci­sion est prise, contre­dite, ou ju­gée. L'un se pose en ac­cu­sa­teur — &quot;tu né­go­ciais de­puis une heure&quot; — et l'autre en dé­fen­deur — &quot;je ne né­go­cie pas, j'es­saie de com­prendre.&quot; Le vrai en­jeu n'est pas la dé­ci­sion. C'est le ver­dict : qui a rai­son d'être le pa­rent qu'il est ?"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ce jeu a un bé­né­fice se­con­daire pré­cis. Pour lui : in­ter­ve­nir et ob­te­nir un ré­sul­tat ra­pide confirme que son ap­proche fonc­tionne. Pour elle : ré­sis­ter à son in­ter­ven­tion et poin­ter ses li­mites confirme qu'elle voit ce qu'il ne voit pas."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Les deux cherchent la même chose — être re­con­nus comme com­pé­tents, ai­mants, suf­fi­sants. Et ils le cherchent en s'op­po­sant. Ce n'est pas ra­tion­nel. C'est hu­main."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="L'alerte à ne pas "/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <ITEXT CH="man­quer"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <ITEXT CH="La sor­tie de ce jeu n'est pas de s'ali­gner sur une seule mé­thode — ou de dé­ci­der qui a rai­son entre la li­mite et la com­pré­hen­sion."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Les deux ap­proches ont une va­leur. Le pro­blème n'est pas la mé­thode — c'est la dés­union."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="La vraie ques­tion pour lui : &quot;"/>
                <ITEXT FONT="Times New Roman Italic" CH="qu'est-ce que ça ac­tive en moi de voir cette scène en ren­trant — et pour­quoi j'in­ter­viens avant même de de­man­der ce qui se passe ?"/>
                <ITEXT CH="&quot;"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="La vraie ques­tion pour elle : &quot;"/>
                <ITEXT FONT="Times New Roman Italic" CH="qu'est-ce que je construis vrai­ment — et com­ment est-ce que je le rends vi­sible à l'autre, au­tre­ment que dans le mo­ment de ten­sion ?"/>
                <ITEXT CH="&quot;"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="560.630551181103" YPOS="28647.9196348687" OwnPage="90" ItemID="274209008" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5180600654883" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="274234496" BACKITEM="274220336"/>
        <PAGEOBJECT XPOS="560.630551181103" YPOS="29283.1949104592" OwnPage="92" ItemID="274231664" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5177451048574" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="274234496"/>
        <PAGEOBJECT XPOS="141.102992125985" YPOS="29283.1949104592" OwnPage="91" ItemID="274234496" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5177451048574" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="274231664" BACKITEM="274209008"/>
        <PAGEOBJECT XPOS="141.102992125985" YPOS="29918.4701860498" OwnPage="93" ItemID="274228832" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5174301442265" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="274226000" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Ce dont on a vrai­ment be­soin — l'angle CNV"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Dans cette scène, les deux pro­ta­go­nistes ne vivent pas la même chose — et ils n'ont pas les mêmes be­soins. Ce qui suit pro­pose deux lec­tures sé­pa­rées. Pas pour dé­si­gner qui a rai­son sur la mé­thode. Pour per­mettre à cha­cun de se re­con­naître dans ce qui est ac­ti­vé en lui — et de trou­ver sa propre porte de sor­tie."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="La même règle s'ap­plique dans les deux cas : un be­soin m'ap­par­tient. Il ne dé­pend pas de ce que l'autre fait ou ne fait pas. Je suis res­pon­sable de trou­ver com­ment le nour­rir — pas d'at­tendre que l'autre le de­vine."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Si tu es ce­lui ou celle dont les ef­forts ont été court-cir­cui­tés"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ce que tu ex­primes à tra­vers la ré­sis­tance et la cri­tique n'est pas de l'en­tê­te­ment. C'est une in­for­ma­tion sur ce qui compte pro­fon­dé­ment pour toi — et sur ce qui dis­pa­raît sans lais­ser de trace quand le ré­sul­tat ef­face le che­min."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Lis cette liste. Coche ce qui ré­sonne vrai­ment."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Une fois ton be­soin iden­ti­fié, com­plète cette phrase :"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="&quot;J'ai be­soin de ______. Quand je me re­con­necte à ce be­soin, ce que je choi­sis de faire c'est ______.&quot;"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Quelques exemples :"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="&quot;J'ai be­soin de sens. Ce que je choi­sis de faire c'est conti­nuer mon ap­proche — même sans ré­sul­tat im­mé­diat — et ob­ser­ver ce qu'elle construit sur la du­rée, pas seule­ment ce soir.&quot;_"/>
                <para PARENT="narration" ALIGN="3"/>
                <para ALIGN="3"/>
                <ITEXT CH="&quot;J'ai be­soin d'in­té­gri­té. Ce que je choi­sis de faire c'est res­ter dans ce que je crois juste pour cet en­fant — et trou­ver un mo­ment au calme pour par­ta­ger ce che­min avec l'autre, pas l'im­po­ser, juste le rendre vi­sible.&quot;"/>
                <para PARENT="narration" ALIGN="3"/>
                <para ALIGN="3"/>
                <ITEXT CH="&quot;J'ai be­soin de crois­sance. Ce que je choi­sis de faire c'est nom­mer, pour moi d'abord, ce que je veux trans­mettre — et ce que je ne veux pas re­pro­duire. Pas comme un re­proche à l'autre. Comme une bous­sole pour moi.&quot;"/>
                <para PARENT="narration" ALIGN="3"/>
                <para ALIGN="3"/>
                <para ALIGN="3"/>
                <ITEXT CH="Si tu es ce­lui ou celle qui est in­ter­ve­nu"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ce que tu as fait n'était pas du mé­pris. C'était un ré­flexe — ra­pide, ef­fi­cace, hé­ri­té. Mais un ré­flexe n'est pas un choix. Et la ques­tion qui mé­rite d'être po­sée n'est pas &quot;est-ce que ça a fonc­tion­né ?&quot; C'est &quot;qu'est-ce qui s'est ac­ti­vé en moi — et qu'est-ce que ça dit de ce dont j'ai vrai­ment be­soin ?&quot;"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Lis cette liste. Coche ce qui ré­sonne vrai­ment."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Une fois ton be­soin iden­ti­fié, com­plète cette phrase :"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="&quot;J'ai be­soin de ______. Quand je me re­con­necte à ce be­soin, ce que je choi­sis de faire c'est ______.&quot;"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Quelques exemples :"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="&quot;J'ai be­soin de paix in­té­rieure. Ce que je choi­sis de faire c'est m'ac­cor­der un mo­ment pour dé­com­pres­ser en ren­trant — avant d'en­trer dans ce qui se passe — pour ne pas in­ter­ve­nir de­puis l'épui­se­ment.&quot;"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="&quot;J'ai be­soin de contri­bu­tion. Ce que je choi­sis de faire c'est de­man­der à l'autre com­ment je peux ai­der — avant d'agir. Juste ça. Deux se­condes. Avant.&quot;"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="&quot;J'ai be­soin de confiance en moi. Ce que je choi­sis de faire c'est m'in­ter­ro­ger sur ce que mes au­to­ma­tismes édu­ca­tifs portent — ce qu'ils m'ont ap­por­té, ce qu'ils re­pro­duisent — sans les dé­fendre ni les re­je­ter en bloc.&quot;"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ces deux listes parlent de la même as­pi­ra­tion — être un pa­rent qui agit de­puis ce qu'il croit vrai­ment, pas de­puis le ré­flexe ou la fa­tigue. Elles ne se ren­contrent pas dans la scène. Mais elles peuvent se ren­con­trer au calme, quand les deux ont dé­ci­dé de par­ler non pas de mé­thode — mais de ce qu'ils veulent vrai­ment construire en­semble."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para ALIGN="3"/>
                <para ALIGN="3"/>
                <para ALIGN="3"/>
                <para ALIGN="3"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="560.630551181103" YPOS="29918.4701860498" OwnPage="94" ItemID="274226000" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5174301442265" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="274237328" BACKITEM="274228832"/>
        <PAGEOBJECT XPOS="560.630551181103" YPOS="30553.7454616403" OwnPage="96" ItemID="274223168" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5171151835955" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Nour­rir ton En­fant Libre"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Il y a quelque chose qui opère en fond dans cette scène — et qui mé­rite d'être nom­mé."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Les deux ar­rivent dans ce mo­ment de­puis leur Pa­rent. Lui de­puis le Nor­ma­tif — la règle, la li­mite, l'ef­fi­ca­ci­té. Elle de­puis le Nour­ri­cier — la com­pré­hen­sion, le soin, la pa­tience. Deux formes d'amour sé­rieux. Deux fa­çons d'être là pour cet en­fant qui coûtent beau­coup — et qui laissent peu de place à autre chose."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ce qu'on voit ra­re­ment de­puis l'in­té­rieur : la ten­sion qui monte dans ces mo­ments n'est pas seule­ment le pro­duit de l'in­ter­ac­tion. Elle est aus­si ce qu'on y ap­porte. Quand on est très fo­ca­li­sé sur bien faire — sur le ré­sul­tat, sur la mé­thode, sur ce qui est juste — on ar­rive dans la re­la­tion avec peu de res­pi­ra­tion. Et cette ab­sence de res­pi­ra­tion se trans­met. À l'en­fant. À l'autre pa­rent. Elle nour­rit exac­te­ment ce qu'on vou­lait évi­ter."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Nour­rir son En­fant Libre n'est pas une fa­çon de moins bien faire son rôle de pa­rent. C'est une fa­çon de prendre soin de soi — pour ar­ri­ver dans la re­la­tion au­tre­ment. Pas moins exi­geant. Moins ten­du. Et cette dif­fé­rence-là, l'en­fant la sent avant même que les mots ar­rivent."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Il ne s'agit pas de chan­ger d'abord la scène des de­voirs. Il s'agit de se de­man­der ce qu'on s'est ac­cor­dé au­jour­d'hui — en de­hors du rôle de pa­rent, en de­hors du couple, en de­hors de ce qu'on doit. Un mo­ment qui n'ap­par­tient qu'à soi. Pas grand-chose. Mais quelque chose."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Parce que prendre soin de soi, c'est prendre soin de la re­la­tion. Pas à la place de l'exi­gence — à cô­té d'elle. Et sou­vent, quand on s'ac­corde cette res­pi­ra­tion-là, l'exi­gence se pose d'elle-même — sans qu'on ait rien dé­ci­dé d'autre."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="La ques­tion à se po­ser ce soir :"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Qu'est-ce que je me suis ac­cor­dé au­jour­d'hui — pas pour être utile, pas pour bien faire — juste pour moi ?"/>
                <para PARENT="narration" ALIGN="3"/>
                <ITEXT CH="Est-ce que la ten­sion que j'ai vé­cue ce soir était seule­ment dans la si­tua­tion — ou est-ce que je l'ap­por­tais dé­jà avec moi en en­trant dans la pièce ?"/>
                <trail PARENT="narration" ALIGN="3"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="141.102992125985" YPOS="30553.7454616403" OwnPage="95" ItemID="274237328" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5171151835955" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="274226000"/>
        <PAGEOBJECT XPOS="141.102992125985" YPOS="31189.0207372309" OwnPage="97" ItemID="274251488" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5168002229646" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="274240160" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Les portes de sor­tie"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ni­veau 1 — Re­pé­rer son rôle dans le tri­angle (so­lo — les deux par­te­naires)"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Une seule ques­tion, dans le mo­ment :"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Dans quel rôle suis-je là — "/>
                <ITEXT FONT="Times New Roman Bold" CH="Vic­time"/>
                <ITEXT CH=", "/>
                <ITEXT FONT="Times New Roman Bold" CH="Sau­veur"/>
                <ITEXT CH=", ou "/>
                <ITEXT FONT="Times New Roman Bold" CH="Per­sé­cu­teur"/>
                <ITEXT CH=" ?"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Si tu es "/>
                <ITEXT FONT="Times New Roman Bold" CH="Vic­time"/>
                <ITEXT CH=" : qu'est-ce que tu at­tends de l'autre — du sou­tien, une so­lu­tion ? Est-ce que tu peux le de­man­der di­rec­te­ment plu­tôt que de l'at­tendre ?"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Si tu es "/>
                <ITEXT FONT="Times New Roman Bold" CH="Sau­veur"/>
                <ITEXT CH=" : est-ce qu'on t'a de­man­dé d'in­ter­ve­nir ? Est-ce que ton in­ter­ven­tion sert l'autre — ou sert-elle d'abord ton be­soin d'être utile ?"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Si tu es "/>
                <ITEXT FONT="Times New Roman Bold" CH="Per­sé­cu­teur"/>
                <ITEXT CH=" : qu'est-ce que tu dé­fends vrai­ment — une mé­thode édu­ca­tive, ou ta lé­gi­ti­mi­té en tant que pa­rent ?"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Re­pé­rer le rôle ne le fait pas dis­pa­raître im­mé­dia­te­ment. Mais il crée un es­pace — une lé­gère dis­tance entre le ré­flexe et la ré­ac­tion — de­puis le­quel quelque chose d'autre de­vient pos­sible."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ni­veau 2 — Ob­ser­ver de­puis quel en­droit on parle (so­lo — les deux par­te­naires)"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="La pro­chaine fois que cette scène se dé­clenche, une ques­tion com­plé­men­taire :"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Est-ce que je ré­agis à l'en­fant, ou est-ce que je ré­agis à l'autre pa­rent ?"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Si l'émo­tion prin­ci­pale est de la frus­tra­tion en­vers l'en­fant — c'est une ques­tion édu­ca­tive. Si l'émo­tion prin­ci­pale est de la frus­tra­tion en­vers l'autre — c'est une ques­tion de couple dé­gui­sée en ques­tion édu­ca­tive. Les deux mé­ritent une ré­ponse. Mais pas la même."/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ni­veau 3 — Se don­ner un pro­to­cole de re­lais (duo — à construire hors ten­sion)"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="La scène du re­lais est in­évi­table dans tout couple avec en­fants. Ce qui crée le pro­blème, c'est qu'elle n'a ja­mais été dis­cu­tée. Elle s'im­pro­vise, dans le mo­ment, sous ten­sion."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Une conver­sa­tion à avoir au calme, sans en­fant :"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="&quot;Quand l'un de nous est en dif­fi­cul­té — com­ment est-ce qu'on se re­laye sans se court-cir­cui­ter ? Qu'est-ce que cha­cun a be­soin de l'autre dans ce mo­ment ?&quot;"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Pas une règle ri­gide. Un ac­cord souple — un si­gnal, une phrase, un geste qui dit &quot;j'ai be­soin d'aide&quot; ou &quot;je prends le re­lais, tu souffles.&quot; Quelque chose de choi­si en­semble, pas im­po­sé dans l'ur­gence."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ni­veau 4 — Nom­mer la di­ver­gence d'ap­proche sans en faire un ver­dict (duo)"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="&quot;Je réa­lise qu'on n'a ja­mais vrai­ment par­lé de nos ap­proches édu­ca­tives — ce qu'on veut pour lui, ce qui est im­por­tant pour cha­cun, ce qu'on a re­çu et ce qu'on veut re­pro­duire ou pas. Est-ce qu'on peut faire ça — pas pour dé­ci­der qui a rai­son, mais pour se com­prendre ?&quot;"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Cette conver­sa­tion sort les désac­cords du ter­rain de la ré­ac­tion et les pose sur le ter­rain du choix. Elle per­met à cha­cun d'en­tendre d'où vient l'autre — pas comme une me­nace, mais comme une his­toire."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <ITEXT CH="Ni­veau 5 — Nom­mer le jeu en­semble (duo)"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Quelques jours après la scène, au calme :"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="&quot;Je pe"/>
                <ITEXT FONT="Times New Roman Italic" CH="n"/>
                <ITEXT CH="se qu'on re­joue par­fois quelque chose — pas sur les de­voirs, mais sur qui est le bon pa­rent. Je bas­cule en Sau­veur sans qu'on me le de­mande, et ça te met en po­si­tion im­pos­sible. Je le vois main­te­nant. Est-ce qu'on peut en par­ler ?&quot;"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Pas une ac­cu­sa­tion. Une ob­ser­va­tion par­ta­gée de­puis l'Adulte — qui ouvre la pos­si­bi­li­té de par­ler de ce qui se passe vrai­ment."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para ALIGN="3"/>
                <para ALIGN="3"/>
                <para ALIGN="3"/>
                <para ALIGN="3"/>
                <para ALIGN="3"/>
                <para ALIGN="3"/>
                <para ALIGN="3"/>
                <para ALIGN="3"/>
                <para ALIGN="3"/>
                <para ALIGN="3"/>
                <ITEXT CH="V = Vic­time · S = Sau­veur · P = Per­sé­cu­teur"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <ITEXT CH="La ques­tion du soir :"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Lun­di : Dans quel rôle ai-je pas­sé le plus de temps au­jour­d'hui — et qu'est-ce qui m'y a conduit ?"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Mar­di : Qu'est-ce que j'ai ac­ti­vé en ren­trant ce soir — et d'où ça ve­nait ?"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Mer­cre­di : À quel mo­ment j'ai vu l'ap­proche de l'autre comme une me­nace plu­tôt que comme une dif­fé­rence ?"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Jeu­di : Qu'est-ce que mon his­toire m'a ap­pris sur ce qu'est un bon pa­rent — et est-ce que ça joue en­core ici ?"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ven­dre­di : Com­ment j'ai nour­ri mon En­fant Libre au­jour­d'hui — et qu'est-ce que ça a chan­gé dans ma pré­sence ?"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Sa­me­di : Qu'est-ce que je me suis ac­cor­dé cette se­maine — juste pour moi ?"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Di­manche : Si on était vrai­ment une équipe dans ces mo­ments — à quoi ça res­sem­ble­rait concrè­te­ment ?"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ver­sion duo — échange en 2 temps"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="À faire hors de tout épi­sode ré­cent — au calme, sans en­fant pré­sent, 20 mi­nutes."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para ALIGN="3"/>
                <ITEXT CH="Temps 1 — Nos his­toires de pa­rents (10 mi­nutes)"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Cha­cun com­plète ces phrases sé­pa­ré­ment, par écrit :"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="&quot;Ce que j'ai re­çu comme édu­ca­tion, et que je veux trans­mettre, c'est...&quot; &quot;Ce que je n'ai pas re­çu, et que j'es­saie de don­ner, c'est...&quot; &quot;Ce dont j'ai be­soin de toi dans les mo­ments dif­fi­ciles avec les en­fants, c'est...&quot;"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Puis on par­tage — cha­cun lit, l'autre écoute sans in­ter­rompre. L'ob­jec­tif n'est pas de dé­ci­der d'une mé­thode com­mune. C'est d'en­tendre d'où vient l'autre."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Temps 2 — Un ac­cord de re­lais (10 mi­nutes)"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="&quot;Com­ment est-ce qu'on se sou­tient mu­tuel­le­ment dans ces mo­ments — sans se court-cir­cui­ter ?&quot;"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Pas un pro­to­cole ri­gide. Un ac­cord souple, ré­vi­sable, qui dit : on est une équipe. Et quand l'un est épui­sé, l'autre prend le re­lais — d'une fa­çon qui res­pecte ce que l'autre a com­men­cé."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="La der­nière scène est la plus si­len­cieuse de toutes. Elle se passe dans le noir, à 23h. Et ce qui s'y joue n'a du­ré que trente se­condes."/>
                <trail PARENT="scene_page_subtitle" ALIGN="1"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="560.630551181103" YPOS="31189.0207372309" OwnPage="98" ItemID="274240160" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5168002229646" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="274245824" BACKITEM="274251488"/>
        <PAGEOBJECT XPOS="560.630551181103" YPOS="31824.2960128214" OwnPage="100" ItemID="274242992" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5164852623337" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="274245824"/>
        <PAGEOBJECT XPOS="141.102992125985" YPOS="31824.2960128214" OwnPage="99" ItemID="274245824" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5164852623337" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="274242992" BACKITEM="274240160"/>
        <PAGEOBJECT XPOS="141.102992125985" YPOS="32459.571288412" OwnPage="101" ItemID="274248656" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5161703017028" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <trail/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="560.630551181103" YPOS="32459.571288412" OwnPage="102" ItemID="222981056" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5161703017028" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <ITEXT CH="Scène 6 — La chambre"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <ITEXT CH="&quot;Pas ce soir&quot;"/>
                <trail PARENT="Titre" ALIGN="1"/>
            </StoryText>
            <PageItemAttributes>
                <ItemAttribute Name="tdm" Type="string" Value="Scène 6 — La chambre" Parameter="" Relationship="none" RelationshipTo="" AutoAddTo="none"/>
            </PageItemAttributes>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="560.630551181103" YPOS="33094.8465640025" OwnPage="104" ItemID="222978224" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5158553410718" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="222986720" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Avant la scène — quelques mots sur ce qui est vrai­ment en jeu"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Cette scène est dif­fé­rente des cinq pré­cé­dentes. Pas parce qu'elle est plus grave. Parce qu'elle est plus proche."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Les tâches mé­na­gères, l'heure de re­tour, l'ar­gent, les en­fants — ce sont des su­jets qu'on peut mettre sur la table, dé­battre, né­go­cier. Ils ont une forme ex­té­rieure. On peut poin­ter quelque chose de concret."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="La sexua­li­té dans un couple n'a pas cette forme-là. Elle touche à quelque chose qui ré­siste aux mots — le dé­sir, la vul­né­ra­bi­li­té, le be­soin d'être vou­lu. Et der­rière ces mots-là, quelque chose d'en­core plus fon­da­men­tal : est-ce que je compte pour toi ?"/>
                <ITEXT FONT="Times New Roman Italic" CH=" Est-ce que tu me vois — pas comme un co­lo­ca­taire, pas comme un pa­rent de nos en­fants, pas comme quel­qu'un avec qui je par­tage un bud­get — mais comme quel­qu'un à qui tu tiens, spé­ci­fi­que­ment, in­ti­me­ment ?"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="C'est pour ça que ce su­jet est si dif­fi­cile à abor­der. Pas parce qu'il est ta­bou — même si la pu­deur est réelle. Parce qu'il ex­pose quelque chose qu'on ne peut pas dé­fendre avec des ar­gu­ments."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Il y a aus­si une croyance ré­pan­due, ra­re­ment for­mu­lée, qui com­plique tout : la sexua­li­té, "/>
                <ITEXT FONT="Times New Roman Italic" CH="c'est ce qui nous dif­fé­ren­cie d'une ami­tié. Si elle dis­pa­raît, qu'est-ce qu'on est ?"/>
                <ITEXT CH=" Cette croyance trans­forme chaque re­fus en me­nace exis­ten­tielle pour le lien. Et chaque de­mande en test de l'état du couple."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ce n'est pas une vé­ri­té. Mais c'est une croyance très ac­tive — et elle mé­rite d'être nom­mée avant d'en­trer dans la scène."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Une der­nière chose. Ce que la plu­part des gens cherchent quand ils cherchent de l'in­ti­mi­té phy­sique n'est pas tou­jours ce qu'ils de­mandent. Der­rière le dé­sir sexuel, il y a sou­vent quelque chose de plus simple et de plus pro­fond : de la cha­leur. De la connexion. La cer­ti­tude d'exis­ter pour l'autre d'une fa­çon qui n'ap­par­tient qu'à vous deux. Le sexe peut être le che­min vers ça — ou le seul che­min qu'on connaît pour y al­ler. Mais ce n'est pas la seule route."/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="C'est de­puis cet en­droit-là que cette scène mé­rite d'être lue."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="La scène"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Chambre, 23h. Ils sont au lit. Les lu­mières sont éteintes. Il se rap­proche, pose une main sur son épaule."/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Lui : (voix basse) &quot;Tu dors ?&quot;"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Elle : &quot;Pas en­core.&quot;"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Un si­lence. Il reste proche."/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Elle : &quot;Je suis vrai­ment fa­ti­guée ce soir.&quot;"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Lui : &quot;Ouais.&quot; (il se re­tourne de son cô­té)"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Si­lence. Les deux les yeux ou­verts dans le noir."/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Elle : (après un mo­ment) &quot;Tu es fâ­ché ?&quot;"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Lui : &quot;Non. Dors bien.&quot;"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Elle se re­tourne. Le si­lence s'ins­talle — pas pai­sible. Cha­cun de son cô­té, cha­cun dans sa tête."/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Tu te re­con­nais ?"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Cette scène, je la vis : ja­mais · par­fois · sou­vent"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Dans cette scène, tu res­sembles plu­tôt à : ce­lui qui s'ap­proche · ce­lui qui dit non · les deux se­lon les mo­ments"/>
                <trail PARENT="BODY" ALIGN="3"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="141.102992125985" YPOS="33094.8465640025" OwnPage="103" ItemID="222992384" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5158553410718" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <trail/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="141.102992125985" YPOS="33730.1218395931" OwnPage="105" ItemID="222986720" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5155403804445" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="222978224"/>
        <PAGEOBJECT XPOS="560.630551181103" YPOS="33730.1218395931" OwnPage="106" ItemID="222983888" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5155403804445" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="222998048" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Avant l'ana­lyse — une chose im­por­tante"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Si tu te re­con­nais dans cette scène, tu connais pro­ba­ble­ment ce que ça fait de vou­loir quelque chose — et de ne pas sa­voir com­ment le dire."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="L'ap­proche si­len­cieuse à 23h n'est pas une de­mande. C'est une ten­ta­tive. Un geste qui es­père être com­pris sans avoir à s'ex­po­ser da­van­tage. Et cette fa­çon-là de ne pas dire — de lais­ser l'autre de­vi­ner — place l'autre dans une po­si­tion dif­fi­cile : ré­pondre à chaud, sans pré­pa­ra­tion, de­puis l'en­droit où il se trouve à ce mo­ment-là. Sou­vent épui­sé. Sou­vent dé­jà ailleurs dans sa tête."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Le re­fus qui suit n'est pas tou­jours un re­jet. C'est sou­vent la ré­ponse d'un corps qui n'a plus de res­source — pas pour ça, pas main­te­nant. Mais parce que la de­mande n'a pas été po­sée, le re­fus ne peut pas être nuan­cé non plus. Il ar­rive brut, même quand il est doux. Et dans le si­lence qui suit, cha­cun reste seul avec ce qu'il n'a pas dit."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ce qui man­quait dans cette scène n'était pas du dé­sir. C'était une conver­sa­tion — plus tôt dans la soi­rée, dans un mo­ment où les deux étaient en­core dis­po­nibles. "/>
                <ITEXT FONT="Times New Roman Italic" CH="&quot;J'au­rais en­vie qu'on ait un mo­ment en­semble ce soir.&quot;"/>
                <ITEXT CH=" Cette phrase-là ouvre quelque chose. Elle laisse à l'autre la li­ber­té de ré­pondre — pas de­puis l'obli­ga­tion ou le re­jet, mais de­puis ce qui est vrai­ment pos­sible pour lui. Peut-être pas ce qui était de­man­dé. Mais peut-être quelque chose — un câ­lin, une proxi­mi­té, un mo­ment de cha­leur qui n'exige rien mais qui dit on est en­core nous."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="L'in­ti­mi­té ne se ré­sume pas à la sexua­li­té. Et c'est sou­vent quand on croit que c'est tout ou rien qu'on fi­nit avec rien."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ce qui se passe vrai­ment"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <ITEXT CH="Ce qui s'est pas­sé dans cette scène n'a du­ré que trente se­condes. Et pour­tant les deux vont mettre du temps à trou­ver le som­meil."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Lui n'a pas de­man­dé quelque chose. Il s'est ap­pro­ché. Ce geste-là — simple, si­len­cieux, vul­né­rable — por­tait quelque chose qu'il n'au­rait pas pu for­mu­ler fa­ci­le­ment. Peut-être : j'ai en­vie de toi. j'ai en­vie d'être proche. j'ai be­soin de sen­tir qu'on est en­core nous. Peut-être quelque chose de plus simple en­core : je veux te tou­cher."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Elle a dit non — dou­ce­ment, sans bru­ta­li­té, avec une vraie fa­tigue. Elle n'a pas re­je­té lui. Elle a re­fu­sé quelque chose qu'elle n'avait pas l'éner­gie de don­ner ce soir. La nuance est réelle. Mais dans l'obs­cu­ri­té, dans le si­lence qui a sui­vi, cette nuance s'est per­due."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="&quot;"/>
                <ITEXT FONT="Times New Roman Italic" CH="Tu es fâ­ché ?"/>
                <ITEXT CH="&quot; dit qu'elle a sen­ti quelque chose. Pas de la co­lère — du re­trait. Ce re­trait-là lui a par­lé plus fort que ses mots. Et son &quot;non, dors bien&quot; — trop court, trop propre — a confir­mé ce qu'elle crai­gnait : qu'il soit bles­sé. Qu'elle ait fait quelque chose de mal en étant sim­ple­ment fa­ti­guée."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Per­sonne n'a dit ce qui se pas­sait vrai­ment. Per­sonne n'avait les mots pour ça — pas à 23h, pas dans le noir, pas sans ris­quer quelque chose."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <ITEXT CH="Un mot sur les dif­fé­rences — sans gé­né­ra­li­ser"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Il y a une réa­li­té que cette scène porte sans la nom­mer : le dé­sir ne fonc­tionne pas de la même fa­çon pour tout le monde. Et dans beau­coup de couples — pas tous, mais beau­coup — il existe un dé­ca­lage. L'un est plus sou­vent de­man­deur, l'autre plus sou­vent en re­trait. Ce n'est pas une ques­tion de manque d'amour. Ce n'est pas non plus une fa­ta­li­té."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ce dé­ca­lage vient sou­vent de choses simples et pro­fondes à la fois. La fa­tigue s'ac­cu­mule dif­fé­rem­ment. Le stress coupe le dé­sir dif­fé­rem­ment. Le be­soin de connexion s'ex­prime dif­fé­rem­ment — l'un par le corps, l'autre par les mots, le temps par­ta­gé, la ten­dresse quo­ti­dienne. Ce que l'un lit comme un si­gnal d'in­ti­mi­té — il s'ap­proche, il veut de moi — l'autre le lit par­fois comme une pres­sion — en­core une de­mande que je n'ai pas l'éner­gie d'ho­no­rer."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ces dif­fé­rences ne sont pas des dé­fauts. Elles sont des lan­gages qui ne se sont pas en­core trou­vé de tra­duc­teur com­mun."/>
                <trail PARENT="BODY" ALIGN="3"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="141.102992125985" YPOS="34365.3971151836" OwnPage="107" ItemID="222998048" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5152254198172" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="222983888"/>
        <PAGEOBJECT XPOS="560.630551181103" YPOS="34365.3971151836" OwnPage="108" ItemID="223000880" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5152254198172" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="222995216" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Les états du moi en pré­sence :"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ce qui est frap­pant ici : les deux dé­marrent de­puis l'"/>
                <ITEXT FONT="Times New Roman Bold" CH="En­fant Libre"/>
                <ITEXT CH=" — spon­ta­né, ou­vert, sans cal­cul. Et c'est l'"/>
                <ITEXT FONT="Times New Roman Bold" CH="En­fant Bles­sé"/>
                <ITEXT CH=" qui prend le des­sus, des deux cô­tés, dans le si­lence qui suit. "/>
                <ITEXT FONT="Times New Roman Bold" CH="L'Adulte"/>
                <ITEXT CH=" — ce­lui qui pour­rait dire &quot;"/>
                <ITEXT FONT="Times New Roman Italic" CH="je t'ai sen­ti te re­ti­rer et j'ai eu peur que tu sois bles­sé"/>
                <ITEXT CH="&quot; ou &quot;"/>
                <ITEXT FONT="Times New Roman Italic" CH="quand tu dis non, quelque chose se ferme en moi, pas de la co­lère, plu­tôt de la tris­tesse"/>
                <ITEXT CH="&quot; — n'a pas de place dans ce mo­ment-là."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ce n'est pas un manque de ma­tu­ri­té. C'est la na­ture de ce qui se joue ici. On ne parle pas de dé­sir de­puis "/>
                <ITEXT FONT="Times New Roman Bold" CH="l'Adulte"/>
                <ITEXT CH=". On le vit de­puis "/>
                <ITEXT FONT="Times New Roman Bold" CH="l'En­fant"/>
                <ITEXT CH=" — et c'est pré­ci­sé­ment pour ça que les mots manquent."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Le tri­angle de Karp­man — le drame si­len­cieux"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ce qui rend ce tri­angle par­ti­cu­lier, c'est qu'il se joue presque en­tiè­re­ment en si­lence. Pas de cris, pas de re­proche ou­vert. Et pour­tant les rôles sont là — ac­tifs, dou­lou­reux, aus­si réels que dans les scènes pré­cé­dentes."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT FONT="Times New Roman Bold" CH="Acte 1"/>
                <ITEXT CH=" — l'ap­proche. Il s'ap­proche de­puis un en­droit vul­né­rable. Il est en "/>
                <ITEXT FONT="Times New Roman Bold" CH="En­fant Libre"/>
                <ITEXT CH=" — spon­ta­né, ou­vert, sans dé­fense. Ce mo­ment-là, avant la ré­ponse, est peut-être le plus ex­po­sé de la scène."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT FONT="Times New Roman Bold" CH="Acte 2"/>
                <ITEXT CH=" — le re­fus. Elle dit non — dou­ce­ment, hon­nê­te­ment. Elle n'est pas "/>
                <ITEXT FONT="Times New Roman Bold" CH="Per­sé­cu­teur"/>
                <ITEXT CH=". Elle est sim­ple­ment fa­ti­guée. Mais dans la lo­gique du tri­angle, son re­fus le place mal­gré elle dans une po­si­tion de "/>
                <ITEXT FONT="Times New Roman Bold" CH="Vic­time"/>
                <ITEXT CH=" — pas re­je­té vio­lem­ment, mais lais­sé seul avec quelque chose qu'il avait ten­du."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT FONT="Times New Roman Bold" CH="Acte 3"/>
                <ITEXT CH=" — le re­trait. Il se re­tourne. Ce re­trait si­len­cieux est un dé­pla­ce­ment de rôle. Il bas­cule en "/>
                <ITEXT FONT="Times New Roman Bold" CH="Per­sé­cu­teur"/>
                <ITEXT CH=" pas­sif — pas par in­ten­tion, mais par ef­fet. Son si­lence pu­nit sans le dire. Elle le sent. Et c'est ce qui la fait de­man­der &quot;tu es fâ­ché ?&quot;"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT FONT="Times New Roman Bold" CH="Acte 4"/>
                <ITEXT CH=" — le coup de théâtre. Elle de­mande. Elle est main­te­nant en "/>
                <ITEXT FONT="Times New Roman Bold" CH="Vic­time"/>
                <ITEXT CH=" — cou­pable d'une bles­sure qu'elle n'a pas vou­lue, an­xieuse de la ré­ac­tion qu'elle a pro­vo­quée. Lui ré­pond &quot;non, dors bien&quot; — et re­de­vient "/>
                <ITEXT FONT="Times New Roman Bold" CH="Sau­veur"/>
                <ITEXT CH=" de fa­çade, ce­lui qui dit que tout va bien pour que ça s'ar­rête. Mais les deux savent que tout ne va pas bien."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT FONT="Times New Roman Bold" CH="En­fant Libre"/>
                <ITEXT CH=" (lui) → "/>
                <ITEXT FONT="Times New Roman Bold" CH="Vic­time"/>
                <ITEXT CH=" du re­fus → "/>
                <ITEXT FONT="Times New Roman Bold" CH="Per­sé­cu­teur"/>
                <ITEXT CH=" si­len­cieux → Elle en "/>
                <ITEXT FONT="Times New Roman Bold" CH="Vic­time"/>
                <ITEXT CH=" cou­pable → "/>
                <ITEXT FONT="Times New Roman Bold" CH="Sau­veur"/>
                <ITEXT CH=" de fa­çade (lui) → si­lence dou­lou­reux des deux cô­tés"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Le bé­né­fice ca­ché du drame"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ce tri­angle dure parce qu'il pro­tège quelque chose — chez cha­cun, dif­fé­rem­ment."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Pour lui : ne pas for­mu­ler la de­mande pro­tège de quelque chose de plus ex­po­sant en­core que le corps — la vul­né­ra­bi­li­té des mots. Tant que la de­mande reste un geste, un si­lence, une ap­proche phy­sique, il n'a pas à dire ce qu'il cherche vrai­ment. Et si c'est re­fu­sé, c'est le geste qui est re­fu­sé — pas les mots. Pas ce qu'il y avait der­rière."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Pour elle : gé­rer la culpa­bi­li­té après le re­fus est in­con­for­table — mais c'est un ter­rain connu. Plus fa­mi­lier, en tout cas, que la conver­sa­tion sur ce dont elle a be­soin pour avoir en­vie de connexion. Ce qu'elle ai­me­rait — être vue dans sa fa­tigue avant d'être dé­si­rée, être re­jointe sans pres­sion, trou­ver un autre che­min vers la proxi­mi­té — est dif­fi­cile à for­mu­ler. Alors elle ne le for­mule pas. Et la culpa­bi­li­té prend la place."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Les deux évitent la même chose — non pas l'in­ti­mi­té, mais les mots qui per­met­traient de la construire au­tre­ment. Et cet évi­te­ment-là, ré­pé­té, creuse dou­ce­ment la dis­tance qu'au­cun des deux ne veut."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Le jeu &quot;Bat­tez-vous&quot; — et sa ver­sion si­len­cieuse"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Le jeu dé­crit par Berne sous le nom &quot;Bat­tez-vous&quot; prend ici une forme par­ti­cu­lière. Dans sa ver­sion clas­sique, un grief ex­té­rieur est uti­li­sé pour re­je­ter une ap­proche in­time — trans­for­mant une vul­né­ra­bi­li­té en conflit de pou­voir. La sexua­li­té de­vient un ter­rain de né­go­cia­tion, voire de pu­ni­tion."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Dans cette scène, il n'y a pas de grief ou­vert. Mais la struc­ture est si­mi­laire — et plus in­si­dieuse. Le conflit ne s'ex­prime pas, il se dé­pose. Dans le re­trait si­len­cieux. Dans le &quot;dors bien&quot; trop court. Dans les yeux ou­verts dans le noir."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ce jeu-là a un bé­né­fice se­con­daire pré­cis : il per­met d'évi­ter l'in­ti­mi­té réelle — pa­ra­doxa­le­ment — en la de­man­dant ou en la re­fu­sant. Parce que l'in­ti­mi­té réelle, celle des mots vrais dans le noir, est plus ex­po­sante en­core que le corps."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="L'alerte à ne pas man­quer"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="La sor­tie de ce jeu n'est pas de faire plus d'ef­forts — ni d'ac­cep­ter quand on n'en a pas en­vie."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ac­cep­ter sans dé­sir réel ne nour­rit pas l'in­ti­mi­té. Ça crée une dette si­len­cieuse — de part et d'autre."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="La vraie ques­tion pour lui n'est pas &quot;"/>
                <ITEXT FONT="Times New Roman Italic" CH="com­ment ob­te­nir plus sou­vent un oui ?"/>
                <ITEXT CH="&quot; C'est &quot;q"/>
                <ITEXT FONT="Times New Roman Italic" CH="u'est-ce que je cherche vrai­ment quand je m'ap­proche — et est-ce que je peux le dire au­tre­ment, ou plus tôt ?&quot;"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="La vraie ques­tion pour elle n'est pas &quot;"/>
                <ITEXT FONT="Times New Roman Italic" CH="com­ment re­fu­ser sans le bles­ser "/>
                <ITEXT CH="?&quot; C'est &quot;"/>
                <ITEXT FONT="Times New Roman Italic" CH="de quoi ai-je be­soin pour me sen­tir dis­po­nible à la connexion — et est-ce que je le sais moi-même ?&quot;"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ces deux ques­tions pointent vers le même en­droit : l'in­ti­mi­té n'est pas un acte. C'est un état — qu'on construit ou qu'on laisse s'éro­der, dans les gestes quo­ti­diens, bien avant 23h."/>
                <trail PARENT="BODY" ALIGN="3"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="141.102992125985" YPOS="35000.6723907742" OwnPage="109" ItemID="222995216" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5149104591899" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="222989552" BACKITEM="223000880"/>
