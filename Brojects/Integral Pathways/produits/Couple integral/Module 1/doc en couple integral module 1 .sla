        <PAGEOBJECT XPOS="562.805939655773" YPOS="24506.148583374" OwnPage="76" ItemID="257686944" PTYPE="2" WIDTH="334.730123336353" HEIGHT="94.5257473346392" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="0.39" LOCALSCY="0.39" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" Pagenumber="0" PFILE="images/en/need2chap4.png" PRFILE="Embedded sRGB built-in" IRENDER="0" EPROF="Embedded sRGB built-in" path="M0 0 L334.73 0 L334.73 94.5257 L0 94.5257 L0 0 Z" copath="M0 0 L334.73 0 L334.73 94.5257 L0 94.5257 L0 0 Z" gXpos="562.805939655773" gYpos="24506.148583374" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1"/>
        <PAGEOBJECT XPOS="141.102992125985" YPOS="26106.8185325065" OwnPage="81" ItemID="257684112" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5193199080121" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="225702864"/>
        <PAGEOBJECT XPOS="560.630551181103" YPOS="26106.8185325065" OwnPage="82" ItemID="257681280" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5193199080121" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Tracking — 7 Days"/>
                <para PARENT="scene_page_subtitle"/>
                <para PARENT="scene_page_subtitle"/>
                <ITEXT CH="Every evening, 2 minutes."/>
                <para PARENT="narration"/>
                <para/>
                <para/>
                <para/>
                <para/>
                <para/>
                <para/>
                <para/>
                <para/>
                <para/>
                <para/>
                <para/>
                <para/>
                <para/>
                <ITEXT CH="The evening question:"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="Monday: "/>
                <ITEXT FONT="Times New Roman Italic" CH="Today, what did money represent in my interactions — beyond the numbers?"/>
                <para PARENT="BODY"/>
                <ITEXT CH="Tuesday:"/>
                <ITEXT FONT="Times New Roman Italic" CH=" When I spent or monitored, what was I truly looking for?"/>
                <para PARENT="BODY"/>
                <ITEXT CH="Wednesday: "/>
                <ITEXT FONT="Times New Roman Italic" CH="At what moment did I use money to say something I didn't say in words?"/>
                <para PARENT="BODY"/>
                <ITEXT CH="Thursday: "/>
                <ITEXT FONT="Times New Roman Italic" CH="What would I have needed to ask for — or offer — instead?"/>
                <para PARENT="BODY"/>
                <ITEXT CH="Friday: "/>
                <ITEXT FONT="Times New Roman Italic" CH="How did I nourish my Free Child today — and what did it change in my relationship to money?"/>
                <para PARENT="BODY"/>
                <ITEXT CH="Saturday: "/>
                <ITEXT FONT="Times New Roman Italic" CH="What belief about the other person did this scene come to confirm this week?"/>
                <para PARENT="BODY"/>
                <ITEXT CH="Sunday: "/>
                <ITEXT FONT="Times New Roman Italic" CH="If money were no longer a terrain of power between us — what would that conversation look like?"/>
                <trail PARENT="BODY"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="560.630551181103" YPOS="26742.093808097" OwnPage="84" ItemID="257675616" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5190049473811" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <ITEXT CH="Scene 5 — Homework"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <ITEXT CH="&quot;The Bad Parent&quot;"/>
                <trail PARENT="Titre" ALIGN="1"/>
            </StoryText>
            <PageItemAttributes>
                <ItemAttribute Name="tdm" Type="string" Value="Scène 5 — Les devoirs" Parameter="" Relationship="none" RelationshipTo="" AutoAddTo="none"/>
            </PageItemAttributes>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="141.102992125985" YPOS="26742.093808097" OwnPage="83" ItemID="257689776" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5190049473811" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Duo Version — Exchange in 2 Parts"/>
                <para PARENT="scene_page_subtitle"/>
                <para PARENT="scene_page_subtitle"/>
                <ITEXT CH="To do outside any recent overspend — calmly, 20 minutes."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="Part 1 — What Money Represents (10 minutes)"/>
                <para PARENT="scene_page_subtitle"/>
                <para PARENT="BODY"/>
                <ITEXT CH="Each person completes these sentences separately, in writing:"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="&quot;In our relationship, money represents for me...&quot; &quot;What I need to feel free / financially secure is...&quot; &quot;What I've never allowed myself — and would like to be able to give myself — is...&quot;"/>
                <para PARENT="narration"/>
                <para PARENT="BODY"/>
                <ITEXT CH="Then you share — each person reads, the other listens without interrupting. The goal isn't to convince each other. It's to hear what money truly represents for the other person — beyond the numbers."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="Part 2 — A Framework That Respects Both (10 minutes)"/>
                <para PARENT="scene_page_subtitle"/>
                <para PARENT="BODY"/>
                <ITEXT CH="One question to explore together:"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="&quot;How do we build something that gives you security and gives me freedom — at the same time?&quot;"/>
                <para PARENT="narration"/>
                <para PARENT="BODY"/>
                <ITEXT CH="Not an imposed rule. A proposal built together — that can be adjusted, tested, revised."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="The next scene enters even more delicate terrain — that of parenting. Two parents, a child who resists, and two ways of loving that don't speak to each other."/>
                <trail PARENT="scene_page_subtitle" ALIGN="1"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="560.630551181103" YPOS="27377.3690836876" OwnPage="86" ItemID="257692608" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5186899867502" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="The Scene"/>
                <para PARENT="scene_page_subtitle"/>
                <para PARENT="scene_page_subtitle"/>
                <ITEXT CH="Living room, 6:30 pm. The child is at the table with homework. She's beside him, tense. He comes in, puts his things down."/>
                <para PARENT="narration"/>
                <ITEXT CH="Her: &quot;He refused to do his homework again. I've been struggling with him for an hour.&quot;"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="Him: &quot;Come on, let's go.&quot; (to the child, firm tone) &quot;Put the tablet down and get to work now.&quot;"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="The child complies, sulking. She waits until the child is out of earshot."/>
                <para PARENT="narration"/>
                <ITEXT CH="Her: &quot;You walk in and take over like that — in front of him.&quot;"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="Him: &quot;He wasn't doing anything. You were negotiating for an hour.&quot;"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="Her: &quot;I'm not negotiating. I'm trying to understand what's blocking him.&quot;"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="Him: &quot;What's blocking him is there's no clear limit. If you set the limit, he respects it.&quot;"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="Her: &quot;And what do you think cold authority builds?&quot;"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="Silence. The child comes back to get his notebook. They go quiet. Facade smiles."/>
                <para PARENT="narration"/>
                <para PARENT="BODY"/>
                <ITEXT CH="Later, once the child is asleep:"/>
                <para PARENT="BODY"/>
                <ITEXT CH="Him: &quot;I just wanted to help.&quot;"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="Her: &quot;That's not how you help me.&quot;"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="Do You Recognize Yourself?"/>
                <para PARENT="BODY"/>
                <ITEXT CH="I experience this scene: never · sometimes · often"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="In this scene, I'm more like: the one who sets the limit · the one who tries to understand · both depending on the moment"/>
                <trail PARENT="BODY"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="141.102992125985" YPOS="27377.3690836876" OwnPage="85" ItemID="260392592" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5186899867502" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <trail/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="560.630551181103" YPOS="28012.6443592781" OwnPage="88" ItemID="260389760" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5183750261193" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="260395424"/>
        <PAGEOBJECT XPOS="141.102992125985" YPOS="28012.6443592781" OwnPage="87" ItemID="260395424" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5183750261193" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="260389760" BACKITEM="-1">
            <StoryText>
                <DefaultStyle LINESP="17"/>
                <ITEXT FONT="Arial Regular" LANGUAGE="frp" CH="Before the Analysis — One Important Thing"/>
                <para PARENT="scene_page_subtitle"/>
                <para PARENT="BODY"/>
                <ITEXT FONT="Arial Regular" LANGUAGE="frp" CH="If you recognize yourself in this scene, you probably know what it feels like to hold a course — and see it bypassed in thirty seconds."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT FONT="Arial Regular" LANGUAGE="frp" CH="You know what it's like to have thought through your approach. Not improvising — choosing. Choosing not to shout, to look for what's blocking, to try to understand the child rather than force them. And to see someone arrive, without context, without the path traveled, and resolve the situation the old way — with the firmness you had specifically decided to set aside. And it works. That's the hardest part to swallow."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT FONT="Arial Regular" LANGUAGE="frp" CH="And you might know the other side too: coming home into a tense situation, seeing someone you love exhausted, a child who resists, and feeling that reflex rise — I can fix this. Quickly. Simply. With what you know. Not out of contempt for what the other person was doing — out of genuine desire for it to stop. For everyone. Including yourself."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT FONT="Arial Regular" LANGUAGE="frp" CH="Both positions are honest. They're also both incomplete."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT FONT="Arial Regular" LANGUAGE="frp" CH="What this booklet will offer you is to look not at who has the better method — that question has no answer in the moment of tension — but at what each person was really activating in this scene, beyond the parenting. Because that's where something can change."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT FONT="Arial Regular" LANGUAGE="frp" CH="What's Really Happening"/>
                <para PARENT="scene_page_subtitle"/>
                <para PARENT="scene_page_subtitle"/>
                <ITEXT FONT="Arial Regular" LANGUAGE="frp" CH="On the surface, it's a disagreement about how to get homework done. What's really happening is much more charged — and much older."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT FONT="Arial Regular" LANGUAGE="frp" CH="When two parents clash about parenting, they're rarely debating pedagogy. They're debating what a good parent is. And behind that question is another, deeper one that nobody articulates: "/>
                <ITEXT FONT="Arial Italic" LANGUAGE="frp" CH="am I a good parent"/>
                <ITEXT FONT="Arial Regular" LANGUAGE="frp" CH="? And behind that still: "/>
                <ITEXT FONT="Arial Italic" LANGUAGE="frp" CH="do I have worth in this role that matters more than anything?"/>
                <para PARENT="BODY" LINESP="15"/>
                <para PARENT="BODY"/>
                <ITEXT FONT="Arial Regular" LANGUAGE="frp" CH="That's why these arguments hurt so much. It's not the disagreement about homework that's painful. It's the implicit implication — your way of doing things is wrong — that touches something identity-based. And something, often, very old."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT FONT="Arial Regular" LANGUAGE="frp" CH="What Comes from Further Back"/>
                <para PARENT="scene_page_subtitle"/>
                <para PARENT="BODY"/>
                <ITEXT FONT="Arial Regular" LANGUAGE="frp" CH="Each person arrives in parenthood with a history. With internalized images of what a parent is — how they set limits, how they console, how they demand, how they're present. These images come from childhood. They weren't chosen. They're there, active, often without our knowing."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT FONT="Arial Regular" LANGUAGE="frp" CH="He may have grown up in an environment where clear rules were synonymous with security. Where authority was love — not coldness. When he sets the limit, he's not thinking &quot;"/>
                <ITEXT FONT="Arial Italic" LANGUAGE="frp" CH="I'm taking power."/>
                <ITEXT FONT="Arial Regular" LANGUAGE="frp" CH="&quot; He's thinking &quot;"/>
                <ITEXT FONT="Arial Italic" LANGUAGE="frp" CH="I'm protecting"/>
                <ITEXT FONT="Arial Regular" LANGUAGE="frp" CH=".&quot;"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT FONT="Arial Regular" LANGUAGE="frp" CH="She may have grown up in an environment where authority was arbitrary, or absent, or hurtful. Where understanding what was happening for the child was what was missing. When she tries to understand what's blocking, she's not thinking &quot;"/>
                <ITEXT FONT="Arial Italic" LANGUAGE="frp" CH="I'm negotiating."/>
                <ITEXT FONT="Arial Regular" LANGUAGE="frp" CH="&quot; She's thinking &quot;"/>
                <ITEXT FONT="Arial Italic" LANGUAGE="frp" CH="I'm seeing."/>
                <ITEXT FONT="Arial Regular" LANGUAGE="frp" CH="&quot;"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT FONT="Arial Regular" LANGUAGE="frp" CH="Neither is wrong. They're reproducing — often without knowing it — what they received, or what they would have liked to receive. And when their two histories collide on the terrain of a child's homework, much more than homework is at stake."/>
                <trail PARENT="BODY"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="141.102992125985" YPOS="28647.9196348687" OwnPage="89" ItemID="260398256" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5180600654883" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="260386928" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="The Ego States Present:"/>
                <para PARENT="scene_page_subtitle"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="What's striking: both are operating from the Parent — him from the Normative, her from the Nurturing. Two forms of parental love. Two ways of being a good parent. Incompatible in the moment, not at heart."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="The Adult is absent on both sides. It can't be there because the scene is no longer about homework. It's about who is right to love the child the way they love them."/>
                <para PARENT="BODY"/>
                <para/>
                <para/>
                <ITEXT CH="The Life Positions Present"/>
                <para PARENT="scene_page_subtitle"/>
                <para PARENT="BODY"/>
                <ITEXT CH="In Transactional Analysis, a "/>
                <ITEXT FONT="Times New Roman Italic" CH="life position"/>
                <ITEXT CH=" is the deep conviction we carry about ourselves and the other — built early, rarely conscious, always active in moments of tension."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="He operates from something that resembles &quot;"/>
                <ITEXT FONT="Times New Roman Italic" CH="I'm OK — what you're doing isn't."/>
                <ITEXT CH="&quot; Not out of contempt — out of conviction that his way is right. It's a position of implicit superiority that shows in the unsolicited intervention, in &quot;"/>
                <ITEXT FONT="Times New Roman Italic" CH="if you set the limit, he respects it."/>
                <ITEXT CH="&quot;"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="She slides toward something that resembles &quot;"/>
                <ITEXT FONT="Times New Roman Italic" CH="I'm doing my best — and you come to show me it's not enough"/>
                <ITEXT CH=".&quot; A position that combines the legitimacy of her approach and the hurt of being discredited in front of the child."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="These positions aren't fixed. They move in the scene — he slides into &quot;"/>
                <ITEXT FONT="Times New Roman Italic" CH="I'm not OK"/>
                <ITEXT CH="&quot; when he says &quot;"/>
                <ITEXT FONT="Times New Roman Italic" CH="I just wanted to help"/>
                <ITEXT CH=",&quot; she regains the high ground when she challenges his cold authority. But their collision is enough to make the conversation impossible."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="The Karpman Drama Triangle — the Drama in Three Acts"/>
                <para PARENT="scene_page_subtitle"/>
                <para PARENT="BODY"/>
                <ITEXT CH="This is where the scene reveals its full mechanics. What's particularly striking in this configuration is the speed at which the roles shift."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT FONT="Times New Roman Italic" CH="Act 1 — before he comes home."/>
                <ITEXT CH=" She's been struggling for an hour. She's exhausted, overwhelmed, alone facing the child's resistance. She's in "/>
                <ITEXT FONT="Times New Roman Bold" CH="Victim"/>
                <ITEXT CH=" mode — not in the weak sense, but in the technical sense: she's enduring a situation she no longer controls, and carrying it alone."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT FONT="Times New Roman Italic" CH="Act 2 — he comes home and intervenes"/>
                <ITEXT CH=". He sees the scene. His reflex is immediate — he enters as "/>
                <ITEXT FONT="Times New Roman Bold" CH="Rescuer"/>
                <ITEXT CH=". He takes over, sets the limit, gets the result. The child obeys. He's repaired what seemed broken."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="But something shifts. By becoming the "/>
                <ITEXT FONT="Times New Roman Bold" CH="Rescuer"/>
                <ITEXT CH=" of the situation, he implicitly becomes the "/>
                <ITEXT FONT="Times New Roman Bold" CH="Persecutor"/>
                <ITEXT CH=" of her — he bypassed her authority, in front of the child, without asking. What he experienced as a rescue, she experienced as a humiliation."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT FONT="Times New Roman Italic" CH="Act 3 — the twist"/>
                <ITEXT CH=". She counter-attacks: &quot;you walk in and take over like that.&quot; She shifts to "/>
                <ITEXT FONT="Times New Roman Bold" CH="Persecutor"/>
                <ITEXT CH=". He slides into "/>
                <ITEXT FONT="Times New Roman Bold" CH="Victim"/>
                <ITEXT CH=" — he tried to help, he's being criticized for it. And later, &quot;I just wanted to help&quot; says exactly this position: I am the "/>
                <ITEXT FONT="Times New Roman Bold" CH="victim"/>
                <ITEXT CH=" of your reaction to my help."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="She, who was "/>
                <ITEXT FONT="Times New Roman Bold" CH="Victim"/>
                <ITEXT CH=" at the start, ends up in the uncomfortable position of the one who hurt someone who meant well. The guilt is there, even if unnamed."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT FONT="Times New Roman Bold" CH="Victim"/>
                <ITEXT CH=" (her) → "/>
                <ITEXT FONT="Times New Roman Bold" CH="Rescuer"/>
                <ITEXT CH=" (him) → Implicit "/>
                <ITEXT FONT="Times New Roman Bold" CH="Persecutor"/>
                <ITEXT CH=" (him) → "/>
                <ITEXT FONT="Times New Roman Bold" CH="Victim"/>
                <ITEXT CH=" (her, discredited) → "/>
                <ITEXT FONT="Times New Roman Bold" CH="Persecutor"/>
                <ITEXT CH=" (her attacking) → "/>
                <ITEXT FONT="Times New Roman Bold" CH="Victim"/>
                <ITEXT CH=" (him, misunderstood) → diffuse guilt on both sides"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="The Hidden Benefit of the Drama"/>
                <para PARENT="scene_page_subtitle"/>
                <para PARENT="BODY"/>
                <ITEXT CH="This triangle persists because it protects something — in each person, differently."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="For him: getting a quick result avoids having to enter into what had been happening for an hour. If it works, that's because it was the right way. And being the one who solves says something reassuring about his place in this household — he's useful, he matters."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="For her: naming what just happened protects the meaning of what she's building. Letting it go without saying anything would be allowing an entire path to be silently invalidated. The criticism isn't just anger — it's a way of saying "/>
                <ITEXT FONT="Times New Roman Italic" CH="what I do has value, even if you didn't see it."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="Both protect something legitimate. And neither protects what most needs protecting — the space between them, from which a real conversation about parenting could one day take place."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="The &quot;Courtroom&quot; Game — Who Is the Better Parent?"/>
                <para PARENT="narration"/>
                <para PARENT="BODY"/>
                <ITEXT CH="What Berne calls &quot;"/>
                <ITEXT FONT="Times New Roman Italic" CH="Courtroom"/>
                <ITEXT CH="&quot; isn't a game of cruelty. It's a game of legitimacy — often unconscious, always revealing of what couldn't be said otherwise."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="The structure: a decision is made, contradicted, or judged. One takes the position of accuser — &quot;"/>
                <ITEXT FONT="Times New Roman Italic" CH="you were negotiating for an hour"/>
                <ITEXT CH="&quot; — and the other the position of defendant — &quot;"/>
                <ITEXT FONT="Times New Roman Italic" CH="I'm not negotiating, I'm trying to understand."/>
                <ITEXT CH="&quot; The real issue isn't the decision. It's the verdict: who is right to be the parent they are?"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="This game has a precise secondary benefit. For him: intervening and getting a quick result confirms his approach works. For her: resisting his intervention and pointing out its limits confirms she sees what he doesn't see."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="Both are looking for the same thing — to be recognized as competent, loving, sufficient. And they're looking for it by opposing each other. It's not rational. It's human."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="The Alert Not to Miss"/>
                <para PARENT="scene_page_subtitle"/>
                <ITEXT CH="The exit from this game isn't to align on a single method — or to decide who is right between limit-setting and understanding."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="Both approaches have value. The problem isn't the method — it's the disunity."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="The real question for him: &quot;"/>
                <ITEXT FONT="Times New Roman Italic" CH="what does it activate in me to see this scene when I come home — and why do I intervene before even asking what's happening?"/>
                <ITEXT CH="&quot;"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="The real question for her: &quot;"/>
                <ITEXT FONT="Times New Roman Italic" CH="what am I truly building — and how do I make it visible to the other person, other than in the moment of tension?"/>
                <ITEXT CH="&quot;"/>
                <trail PARENT="BODY"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="560.630551181103" YPOS="28647.9196348687" OwnPage="90" ItemID="260386928" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5180600654883" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="260409584" BACKITEM="260398256"/>
        <PAGEOBJECT XPOS="560.630551181103" YPOS="29283.1949104592" OwnPage="92" ItemID="260406752" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5177451048574" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="260409584"/>
        <PAGEOBJECT XPOS="141.102992125985" YPOS="29283.1949104592" OwnPage="91" ItemID="260409584" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5177451048574" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="260406752" BACKITEM="260386928"/>
        <PAGEOBJECT XPOS="141.102992125985" YPOS="29918.4701860498" OwnPage="93" ItemID="260412416" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5174301442265" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="260401088" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="What We Really Need — the NVC Angle"/>
                <para PARENT="scene_page_subtitle"/>
                <para PARENT="BODY"/>
                <ITEXT CH="In this scene, the two protagonists aren't experiencing the same thing — and they don't have the same needs. What follows offers two separate readings. Not to designate who's right about the method. To allow each person to recognize what's activated in them — and find their own exit."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="The same rule applies in both cases: a need belongs to me. It doesn't depend on what the other person does or doesn't do. I am responsible for finding how to meet it — not for waiting for the other person to guess."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="If you're the one whose efforts were bypassed"/>
                <para PARENT="scene_page_subtitle"/>
                <para PARENT="BODY"/>
                <ITEXT CH="What you express through the resistance and the criticism isn't stubbornness. It's information about what matters deeply to you — and about what disappears without leaving a trace when the result erases the path."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="Read this list. Check what truly resonates."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="Once your need is identified, complete this sentence:"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="&quot;I need __. When I reconnect to this "/>
                <ITEXT FONT="Times New Roman Italic" CH="n"/>
                <ITEXT CH="eed, what I choose to do is __.&quot;"/>
                <para PARENT="narration"/>
                <para PARENT="BODY"/>
                <ITEXT CH="A few examples:"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="&quot;I need meaning. What I choose to do is continue my approach — even wit"/>
                <ITEXT FONT="Tempus Sans ITC Regular" CH="h"/>
                <ITEXT CH="out immediate results — and observe what it builds over time, not just tonight.&quot;"/>
                <para PARENT="narration"/>
                <para PARENT="BODY"/>
                <ITEXT CH="&quot;I need integrity. What I choose to do is stay with what I believe is right for this child — and find a calm moment to share this path with the other person, not impose it, just make it visible.&quot;"/>
                <para PARENT="narration"/>
                <para PARENT="BODY"/>
                <ITEXT CH="&quot;I need growth. What I choose to do is name, for myself first, what I want to transmit — and what I don't want to reproduce. Not as a criticism of the other. As a compass for myself.&quot;"/>
                <para PARENT="narration"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="If you're the one who intervened"/>
                <para PARENT="scene_page_subtitle"/>
                <para PARENT="BODY"/>
                <ITEXT CH="What you did wasn't contempt. It was a reflex — quick, efficient, inherited. But a reflex isn't a choice. And the question worth asking isn't &quot;did it work?&quot; It's &quot;what was activated in me — and what does that say about what I truly need?&quot;"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="Read this list. Check what truly resonates."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="Once your need is identified, complete this sentence:"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="&quot;I need __. When I reconnect to this need, what I choose to do is __.&quot;"/>
                <para PARENT="narration"/>
                <para PARENT="BODY"/>
                <ITEXT CH="A few examples:"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="&quot;I need inner peace. What I choose to do is give myself a moment to decompress when I come home — before entering into what's happening — so I don't intervene from exhaustion.&quot;"/>
                <para PARENT="narration"/>
                <para PARENT="BODY"/>
                <ITEXT CH="&quot;I need contribution. What I choose to do is ask the other person how I can help — before acting. Just that. Two seconds. Before.&quot;"/>
                <para PARENT="narration"/>
                <para PARENT="BODY"/>
                <ITEXT CH="&quot;I need self-confidence. What I choose to do is examine what my parenting automatisms carry — what they've given me, what they reproduce — without defending or wholesale rejecting them.&quot;"/>
                <para PARENT="narration"/>
                <para PARENT="narration"/>
                <para PARENT="narration"/>
                <para PARENT="BODY"/>
                <ITEXT CH="These two lists speak of the same aspiration — being a parent who acts from what they truly believe, not from reflex or fatigue. They don't meet in the scene. But they can meet calmly, when both have decided to speak not of method — but of what they truly want to build together."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="560.630551181103" YPOS="29918.4701860498" OwnPage="94" ItemID="260401088" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5174301442265" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="260403920" BACKITEM="260412416"/>
        <PAGEOBJECT XPOS="560.630551181103" YPOS="30553.7454616403" OwnPage="96" ItemID="260415248" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5171151835955" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Feeding Your Free Child"/>
                <para PARENT="scene_page_subtitle"/>
                <para PARENT="BODY"/>
                <ITEXT CH="There is something operating in the background of this scene — worth naming."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="Both arrive in this moment from their Parent. Him from the Normative — the rule, the limit, the efficiency. Her from the Nurturing — the understanding, the care, the patience. Two serious forms of love. Two ways of being there for this child that cost a lot — and that leave little room for anything else."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="What's rarely seen from the inside: the tension that builds in these moments isn't just the product of the interaction. It's also what we bring to it. When we're very focused on doing things right — on the result, on the method, on what's just — we arrive in the relationship with little breath. And that absence of breath is transmitted. To the child. To the other parent. It nourishes exactly what we wanted to avoid."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="Feeding your Free Child isn't a way of being a less good parent. It's a way of taking care of yourself — so you arrive in the relationship differently. Not less demanding. Less tense. And that difference, the child senses before the words even arrive."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="It's not about changing the homework scene first. It's about asking what you allowed yourself today — outside your role as parent, outside the couple, outside what you must. A moment that belongs only to you. Not much. But something."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="Because taking care of yourself is taking care of the relationship. Not instead of the demand — alongside it. And often, when you allow yourself this breath, the demand settles on its own — without having decided anything else."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="The question to ask yourself tonight:"/>
                <para PARENT="BODY"/>
                <ITEXT CH="What did I allow myself today — not to be useful, not to do things right — just for myself?"/>
                <para PARENT="narration"/>
                <para PARENT="BODY"/>
                <ITEXT CH="And an additional question, specific to this scene:"/>
                <para PARENT="BODY"/>
                <ITEXT CH="Was the tension I experienced tonight only in the situation — or was I already bringing it with me when I walked into the room?Nour­rir ton En­fant Libre"/>
                <para PARENT="narration"/>
                <para PARENT="BODY"/>
                <ITEXT CH="Il y a quelque chose qui opère en fond dans cette scène — et qui mé­rite d'être nom­mé."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="Les deux ar­rivent dans ce mo­ment de­puis leur Pa­rent. Lui de­puis le Nor­ma­tif — la règle, la li­mite, l'ef­fi­ca­ci­té. Elle de­puis le Nour­ri­cier — la com­pré­hen­sion, le soin, la pa­tience. Deux formes d'amour sé­rieux. Deux fa­çons d'être là pour cet en­fant qui coûtent beau­coup — et qui laissent peu de place à autre chose."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="Ce qu'on voit ra­re­ment de­puis l'in­té­rieur : la ten­sion qui monte dans ces mo­ments n'est pas seule­ment le pro­duit de l'in­ter­ac­tion. Elle est aus­si ce qu'on y ap­porte. Quand on est très fo­ca­li­sé sur bien faire — sur le ré­sul­tat, sur la mé­thode, sur ce qui est juste — on ar­rive dans la re­la­tion avec peu de res­pi­ra­tion. Et cette ab­sence de res­pi­ra­tion se trans­met. À l'en­fant. À l'autre pa­rent. Elle nour­rit exac­te­ment ce qu'on vou­lait évi­ter."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="Nour­rir son En­fant Libre n'est pas une fa­çon de moins bien faire son rôle de pa­rent. C'est une fa­çon de prendre soin de soi — pour ar­ri­ver dans la re­la­tion au­tre­ment. Pas moins exi­geant. Moins ten­du. Et cette dif­fé­rence-là, l'en­fant la sent avant même que les mots ar­rivent."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="Il ne s'agit pas de chan­ger d'abord la scène des de­voirs. Il s'agit de se de­man­der ce qu'on s'est ac­cor­dé au­jour­d'hui — en de­hors du rôle de pa­rent, en de­hors du couple, en de­hors de ce qu'on doit. Un mo­ment qui n'ap­par­tient qu'à soi. Pas grand-chose. Mais quelque chose."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="Parce que prendre soin de soi, c'est prendre soin de la re­la­tion. Pas à la place de l'exi­gence — à cô­té d'elle. Et sou­vent, quand on s'ac­corde cette res­pi­ra­tion-là, l'exi­gence se pose d'elle-même — sans qu'on ait rien dé­ci­dé d'autre."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="La ques­tion à se po­ser ce soir :"/>
                <para PARENT="BODY"/>
                <ITEXT CH="Qu'est-ce que je me suis ac­cor­dé au­jour­d'hui — pas pour être utile, pas pour bien faire — juste pour moi ?"/>
                <para PARENT="BODY"/>
                <ITEXT CH="Est-ce que la ten­sion que j'ai vé­cue ce soir était seule­ment dans la si­tua­tion — ou est-ce que je l'ap­por­tais dé­jà avec moi en en­trant dans la pièce ?"/>
                <trail PARENT="BODY"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="141.102992125985" YPOS="30553.7454616403" OwnPage="95" ItemID="260403920" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5171151835955" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="260401088"/>
        <PAGEOBJECT XPOS="141.102992125985" YPOS="31189.0207372309" OwnPage="97" ItemID="260423744" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5168002229646" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="260418080" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="The Exits"/>
                <para PARENT="scene_page_subtitle"/>
                <para PARENT="BODY"/>
                <ITEXT CH="Level 1 — Notice your role in the triangle (solo — both partners)"/>
                <para PARENT="scene_page_subtitle"/>
                <para PARENT="BODY"/>
                <ITEXT CH="One question, in the moment:"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="What role am I in right now — Victim, Rescuer, or Persecutor?"/>
                <para PARENT="narration"/>
                <para PARENT="BODY"/>
                <ITEXT CH="If you're "/>
                <ITEXT FONT="Times New Roman Bold" CH="Victim"/>
                <ITEXT CH=": what are you waiting for from the other — support, a solution? Can you ask for it directly rather than waiting?"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="If you're "/>
                <ITEXT FONT="Times New Roman Bold" CH="Rescuer"/>
                <ITEXT CH=": were you asked to intervene? Does your intervention serve the other — or does it first serve your need to be useful?"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="If you're "/>
                <ITEXT FONT="Times New Roman Bold" CH="Persecutor"/>
                <ITEXT CH=": what are you truly defending — a parenting method, or your legitimacy as a parent?"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="Noticing the role doesn't make it disappear immediately. But it creates a space — a slight distance between reflex and reaction — from which something else becomes possible."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="Level 2 — Observe from which place you're speaking (solo — both partners)"/>
                <para PARENT="scene_page_subtitle"/>
                <para PARENT="BODY"/>
                <ITEXT CH="The next time this scene is triggered, a complementary question:"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="Am I reacting to the child, or am I reacting to the other parent?"/>
                <para PARENT="narration"/>
                <para PARENT="BODY"/>
                <ITEXT CH="If the primary emotion is frustration toward the child — it's a parenting question. If the primary emotion is frustration toward the other — it's a couple question disguised as a parenting question. Both deserve a response. But not the same one."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="Level 3 — Set a handover protocol (together — to build outside tension)"/>
                <para PARENT="scene_page_subtitle"/>
                <para PARENT="BODY"/>
                <ITEXT CH="The handover scene is inevitable in any couple with children. What creates the problem is that it's never been discussed. It's improvised, in the moment, under tension."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="A conversation to have calmly, without the child:"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="&quot;When one of us is struggling — how do we hand over without bypassing each other? What does each of us need from the other in that moment?&quot;"/>
                <para PARENT="narration"/>
                <para PARENT="BODY"/>
                <ITEXT CH="Not a rigid rule. A flexible agreement — a signal, a phrase, a gesture that says &quot;I need help&quot; or &quot;I'll take over, you breathe.&quot; Something chosen together, not imposed in the urgency."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="Level 4 — Name the divergence in approach without making it a verdict (together)"/>
                <para PARENT="scene_page_subtitle"/>
                <para PARENT="BODY"/>
                <ITEXT CH="&quot;I realize we've never really talked about our parenting approaches — what we want for them, what matters to each of us, what we received and what we want to reproduce or not. Can we do that — not to decide who's right, but to understand each other?&quot;"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="This conversation moves disagreements from the terrain of reaction to the terrain of choice. It allows each person to hear where the other is coming from — not as a threat, but as a history."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="Level 5 — Name the game together (together)"/>
                <para PARENT="scene_page_subtitle"/>
                <para PARENT="BODY"/>
                <ITEXT CH="A few days after the scene, calmly:"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="&quot;I think we sometimes replay something — not about the homework, but about who is the good parent. I jump in as Rescuer without being asked, and that puts you in an impossible position. I see that now. Can we talk about it?&quot;"/>
                <para PARENT="narration"/>
                <para PARENT="BODY"/>
                <ITEXT CH="Not an accusation. A shared observation from the Adult — that opens the possibility of talking about what's really happening."/>
                <para PARENT="BODY"/>
                <para/>
                <para/>
                <ITEXT CH="Tracking — 7 Days"/>
                <para PARENT="scene_page_subtitle"/>
                <ITEXT CH="Every evening, 2 minutes."/>
                <para PARENT="narration"/>
                <para PARENT="narration"/>
                <para PARENT="narration"/>
                <para PARENT="narration"/>
                <para PARENT="narration"/>
                <para PARENT="narration"/>
                <para PARENT="narration"/>
                <para PARENT="narration"/>
                <para PARENT="narration"/>
                <para PARENT="narration"/>
                <ITEXT CH="V = Victim · R = Rescuer · P = Persecutor"/>
                <para PARENT="narration"/>
                <para PARENT="narration"/>
                <ITEXT CH="The evening question:"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="Monday: "/>
                <ITEXT FONT="Times New Roman Italic" CH="Which role did I spend the most time in today — and what led me there?"/>
                <para PARENT="BODY"/>
                <ITEXT CH="Tuesday: "/>
                <ITEXT FONT="Times New Roman Italic" CH="What was activated in me when I came home tonight — and where did it come from?"/>
                <para PARENT="BODY"/>
                <ITEXT CH="Wednesday: "/>
                <ITEXT FONT="Times New Roman Italic" CH="At what moment did I see the other person's approach as a threat rather than a difference?"/>
                <para PARENT="BODY"/>
                <ITEXT CH="Thursday: "/>
                <ITEXT FONT="Times New Roman Italic" CH="What has my history taught me about what a good parent is — and is it still playing out here?"/>
                <para PARENT="BODY"/>
                <ITEXT CH="Friday: "/>
                <ITEXT FONT="Times New Roman Italic" CH="How did I nourish my Free Child today — and what did it change in my presence?"/>
                <para PARENT="BODY"/>
                <ITEXT CH="Saturday: "/>
                <ITEXT FONT="Times New Roman Italic" CH="What did I allow myself this week — just for myself?"/>
                <para PARENT="BODY"/>
                <ITEXT CH="Sunday: "/>
                <ITEXT FONT="Times New Roman Italic" CH="If we were truly a team in these moments — what would that look like concretely?"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="Duo Version — Exchange in 2 Parts"/>
                <para PARENT="scene_page_subtitle"/>
                <para PARENT="scene_page_subtitle"/>
                <ITEXT CH="To do outside any recent episode — calmly, without the child present, 20 minutes."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="Part 1 — Our Parenting Histories (10 minutes)"/>
                <para PARENT="scene_page_subtitle"/>
                <para PARENT="BODY"/>
                <ITEXT CH="Each person completes these sentences separately, in writing:"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="&quot;What I received as an upbringing, and want to pass on, is...&quot; &quot;What I didn't receive, and try to give, is...&quot; &quot;What I need from you in the difficult moments with the children is...&quot;"/>
                <para PARENT="narration"/>
                <para PARENT="BODY"/>
                <ITEXT CH="Then you share — each person reads, the other listens without interrupting. The goal isn't to decide on a common method. It's to hear where the other is coming from."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="Part 2 — A Handover Agreement (10 minutes)"/>
                <para PARENT="scene_page_subtitle"/>
                <para PARENT="BODY"/>
                <ITEXT CH="&quot;How do we support each other in these moments — without bypassing each other?&quot;"/>
                <para PARENT="narration"/>
                <para PARENT="BODY"/>
                <ITEXT CH="Not a rigid protocol. A flexible, revisable agreement that says: we're a team. And when one is exhausted, the other takes over — in a way that respects what the other started."/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <para PARENT="BODY"/>
                <ITEXT CH="The last scene is the most silent of all. It takes place in the dark, at 11 pm. And what plays out in it lasted only thirty seconds."/>
                <para PARENT="scene_page_subtitle" ALIGN="1"/>
                <para/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="560.630551181103" YPOS="31189.0207372309" OwnPage="98" ItemID="260418080" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5168002229646" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="260426576" BACKITEM="260423744"/>
        <PAGEOBJECT XPOS="560.630551181103" YPOS="31824.2960128214" OwnPage="100" ItemID="260432240" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5164852623337" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="260426576"/>
        <PAGEOBJECT XPOS="141.102992125985" YPOS="31824.2960128214" OwnPage="99" ItemID="260426576" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5164852623337" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="260432240" BACKITEM="260418080"/>
        <PAGEOBJECT XPOS="141.102992125985" YPOS="32459.571288412" OwnPage="101" ItemID="260429408" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5161703017028" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <trail/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="560.630551181103" YPOS="32459.571288412" OwnPage="102" ItemID="260420912" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5161703017028" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <ITEXT CH="Scène 6 — La chambre"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <ITEXT CH="&quot;Pas ce soir&quot;"/>
                <trail PARENT="Titre" ALIGN="1"/>
            </StoryText>
            <PageItemAttributes>
                <ItemAttribute Name="tdm" Type="string" Value="Scène 6 — La chambre" Parameter="" Relationship="none" RelationshipTo="" AutoAddTo="none"/>
            </PageItemAttributes>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="560.630551181103" YPOS="33094.8465640025" OwnPage="104" ItemID="260435072" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5158553410718" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="260449232" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Avant la scène — quelques mots sur ce qui est vrai­ment en jeu"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Cette scène est dif­fé­rente des cinq pré­cé­dentes. Pas parce qu'elle est plus grave. Parce qu'elle est plus proche."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Les tâches mé­na­gères, l'heure de re­tour, l'ar­gent, les en­fants — ce sont des su­jets qu'on peut mettre sur la table, dé­battre, né­go­cier. Ils ont une forme ex­té­rieure. On peut poin­ter quelque chose de concret."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="La sexua­li­té dans un couple n'a pas cette forme-là. Elle touche à quelque chose qui ré­siste aux mots — le dé­sir, la vul­né­ra­bi­li­té, le be­soin d'être vou­lu. Et der­rière ces mots-là, quelque chose d'en­core plus fon­da­men­tal : est-ce que je compte pour toi ?"/>
                <ITEXT FONT="Times New Roman Italic" CH=" Est-ce que tu me vois — pas comme un co­lo­ca­taire, pas comme un pa­rent de nos en­fants, pas comme quel­qu'un avec qui je par­tage un bud­get — mais comme quel­qu'un à qui tu tiens, spé­ci­fi­que­ment, in­ti­me­ment ?"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="C'est pour ça que ce su­jet est si dif­fi­cile à abor­der. Pas parce qu'il est ta­bou — même si la pu­deur est réelle. Parce qu'il ex­pose quelque chose qu'on ne peut pas dé­fendre avec des ar­gu­ments."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Il y a aus­si une croyance ré­pan­due, ra­re­ment for­mu­lée, qui com­plique tout : la sexua­li­té, "/>
                <ITEXT FONT="Times New Roman Italic" CH="c'est ce qui nous dif­fé­ren­cie d'une ami­tié. Si elle dis­pa­raît, qu'est-ce qu'on est ?"/>
                <ITEXT CH=" Cette croyance trans­forme chaque re­fus en me­nace exis­ten­tielle pour le lien. Et chaque de­mande en test de l'état du couple."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ce n'est pas une vé­ri­té. Mais c'est une croyance très ac­tive — et elle mé­rite d'être nom­mée avant d'en­trer dans la scène."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Une der­nière chose. Ce que la plu­part des gens cherchent quand ils cherchent de l'in­ti­mi­té phy­sique n'est pas tou­jours ce qu'ils de­mandent. Der­rière le dé­sir sexuel, il y a sou­vent quelque chose de plus simple et de plus pro­fond : de la cha­leur. De la connexion. La cer­ti­tude d'exis­ter pour l'autre d'une fa­çon qui n'ap­par­tient qu'à vous deux. Le sexe peut être le che­min vers ça — ou le seul che­min qu'on connaît pour y al­ler. Mais ce n'est pas la seule route."/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="C'est de­puis cet en­droit-là que cette scène mé­rite d'être lue."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="La scène"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Chambre, 23h. Ils sont au lit. Les lu­mières sont éteintes. Il se rap­proche, pose une main sur son épaule."/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Lui : (voix basse) &quot;Tu dors ?&quot;"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Elle : &quot;Pas en­core.&quot;"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Un si­lence. Il reste proche."/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Elle : &quot;Je suis vrai­ment fa­ti­guée ce soir.&quot;"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Lui : &quot;Ouais.&quot; (il se re­tourne de son cô­té)"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Si­lence. Les deux les yeux ou­verts dans le noir."/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Elle : (après un mo­ment) &quot;Tu es fâ­ché ?&quot;"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Lui : &quot;Non. Dors bien.&quot;"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Elle se re­tourne. Le si­lence s'ins­talle — pas pai­sible. Cha­cun de son cô­té, cha­cun dans sa tête."/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Tu te re­con­nais ?"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Cette scène, je la vis : ja­mais · par­fois · sou­vent"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Dans cette scène, tu res­sembles plu­tôt à : ce­lui qui s'ap­proche · ce­lui qui dit non · les deux se­lon les mo­ments"/>
                <trail PARENT="BODY" ALIGN="3"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="141.102992125985" YPOS="33094.8465640025" OwnPage="103" ItemID="260446400" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5158553410718" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <trail/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="141.102992125985" YPOS="33730.1218395931" OwnPage="105" ItemID="260449232" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5155403804445" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="260435072"/>
        <PAGEOBJECT XPOS="560.630551181103" YPOS="33730.1218395931" OwnPage="106" ItemID="260437904" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5155403804445" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="260443568" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Avant l'ana­lyse — une chose im­por­tante"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Si tu te re­con­nais dans cette scène, tu connais pro­ba­ble­ment ce que ça fait de vou­loir quelque chose — et de ne pas sa­voir com­ment le dire."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="L'ap­proche si­len­cieuse à 23h n'est pas une de­mande. C'est une ten­ta­tive. Un geste qui es­père être com­pris sans avoir à s'ex­po­ser da­van­tage. Et cette fa­çon-là de ne pas dire — de lais­ser l'autre de­vi­ner — place l'autre dans une po­si­tion dif­fi­cile : ré­pondre à chaud, sans pré­pa­ra­tion, de­puis l'en­droit où il se trouve à ce mo­ment-là. Sou­vent épui­sé. Sou­vent dé­jà ailleurs dans sa tête."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Le re­fus qui suit n'est pas tou­jours un re­jet. C'est sou­vent la ré­ponse d'un corps qui n'a plus de res­source — pas pour ça, pas main­te­nant. Mais parce que la de­mande n'a pas été po­sée, le re­fus ne peut pas être nuan­cé non plus. Il ar­rive brut, même quand il est doux. Et dans le si­lence qui suit, cha­cun reste seul avec ce qu'il n'a pas dit."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ce qui man­quait dans cette scène n'était pas du dé­sir. C'était une conver­sa­tion — plus tôt dans la soi­rée, dans un mo­ment où les deux étaient en­core dis­po­nibles. "/>
                <ITEXT FONT="Times New Roman Italic" CH="&quot;J'au­rais en­vie qu'on ait un mo­ment en­semble ce soir.&quot;"/>
                <ITEXT CH=" Cette phrase-là ouvre quelque chose. Elle laisse à l'autre la li­ber­té de ré­pondre — pas de­puis l'obli­ga­tion ou le re­jet, mais de­puis ce qui est vrai­ment pos­sible pour lui. Peut-être pas ce qui était de­man­dé. Mais peut-être quelque chose — un câ­lin, une proxi­mi­té, un mo­ment de cha­leur qui n'exige rien mais qui dit on est en­core nous."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="L'in­ti­mi­té ne se ré­sume pas à la sexua­li­té. Et c'est sou­vent quand on croit que c'est tout ou rien qu'on fi­nit avec rien."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ce qui se passe vrai­ment"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <ITEXT CH="Ce qui s'est pas­sé dans cette scène n'a du­ré que trente se­condes. Et pour­tant les deux vont mettre du temps à trou­ver le som­meil."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Lui n'a pas de­man­dé quelque chose. Il s'est ap­pro­ché. Ce geste-là — simple, si­len­cieux, vul­né­rable — por­tait quelque chose qu'il n'au­rait pas pu for­mu­ler fa­ci­le­ment. Peut-être : j'ai en­vie de toi. j'ai en­vie d'être proche. j'ai be­soin de sen­tir qu'on est en­core nous. Peut-être quelque chose de plus simple en­core : je veux te tou­cher."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Elle a dit non — dou­ce­ment, sans bru­ta­li­té, avec une vraie fa­tigue. Elle n'a pas re­je­té lui. Elle a re­fu­sé quelque chose qu'elle n'avait pas l'éner­gie de don­ner ce soir. La nuance est réelle. Mais dans l'obs­cu­ri­té, dans le si­lence qui a sui­vi, cette nuance s'est per­due."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="&quot;"/>
                <ITEXT FONT="Times New Roman Italic" CH="Tu es fâ­ché ?"/>
                <ITEXT CH="&quot; dit qu'elle a sen­ti quelque chose. Pas de la co­lère — du re­trait. Ce re­trait-là lui a par­lé plus fort que ses mots. Et son &quot;non, dors bien&quot; — trop court, trop propre — a confir­mé ce qu'elle crai­gnait : qu'il soit bles­sé. Qu'elle ait fait quelque chose de mal en étant sim­ple­ment fa­ti­guée."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Per­sonne n'a dit ce qui se pas­sait vrai­ment. Per­sonne n'avait les mots pour ça — pas à 23h, pas dans le noir, pas sans ris­quer quelque chose."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <ITEXT CH="Un mot sur les dif­fé­rences — sans gé­né­ra­li­ser"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Il y a une réa­li­té que cette scène porte sans la nom­mer : le dé­sir ne fonc­tionne pas de la même fa­çon pour tout le monde. Et dans beau­coup de couples — pas tous, mais beau­coup — il existe un dé­ca­lage. L'un est plus sou­vent de­man­deur, l'autre plus sou­vent en re­trait. Ce n'est pas une ques­tion de manque d'amour. Ce n'est pas non plus une fa­ta­li­té."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ce dé­ca­lage vient sou­vent de choses simples et pro­fondes à la fois. La fa­tigue s'ac­cu­mule dif­fé­rem­ment. Le stress coupe le dé­sir dif­fé­rem­ment. Le be­soin de connexion s'ex­prime dif­fé­rem­ment — l'un par le corps, l'autre par les mots, le temps par­ta­gé, la ten­dresse quo­ti­dienne. Ce que l'un lit comme un si­gnal d'in­ti­mi­té — il s'ap­proche, il veut de moi — l'autre le lit par­fois comme une pres­sion — en­core une de­mande que je n'ai pas l'éner­gie d'ho­no­rer."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ces dif­fé­rences ne sont pas des dé­fauts. Elles sont des lan­gages qui ne se sont pas en­core trou­vé de tra­duc­teur com­mun."/>
                <trail PARENT="BODY" ALIGN="3"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="141.102992125985" YPOS="34365.3971151836" OwnPage="107" ItemID="260443568" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5152254198172" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="260437904"/>
        <PAGEOBJECT XPOS="560.630551181103" YPOS="34365.3971151836" OwnPage="108" ItemID="260440736" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5152254198172" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="285068448" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Les états du moi en pré­sence :"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ce qui est frap­pant ici : les deux dé­marrent de­puis l'"/>
                <ITEXT FONT="Times New Roman Bold" CH="En­fant Libre"/>
                <ITEXT CH=" — spon­ta­né, ou­vert, sans cal­cul. Et c'est l'"/>
                <ITEXT FONT="Times New Roman Bold" CH="En­fant Bles­sé"/>
                <ITEXT CH=" qui prend le des­sus, des deux cô­tés, dans le si­lence qui suit. "/>
                <ITEXT FONT="Times New Roman Bold" CH="L'Adulte"/>
                <ITEXT CH=" — ce­lui qui pour­rait dire &quot;"/>
                <ITEXT FONT="Times New Roman Italic" CH="je t'ai sen­ti te re­ti­rer et j'ai eu peur que tu sois bles­sé"/>
                <ITEXT CH="&quot; ou &quot;"/>
                <ITEXT FONT="Times New Roman Italic" CH="quand tu dis non, quelque chose se ferme en moi, pas de la co­lère, plu­tôt de la tris­tesse"/>
                <ITEXT CH="&quot; — n'a pas de place dans ce mo­ment-là."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ce n'est pas un manque de ma­tu­ri­té. C'est la na­ture de ce qui se joue ici. On ne parle pas de dé­sir de­puis "/>
                <ITEXT FONT="Times New Roman Bold" CH="l'Adulte"/>
                <ITEXT CH=". On le vit de­puis "/>
                <ITEXT FONT="Times New Roman Bold" CH="l'En­fant"/>
                <ITEXT CH=" — et c'est pré­ci­sé­ment pour ça que les mots manquent."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Le tri­angle de Karp­man — le drame si­len­cieux"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ce qui rend ce tri­angle par­ti­cu­lier, c'est qu'il se joue presque en­tiè­re­ment en si­lence. Pas de cris, pas de re­proche ou­vert. Et pour­tant les rôles sont là — ac­tifs, dou­lou­reux, aus­si réels que dans les scènes pré­cé­dentes."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT FONT="Times New Roman Bold" CH="Acte 1"/>
                <ITEXT CH=" — l'ap­proche. Il s'ap­proche de­puis un en­droit vul­né­rable. Il est en "/>
                <ITEXT FONT="Times New Roman Bold" CH="En­fant Libre"/>
                <ITEXT CH=" — spon­ta­né, ou­vert, sans dé­fense. Ce mo­ment-là, avant la ré­ponse, est peut-être le plus ex­po­sé de la scène."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT FONT="Times New Roman Bold" CH="Acte 2"/>
                <ITEXT CH=" — le re­fus. Elle dit non — dou­ce­ment, hon­nê­te­ment. Elle n'est pas "/>
                <ITEXT FONT="Times New Roman Bold" CH="Per­sé­cu­teur"/>
                <ITEXT CH=". Elle est sim­ple­ment fa­ti­guée. Mais dans la lo­gique du tri­angle, son re­fus le place mal­gré elle dans une po­si­tion de "/>
                <ITEXT FONT="Times New Roman Bold" CH="Vic­time"/>
                <ITEXT CH=" — pas re­je­té vio­lem­ment, mais lais­sé seul avec quelque chose qu'il avait ten­du."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT FONT="Times New Roman Bold" CH="Acte 3"/>
                <ITEXT CH=" — le re­trait. Il se re­tourne. Ce re­trait si­len­cieux est un dé­pla­ce­ment de rôle. Il bas­cule en "/>
                <ITEXT FONT="Times New Roman Bold" CH="Per­sé­cu­teur"/>
                <ITEXT CH=" pas­sif — pas par in­ten­tion, mais par ef­fet. Son si­lence pu­nit sans le dire. Elle le sent. Et c'est ce qui la fait de­man­der &quot;tu es fâ­ché ?&quot;"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT FONT="Times New Roman Bold" CH="Acte 4"/>
                <ITEXT CH=" — le coup de théâtre. Elle de­mande. Elle est main­te­nant en "/>
                <ITEXT FONT="Times New Roman Bold" CH="Vic­time"/>
                <ITEXT CH=" — cou­pable d'une bles­sure qu'elle n'a pas vou­lue, an­xieuse de la ré­ac­tion qu'elle a pro­vo­quée. Lui ré­pond &quot;non, dors bien&quot; — et re­de­vient "/>
                <ITEXT FONT="Times New Roman Bold" CH="Sau­veur"/>
                <ITEXT CH=" de fa­çade, ce­lui qui dit que tout va bien pour que ça s'ar­rête. Mais les deux savent que tout ne va pas bien."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT FONT="Times New Roman Bold" CH="En­fant Libre"/>
                <ITEXT CH=" (lui) → "/>
                <ITEXT FONT="Times New Roman Bold" CH="Vic­time"/>
                <ITEXT CH=" du re­fus → "/>
                <ITEXT FONT="Times New Roman Bold" CH="Per­sé­cu­teur"/>
                <ITEXT CH=" si­len­cieux → Elle en "/>
                <ITEXT FONT="Times New Roman Bold" CH="Vic­time"/>
                <ITEXT CH=" cou­pable → "/>
                <ITEXT FONT="Times New Roman Bold" CH="Sau­veur"/>
                <ITEXT CH=" de fa­çade (lui) → si­lence dou­lou­reux des deux cô­tés"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Le bé­né­fice ca­ché du drame"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ce tri­angle dure parce qu'il pro­tège quelque chose — chez cha­cun, dif­fé­rem­ment."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Pour lui : ne pas for­mu­ler la de­mande pro­tège de quelque chose de plus ex­po­sant en­core que le corps — la vul­né­ra­bi­li­té des mots. Tant que la de­mande reste un geste, un si­lence, une ap­proche phy­sique, il n'a pas à dire ce qu'il cherche vrai­ment. Et si c'est re­fu­sé, c'est le geste qui est re­fu­sé — pas les mots. Pas ce qu'il y avait der­rière."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Pour elle : gé­rer la culpa­bi­li­té après le re­fus est in­con­for­table — mais c'est un ter­rain connu. Plus fa­mi­lier, en tout cas, que la conver­sa­tion sur ce dont elle a be­soin pour avoir en­vie de connexion. Ce qu'elle ai­me­rait — être vue dans sa fa­tigue avant d'être dé­si­rée, être re­jointe sans pres­sion, trou­ver un autre che­min vers la proxi­mi­té — est dif­fi­cile à for­mu­ler. Alors elle ne le for­mule pas. Et la culpa­bi­li­té prend la place."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Les deux évitent la même chose — non pas l'in­ti­mi­té, mais les mots qui per­met­traient de la construire au­tre­ment. Et cet évi­te­ment-là, ré­pé­té, creuse dou­ce­ment la dis­tance qu'au­cun des deux ne veut."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Le jeu &quot;Bat­tez-vous&quot; — et sa ver­sion si­len­cieuse"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Le jeu dé­crit par Berne sous le nom &quot;Bat­tez-vous&quot; prend ici une forme par­ti­cu­lière. Dans sa ver­sion clas­sique, un grief ex­té­rieur est uti­li­sé pour re­je­ter une ap­proche in­time — trans­for­mant une vul­né­ra­bi­li­té en conflit de pou­voir. La sexua­li­té de­vient un ter­rain de né­go­cia­tion, voire de pu­ni­tion."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Dans cette scène, il n'y a pas de grief ou­vert. Mais la struc­ture est si­mi­laire — et plus in­si­dieuse. Le conflit ne s'ex­prime pas, il se dé­pose. Dans le re­trait si­len­cieux. Dans le &quot;dors bien&quot; trop court. Dans les yeux ou­verts dans le noir."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ce jeu-là a un bé­né­fice se­con­daire pré­cis : il per­met d'évi­ter l'in­ti­mi­té réelle — pa­ra­doxa­le­ment — en la de­man­dant ou en la re­fu­sant. Parce que l'in­ti­mi­té réelle, celle des mots vrais dans le noir, est plus ex­po­sante en­core que le corps."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="L'alerte à ne pas man­quer"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="La sor­tie de ce jeu n'est pas de faire plus d'ef­forts — ni d'ac­cep­ter quand on n'en a pas en­vie."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ac­cep­ter sans dé­sir réel ne nour­rit pas l'in­ti­mi­té. Ça crée une dette si­len­cieuse — de part et d'autre."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="La vraie ques­tion pour lui n'est pas &quot;"/>
                <ITEXT FONT="Times New Roman Italic" CH="com­ment ob­te­nir plus sou­vent un oui ?"/>
                <ITEXT CH="&quot; C'est &quot;q"/>
                <ITEXT FONT="Times New Roman Italic" CH="u'est-ce que je cherche vrai­ment quand je m'ap­proche — et est-ce que je peux le dire au­tre­ment, ou plus tôt ?&quot;"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="La vraie ques­tion pour elle n'est pas &quot;"/>
                <ITEXT FONT="Times New Roman Italic" CH="com­ment re­fu­ser sans le bles­ser "/>
                <ITEXT CH="?&quot; C'est &quot;"/>
                <ITEXT FONT="Times New Roman Italic" CH="de quoi ai-je be­soin pour me sen­tir dis­po­nible à la connexion — et est-ce que je le sais moi-même ?&quot;"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ces deux ques­tions pointent vers le même en­droit : l'in­ti­mi­té n'est pas un acte. C'est un état — qu'on construit ou qu'on laisse s'éro­der, dans les gestes quo­ti­diens, bien avant 23h."/>
                <trail PARENT="BODY" ALIGN="3"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="141.102992125985" YPOS="35000.6723907742" OwnPage="109" ItemID="285068448" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5149104591899" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="285057120" BACKITEM="260440736"/>
