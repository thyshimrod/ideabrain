        <PAGEOBJECT XPOS="142.858897637795" YPOS="28671.5623078531" OwnPage="89" ItemID="285082608" PTYPE="2" WIDTH="335.57814786426" HEIGHT="164.300884955752" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="0.39" LOCALSCY="0.39" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" Pagenumber="0" PFILE="images/en/etatmoichap5.png" PRFILE="Embedded sRGB built-in" IRENDER="0" EPROF="Embedded sRGB built-in" path="M0 0 L335.578 0 L335.578 164.301 L0 164.301 L0 0 Z" copath="M0 0 L335.578 0 L335.578 164.301 L0 164.301 L0 0 Z" gXpos="142.858897637795" gYpos="28671.5623078531" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1"/>
