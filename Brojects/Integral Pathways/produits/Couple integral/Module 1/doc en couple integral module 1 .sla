        <PAGEOBJECT XPOS="560.630551181103" YPOS="38812.3240443174" OwnPage="122" ItemID="211815872" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5130206954262" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Une der­nière chose"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ce book­let a tra­ver­sé six scènes. Des dis­putes sur la vais­selle, des re­tours tar­difs, des ap­pels dif­fi­ciles, des bud­gets dé­pas­sés, des de­voirs qui ré­sistent, des nuits si­len­cieuses."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Au­cune de ces scènes n'était vrai­ment sur ce qu'elle sem­blait être."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Les tâches mé­na­gères par­laient de qui porte quoi — et pour­quoi. Le re­tour tar­dif par­lait du be­soin d'exis­ter pour l'autre. L'ap­pel avec la mère par­lait d'être en­ten­du, pas conseillé. L'ar­gent par­lait de li­ber­té et de confiance. Les de­voirs par­laient de lé­gi­ti­mi­té et d'his­toire. Et cette der­nière scène — peut-être la plus simple de toutes dans sa forme, peut-être la plus char­gée dans son fond — par­lait d'une seule chose : est-ce que je compte pour toi, d'une fa­çon qui n'ap­par­tient qu'à nous ?"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ce n'est pas une ques­tion qu'on pose. C'est une ques­tion qu'on joue — dans les si­lences, les re­traits, les re­prises de contrôle, les so­lu­tions non de­man­dées, les nuits les yeux ou­verts dans le noir."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ce book­let ne ré­sout pas cette ques­tion. Il pro­pose quelque chose de plus mo­deste et de plus utile : com­men­cer à la voir. Parce que voir un jeu, c'est dé­jà ne plus en être en­tiè­re­ment pri­son­nier."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="La suite — si vous vou­lez al­ler plus loin — c'est la conver­sa­tion. Celle qui n'a pas en­core eu lieu. Celle qui com­mence par &quot;j"/>
                <ITEXT FONT="Times New Roman Italic" CH="e vais te dire quelque chose de dif­fi­cile à for­mu­ler&quot;"/>
                <ITEXT CH=" — et qui se tient dans un mo­ment où les deux sont prêts à en­tendre."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ce mo­ment-là, vous seuls pou­vez le choi­sir."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para ALIGN="3"/>
                <ITEXT CH="Par ailleurs, même si je tiens vrai­ment à ce que vous de­ve­niez au­to­nome sur cette re­cherche d'une re­la­tion &quot;amé­lio­rée&quot;, c'est sou­vent très dif­fi­cile de ré­soudre en étant soi même im­pli­qué dans la re­la­tion. Une aide ex­té­rieure est sou­vent un moyen de prendre conscience et de rendre plus douce la dis­cus­sion. N'hé­si­tez pas à me contac­ter pour en dis­cu­ter ou être ac­com­pa­gné. Ce­la se­ra avec plai­sir que je vous ré­pon­drai."/>
                <trail PARENT="BODY" ALIGN="3"/>
            </StoryText>
        </PAGEOBJECT>
