        <PAGEOBJECT XPOS="141.912134346039" YPOS="24449.7238046129" OwnPage="75" ItemID="257669952" PTYPE="2" WIDTH="335.504424778761" HEIGHT="76.9105818410062" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="0.39" LOCALSCY="0.39" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" Pagenumber="0" PFILE="images/en/need1chap4.png" PRFILE="Embedded sRGB built-in" IRENDER="0" EPROF="Embedded sRGB built-in" path="M0 0 L335.504 0 L335.504 76.9106 L0 76.9106 L0 0 Z" copath="M0 0 L335.504 0 L335.504 76.9106 L0 76.9106 L0 0 Z" gXpos="141.912134346039" gYpos="24449.7238046129" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1"/>
