                <ITEXT CH=" Scène 1 — Les tâches ménagères"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <ITEXT CH="&quot;La Jambe de Bois&quot;"/>
