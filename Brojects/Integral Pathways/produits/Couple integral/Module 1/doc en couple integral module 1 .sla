        <PAGEOBJECT XPOS="579.257267089401" YPOS="29373.5020667549" OwnPage="92" ItemID="285088272" PTYPE="5" WIDTH="295.263379417221" HEIGHT="1" FRTYPE="0" CLIPEDIT="0" ROT="359.914137254786" PWIDTH="0.283464566929134" PCOLOR="bordeaux" SHADE="0" PCOLOR2="bordeaux" PLINEART="1" path="" gXpos="579.257267089402" gYpos="12856.3367124242" gWidth="0" gHeight="0" LAYER="0"/>
