                <DefaultStyle/>
                <trail/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="560.630551181103" YPOS="3872.18388683715" OwnPage="12" ItemID="537251232" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5303435300678" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="La scène"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para ALIGN="3"/>
                <ITEXT CH="Cui­sine, le soir. Elle charge le lave-vais­selle, lui est as­sis au sa­lon."/>
                <para PARENT="narration" ALIGN="3"/>
                <para ALIGN="3"/>
                <ITEXT CH="Elle : &quot;Tu peux lan­cer une ma­chine ?&quot;"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Il ar­rive dans la cui­sine, re­garde la ma­chine."/>
                <para PARENT="narration" ALIGN="3"/>
                <ITEXT CH="Lui : &quot;Euh... c'est quel pro­gramme dé­jà ?&quot;"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Elle sou­pire, s'ap­proche."/>
                <para PARENT="narration" ALIGN="3"/>
                <ITEXT CH="Elle : &quot;Laisse, je vais le faire.&quot;"/>
                <para PARENT="DIALOGUE" ALIGN="3"/>
                <ITEXT CH="Il re­part vers le sa­lon. Elle reste de­vant la ma­chine, vi­sage fer­mé."/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <ITEXT CH="Plus tard, dans la soi­rée."/>
                <para PARENT="narration" ALIGN="3"/>
                <ITEXT CH="Elle : &quot;Tu pour­rais quand même faire un ef­fort.&quot;"/>
                <para PARENT="DIALOGUE" ALIGN="3"/>
                <ITEXT CH="Lui : &quot;La der­nière fois que j'ai vou­lu t'ai­der, tu es re­pas­sée der­rière moi pour tout re­faire. Alors à quoi bon.&quot;"/>
                <para PARENT="DIALOGUE" ALIGN="3"/>
                <para ALIGN="3"/>
                <ITEXT CH="Si­lence. Cha­cun de son cô­té."/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Tu te re­con­nais ?"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="&gt; Cette scène, je la vis : ja­mais · par­fois · sou­vent"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="&gt; Dans cette scène, tu res­sembles plu­tôt à : ce­lui qui de­mande · ce­lui qui &quot;ne sait pas&quot; · les deux se­lon les mo­ments"/>
                <trail PARENT="BODY" ALIGN="3"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="141.102992125984" YPOS="4507.4591624277" OwnPage="13" ItemID="537259728" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5300285694373" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Avant l'ana­lyse — une chose im­por­tante"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Si tu lis ce book­let, c'est pro­ba­ble­ment parce que quelque chose ne va pas. Parce que tu es fa­ti­gué de por­ter plus que ta part. Parce que tu as l'im­pres­sion que quoi que tu fasses, ce n'est ja­mais as­sez bien. Parce que les mêmes dis­putes re­viennent — sur les mêmes su­jets, avec les mêmes mots — et que tu ne com­prends plus très bien com­ment en sor­tir."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ce que tu res­sens est réel. L'épui­se­ment est réel. La frus­tra­tion est réelle. Ce book­let ne va pas te dire que tu as tort de les res­sen­tir."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Mais il va te pro­po­ser quelque chose d'un peu in­con­for­table : re­gar­der aus­si ce qui se passe de ton cô­té. Pas pour te culpa­bi­li­ser. Pas pour dire que tu as au­tant tort que l'autre. Mais parce que c'est le seul en­droit de­puis le­quel tu peux vrai­ment chan­ger quelque chose."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="On ne peut pas chan­ger l'autre. On peut chan­ger ce qu'on fait — et ob­ser­ver com­ment le sys­tème se re­con­fi­gure."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="C'est tout ce que ce book­let te de­mande."/>
                <trail PARENT="BODY" ALIGN="3"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="560.630551181103" YPOS="4507.4591624277" OwnPage="14" ItemID="537254064" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5300285694373" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="537265392" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Ce qui se passe vrai­ment"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="La scène que tu viens de lire, tu l'as peut-être vé­cue des di­zaines de fois. Les dé­tails changent — la ma­chine à la­ver, la vais­selle, les courses, la salle de bain. Mais la struc­ture reste la même. L'un de­mande. L'autre ne sait pas, ou fait sem­blant de ne pas sa­voir. L'un re­prend. L'autre re­part. Et le soir, quelque chose de lourd flotte dans l'air sans que per­sonne ne sache vrai­ment quoi en faire."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ce qui se passe en sur­face res­semble à un pro­blème d'or­ga­ni­sa­tion. Qui fait quoi. Qui sait quoi. Ce qui se passe vrai­ment est dif­fé­rent."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Un sys­tème s'est ins­tal­lé — pro­gres­si­ve­ment, sans que per­sonne ne l'ait dé­ci­dé. Comme tous les sys­tèmes, il a sa propre lo­gique. Il se main­tient tout seul. Et il coûte énor­mé­ment — pas en éner­gie dé­pen­sée pour les tâches, mais en res­sen­ti­ment qui s'ac­cu­mule, en dis­tance qui s'ins­talle, en image de l'autre qui se dé­forme dou­ce­ment."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ce n'est pas une dis­pute sur la les­sive. C'est une dis­pute sur qui est res­pon­sable de quoi dans ce couple — et ce que ça dit de cha­cun."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ce que cha­cun vit vrai­ment"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Com­men­çons par elle — parce que si tu te re­con­nais dans ce rôle, tu mé­rites qu'on nomme ce que tu portes vrai­ment."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Gé­rer le foyer en grande par­tie seule, c'est épui­sant. Pas seule­ment phy­si­que­ment. C'est la charge men­tale — cette liste per­ma­nente dans la tête de ce qui reste à faire, ce qui va man­quer, ce qu'il fau­dra pen­ser à or­ga­ni­ser. Cette liste que per­sonne d'autre ne porte. Et quand en­fin tu de­mandes de l'aide, tu ob­tiens un re­gard per­du de­vant la ma­chine à la­ver — alors que cette ma­chine tourne de­puis des an­nées dans cet ap­par­te­ment."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ce que tu res­sens là n'est pas de la mau­vaise hu­meur. C'est de l'épui­se­ment pro­fond. Et quelque chose qui res­semble à de la so­li­tude."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Main­te­nant, lui."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Si tu te re­con­nais dans l'autre rôle — ce­lui qui &quot;ne sait pas&quot;, ce­lui qui re­part au sa­lon — tu connais peut-être ce sen­ti­ment : quoi que tu fasses, c'est tou­jours re­vu, cor­ri­gé, re­fait. Tu charges le lave-vais­selle, elle ré­or­ga­nise les verres. Tu plies le linge, elle re­fait les piles. Tu es­saies de bien faire — et le mes­sage que tu re­çois, sans qu'on te le dise avec des mots, c'est que ça ne suf­fit pas. Que ta fa­çon de faire n'est pas la bonne fa­çon."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="À un mo­ment, tu ar­rêtes d'es­sayer. Pas par pa­resse. Par dé­cou­ra­ge­ment."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ces deux vé­cus sont réels. Les deux sont lé­gi­times. Et les deux ali­mentent le même sys­tème — sans que ni l'un ni l'autre ne l'ait vou­lu."/>
                <trail PARENT="BODY" ALIGN="3"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="141.102992125984" YPOS="5142.73443801826" OwnPage="15" ItemID="537265392" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5297136088073" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="537254064"/>
        <PAGEOBJECT XPOS="560.630551181103" YPOS="5142.73443801826" OwnPage="16" ItemID="537262560" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5297136088073" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Le jeu qui se joue — sans que per­sonne ne l'ait dé­ci­dé"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="En psy­cho­lo­gie, on ap­pelle ça un jeu — pas dans le sens amu­sant du terme, mais dans le sens d'un scé­na­rio qui se ré­pète, avec des rôles fixes, et une conclu­sion tou­jours iden­tique. Un jeu où tout le monde perd, mais où tout le monde conti­nue quand même à joue­qr."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ce­lui-ci s'ap­pelle &quot;La Jambe de Bois&quot; — et il res­semble à ce­ci."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Il y a trois rôles dans ce jeu. La "/>
                <ITEXT FONT="Times New Roman Bold" CH="Vic­tim"/>
                <ITEXT CH="e  — ce­lui qui su­bit, qui ne peut pas, qui est dé­pas­sé. Le "/>
                <ITEXT FONT="Times New Roman Bold" CH="Sau­veur"/>
                <ITEXT CH=" — ce­lui qui prend en charge, qui ré­pare, qui fait à la place. Et le "/>
                <ITEXT FONT="Times New Roman Bold" CH="Per­sé­cu­teur"/>
                <ITEXT CH=" — ce­lui qui ac­cuse, qui re­proche, qui juge."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ce qui est re­tors dans ce jeu, c'est que les rôles bas­culent. Re­garde com­ment ça se passe dans la scène."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Elle ar­rive avec une de­mande — &quot;"/>
                <ITEXT FONT="Times New Roman Italic" CH="tu peux lan­cer une ma­chine ?"/>
                <ITEXT CH="&quot; Mais cette de­mande n'est pas neutre. Elle ar­rive après plu­sieurs fois où ça n'a pas été fait. Elle porte dé­jà, en si­lence, l'at­tente d'un échec. C'est la po­si­tion du "/>
                <ITEXT FONT="Times New Roman Bold" CH="Per­sé­cu­teur en at­tente"/>
                <ITEXT CH=" — pas par mé­chan­ce­té, mais parce que l'his­toire entre eux a dé­jà écrit la suite."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Lui le sent. Pas consciem­ment. Mais il sent que quoi qu'il fasse, ce ne se­ra pro­ba­ble­ment pas as­sez bien. Alors il entre en "/>
                <ITEXT FONT="Times New Roman Bold" CH="Vic­time"/>
                <ITEXT CH=" — &quot;"/>
                <ITEXT FONT="Times New Roman Italic" CH="je ne sais pas com­ment"/>
                <ITEXT CH="&quot; est une fa­çon de dire &quot;"/>
                <ITEXT FONT="Times New Roman Italic" CH="je pré­fère ne pas es­sayer plu­tôt que d'es­sayer et échouer."/>
                <ITEXT CH="&quot;"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Elle re­prend. Elle de­vient le "/>
                <ITEXT FONT="Times New Roman Bold" CH="Sau­veur"/>
                <ITEXT CH=" — elle ré­sout, elle fait, elle main­tient le foyer. Et lui re­part au sa­lon — "/>
                <ITEXT FONT="Times New Roman Bold" CH="Vic­time"/>
                <ITEXT CH=" sou­la­gée, qui a évi­té la cri­tique."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Puis le soir, elle re­proche. Elle passe en "/>
                <ITEXT FONT="Times New Roman Bold" CH="Per­sé­cu­teur"/>
                <ITEXT CH=". Et lui sort la carte im­pa­rable — &quot;"/>
                <ITEXT FONT="Times New Roman Italic" CH="la der­nière fois que j'ai vou­lu t'ai­der, tu es re­pas­sée der­rière moi pour tout re­faire."/>
                <ITEXT CH="&quot; Il a rai­son. Et ce fait-là la place, mo­men­ta­né­ment, en "/>
                <ITEXT FONT="Times New Roman Bold" CH="Vic­time"/>
                <ITEXT CH=" de sa propre fa­çon de faire."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Elle est pié­gée. Lui est pié­gé. Et de­main, la même scène re­com­men­ce­ra."/>
                <trail PARENT="BODY" ALIGN="3"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="141.102992125984" YPOS="5778.00971360881" OwnPage="17" ItemID="537268224" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5293986481773" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="537256896" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Ce que cha­cun y trouve — la par­tie dif­fi­cile à lire"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Voi­là la sec­tion la plus in­con­for­table. Celle où tu vas peut-être avoir en­vie de fer­mer ce book­let."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Parce que ce sys­tème dure non pas parce que l'un est pa­res­seux et l'autre cou­ra­geux. Il dure parce qu'il est utile — pas consciem­ment, pas dé­li­bé­ré­ment, mais réel­le­ment — aux deux."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Pour elle. Por­ter tout donne quelque chose. Ce n'est pas seule­ment un far­deau — c'est aus­si une po­si­tion. La po­si­tion de celle qui sait, qui fait, qui tient. Une forme de contrôle sur l'es­pace et sur la fa­çon dont les choses sont faites. Et par­fois quelque chose de plus pro­fond : la convic­tion que si elle lâche, tout s'ef­fondre. Que sa va­leur dans ce couple passe en par­tie par ce qu'elle fait pour lui."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ce n'est pas sa faute. C'est sou­vent quelque chose qu'on ap­prend très tôt — que prendre soin des autres, c'est ce qui nous rend ai­mables."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Pour lui. Ne pas sa­voir pro­tège de quelque chose. Si je ne fais pas, je ne peux pas mal faire. Si je cède ra­pi­de­ment, elle re­prend — et j'évite d'être éva­lué. Cette stra­té­gie a une his­toire, elle aus­si. Quelque part, à un mo­ment, ne pas es­sayer était moins dou­lou­reux qu'es­sayer et se faire cor­ri­ger."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Lire ça peut faire ré­sis­tance. C'est nor­mal. Ce n'est pas une ac­cu­sa­tion — c'est une in­vi­ta­tion à re­gar­der hon­nê­te­ment ce que ce sys­tème te donne, à toi, en ce mo­ment. Parce que tant qu'on ne voit pas ce qu'on y trouve, on ne com­prend pas vrai­ment pour­quoi on conti­nue à y jouer."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Le piège du &quot;bien fait&quot; — un mot pour ce­lui qui re­prend"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Il y a quelque chose de spé­ci­fique qui mé­rite d'être nom­mé — parce que c'est sou­vent in­vi­sible à ce­lui qui le fait."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Quand on gère le foyer de­puis long­temps, on dé­ve­loppe une fa­çon de faire. Une lo­gique d'or­ga­ni­sa­tion qui fonc­tionne, qui est ef­fi­cace, qui a fait ses preuves. Le linge trié d'une cer­taine fa­çon. Le lave-vais­selle char­gé dans un cer­tain ordre. Les courses lis­tées se­lon un cer­tain sys­tème."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ce n'est pas du per­fec­tion­nisme ar­bi­traire. C'est de l'ex­pé­rience ac­cu­mu­lée."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Le pro­blème, c'est que cette fa­çon de faire de­vient un stan­dard im­pli­cite — ja­mais vrai­ment for­mu­lé, ja­mais vrai­ment par­ta­gé. Et quand l'autre es­saie, à sa fa­çon, avec ses ha­bi­tudes à lui — et que le ré­sul­tat ne cor­res­pond pas à ce stan­dard — quelque chose se dé­clenche. Un sou­pir. Une cor­rec­tion dis­crète. Une re­prise ra­pide — &quot;"/>
                <ITEXT FONT="Times New Roman Italic" CH="laisse, je vais re­faire"/>
                <ITEXT CH=".&quot;"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ce geste-là — même fait sans in­ten­tion de bles­ser — en­voie un mes­sage très clair à l'autre : "/>
                <ITEXT FCOLOR="bordeaux" FSHADE="100" CH="ce que tu fais n'est pas as­sez bien"/>
                <ITEXT CH="."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Et l'autre, qui a pour­tant es­sayé, re­tient la le­çon. La pro­chaine fois, il es­saie­ra moins. Puis plus du tout. Et tu te re­trouves à te plaindre qu'il ne fait rien — alors que tu l'as, sans le vou­loir, for­mé à ne pas faire."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Une ques­tion à se po­ser hon­nê­te­ment :"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT FONT="Times New Roman Italic" CH="Est-ce que je re­prends parce que c'est vrai­ment né­ces­saire — ou parce que ce n'est pas fait comme je l'au­rais fait moi ?"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ces deux rai­sons ne sont pas la même chose. La pre­mière est une ques­tion de ré­sul­tat — quelque chose ne fonc­tionne pas, il faut cor­ri­ger. La se­conde est une ques­tion de pré­fé­rence. Et les pré­fé­rences, elles, peuvent se né­go­cier."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Et si tu lais­sais le linge plié dif­fé­rem­ment — mais plié ? Et si tu lais­sais la cui­sine ran­gée se­lon sa lo­gique à lui — pas la tienne, mais une lo­gique quand même ?"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Qu'est-ce que ça chan­ge­rait vrai­ment ? Et qu'est-ce que ça li­bè­re­rait — pour toi, pour lui, pour vous deux ?"/>
                <trail PARENT="BODY" ALIGN="3"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="560.630551181103" YPOS="5778.00971360881" OwnPage="18" ItemID="537256896" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5293986481773" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="537268224"/>
        <PAGEOBJECT XPOS="141.102992125984" YPOS="7048.56026478991" OwnPage="21" ItemID="537279552" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5287687269172" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="537282384" BACKITEM="468789472"/>
        <PAGEOBJECT XPOS="560.630551181103" YPOS="7048.56026478991" OwnPage="22" ItemID="537282384" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5287687269172" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="537279552"/>
        <PAGEOBJECT XPOS="560.630551181103" YPOS="10860.2119183332" OwnPage="34" ItemID="537271056" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5268789631399" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="537273888" BACKITEM="468797968"/>
        <PAGEOBJECT XPOS="141.102992125984" YPOS="11495.4871939238" OwnPage="35" ItemID="537273888" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5265640025107" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="537271056"/>
        <PAGEOBJECT XPOS="560.630551181103" YPOS="11495.4871939238" OwnPage="36" ItemID="537285216" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5265640025107" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Ce dont on a vrai­ment be­soin — l'angle CNV"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <ITEXT CH="Avant d'al­ler plus loin, un point im­por­tant."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Dans cette scène, les deux pro­ta­go­nistes n'oc­cupent pas la même po­si­tion — et ils n'ont pas les mêmes be­soins. Les mé­lan­ger, c'est ra­ter quelque chose d'es­sen­tiel."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ce qui suit pro­pose deux lec­tures sé­pa­rées. Pas pour dé­si­gner un cou­pable et une vic­time. Pour per­mettre à cha­cun de se re­con­naître hon­nê­te­ment dans ce qui est ac­ti­vé en lui — et de trou­ver sa propre porte de sor­tie."/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Et dans les deux cas, la même règle s'ap­plique : un be­soin m'ap­par­tient. Il ne dé­pend pas de ce que l'autre fait ou ne fait pas. Je suis res­pon­sable de trou­ver com­ment le nour­rir — pas d'at­tendre que l'autre le de­vine."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Si tu es ce­lui ou celle qui at­tend"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ce que tu ex­primes à tra­vers le re­proche n'est pas vrai­ment de la co­lère contre les ho­raires de l'autre. C'est une in­for­ma­tion sur ce qui compte pour toi — et sur ce qui s'érode quand les soi­rées se res­semblent toutes."/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Lis cette liste. Coche ce qui ré­sonne vrai­ment."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para ALIGN="3"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="141.102992125984" YPOS="12130.7624695144" OwnPage="37" ItemID="537288048" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5262490418816" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Une fois ton be­soin iden­ti­fié, com­plète cette phrase :"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="&quot;J'ai be­soin de __. Quand je me re­con­necte à ce be­soin, ce que je choi­sis de faire c'est __.&quot;"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Quelques exemples :"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="&quot;J'ai be­soin de connexion. Ce que je choi­sis de faire c'est pro­po­ser un soir par se­maine sanc­tua­ri­sé — pas for­cé­ment grand-chose, juste nous deux sans écran.&quot;"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <ITEXT CH="&quot;J'ai be­soin de fun. Ce que je choi­sis de faire c'est sug­gé­rer quelque chose de spon­ta­né ce week-end — pas pla­ni­fier à l'ex­cès, juste pro­po­ser.&quot;"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <ITEXT CH="&quot;J'ai be­soin d'in­ti­mi­té. Ce que je choi­sis de faire c'est dire clai­re­ment ce dont j'ai en­vie — plu­tôt que d'es­pé­rer que l'autre le de­vine.&quot;"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Si tu es ce­lui ou celle qui rentre"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ce que tu vis en ren­trant tard et fa­ti­gué n'est pas de l'in­dif­fé­rence. C'est sou­vent de l'épui­se­ment. Et l'épui­se­ment a ses propres be­soins — qui mé­ritent d'être nom­més, pas tus."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Lis cette liste. Coche ce qui ré­sonne vrai­ment."/>
                <trail PARENT="BODY" ALIGN="3"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="560.630551181103" YPOS="12130.7624695144" OwnPage="38" ItemID="537276720" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5262490418816" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Une fois ton be­soin iden­ti­fié, com­plète cette phrase :"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="&quot;J'ai be­soin de __. Quand je me re­con­necte à ce be­soin, ce que je choi­sis de faire c'est __.&quot;"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Quelques exemples :"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="&quot;J'ai be­soin d'es­pace. Ce que je choi­sis de faire c'est dire en ren­trant — une phrase, pas une ex­pli­ca­tion — que j'ai be­soin de dix mi­nutes avant d'être là.&quot;"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <ITEXT CH="&quot;J'ai be­soin d'em­pa­thie. Ce que je choi­sis de faire c'est de­man­der à l'autre de m'en­tendre deux mi­nutes sur ma jour­née avant qu'on passe à autre chose.&quot;"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <ITEXT CH="&quot;J'ai be­soin de dou­ceur. Ce que je choi­sis de faire c'est nom­mer ce dont j'ai be­soin en ren­trant — plu­tôt que d'at­tendre que l'am­biance me le donne ou non.&quot;"/>
                <trail PARENT="narration" ALIGN="3"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="141.102992125984" YPOS="12766.0377451048" OwnPage="39" ItemID="537302208" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5259340812525" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="537293712" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Le sas de dé­com­pres­sion — une idée simple et sous-es­ti­mée"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Il y a quelque chose de concret que beau­coup de couples n'ont ja­mais vrai­ment mis en place — non pas parce que c'est com­pli­qué, mais parce que per­sonne n'en a par­lé."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="C'est le sas."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Un mo­ment court — cinq, dix mi­nutes — entre la porte d'en­trée et la soi­rée com­mune. Pas pour s'igno­rer. Pour re­ve­nir à soi avant de re­ve­nir à l'autre."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Pour ce­lui qui rentre : po­ser ses af­faires, souf­fler, se chan­ger. Pas pour dis­pa­raître — pour ar­ri­ver vrai­ment."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Pour ce­lui qui at­tend : lais­ser ce mo­ment sans at­tente, sans ques­tion, sans ten­sion. Pas par ré­si­gna­tion — par choix. Parce que l'autre qui ar­rive vrai­ment vaut mieux que l'autre qui ar­rive en fa­çade."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ce sas n'est pas un luxe. C'est une condi­tion pour que la soi­rée com­mence au­tre­ment que par une col­li­sion."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="La croyance qui com­plique tout — &quot;ça de­vrait être spon­ta­né&quot;"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Il y a une convic­tion im­pli­cite dans beau­coup de couples qui fait beau­coup de dé­gâts sans qu'on la nomme ja­mais."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Elle res­semble à ce­ci : se don­ner un cadre, pla­ni­fier des mo­ments, ex­pli­ci­ter ce dont on a be­soin — c'est ad­mettre que quelque chose ne va plus. Un vrai couple n'a pas be­soin de tout ça. Ça de­vrait ve­nir na­tu­rel­le­ment."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Cette convic­tion est belle. Et elle est fausse."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ou plu­tôt — elle dé­crit peut-être les pre­miers mois d'une re­la­tion, quand tout est nou­veau et que l'autre oc­cupe toute l'at­ten­tion. Mais dans la du­rée, dans la fa­tigue des se­maines char­gées, dans la rou­tine qui s'ins­talle — at­tendre que ça vienne na­tu­rel­le­ment, c'est at­tendre que l'autre de­vine. Et per­sonne ne de­vine vrai­ment. Pas du­ra­ble­ment."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ce qui crée de la connexion dans la du­rée, c'est sou­vent l'in­verse de la spon­ta­néi­té : c'est la dé­ci­sion. Dé­ci­der que ce soir-là, on est en­semble. Dé­ci­der de se dire ce dont on a en­vie. Dé­ci­der de ne pas lais­ser la se­maine dé­ci­der à notre place."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ce n'est pas tuer la spon­ta­néi­té. C'est créer les condi­tions pour qu'elle existe."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Se dire ce qui compte — une danse, pas un plan­ning"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ce qui manque dans cette scène — et dans beau­coup de soi­rées qui lui res­semblent — c'est un ac­cord simple sur ce qui compte pour cha­cun."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Pas une liste de règles. Pas un ta­bleau de plan­ning. Une conver­sa­tion."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="&quot;Ce soir j'avais en­vie de ça. C'est pos­sible — ou c'est de­main ?&quot;"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Cette phrase-là change tout. Elle dit ce dont on a en­vie sans exi­ger. Elle laisse à l'autre la li­ber­té de ré­pondre. Elle ouvre une né­go­cia­tion qui n'est pas un conflit — c'est une fa­çon de se re­joindre."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Et quand les deux savent ce qui compte pour l'autre — quand on a eu cette conver­sa­tion au calme, hors du mo­ment de ten­sion — les soi­rées com­pli­quées de­viennent plus simples à tra­ver­ser. Pas parce que tout est ré­glé. Parce qu'on sait où on va."/>
                <trail PARENT="BODY" ALIGN="3"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="560.630551181103" YPOS="12766.0377451048" OwnPage="40" ItemID="537293712" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5259340812525" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="537302208"/>
        <PAGEOBJECT XPOS="141.102992125984" YPOS="13401.3130206954" OwnPage="41" ItemID="537290880" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5256191206234" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="537296544" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="L'alerte à ne pas man­quer"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="La sor­tie de ce jeu n'est pas de ren­trer plus tôt — ou de moins re­pro­cher."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ren­trer plus tôt sans chan­ger la dy­na­mique pro­duit la même scène dans un autre contexte. Et se re­te­nir de re­pro­cher sans adres­ser le be­soin réel crée une pres­sion qui fi­nit par ex­plo­ser ailleurs."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ce qui change quelque chose, c'est le dé­pla­ce­ment : de &quot;qu'est-ce que je veux que l'autre fasse&quot; vers &quot;qu'est-ce que j'ai be­soin de nour­rir ce soir — et com­ment je le nour­ris ?&quot;"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Les portes de sor­tie"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <ITEXT CH="Porte 1 — Re­pé­rer son rôle dans le mo­ment"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="La pro­chaine fois que cette scène se dé­clenche — ou que tu sens qu'elle ap­proche — une seule ques­tion in­té­rieure :"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="En ce mo­ment, je suis plu­tôt en train d'at­tendre, d'ac­cu­ser, ou de me dé­fendre ?"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Juste nom­mer. Pas ana­ly­ser. Nom­mer crée un es­pace entre le ré­flexe et la ré­ac­tion."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Si tu es en train d'at­tendre : qu'est-ce que tu at­tends exac­te­ment — et est-ce que tu peux le de­man­der di­rec­te­ment plu­tôt que de l'es­pé­rer ?"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Si tu es en train d'ac­cu­ser : qu'est-ce qui est ac­ti­vé vrai­ment — la frus­tra­tion de ce soir, ou quelque chose qui s'ac­cu­mule de­puis plus long­temps ?"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Si tu es en train de te dé­fendre : qu'est-ce que tu au­rais eu be­soin de trou­ver en ren­trant — et est-ce que tu peux le dire ?"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Porte 2 — Dire ce dont on a be­soin avant que la soi­rée com­mence (so­lo)"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Cet exer­cice de­mande un peu d'an­ti­ci­pa­tion."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Avant que l'autre rentre — ou avant de ren­trer soi-même — une ques­tion in­té­rieure :"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ce soir, de quoi est-ce que j'ai vrai­ment be­soin ?"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Pas une liste. Une chose. La plus hon­nête."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Puis es­sayer de la for­mu­ler sim­ple­ment, sans re­proche, avant que la ten­sion monte. Quelques exemples de for­mu­la­tions à adap­ter :"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="&quot;Ce soir j'ai be­soin qu'on soit vrai­ment en­semble — pas sur nos té­lé­phones. Est-ce qu'on peut faire ça ?&quot;"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <ITEXT CH="&quot;J'ai eu une jour­née dif­fi­cile. J'ai be­soin de 10 mi­nutes pour souf­fler avant d'être vrai­ment dis­po­nible.&quot;"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <ITEXT CH="&quot;J'avais be­soin de sa­voir à quelle heure tu ren­trais. La pro­chaine fois, est-ce que tu peux m'en­voyer un mes­sage ?&quot;"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ces phrases ne règlent pas tout. Mais elles disent quelque chose de vrai — et elles laissent à l'autre la pos­si­bi­li­té de ré­pondre plu­tôt que de se dé­fendre."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Porte 3 — Re­con­nec­ter à son be­soin dans le mo­ment (so­lo)"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Quand la ten­sion monte, quand le re­proche ar­rive ou quand l'en­vie de se re­ti­rer est forte — une pause. Dix se­condes."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Com­plète men­ta­le­ment :"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="&quot;Le be­soin qui est ac­ti­vé en moi là, c'est __. Et quelque chose que je peux faire pour le nour­rir ce soir, c'est __.&quot;"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Pas pour ef­fa­cer la frus­tra­tion. Pour choi­sir ce qu'on en fait."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Porte 4 — La conver­sa­tion au calme (duo)"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="À avoir hors du mo­ment de ten­sion — pas le soir du re­tour tar­dif, pas pen­dant le dî­ner si­len­cieux. Le len­de­main, au calme, 20 mi­nutes."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Cha­cun com­plète ces phrases sé­pa­ré­ment, par écrit :"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <ITEXT CH="&quot;Quand cette scène se pro­duit, ce qui est ac­ti­vé en moi c'est...&quot;"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <ITEXT CH="&quot;Le be­soin réel der­rière ma ré­ac­tion, c'est...&quot;"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <ITEXT CH="&quot;Ce que j'au­rais be­soin de l'autre dans ces mo­ments — pas qu'il change, mais...&quot;"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Puis on par­tage — cha­cun lit, l'autre écoute sans in­ter­rompre. L'ob­jec­tif n'est pas de se convaincre. C'est d'en­tendre ce que l'autre vit vrai­ment sous la sur­face."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="En­suite, une seule ques­tion à ex­plo­rer en­semble :"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="&quot;Qu'est-ce qu'on pour­rait faire — un geste concret, simple, réa­liste — pour que ces soi­rées se passent dif­fé­rem­ment ?&quot;"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Pas un en­ga­ge­ment so­len­nel. Un es­sai. Qu'on peut ajus­ter, re­voir, aban­don­ner si ça ne fonc­tionne pas."/>
                <trail PARENT="BODY" ALIGN="3"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="560.630551181103" YPOS="13401.3130206954" OwnPage="42" ItemID="537296544" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5256191206234" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="537307872" BACKITEM="537290880"/>
        <PAGEOBJECT XPOS="141.102992125984" YPOS="14036.588296286" OwnPage="43" ItemID="537307872" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5253041599943" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="537296544"/>
        <PAGEOBJECT XPOS="560.630551181103" YPOS="14036.588296286" OwnPage="44" ItemID="537305040" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5253041599943" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Nour­rir ton En­fant Libre — rap­pel"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Comme dans la scène pré­cé­dente — et dans toutes les sui­vantes — il y a quelque chose qui joue en fond dans cette dy­na­mique."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Quand on est épui­sé, quand on at­tend que l'autre comble quelque chose, quand on rentre sur les ge­noux sans res­source pour être pré­sent — c'est sou­vent le signe qu'on s'est ou­blié quelque part dans la jour­née."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="L'En­fant Libre, c'est cette par­tie de toi qui a des en­vies propres, qui se nour­rit de choses simples — un mo­ment seul, une ac­ti­vi­té qui te res­source, quelque chose qui n'est là que pour toi. Quand il est nour­ri, l'at­tente en­vers l'autre di­mi­nue na­tu­rel­le­ment. On ar­rive moins vide, moins en de­mande, moins sur le fil."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="La ques­tion à se po­ser ce soir :"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Qu'est-ce que j'ai fait au­jour­d'hui — même cinq mi­nutes — juste pour moi ?"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Sui­vi — 7 jours"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Chaque soir, deux mi­nutes."/>
                <trail PARENT="BODY" ALIGN="3"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="141.102992125984" YPOS="14671.8635718765" OwnPage="45" ItemID="537310704" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5249891993652" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Une ques­tion par soir — juste celle du jour :"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Lun­di : Ce soir, dans quel rôle ai-je pas­sé le plus de temps — Vic­time, Per­sé­cu­teur, ou Sau­veur ?"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Mar­di : Qu'est-ce que j'au­rais vou­lu dire — et que je n'ai pas dit ?"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Mer­cre­di : Quel be­soin était ac­ti­vé ce soir — et com­ment est-ce que j'ai choi­si de le nour­rir ?"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Jeu­di : Qu'est-ce qui se se­rait pas­sé si j'avais dit ce dont j'avais be­soin, di­rec­te­ment ?"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ven­dre­di : Com­ment j'ai nour­ri mon En­fant Libre au­jour­d'hui — et qu'est-ce que ça a chan­gé dans ma dis­po­ni­bi­li­té pour l'autre ?"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Sa­me­di : Quelle croyance sur l'autre est-ce que cette se­maine est ve­nue confir­mer — et est-ce que c'est vrai­ment vrai ?"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Di­manche : Si je rem­pla­çais le re­proche par le be­soin réel — quelle phrase est-ce que ça don­ne­rait ?"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="La scène sui­vante n'a pas de re­proche ou­vert. Juste un ap­pel qui s'est mal pas­sé — et deux fa­çons très dif­fé­rentes d'être là pour quel­qu'un qui souffre."/>
                <trail PARENT="scene_page_subtitle" ALIGN="3"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="560.630551181103" YPOS="14671.8635718765" OwnPage="46" ItemID="537299376" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5249891993652" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <ITEXT CH="Scène 3 — L'appel avec la mère"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <ITEXT CH="&quot;Répare-moi&quot;"/>
                <trail PARENT="Titre" ALIGN="1"/>
            </StoryText>
            <PageItemAttributes>
                <ItemAttribute Name="tdm" Type="string" Value="Scène 3 — L'appel avec la mère" Parameter="" Relationship="none" RelationshipTo="" AutoAddTo="none"/>
            </PageItemAttributes>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="141.102992125984" YPOS="15307.1388474671" OwnPage="47" ItemID="537319200" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5246742387361" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <trail/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="560.630551181103" YPOS="15307.1388474671" OwnPage="48" ItemID="537322032" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5246742387361" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="La scène"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <ITEXT CH="Sa­lon, en soi­rée. Elle rac­croche, pose son té­lé­phone sur la table. Son vi­sage dit que l'ap­pel ne s'est pas bien pas­sé."/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="DIALOGUE" ALIGN="3"/>
                <ITEXT CH="Elle : &quot;Ma mère, c'est in­croyable. Elle a en­core fait une re­marque sur la fa­çon dont j'élève les en­fants. De­vant eux en plus.&quot;"/>
                <para PARENT="DIALOGUE" ALIGN="3"/>
                <para PARENT="DIALOGUE" ALIGN="3"/>
                <ITEXT CH="Lui : &quot;Tu lui as ré­pon­du quoi ?&quot;"/>
                <para PARENT="DIALOGUE" ALIGN="3"/>
                <para PARENT="DIALOGUE" ALIGN="3"/>
                <ITEXT CH="Elle : &quot;Rien. Je ne vou­lais pas que ça dé­gé­nère.&quot;"/>
                <para PARENT="DIALOGUE" ALIGN="3"/>
                <para PARENT="DIALOGUE" ALIGN="3"/>
                <ITEXT CH="Lui : &quot;La pro­chaine fois, tu pour­rais lui dire cal­me­ment que ce n'est pas son rôle. Tu n'as pas à su­bir ça.&quot;"/>
                <para PARENT="DIALOGUE" ALIGN="3"/>
                <para PARENT="DIALOGUE" ALIGN="3"/>
                <ITEXT CH="Elle : &quot;Je sais. Mais ce n'est pas si simple avec elle.&quot;"/>
                <para PARENT="DIALOGUE" ALIGN="3"/>
                <para PARENT="DIALOGUE" ALIGN="3"/>
                <ITEXT CH="Lui : &quot;Je com­prends, mais si tu ne poses pas de li­mite main­te­nant, ça va conti­nuer.&quot;"/>
                <para PARENT="DIALOGUE" ALIGN="3"/>
                <para PARENT="DIALOGUE" ALIGN="3"/>
                <ITEXT CH="Si­lence. Elle re­garde ailleurs."/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="DIALOGUE" ALIGN="3"/>
                <ITEXT CH="Elle : &quot;Laisse tom­ber.&quot;"/>
                <para PARENT="DIALOGUE" ALIGN="3"/>
                <para PARENT="DIALOGUE" ALIGN="3"/>
                <ITEXT CH="Elle se lève, va dans la cui­sine. Lui reste sur le ca­na­pé, per­plexe — il a es­sayé d'ai­der."/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="DIALOGUE" ALIGN="3"/>
                <para PARENT="DIALOGUE" ALIGN="3"/>
                <ITEXT CH="Tu te re­con­nais ?"/>
                <para PARENT="DIALOGUE" ALIGN="3"/>
                <ITEXT CH="Cette scène, je la vis : ja­mais · par­fois · sou­vent"/>
                <para PARENT="DIALOGUE" ALIGN="3"/>
                <para PARENT="DIALOGUE" ALIGN="3"/>
                <ITEXT CH="Dans cette scène, tu res­sembles plu­tôt à : celle qui rac­croche · ce­lui qui conseille · les deux se­lon les mo­ments"/>
                <trail PARENT="DIALOGUE" ALIGN="3"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="141.102992125984" YPOS="15942.4141230576" OwnPage="49" ItemID="537313536" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.524359278107" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="537316368" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Avant l'ana­lyse — une chose im­por­tante"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Si tu te re­con­nais dans cette scène, tu connais pro­ba­ble­ment les deux cô­tés."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Tu connais ce que c'est de rac­cro­cher avec quelque chose de lourd dans la poi­trine — et de vou­loir juste que quel­qu'un soit là. Pas qu'il ex­plique. Pas qu'il struc­ture. Juste qu'il reste, et qu'il dise avec ses yeux ou ses mots : je vois que c'est dif­fi­cile, et tu n'es pas seul avec ça."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Et tu connais peut-être aus­si l'autre cô­té : voir quel­qu'un qu'on aime souf­frir, et ne pas sa­voir quoi faire de ses mains. L'in­con­fort de l'im­puis­sance. L'en­vie sin­cère d'ai­der — qui ar­rive sous forme de so­lu­tions, parce que c'est le seul ou­til qu'on a sous la main."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Les deux sont lé­gi­times. Les deux sont hu­mains."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ce que ce book­let va te pro­po­ser, c'est de re­gar­der ce qui se passe vrai­ment dans l'es­pace entre ces deux be­soins — quand l'un cherche à être en­ten­du, et que l'autre cherche à être utile. Pas pour dé­si­gner un cou­pable. Pour voir la mé­ca­nique — et trou­ver com­ment en sor­tir en­semble."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <ITEXT CH="Ce qui se passe vrai­ment"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <ITEXT CH="En sur­face, c'est une conver­sa­tion sur la mère. Ce qui se passe vrai­ment n'a rien à voir avec ce qu'il fau­drait dire ou ne pas dire à la pro­chaine oc­ca­sion."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Elle vient de vivre quelque chose de dou­lou­reux. Une re­marque de sa mère — pas la pre­mière, pro­ba­ble­ment pas la der­nière — qui touche un en­droit pré­cis : sa fa­çon d'éle­ver ses en­fants, c'est-à-dire quelque chose d'es­sen­tiel à qui elle est. Elle rac­croche avec cette dou­leur. Elle en parle. Pas pour trou­ver une so­lu­tion — pour ne pas être seule avec ça."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ce qu'elle cherche en po­sant son té­lé­phone et en di­sant &quot;ma mère, c'est in­croyable&quot; n'est pas un plan d'ac­tion. C'est quel­qu'un qui dit : je vois que tu as mal. C'est nor­mal d'avoir mal. Je suis là."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Lui en­tend quelque chose de dif­fé­rent. Il en­tend un pro­blème — et les pro­blèmes, ça se ré­sout. Il s'ac­tive. Il pro­pose. Il struc­ture. Il fait ce qu'il fait le mieux quand quel­qu'un qu'il aime souffre : il cherche com­ment ré­pa­rer."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Le pro­blème, c'est que ce qu'elle lui ap­porte n'est pas cas­sé. C'est dou­lou­reux. Et la dou­leur ne se ré­pare pas — elle se tra­verse, ac­com­pa­gnée."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Quand il dit &quot;tu pour­rais lui dire cal­me­ment que ce n'est pas son rôle&quot;, il est convain­cu d'ai­der. Elle en­tend : tu n'as pas su gé­rer ça. Quand il dit &quot;si tu ne poses pas de li­mite main­te­nant, ça va conti­nuer&quot;, il pense avoir rai­son — pro­ba­ble­ment qu'il a rai­son. Elle en­tend : tu es res­pon­sable de ce que ta mère te fait su­bir."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Elle dit &quot;laisse tom­ber&quot; et quitte la pièce. Lui reste per­plexe, sin­cè­re­ment. Il a es­sayé."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="C'est ça le jeu. Per­sonne n'a tort. Per­sonne ne gagne."/>
                <trail PARENT="BODY" ALIGN="3"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="560.630551181103" YPOS="15942.4141230576" OwnPage="50" ItemID="537316368" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.524359278107" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="537313536"/>
        <PAGEOBJECT XPOS="141.102992125984" YPOS="16577.6893986481" OwnPage="51" ItemID="391357520" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.524044317476" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="391368848" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Le jeu qui se joue — sans que per­sonne ne l'ait dé­ci­dé"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="En psy­cho­lo­gie, ce type de scène a un nom pré­cis : le jeu &quot;Oui mais&quot;. C'est un des sché­mas les plus ré­pan­dus dans les couples — et un des plus mal com­pris, pré­ci­sé­ment parce qu'il res­semble à une de­mande d'aide."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="La struc­ture est tou­jours la même. Quel­qu'un pré­sente un pro­blème. L'autre pro­pose une so­lu­tion. Le pre­mier ré­pond : &quot;Oui, mais...&quot; — et ex­plique pour­quoi ça ne peut pas mar­cher. L'autre pro­pose autre chose. &quot;Oui, mais...&quot; La sé­quence se ré­pète jus­qu'à l'épui­se­ment — et se ter­mine par un si­lence, un sou­pir, ou un &quot;laisse tom­ber&quot;."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ce qui dé­route ce­lui qui pro­pose, c'est la convic­tion d'avoir bien en­ten­du une de­mande d'aide. Il a rai­son sur la forme. Il a tort sur le fond."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="La de­mande ap­pa­rente est : &quot;aide-moi à trou­ver une so­lu­tion.&quot; La de­mande réelle — celle qui opère sous la sur­face — res­semble da­van­tage à : &quot;confirme-moi que la si­tua­tion est vrai­ment dif­fi­cile, et que je ne suis pas seule avec ce que je vis.&quot;"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Les so­lu­tions pro­po­sées ne peuvent pas être ac­cep­tées — non pas parce qu'elles sont mau­vaises, mais parce qu'elles ré­pon­draient à la mau­vaise ques­tion. Ac­cep­ter une so­lu­tion, ce se­rait clore quelque chose qui n'est pas en­core prêt à être clos. Ce n'est pas de la mau­vaise foi. C'est mé­ca­nique."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="La Vic­time qui éveille le Sau­veur"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Il y a quelque chose d'im­por­tant à voir ici — avant même que les mots ar­rivent."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Quand elle rac­croche avec ce vi­sage, quand elle dit &quot;ma mère, c'est in­croyable&quot; — quelque chose s'ac­tive en lui au­to­ma­ti­que­ment. Pas une dé­ci­sion. Un ré­flexe. La souf­france de l'autre — même in­vo­lon­taire, même lé­gi­time — éveille le "/>
                <ITEXT FONT="Times New Roman Bold" CH="Sau­veur"/>
                <ITEXT CH=". Et le "/>
                <ITEXT FONT="Times New Roman Bold" CH="Sau­veur"/>
                <ITEXT CH=" ar­rive avec des so­lu­tions, parce que c'est sa fa­çon d'ai­mer."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ce ré­flexe n'est pas un dé­faut. C'est sou­vent ce qui fait de lui quel­qu'un d'at­ten­tion­né, de pré­sent, de fiable. Mais il a un angle mort : il ré­pond à la dé­tresse vi­sible sans vé­ri­fier ce dont l'autre a vrai­ment be­soin. Il part du prin­cipe que souf­frir ap­pelle à être ai­dé — et qu'ai­der, c'est pro­po­ser."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Plus elle ex­prime sa dou­leur, plus son "/>
                <ITEXT FONT="Times New Roman Bold" CH="Sau­veur"/>
                <ITEXT CH=" s'ac­tive. Plus son "/>
                <ITEXT FONT="Times New Roman Bold" CH="Sau­veur"/>
                <ITEXT CH=" s'ac­tive, plus elle se sent in­com­prise. Plus elle se sent in­com­prise, plus la dou­leur se ferme — ou ex­plose. Et la boucle tourne."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Le "/>
                <ITEXT FONT="Times New Roman Bold" CH="Sau­veur"/>
                <ITEXT CH=" croit ser­vir l'autre. Il sert d'abord son propre be­soin de ne pas être im­puis­sant face à la souf­france de quel­qu'un qu'il aime. Ce n'est pas un re­proche — c'est une mé­ca­nique. Et la voir, c'est dé­jà com­men­cer à en sor­tir."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Le tri­angle de Karp­man"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Il y a trois rôles dans ce jeu. La "/>
                <ITEXT FONT="Times New Roman Bold" CH="Vic­time"/>
                <ITEXT CH=" — celle qui souffre, qui par­tage, qui cherche à être en­ten­due. Le "/>
                <ITEXT FONT="Times New Roman Bold" CH="Sau­veur"/>
                <ITEXT CH=" — ce­lui qui pro­pose, qui struc­ture, qui veut ré­pa­rer. Et le "/>
                <ITEXT FONT="Times New Roman Bold" CH="Per­sé­cu­teur"/>
                <ITEXT CH=" — ce­lui qui, sans le vou­loir, fi­nit par bles­ser ou par être bles­sé."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Elle ar­rive en "/>
                <ITEXT FONT="Times New Roman Bold" CH="Vic­time"/>
                <ITEXT CH=" — au sens tech­nique : elle su­bit quelque chose qu'elle n'a pas choi­si, et elle en parle. Lui entre im­mé­dia­te­ment en "/>
                <ITEXT FONT="Times New Roman Bold" CH="Sau­veur"/>
                <ITEXT CH=" — c'est son mou­ve­ment na­tu­rel face à la souf­france de l'autre."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Le coup de théâtre ar­rive quand ses so­lu­tions sont re­je­tées. Lui bas­cule en "/>
                <ITEXT FONT="Times New Roman Bold" CH="Vic­time"/>
                <ITEXT CH=" — il a es­sayé, il n'est pas com­pris, à quoi bon. Et elle, qui cher­chait juste à être en­ten­due, se re­trouve en po­si­tion de gé­rer sa per­plexi­té à lui — en plus de la dou­leur de l'ap­pel. Elle de­vient mal­gré elle "/>
                <ITEXT FONT="Times New Roman Bold" CH="Per­sé­cu­teur"/>
                <ITEXT CH=" de quel­qu'un qui vou­lait l'ai­der."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT FONT="Times New Roman Bold" CH="Vic­time"/>
                <ITEXT CH=" qui par­tage → éveille → "/>
                <ITEXT FONT="Times New Roman Bold" CH="Sau­veur"/>
                <ITEXT CH=" qui pro­pose → re­jet → "/>
                <ITEXT FONT="Times New Roman Bold" CH="Sau­veur"/>
                <ITEXT CH=" de­vient "/>
                <ITEXT FONT="Times New Roman Bold" CH="Vic­time"/>
                <ITEXT CH=" → celle qui souf­frait de­vient "/>
                <ITEXT FONT="Times New Roman Bold" CH="Per­sé­cu­teur"/>
                <ITEXT CH=" → si­lence"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Les deux sortent de la scène avec quelque chose de désa­gréable. "/>
                <ITEXT FONT="Times New Roman Bold" CH="Elle"/>
                <ITEXT CH=" : seule avec sa dou­leur, et en plus cou­pable de l'avoir bles­sé. "/>
                <ITEXT FONT="Times New Roman Bold" CH="Lui"/>
                <ITEXT CH=" : in­com­pris dans ses ef­forts, avec le sen­ti­ment dif­fus d'avoir ra­té quelque chose sans sa­voir quoi."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ce que cha­cun y trouve — la par­tie dif­fi­cile"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ce sys­tème dure parce qu'il confirme quelque chose pour cha­cun — et parce qu'il pro­tège cha­cun de quelque chose."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Pour elle : &quot;"/>
                <ITEXT FONT="Times New Roman Italic" CH="quand je lui parle de ce qui me fait vrai­ment mal, je me re­trouve à gé­rer sa ré­ac­tion"/>
                <ITEXT CH=".&quot; Cette convic­tion rend les pro­chaines confi­dences moins pro­bables — elle ap­pren­dra à ne pas en par­ler, à ré­gler ça seule, à ne mon­trer que ce qui ne risque pas de dé­clen­cher des conseils. La dis­tance s'ins­talle dou­ce­ment, sans que per­sonne ne l'ait dé­ci­dée."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Il y a quelque chose de plus pro­fond aus­si. Tant que le pro­blème avec la mère est in­so­luble — tant qu'au­cune so­lu­tion ne fonc­tionne — elle n'a pas à chan­ger quelque chose dans cette re­la­tion. Elle n'a pas à po­ser une li­mite qui lui fait peur. Elle n'a pas à af­fron­ter le fait que cette re­la­tion est peut-être struc­tu­rel­le­ment dou­lou­reuse. Le jeu lui per­met de res­ter dans la souf­france — qui est réelle — sans avoir à se confron­ter à ce qu'elle de­mande d'elle. C'est in­con­for­table, mais c'est connu."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Pour lui : &quot;"/>
                <ITEXT FONT="Times New Roman Italic" CH="quand elle souffre, je ne sais pas quoi faire"/>
                <ITEXT CH=".&quot; Cette im­puis­sance est in­con­for­table — et le ré­flexe de pro­po­ser des so­lu­tions est pré­ci­sé­ment une fa­çon de ne pas res­ter dans cet in­con­fort. Si j'ai un plan, je ne suis pas im­puis­sant. Le pro­blème, c'est que le plan rate le be­soin. Et ra­ter le be­soin confirme l'im­puis­sance — et donc ren­force le ré­flexe la pro­chaine fois."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Chaque so­lu­tion re­je­tée lui confirme qu'il es­saie — qu'il est pré­sent, qu'il fait des ef­forts. Le jeu lui per­met d'évi­ter l'in­con­fort de sim­ple­ment être là, sans rien faire, sans être utile. Cette im­puis­sance-là est plus dif­fi­cile à te­nir que l'ac­cu­mu­la­tion de so­lu­tions qui ne fonc­tionnent pas."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Les deux sont pié­gés dans quelque chose qu'ils ont construit en­semble, sans le voir."/>
                <trail PARENT="BODY" ALIGN="3"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="560.630551181103" YPOS="16577.6893986481" OwnPage="52" ItemID="391368848" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.524044317476" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="391371680" BACKITEM="391357520"/>
        <PAGEOBJECT XPOS="141.102992125984" YPOS="17212.9646742387" OwnPage="53" ItemID="391371680" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5237293568451" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="391368848"/>
        <PAGEOBJECT XPOS="560.630551181103" YPOS="17212.9646742387" OwnPage="54" ItemID="391360352" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5237293568451" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Ce dont on a vrai­ment be­soin — l'angle CNV"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ici aus­si, les deux pro­ta­go­nistes n'oc­cupent pas la même po­si­tion — et ils n'ont pas les mêmes be­soins. Deux lec­tures sé­pa­rées, donc."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Et dans les deux cas, la même règle : un be­soin m'ap­par­tient. Il ne dé­pend pas de ce que l'autre fait ou ne fait pas. Je suis res­pon­sable de trou­ver com­ment le nour­rir — pas d'at­tendre que l'autre le de­vine."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Si tu es celle qui a rac­cro­ché"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ce que tu ex­primes à tra­vers le &quot;laisse tom­ber&quot; n'est pas du re­jet. C'est une in­for­ma­tion sur ce dont tu avais be­soin — et sur ce que tu n'as pas trou­vé."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Lis cette liste. Coche ce qui ré­sonne vrai­ment."/>
                <trail PARENT="BODY" ALIGN="3"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="141.102992125984" YPOS="17848.2399498293" OwnPage="55" ItemID="391374512" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5234143962142" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Une fois ton be­soin iden­ti­fié, com­plète cette phrase :"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="&quot;J'ai be­soin de __. Quand je me re­con­necte à ce be­soin, ce que je choi­sis de faire c'est __.&quot;"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Quelques exemples :"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="&quot;J'ai be­soin de pré­sence. Ce que je choi­sis de faire c'est le dire avant de com­men­cer — 'j'ai be­soin de te par­ler, mais là j'ai sur­tout be­soin que tu écoutes, pas de conseils pour l'ins­tant.'&quot;"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <ITEXT CH="&quot;J'ai be­soin de va­li­da­tion. Ce que je choi­sis de faire c'est de­man­der ex­pli­ci­te­ment ce dont j'ai en­vie : 'dis-moi juste que c'était dif­fi­cile.'&quot;"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <ITEXT CH="&quot;J'ai be­soin de sé­cu­ri­té. Ce que je choi­sis de faire c'est nom­mer ce qui me ferme — 'quand les conseils ar­rivent vite, je me sens moins en sé­cu­ri­té pour conti­nuer à par­ler.'&quot;"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Si tu es ce­lui qui a pro­po­sé des so­lu­tions"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ce que tu fai­sais en pro­po­sant n'était pas de l'in­dif­fé­rence à sa dou­leur. C'était, à ta fa­çon, une forme d'amour. Mais ce que tu cher­chais, toi, dans cet échange mé­rite aus­si d'être re­gar­dé."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Lis cette liste. Coche ce qui ré­sonne vrai­ment."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="560.630551181103" YPOS="17848.2399498293" OwnPage="56" ItemID="391363184" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5234143962142" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Une fois ton be­soin iden­ti­fié, com­plète cette phrase :"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="&quot;J'ai be­soin de __. Quand je me re­con­necte à ce be­soin, ce que je choi­sis de faire c'est __.&quot;"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Quelques exemples :"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="&quot;J'ai be­soin de clar­té. Ce que je choi­sis de faire c'est de­man­der avant de pro­po­ser : 'tu veux qu'on cherche quoi faire, ou tu as sur­tout be­soin que j'écoute ?'&quot;"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <ITEXT CH="&quot;J'ai be­soin de connexion. Ce que je choi­sis de faire c'est res­ter là sans par­ler — juste être pré­sent, et lais­ser ça suf­fire.&quot;"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <ITEXT CH="&quot;J'ai be­soin d'uti­li­té. Ce que je choi­sis de faire c'est me rap­pe­ler qu'écou­ter vrai­ment est aus­si une forme d'aide — peut-être la plus utile ici.&quot;"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="La phrase qui change tout"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Il y a une phrase courte — une ques­tion — qui peut désa­mor­cer cette scène avant qu'elle com­mence. Elle ne de­mande au­cun tra­vail théo­rique. Elle de­mande juste d'être po­sée."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="&quot;Tu veux qu'on cherche quoi faire, ou tu as sur­tout be­soin que j'écoute ?&quot;"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Cette ques­tion fait plu­sieurs choses en même temps. Elle dit à l'autre : j'ai en­ten­du que quelque chose est dif­fi­cile. Elle lui laisse le choix — pas de pré­sup­po­sé sur ce dont il a be­soin. Et elle évite à ce­lui qui écoute de na­vi­guer à l'aveugle, de pro­po­ser des so­lu­tions qui ra­te­ront, de se re­trou­ver per­plexe sur le ca­na­pé."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Elle n'est pas ma­gique. Mais elle court-cir­cuite le jeu avant qu'il s'ins­talle."/>
                <trail PARENT="BODY" ALIGN="3"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="141.102992125984" YPOS="18483.5152254199" OwnPage="57" ItemID="391377344" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5230994355832" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="391366016" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="L'alerte à ne pas man­quer"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="La sor­tie de ce jeu n'est pas d'ar­rê­ter de pro­po­ser des so­lu­tions — ou de se for­cer à se taire."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Se re­te­nir en si­lence est une autre forme du même in­con­fort. Elle le sen­ti­ra. Et le si­lence contraint n'est pas de la pré­sence — c'est de l'ab­sence avec bonne conscience."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="La vraie ques­tion pour lui n'est pas &quot;"/>
                <ITEXT FONT="Times New Roman Italic" CH="com­ment l'ai­der à gé­rer sa mère ?"/>
                <ITEXT CH="&quot; C'est &quot;qu'est-ce qui se passe en moi quand elle souffre et que je ne peux rien faire ?&quot; Et plus pré­ci­sé­ment : &quot;"/>
                <ITEXT FONT="Times New Roman Italic" CH="est-ce que mes so­lu­tions servent vrai­ment son be­soin — ou servent-elles d'abord mon be­soin de ne pas me sen­tir im­puis­sant ?"/>
                <ITEXT CH="&quot;"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="La vraie ques­tion pour elle n'est pas &quot;"/>
                <ITEXT FONT="Times New Roman Italic" CH="com­ment lui faire com­prendre qu'il ne m'écoute pas ?"/>
                <ITEXT CH="&quot; C'est &quot;"/>
                <ITEXT FONT="Times New Roman Italic" CH="qu'est-ce qui m'em­pêche de lui dire di­rec­te­ment ce dont j'ai be­soin — pas une so­lu­tion, juste être en­ten­due ?"/>
                <ITEXT CH="&quot;"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Les portes de sor­tie"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <ITEXT CH="Porte 1 — De­man­der avant de ré­pondre (so­lo — ce­lui qui écoute)"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="La pro­chaine fois que l'autre par­tage quelque chose de dif­fi­cile, avant de pro­po­ser quoi que ce soit — une seule ques­tion :"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="&quot;Tu veux qu'on cherche quoi faire, ou tu as sur­tout be­soin que j'écoute ?&quot;"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Juste ça. Pas d'in­ter­pré­ta­tion, pas de sup­po­si­tion. La ré­ponse dit tout ce qu'il faut sa­voir sur com­ment être utile dans ce mo­ment."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Si la ré­ponse est &quot;"/>
                <ITEXT FONT="Times New Roman Italic" CH="j'ai be­soin que tu écoutes"/>
                <ITEXT CH="&quot; — res­ter. Ne rien pro­po­ser. Lais­ser le si­lence faire son tra­vail. Et si l'in­con­fort de l'im­puis­sance monte, le no­ter in­té­rieu­re­ment sans y ré­pondre."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Porte 2 — Dire ce dont on a be­soin avant de com­men­cer (so­lo —"/>
                <ITEXT FONT="Tempus Sans ITC Regular" CH=" "/>
                <ITEXT CH="celle qui parle)"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Avant d'en­ta­mer une conver­sa­tion dif­fi­cile, une phrase courte qui dit ce dont tu as be­soin — sans at­tendre que l'autre de­vine :"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="&quot;J'ai be­soin de te par­ler de quelque chose, mais là j'ai sur­tout be­soin que tu écoutes — pas de conseils pour l'ins­tant.&quot;"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ou, plus court en­core : &quot;"/>
                <ITEXT FONT="Times New Roman Italic" CH="J'ai juste be­soin que tu sois là."/>
                <ITEXT CH="&quot;"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Cette phrase peut sem­bler in­utile — pour­quoi de­voir de­man­der à être écou­té ? Mais elle coupe court à la boucle avant qu'elle dé­marre. Et elle donne à l'autre ce dont il a be­soin aus­si : sa­voir com­ment être pré­sent."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Porte 3 — Re­flé­ter avant de ré­pondre (so­lo — ce­lui qui écoute)"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Quand l'autre par­tage quelque chose de dou­lou­reux, le ré­flexe de so­lu­tion ar­rive vite — avant même qu'on ait vrai­ment en­ten­du."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Une pra­tique simple : avant de ré­pondre, lais­ser pas­ser un si­lence. Pas un si­lence gê­né — un si­lence qui dit je prends le temps de vrai­ment re­ce­voir ce que tu viens de dire. Puis, au lieu de pro­po­ser, re­flé­ter. Nom­mer ce qu'on a en­ten­du sous les mots."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="&quot;Ça a l'air d'avoir été vrai­ment dif­fi­cile.&quot;"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <ITEXT CH="&quot;Une re­marque comme ça, de­vant les en­fants en plus — c'est bles­sant.&quot;"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <ITEXT CH="&quot;Tu n'avais pas be­soin de ça ce soir.&quot;"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <ITEXT CH="&quot;Je com­prends que tu n'aies pas vou­lu que ça dé­gé­nère.&quot;"/>
                <para PARENT="narration" ALIGN="3"/>
                <ITEXT CH="Ces phrases ne ré­solvent rien. Elles font quelque chose de plus utile : elles disent à l'autre qu'il n'est pas seul avec ce qu'il res­sent. Et sou­vent, c'est tout ce dont il avait be­soin."/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Porte 4 — Nom­mer le jeu en­semble (duo)"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Une conver­sa­tion à avoir hors du mo­ment de ten­sion — pas le soir de l'ap­pel, pas dans l'in­con­fort en­core frais. Quelques jours après, au calme, 20 mi­nutes."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Cha­cun com­plète ces phrases sé­pa­ré­ment, par écrit :"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="&quot;Quand je par­tage quelque chose de dou­lou­reux, ce dont j'ai be­soin en pre­mier c'est...&quot;"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <ITEXT CH="&quot;Quand l'autre souffre et que je ne peux rien faire, ce qui se passe en moi c'est...&quot;"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <ITEXT CH="&quot;Ce que je trouve dif­fi­cile à dire dans ces mo­ments, c'est...&quot;"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Puis on par­tage — cha­cun lit, l'autre écoute sans in­ter­rompre, sans se dé­fendre. L'ob­jec­tif n'est pas de se convaincre. C'est d'en­tendre ce que l'autre vit vrai­ment sous la sur­face."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="En­suite, une seule ques­tion à ex­plo­rer en­semble :"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="&quot;Est-ce qu'on peut se don­ner un si­gnal — un mot, une phrase courte — qui dit 'là j'ai be­soin d'être en­ten­du, pas conseillé' ? Quelque chose qu'on re­con­naît tous les deux, et qui évite d'avoir à ex­pli­quer ça dans le mo­ment de dou­leur.&quot;"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Pas un code se­cret. Un rac­cour­ci. Qu'on peut tes­ter, ajus­ter, aban­don­ner si ça ne fonc­tionne pas."/>
                <trail PARENT="BODY" ALIGN="3"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="560.630551181103" YPOS="18483.5152254199" OwnPage="58" ItemID="391366016" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5230994355832" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="391385840" BACKITEM="391377344"/>
        <PAGEOBJECT XPOS="141.102992125984" YPOS="19118.7905010104" OwnPage="59" ItemID="391385840" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5227844749523" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="391366016"/>
        <PAGEOBJECT XPOS="560.630551181103" YPOS="19118.7905010104" OwnPage="60" ItemID="391380176" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5227844749523" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Nour­rir ton En­fant Libre — rap­pel"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Il y a quelque chose qui opère en fond dans cette scène — et dans toutes les sui­vantes."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Quand lui ne sait pas res­ter dans l'in­con­fort sans agir, c'est sou­vent le signe que quelque chose n'est pas nour­ri ailleurs. Que la seule fa­çon qu'il connaît d'être utile — et donc d'avoir de la va­leur — passe par les so­lu­tions, les plans, les ac­tions. Et quand ça ne fonc­tionne pas, il reste vide."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Quand elle ne peut pas dire di­rec­te­ment ce dont elle a be­soin — quand elle pré­fère se fer­mer plu­tôt que de de­man­der — c'est sou­vent le signe que quelque chose de plus an­cien est ac­ti­vé. Quelque chose qui lui dit que ses be­soins sont trop, ou qu'ils ne se­ront pas en­ten­dus de toute fa­çon."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="L'En­fant Libre, c'est cette par­tie de toi qui joue, qui res­sent, qui s'ex­prime sans cal­cul. Celle qui exis­tait avant que tu ap­prennes à être utile, ou à ne pas trop de­man­der. Elle n'a pas dis­pa­ru. Elle at­tend juste d'avoir un peu de place."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="La ques­tion à se po­ser ce soir :"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Qu'est-ce que j'ai fait au­jour­d'hui — même cinq mi­nutes — juste pour moi ? Pas pour être utile. Pas pour gé­rer. Juste pour moi."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="141.102992125984" YPOS="19754.0657766009" OwnPage="61" ItemID="391394336" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5224695143214" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Tra­cker En­fant Libre — 7 jours : Chaque soir, une mi­nute."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para ALIGN="3"/>
                <para ALIGN="3"/>
                <para ALIGN="3"/>
                <para ALIGN="3"/>
                <para ALIGN="3"/>
                <para ALIGN="3"/>
                <para ALIGN="3"/>
                <para ALIGN="3"/>
                <para ALIGN="3"/>
                <para ALIGN="3"/>
                <para ALIGN="3"/>
                <para ALIGN="3"/>
                <para ALIGN="3"/>
                <para ALIGN="3"/>
                <ITEXT CH="La ques­tion de fin de se­maine :"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <ITEXT CH="Les jours où j'ai nour­ri mon En­fant Libre — est-ce que j'avais plus ou moins en­vie de ré­soudre, de contrô­ler, de me fer­mer ? Est-ce qu'il y a un lien ?"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Sui­vi — 7 jours"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <ITEXT CH="Chaque soir, deux mi­nutes."/>
                <para PARENT="BODY" ALIGN="3"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="560.630551181103" YPOS="19754.0657766009" OwnPage="62" ItemID="391388672" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5224695143214" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Une ques­tion par soir — juste celle du jour :"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Lun­di : Ce soir, dans quel rôle ai-je pas­sé le plus de temps — Vic­time, Sau­veur, ou Per­sé­cu­teur ?"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Mar­di : Quand j'ai eu en­vie de pro­po­ser une so­lu­tion — qu'est-ce que je cher­chais à faire de mon propre in­con­fort ?"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Mer­cre­di : Quand j'ai par­ta­gé quelque chose de dif­fi­cile, est-ce que j'ai dit ce dont j'avais be­soin — ou j'ai lais­sé l'autre de­vi­ner ?"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Jeu­di : Qu'est-ce qui m'em­pêche de dire di­rec­te­ment &quot;j'ai be­soin d'être écou­té, pas conseillé&quot; ?"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ven­dre­di : Com­ment j'ai nour­ri mon En­fant Libre au­jour­d'hui — et qu'est-ce que ça a chan­gé dans ma dis­po­ni­bi­li­té pour l'autre ?"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Sa­me­di : Quelle croyance sur l'autre est-ce que cette se­maine est ve­nue confir­mer — et est-ce que c'est vrai­ment vrai ?"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Di­manche : Si je rem­pla­çais le &quot;laisse tom­ber&quot; par ce dont j'avais vrai­ment be­soin — quelle phrase est-ce que ça don­ne­rait ?"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="La scène sui­vante se passe dans une cui­sine, un soir or­di­naire. Il y a un té­lé­phone, un re­le­vé ban­caire, et un sac po­sé sur la table. Et une ques­tion que per­sonne n'a en­core po­sée clai­re­ment."/>
                <trail PARENT="scene_page_subtitle" ALIGN="1"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="141.102992125984" YPOS="20389.3410521915" OwnPage="63" ItemID="391391504" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5221545536904" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <trail/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="560.630551181103" YPOS="20389.3410521915" OwnPage="64" ItemID="391383008" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5221545536904" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <ITEXT CH="Scène 4 — Les finances"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <ITEXT CH="&quot;Le grand livre des comptes&quot;"/>
                <trail PARENT="Titre" ALIGN="1"/>
            </StoryText>
            <PageItemAttributes>
                <ItemAttribute Name="tdm" Type="string" Value="Scène 4 — Les finances" Parameter="" Relationship="none" RelationshipTo="" AutoAddTo="none"/>
            </PageItemAttributes>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="141.102992125984" YPOS="21024.616327782" OwnPage="65" ItemID="391402832" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5218395930595" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <trail/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="560.630551181103" YPOS="21024.616327782" OwnPage="66" ItemID="391405664" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5218395930595" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="La scène"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <ITEXT CH="Cui­sine, un soir de se­maine. Il consulte le compte ban­caire sur son té­lé­phone. Elle rentre avec un sac."/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <ITEXT CH="Lui : &quot;Tu as en­core fait des achats ?&quot;"/>
                <para PARENT="DIALOGUE" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <ITEXT CH="Elle : &quot;J'avais be­soin de quelques trucs.&quot;"/>
                <para PARENT="DIALOGUE" ALIGN="3"/>
                <para PARENT="DIALOGUE" ALIGN="3"/>
                <ITEXT CH="Lui : &quot;On avait dit qu'on fai­sait at­ten­tion ce mois-ci. On est dé­jà dans le rouge.&quot;"/>
                <para PARENT="DIALOGUE" ALIGN="3"/>
                <para PARENT="DIALOGUE" ALIGN="3"/>
                <ITEXT CH="Elle : &quot;C'était pas grand-chose. Et puis c'est aus­si mon ar­gent.&quot;"/>
                <para PARENT="DIALOGUE" ALIGN="3"/>
                <para PARENT="DIALOGUE" ALIGN="3"/>
                <ITEXT CH="Lui : &quot;Je ne dis pas que c'est pas ton ar­gent. Je dis qu'on a un bud­get com­mun et que tu n'en tiens pas compte.&quot;"/>
                <para PARENT="DIALOGUE" ALIGN="3"/>
                <para PARENT="DIALOGUE" ALIGN="3"/>
                <ITEXT CH="Elle : &quot;Tu sur­veilles tout ce que je fais main­te­nant ?&quot;"/>
                <para PARENT="DIALOGUE" ALIGN="3"/>
                <para PARENT="DIALOGUE" ALIGN="3"/>
                <ITEXT CH="Il pose son té­lé­phone. Si­lence."/>
                <para PARENT="DIALOGUE" ALIGN="3"/>
                <para PARENT="DIALOGUE" ALIGN="3"/>
                <ITEXT CH="Lui : &quot;Laisse tom­ber.&quot;"/>
                <para PARENT="DIALOGUE" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <ITEXT CH="Elle pose le sac, sort de la pièce. Le sac reste sur la table."/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <ITEXT CH="Tu te re­con­nais ?"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Cette scène, je la vis : ja­mais · par­fois · sou­vent"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Dans cette scène, tu res­sembles plu­tôt à : ce­lui qui sur­veille · ce­lui qui dé­pense · les deux se­lon les mo­ments"/>
                <trail PARENT="BODY" ALIGN="3"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="141.102992125984" YPOS="21659.8916033726" OwnPage="67" ItemID="391408496" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5215246324286" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="391397168" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Avant l'ana­lyse — une chose im­por­tante"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Si tu te re­con­nais dans cette scène, tu connais pro­ba­ble­ment les deux cô­tés."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Tu connais ce que c'est de re­gar­der un re­le­vé et de sen­tir quelque chose se ser­rer. Pas de la mé­chan­ce­té — une in­quié­tude réelle, dif­fuse, dif­fi­cile à for­mu­ler sans qu'elle sorte comme un re­proche. Le sen­ti­ment que le cadre qu'on s'est don­né ne tient pas. Que les dé­ci­sions ne se prennent pas vrai­ment en­semble. Et de ne pas sa­voir com­ment le dire sans avoir l'air de sur­veiller."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Et tu connais peut-être aus­si l'autre cô­té : ren­trer avec quelque chose — un achat, un geste pour soi — et sen­tir le re­gard avant même d'avoir po­sé le sac. L'im­pres­sion d'avoir à se jus­ti­fier pour quelque chose qui ne sem­blait pas si grave. Et la ques­tion qui monte, pas tou­jours for­mu­lée : suis-je libre dans ce couple ?"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Les deux sont réels. Les deux sont lé­gi­times. Et les deux se ren­contrent ra­re­ment — parce que cha­cun ré­pond à ce qu'il en­tend, pas à ce que l'autre dit vrai­ment."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ce que ce book­let va te pro­po­ser, c'est de re­gar­der ce qui se passe vrai­ment sous la sur­face — pas pour dé­si­gner ce­lui qui a tort, mais parce que c'est le seul en­droit de­puis le­quel quelque chose peut chan­ger."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ce qui se passe vrai­ment"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <ITEXT CH="En sur­face, c'est une dis­pute sur un bud­get dé­pas­sé. Ce qui se passe vrai­ment n'a presque rien à voir avec le mon­tant sur le re­le­vé."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="L'ar­gent dans un couple n'est ja­mais seule­ment de l'ar­gent. Il est le ter­rain sur le­quel s'ex­priment des ques­tions bien plus char­gées : qui dé­cide, qui contrôle, qui fait confiance, qui est libre, qui est res­pon­sable. Ce que cha­cun fait avec l'ar­gent — dé­pen­ser, re­te­nir, sur­veiller, igno­rer — dit quelque chose sur ce dont il a be­soin et ce qu'il craint. Pas consciem­ment. Mais réel­le­ment."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Il y a aus­si, sou­vent, une ques­tion que les deux n'ont ja­mais vrai­ment tran­chée — pas parce qu'ils l'ont évi­tée, mais parce qu'elle ne s'est ja­mais po­sée clai­re­ment."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Jus­qu'où l'ar­gent est-il nôtre ?"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ce pas­sage de mon ar­gent à notre ar­gent n'a rien d'au­to­ma­tique. Il sup­pose une dé­ci­sion — consciente, ex­pli­cite, choi­sie en­semble — sur ce qu'on met en com­mun, ce qu'on garde sé­pa­ré, et ce que ça dit de la fa­çon dont on se lie. Cer­tains couples fu­sionnent tout dès le dé­but, sans en dis­cu­ter. D'autres main­tiennent des zones sé­pa­rées, sans l'avoir vrai­ment dé­ci­dé non plus. Et beau­coup vivent dans un entre-deux flou — un compte com­mun pour les charges, des comptes per­son­nels pour le reste — sans avoir ja­mais nom­mé ce que cette or­ga­ni­sa­tion dit de leur re­la­tion."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="&quot;C'est aus­si mon ar­gent&quot; — cette phrase qui sort dans la scène n'est pas seule­ment une re­ven­di­ca­tion d'au­to­no­mie. C'est le signe que cette ques­tion-là n'a pas en­core été ré­so­lue. Pas entre les chiffres. Entre eux."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Et tant qu'elle ne l'est pas, la dis­pute sur le bud­get tourne en rond — parce qu'elle cherche une ré­ponse fi­nan­cière à une ques­tion qui est d'abord re­la­tion­nelle."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ici, lui ouvre le compte et voit un dé­pas­se­ment. Ce qu'il res­sent n'est pas seule­ment de l'in­quié­tude fi­nan­cière — c'est quelque chose de plus dif­fus : l'im­pres­sion que les dé­ci­sions ne se prennent pas en­semble, que l'ac­cord n'est pas res­pec­té, que le cadre com­mun ne tient pas. Ce n'est pas en­core un re­proche — c'est une an­xié­té qui cherche une sor­tie. Et elle sort par la sur­veillance."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Elle rentre avec un sac. Elle n'a pas l'im­pres­sion d'avoir fait quelque chose de grave — ou si elle l'a, elle ne veut pas l'ad­mettre. Quand il pointe le dé­pas­se­ment, elle en­tend autre chose que ce qu'il dit. Elle en­tend : tu n'es pas fiable. Je dois te sur­veiller. Tu n'es pas libre. Et à cette phrase-là, elle ré­pond — pas au bud­get."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="&quot;Tu sur­veilles tout ce que je fais ?&quot; n'est pas une ques­tion sur les re­le­vés ban­caires. C'est une ques­tion sur la confiance, l'au­to­no­mie, la place qu'elle a dans ce couple."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Per­sonne ne parle de ce dont il parle vrai­ment. Et c'est pour ça que ça ne se ré­sout pas."/>
                <trail PARENT="BODY" ALIGN="3"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="560.630551181103" YPOS="21659.8916033726" OwnPage="68" ItemID="391397168" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5215246324286" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="391408496"/>
        <PAGEOBJECT XPOS="141.102992125984" YPOS="22295.1668789632" OwnPage="69" ItemID="391411328" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5212096717976" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="391400000" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Les états du moi en pré­sence :"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ce qui est frap­pant : les deux opèrent de­puis des états qui ne peuvent pas se ren­con­trer. Son "/>
                <ITEXT FONT="Times New Roman Bold" CH="Pa­rent Nor­ma­tif"/>
                <ITEXT CH=" s'adresse à un "/>
                <ITEXT FONT="Times New Roman Bold" CH="Adulte"/>
                <ITEXT CH=" qui n'est pas là. Son"/>
                <ITEXT FONT="Times New Roman Bold" CH=" En­fant Re­belle"/>
                <ITEXT CH=" ré­pond à un "/>
                <ITEXT FONT="Times New Roman Bold" CH="Pa­rent"/>
                <ITEXT CH=" qu'elle ne veut pas re­con­naître. "/>
                <ITEXT FONT="Times New Roman Bold" CH="L'Adulte"/>
                <ITEXT CH=" — ce­lui qui pour­rait par­ler de bud­get, de be­soins, de dé­ci­sions com­munes — est ab­sent des deux cô­tés."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="La "/>
                <ITEXT FONT="Times New Roman Bold" CH="Vic­time"/>
                <ITEXT CH=" qui éveille le "/>
                <ITEXT FONT="Times New Roman Bold" CH="Contrô­leur"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Il y a un ré­flexe sy­mé­trique à ce­lui qu'on a vu dans la scène pré­cé­dente — mais in­ver­sé."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Quand il per­çoit un dé­pas­se­ment bud­gé­taire, quelque chose s'ac­tive en lui au­to­ma­ti­que­ment. Pas une dé­ci­sion. Un ré­flexe de pro­tec­tion. La me­nace per­çue — fi­nan­cière, mais aus­si re­la­tion­nelle — éveille le "/>
                <ITEXT FONT="Times New Roman Bold" CH="Pa­rent Nor­ma­tif"/>
                <ITEXT CH=" en mode contrôle. Il vé­ri­fie, il re­cadre, il rap­pelle les règles."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ce ré­flexe n'est pas ar­bi­traire. Il vient sou­vent d'un en­droit pré­cis : la peur de l'in­sta­bi­li­té, un rap­port à l'ar­gent construit tôt, une convic­tion que si per­sonne ne sur­veille tout s'ef­fondre. Ce n'est pas lui qui sur­veille elle — c'est lui qui sur­veille le sys­tème, parce que le sys­tème re­pré­sente quelque chose de vi­tal."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Mais elle ne voit pas le sys­tème. Elle voit le re­gard sur elle. Et ce re­gard-là ac­tive son "/>
                <ITEXT FONT="Times New Roman Bold" CH="En­fant Re­belle"/>
                <ITEXT CH=" — ce­lui qui re­fuse la tu­telle, qui re­ven­dique sa place, qui dit je ne suis pas une en­fant qu'on sur­veille."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Les deux ré­agissent à quelque chose de réel. Et au­cun des deux ne ré­agit à ce que l'autre dit vrai­ment."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Le tri­angle de Karp­man — le drame en trois actes"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ce qui rend ce tri­angle par­ti­cu­lier, c'est qu'il dé­marre avant même que les mots ar­rivent. Le jeu est dé­jà en cours quand elle pousse la porte."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT FONT="Times New Roman Bold" CH="Acte 1"/>
                <ITEXT CH=" — avant qu'elle rentre. Il consulte le compte. Il voit le dé­pas­se­ment. Quelque chose se serre. Il n'a en­core rien dit — mais il est dé­jà en "/>
                <ITEXT FONT="Times New Roman Bold" CH="Vic­time"/>
                <ITEXT CH=" : seul avec une in­quié­tude qu'il porte, un cadre qu'il sur­veille, une dé­ci­sion qui a été prise sans lui. L'autre n'est pas en­core là, et le jeu a dé­jà com­men­cé."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT FONT="Times New Roman Bold" CH="Acte 2"/>
                <ITEXT CH=" — elle rentre. Elle pose le sac. Il dit : &quot;"/>
                <ITEXT FONT="Times New Roman Italic" CH="tu as en­core fait des achats "/>
                <ITEXT CH="?&quot; Il bas­cule en "/>
                <ITEXT FONT="Times New Roman Bold" CH="Per­sé­cu­teur"/>
                <ITEXT CH=" — pas par in­ten­tion, mais par ef­fet. La ques­tion n'est pas neutre. Elle pointe. Elle éva­lue. Elle place l'autre en po­si­tion de se jus­ti­fier."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Elle entre en "/>
                <ITEXT FONT="Times New Roman Bold" CH="Vic­time"/>
                <ITEXT CH=" — sur­prise, ou peut-être pas tout à fait. Elle sa­vait. Et quelque chose en elle s'était pré­pa­ré à ça."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT FONT="Times New Roman Bold" CH="Acte 3"/>
                <ITEXT CH=" — le coup de théâtre. &quot;"/>
                <ITEXT FONT="Times New Roman Italic" CH="Tu sur­veilles tout ce que je fais "/>
                <ITEXT CH="?&quot; Elle bas­cule en "/>
                <ITEXT FONT="Times New Roman Bold" CH="Per­sé­cu­teur"/>
                <ITEXT CH=". Ce n'est plus une ré­ponse au bud­get — c'est une contre-at­taque sur le ter­rain du contrôle et de la li­ber­té. Lui de­vient "/>
                <ITEXT FONT="Times New Roman Bold" FONTSIZE="5.5" CH="Vic­time"/>
                <ITEXT CH=" à nou­veau : il es­sayait juste de te­nir un ac­cord, et il se re­trouve ac­cu­sé de sur­veiller."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="&quot;Laisse tom­ber.&quot; Il se re­tire. Le jeu s'ar­rête — sans vain­queur, sans ré­so­lu­tion. Le sac reste sur la table. Et cha­cun re­part avec la confir­ma­tion de ce qu'il crai­gnait."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT FONT="Times New Roman Bold" CH="Vic­time"/>
                <ITEXT CH=" seul avec le re­le­vé → "/>
                <ITEXT FONT="Times New Roman Bold" CH="Per­sé­cu­teur"/>
                <ITEXT CH=" à son ar­ri­vée → elle en "/>
                <ITEXT FONT="Times New Roman Bold" CH="Vic­time"/>
                <ITEXT CH=" → elle bas­cule "/>
                <ITEXT FONT="Times New Roman Bold" CH="Per­sé­cu­teur"/>
                <ITEXT CH=" → lui en "/>
                <ITEXT FONT="Times New Roman Bold" CH="Vic­time"/>
                <ITEXT CH=" → re­trait → confir­ma­tion mu­tuelle de ce qu'on crai­gnait dé­jà"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Le bé­né­fice ca­ché du drame"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ce tri­angle dure parce qu'il pro­tège quelque chose — chez cha­cun, dif­fé­rem­ment."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT FONT="Times New Roman Bold" CH="Pour lui"/>
                <ITEXT CH=" : sur­veiller, c'est une fa­çon de ne pas être sub­mer­gé par une in­quié­tude qu'il ne sait pas tou­jours nom­mer. Si j'ai le cadre en main, je ne suis pas im­puis­sant. Ce n'est pas du contrôle pour le contrôle — c'est une ré­ponse à quelque chose de plus an­cien, sou­vent, sur l'in­sta­bi­li­té ou la perte. Le pro­blème, c'est que cette ré­ponse-là coûte à l'autre ce dont elle a le plus be­soin : se sen­tir libre."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT FONT="Times New Roman Bold" CH="Pour elle"/>
                <ITEXT CH=" : dé­pen­ser sans en par­ler pré­serve une zone qui lui ap­par­tient. Une dé­ci­sion prise seule, pour elle, sans né­go­cia­tion. Ce n'est pas de l'ir­res­pon­sa­bi­li­té — c'est sou­vent un be­soin d'au­to­no­mie qui n'a pas en­core trou­vé d'autre che­min. Le pro­blème, c'est que ce che­min-là coûte à l'autre ce dont il a le plus be­soin : se sen­tir dans la même équipe."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Les deux pro­tègent quelque chose de lé­gi­time. Et les deux le font d'une fa­çon qui blesse exac­te­ment là où l'autre est le plus vul­né­rable. Ce n'est pas de la mal­veillance — c'est ce qui ar­rive quand deux be­soins réels ne se sont ja­mais dit à voix haute."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="560.630551181103" YPOS="22295.1668789632" OwnPage="70" ItemID="391400000" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5212096717976" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="391414160" BACKITEM="391411328"/>
        <PAGEOBJECT XPOS="141.102992125984" YPOS="22930.4421545536" OwnPage="71" ItemID="391414160" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5208947111667" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="391400000"/>
        <PAGEOBJECT XPOS="560.630551181103" YPOS="22930.4421545536" OwnPage="72" ItemID="391419824" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5208947111667" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="391416992" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Pour­quoi elle/il dé­pense — pistes d'ex­plo­ra­tion"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Avant de par­ler de bud­get, il y a une ques­tion plus utile que &quot;"/>
                <ITEXT FONT="Times New Roman Italic" CH="com­bien as-tu dé­pen­sé"/>
                <ITEXT CH=" ?&quot;"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Qu'est-ce que cette dé­pense cher­chait à faire ?"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Pas pour ex­cu­ser. Pas pour nor­ma­li­ser. Mais parce que com­prendre ce qui se passe vrai­ment sous la dé­pense change com­plè­te­ment la na­ture de la conver­sa­tion — et ouvre la pos­si­bi­li­té d'une vraie ré­ponse au lieu d'un conflit de chiffres."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Quelques pistes — plu­sieurs peuvent co­exis­ter, et au­cune n'est uni­ver­selle :"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT FONT="Times New Roman Bold" CH="La dé­pense comme soin de soi"/>
                <ITEXT CH=". Après une se­maine dif­fi­cile, un achat — même pe­tit — peut être la seule fa­çon de se don­ner quelque chose. Pas du luxe : de la dou­ceur. Un geste concret qui dit je compte, moi aus­si. Si le reste de la vie est or­ga­ni­sé au­tour des be­soins des autres, cette dé­pense-là est peut-être la seule zone où elle choi­sit pour elle."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT FONT="Times New Roman Bold" CH="La dé­pense comme ter­ri­toire d'au­to­no­mie"/>
                <ITEXT CH=". Dans un couple où les dé­ci­sions fi­nan­cières sont asy­mé­triques — un qui gagne plus, un qui sur­veille plus, un qui dé­cide plus — dé­pen­ser sans de­man­der peut être une fa­çon si­len­cieuse de re­ven­di­quer une place. Je ne suis pas en train de te de­man­der la per­mis­sion. Ce n'est pas ra­tion­nel. C'est iden­ti­taire."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT FONT="Times New Roman Bold" CH="La dé­pense comme ré­gu­la­tion émo­tion­nelle"/>
                <ITEXT CH=". Le shop­ping, comme d'autres com­por­te­ments com­pul­sifs, peut être une ré­ponse à un état in­té­rieur dif­fi­cile — an­xié­té, en­nui, tris­tesse, sen­ti­ment de vide. L'achat pro­duit une sti­mu­la­tion ra­pide, une mi­ni-sa­tis­fac­tion. Le pro­blème n'est pas la dé­pense — c'est ce qu'elle vient cou­vrir, et qui reste en­tier après."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT FONT="Times New Roman Bold" CH="La dé­pense comme test"/>
                <ITEXT CH=". Par­fois, in­cons­ciem­ment, dé­pas­ser un ac­cord est une fa­çon de tes­ter la ré­ac­tion de l'autre. Est-ce qu'il va s'en rendre compte ? Est-ce qu'il va ré­agir ? Est-ce qu'il fait at­ten­tion à ce qu'on vit ? Ce n'est pas une stra­té­gie — c'est un be­soin de connexion qui s'ex­prime par un che­min de tra­vers."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ces pistes ne sont pas des ex­cuses. Elles sont des portes d'en­trée vers une conver­sa­tion dif­fé­rente. Celle qui com­mence par &quot;qu'est-ce qui s'est pas­sé pour toi ce mois-ci ?&quot; plu­tôt que par &quot;tu as en­core dé­pen­sé.&quot;"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Et pour lui aus­si, une ques­tion sy­mé­trique mé­rite d'être po­sée : pour­quoi est-ce que le contrôle de l'ar­gent est si im­por­tant pour moi ? Qu'est-ce que le dé­pas­se­ment bud­gé­taire ac­tive vrai­ment — l'in­quié­tude fi­nan­cière, ou quelque chose de plus an­cien sur l'in­sta­bi­li­té, la confiance, le sen­ti­ment d'être dé­bor­dé ?"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Il y a sou­vent quelque chose de pa­ra­doxal dans cette po­si­tion. Ce qui énerve chez l'autre — la lé­gè­re­té, l'im­pul­sion, la ca­pa­ci­té à dé­pen­ser sans y pen­ser — est par­fois exac­te­ment ce dont on au­rait be­soin soi-même. Mais un Pa­rent in­té­rieur trop pré­sent le rend in­ac­ces­sible. Il faut être rai­son­nable. Il faut te­nir. Ce n'est pas le mo­ment. Et voir l'autre s'ac­cor­der ce qu'on se re­fuse crée une ir­ri­ta­tion qui res­semble à de la co­lère — mais qui cache sou­vent quelque chose de plus doux : de la tris­tesse, ou de la peur."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ce que cha­cun fait avec l'ar­gent dit aus­si quelque chose de plus pro­fond — sur ce qu'il va­lo­rise, ce qu'il consi­dère comme lé­gi­time, ce qu'il s'au­to­rise. Deux per­sonnes peuvent avoir des re­ve­nus iden­tiques et des rap­ports à l'ar­gent ra­di­ca­le­ment dif­fé­rents — parce que ces rap­ports-là ne se construisent pas sur des chiffres. Ils se construisent sur des his­toires. Ce qu'on a vu faire dans la fa­mille d'ori­gine. Ce qu'on a ap­pris à as­so­cier à la dé­pense — du plai­sir, de la culpa­bi­li­té, de la li­ber­té, du dan­ger. Ce que l'ar­gent re­pré­sen­tait quand on était en­fant — la sé­cu­ri­té, le manque, le pou­voir, la lé­gè­re­té."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ce n'est pas une in­com­pa­ti­bi­li­té. C'est une dif­fé­rence de va­leurs qui n'a pas en­core été nom­mée. Et une dif­fé­rence non nom­mée fi­nit tou­jours par s'ex­pri­mer — sous forme de re­proche, de ré­sis­tance, ou de si­lence."/>
                <trail PARENT="BODY" ALIGN="3"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="141.102992125984" YPOS="23565.7174301442" OwnPage="73" ItemID="391416992" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5205797505358" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="391419824"/>
        <PAGEOBJECT XPOS="560.630551181103" YPOS="23565.7174301442" OwnPage="74" ItemID="468775312" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5205797505358" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="468778144" BACKITEM="-1">
            <StoryText>
                <DefaultStyle LANGUAGE="fur"/>
                <ITEXT LANGUAGE="fur" CH="L'alerte à ne pas manquer"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT LANGUAGE="fur" CH="La sortie de ce jeu n'est pas de mieux tenir le budget — ou de moins surveiller."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT LANGUAGE="fur" CH="Tenir le budget sans changer la dynamique produit une tension souterraine qui explose ailleurs. Et surveiller moins sans adresser l'inquiétude réelle crée une anxiété qui cherche une autre sortie."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT LANGUAGE="fur" CH="La vraie question pour lui n'est pas &quot;"/>
                <ITEXT FONT="Times New Roman Italic" LANGUAGE="fur" CH="comment lui faire respecter le budget ?"/>
                <ITEXT LANGUAGE="fur" CH="&quot; C'est &quot;"/>
                <ITEXT FONT="Times New Roman Italic" LANGUAGE="fur" CH="qu'est-ce que le dépassement active vraiment en moi — et d'où ça vient "/>
                <ITEXT LANGUAGE="fur" CH="?&quot;"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT LANGUAGE="fur" CH="La vraie question pour elle n'est pas &quot;"/>
                <ITEXT FONT="Times New Roman Italic" LANGUAGE="fur" CH="comment lui faire comprendre que c'est aussi mon argent ?"/>
                <ITEXT LANGUAGE="fur" CH="&quot; C'est &quot;"/>
                <ITEXT FONT="Times New Roman Italic" LANGUAGE="fur" CH="qu'est-ce que je cherche quand je dépense sans en parler — et est-ce que cette chose-là pourrait se demander autrement ?"/>
                <ITEXT LANGUAGE="fur" CH="&quot;"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT LANGUAGE="fur" CH="Ce dont on a vraiment besoin — l'angle CNV"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <ITEXT LANGUAGE="fur" CH="Avant d'aller plus loin, un point important."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT LANGUAGE="fur" CH="Dans cette scène, les deux protagonistes n'occupent pas la même position — et ils n'ont pas les mêmes besoins. Les mélanger, c'est rater quelque chose d'essentiel."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT LANGUAGE="fur" CH="Ce qui suit propose deux lectures séparées. Pas pour désigner un coupable et une victime. Pour permettre à chacun de se reconnaître honnêtement dans ce qui est activé en lui — et de trouver sa propre porte de sortie."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT LANGUAGE="fur" CH="Et dans les deux cas, la même règle s'applique : un besoin m'appartient. Il ne dépend pas de ce que l'autre fait ou ne fait pas. Je suis responsable de trouver comment le nourrir — pas d'attendre que l'autre le devine."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT LANGUAGE="fur" CH="Si tu es celui ou celle qui surveille"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT LANGUAGE="fur" CH="Ce que tu exprimes à travers le relevé n'est pas vraiment du contrôle. C'est une information sur ce qui manque — et sur ce que tu ne t'accordes pas."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT LANGUAGE="fur" CH="Il y a souvent quelque chose de paradoxal dans cette position. Ce qui énerve chez l'autre — la légèreté, l'impulsion, la capacité à dépenser sans y penser — est parfois exactement ce dont on aurait besoin soi-même. Mais un Parent intérieur trop présent le rend inaccessible. Il faut être raisonnable. Il faut tenir. Ce n'est pas le moment. Et voir l'autre s'accorder ce qu'on se refuse crée une irritation qui ressemble à de la colère — mais qui cache souvent quelque chose de plus doux : de la tristesse, ou de la peur."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT LANGUAGE="fur" CH="La peur, souvent, d'un effondrement. De ne pas s'en sortir. Quelqu'un en mode survie ne peut pas se projeter — la légèreté devient un luxe qui semble dangereux. Et depuis cet endroit-là, surveiller est une façon maladroite de chercher à construire quelque chose — un cadre partagé, un élan commun, un on est dans le même bateau."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT LANGUAGE="fur" CH="Lis cette liste. Coche ce qui résonne vraiment."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para ALIGN="3"/>
                <para ALIGN="3"/>
                <para ALIGN="3"/>
                <para ALIGN="3"/>
                <para ALIGN="3"/>
                <para ALIGN="3"/>
                <para ALIGN="3"/>
                <para ALIGN="3"/>
                <ITEXT LANGUAGE="fur" CH="Une fois ton besoin identifié, complète cette phrase :"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para ALIGN="3"/>
                <ITEXT LANGUAGE="fur" CH="&quot;J'ai besoin de __. Quand je me reconnecte à ce besoin, ce que je choisis de faire c'est __.&quot;"/>
                <para PARENT="narration" ALIGN="3"/>
                <para ALIGN="3"/>
                <ITEXT LANGUAGE="fur" CH="Quelques exemples :"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para ALIGN="3"/>
                <ITEXT LANGUAGE="fur" CH="&quot;J'ai besoin de légèreté. Ce que je choisis de faire c'est m'accorder quelque chose cette semaine — même petit — sans me justifier. Et observer ce que ça change dans ma disponibilité pour l'autre.&quot;"/>
                <para PARENT="narration" ALIGN="3"/>
                <para ALIGN="3"/>
                <ITEXT LANGUAGE="fur" CH="&quot;J'ai besoin de partage. Ce que je choisis de faire c'est proposer une conversation sur ce qu'on veut construire ensemble — pas sur ce qui a dérapé.&quot;"/>
                <para PARENT="narration" ALIGN="3"/>
                <para ALIGN="3"/>
                <ITEXT LANGUAGE="fur" CH="&quot;J'ai besoin de clarté. Ce que je choisis de faire c'est nommer mon inquiétude directement — pas sous forme de reproche, mais comme quelque chose qui m'appartient et que j'aimerais traverser à deux.&quot;"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <ITEXT LANGUAGE="fur" CH="Si tu es celui ou celle qui dépense"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para ALIGN="3"/>
                <ITEXT LANGUAGE="fur" CH="Ce que tu exprimes à travers l'achat n'est pas de l'irresponsabilité. C'est une information sur ce dont tu as besoin — et sur ce qui manque quand chaque décision devient un terrain de négociation."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT LANGUAGE="fur" CH="La dépense dit quelque chose que les mots ne disent pas encore. Parfois c'est du soin de soi — le seul geste de la semaine qui était pour toi. Parfois c'est de l'autonomie revendiquée — une décision prise seule, sans avoir à demander la permission. Parfois c'est une régulation — quelque chose de difficile à traverser, et l'achat qui apporte une mini-satisfaction rapide. Et parfois, sans le décider, c'est une façon de tester : est-ce qu'il fait attention à ce qui se passe pour moi ?"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT LANGUAGE="fur" CH="Ce n'est pas une stratégie. C'est un besoin qui n'a pas encore trouvé son chemin direct."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT LANGUAGE="fur" CH="Lis cette liste. Coche ce qui résonne vraiment."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para ALIGN="3"/>
                <para ALIGN="3"/>
                <para ALIGN="3"/>
                <para ALIGN="3"/>
                <para ALIGN="3"/>
                <para ALIGN="3"/>
                <para ALIGN="3"/>
                <para ALIGN="3"/>
                <para ALIGN="3"/>
                <ITEXT LANGUAGE="fur" CH="Une fois ton besoin identifié, complète cette phrase :"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para ALIGN="3"/>
                <ITEXT LANGUAGE="fur" CH="&quot;J'ai besoin de __. Quand je me reconnecte à ce besoin, ce que je choisis de faire c'est __.&quot;"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT LANGUAGE="fur" CH="Quelques exemples :"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT LANGUAGE="fur" CH="&quot;J'ai besoin de liberté. Ce que je choisis de faire c'est proposer qu'on réfléchisse ensemble à une enveloppe personnelle — de l'argent dont chacun dispose librement, sans justification.&quot;"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT LANGUAGE="fur" CH="&quot;J'ai besoin de soin de soi. Ce que je choisis de faire c'est trouver d'autres façons de me faire du bien qui ne passent pas uniquement par la dépense — et nommer ce dont j'ai besoin plutôt que de le chercher seule.&quot;"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT LANGUAGE="fur" CH="&quot;J'ai besoin de vitalité. Ce que je choisis de faire c'est proposer quelque chose de léger cette semaine — pas grand-chose, juste quelque chose qui sort de la gestion.&quot;"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT LANGUAGE="fur" CH="Ces deux listes ne s'opposent pas. Elles ne se rencontrent jamais dans la scène — parce que la scène ne leur laisse pas de place. Mais elles parlent au fond de la même chose : deux personnes qui cherchent à vivre, chacune à sa façon, dans un espace qui est censé être commun."/>
                <trail PARENT="BODY" ALIGN="3"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="141.102992125984" YPOS="24200.9927057348" OwnPage="75" ItemID="468778144" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5202647899049" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="468769648" BACKITEM="468775312"/>
        <PAGEOBJECT XPOS="560.630551181103" YPOS="24200.9927057348" OwnPage="76" ItemID="468769648" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5202647899049" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="468766816" BACKITEM="468778144"/>
        <PAGEOBJECT XPOS="141.102992125984" YPOS="24836.2679813253" OwnPage="77" ItemID="468766816" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5199498292739" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="468769648"/>
        <PAGEOBJECT XPOS="560.630551181103" YPOS="24836.2679813253" OwnPage="78" ItemID="468783808" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5199498292739" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Nour­rir ton En­fant Libre"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="DIALOGUE" ALIGN="3"/>
                <para PARENT="DIALOGUE" ALIGN="3"/>
                <ITEXT CH="Il y a quelque chose qui opère en fond dans cette scène — et qui mé­rite d'être nom­mé."/>
                <para PARENT="DIALOGUE" ALIGN="3"/>
                <para PARENT="DIALOGUE" ALIGN="3"/>
                <ITEXT CH="Ce­lui qui sur­veille a sou­vent mis sa propre lé­gè­re­té sous clé de­puis long­temps. Le "/>
                <ITEXT FONT="Times New Roman Bold" CH="Pa­rent Nor­ma­tif"/>
                <ITEXT CH=" a pris trop de place — il faut te­nir, il faut gé­rer, ce n'est pas le mo­ment. Et l'"/>
                <ITEXT FONT="Times New Roman Bold" CH="En­fant Libre"/>
                <ITEXT CH=", cette par­tie qui joue, qui s'ac­corde, qui dé­pense par­fois sans rai­son va­lable, a ap­pris à se taire. Le ré­sul­tat : une dis­po­ni­bi­li­té émo­tion­nelle ré­duite, une ir­ri­ta­bi­li­té de fond, et une ja­lou­sie sourde en­vers ce­lui ou celle qui semble pou­voir faire ce qu'on s'in­ter­dit."/>
                <para PARENT="DIALOGUE" ALIGN="3"/>
                <para PARENT="DIALOGUE" ALIGN="3"/>
                <ITEXT CH="Celle qui dé­pense, elle, cherche à nour­rir son "/>
                <ITEXT FONT="Times New Roman Bold" CH="En­fant Libre "/>
                <ITEXT CH="— mais par un che­min qui dé­clenche le conflit plu­tôt que de créer de l'es­pace. La dé­pense est une ten­ta­tive de lé­gè­re­té. Pas tou­jours la plus di­recte."/>
                <para PARENT="DIALOGUE" ALIGN="3"/>
                <para PARENT="DIALOGUE" ALIGN="3"/>
                <ITEXT CH="Les deux ont be­soin de la même chose — se don­ner de la lé­gè­re­té, cha­cun à sa fa­çon, sans que ça passe par l'ar­gent ou par l'autre."/>
                <para PARENT="DIALOGUE" ALIGN="3"/>
                <para PARENT="DIALOGUE" ALIGN="3"/>
                <ITEXT CH="La ques­tion à se po­ser ce soir :"/>
                <para PARENT="DIALOGUE" ALIGN="3"/>
                <para PARENT="DIALOGUE" ALIGN="3"/>
                <ITEXT CH="Qu'est-ce que j'ai fait au­jour­d'hui — même cinq mi­nutes — juste pour moi ? Pas pour gé­rer. Pas pour être res­pon­sable. Juste pour le plai­sir d'exis­ter."/>
                <para PARENT="DIALOGUE" ALIGN="3"/>
                <para PARENT="DIALOGUE" ALIGN="3"/>
                <ITEXT CH="Et une ques­tion sup­plé­men­taire, propre à cette scène :"/>
                <para PARENT="DIALOGUE" ALIGN="3"/>
                <para PARENT="DIALOGUE" ALIGN="3"/>
                <ITEXT CH="Qu'est-ce que je m'in­ter­dis — et pour­quoi ? Est-ce que cette in­ter­dic­tion me pro­tège vrai­ment, ou est-ce qu'elle m'ap­pau­vrit ?"/>
                <trail PARENT="DIALOGUE" ALIGN="3"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="141.102992125984" YPOS="25471.5432569159" OwnPage="79" ItemID="468772480" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.519634868643" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="468780976" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Les portes de sor­tie"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ni­veau 1 — Re­pé­rer ce que l'ar­gent re­pré­sente (so­lo — les deux par­te­naires)"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Avant la pro­chaine conver­sa­tion fi­nan­cière, une ques­tion in­té­rieure :"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Quand je pense à l'ar­gent dans ce couple, qu'est-ce que je res­sens — et d'où ça vient ?"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Pour ce­lui qui sur­veille : est-ce de l'in­quié­tude concrète, ou quelque chose de plus an­cien sur l'in­sta­bi­li­té, la perte, le sen­ti­ment de ne pas contrô­ler ?"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Pour ce­lui qui dé­pense : est-ce un be­soin réel, un geste de soin de soi, un ter­ri­toire d'au­to­no­mie — ou quelque chose qui cherche à com­bler autre chose ?"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Pas en­core be­soin d'en par­ler. Juste nom­mer, in­té­rieu­re­ment."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ni­veau 2 — Sé­pa­rer l'ar­gent du pou­voir (so­lo — les deux par­te­naires)"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Une pra­tique simple : la pro­chaine fois que la ques­tion fi­nan­cière émerge, no­ter men­ta­le­ment si la conver­sa­tion porte sur les chiffres — ou sur autre chose. Le bud­get, l'au­to­no­mie, la confiance, la li­ber­té, le contrôle."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Si c'est autre chose, la conver­sa­tion sur les chiffres ne ré­sou­dra rien. Il y a une conver­sa­tion dif­fé­rente à avoir — et elle com­mence par nom­mer ce qui est vrai­ment en jeu."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ni­veau 3 — Se don­ner un es­pace pour par­ler d'ar­gent au­tre­ment (duo)"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Une conver­sa­tion sur l'ar­gent ne peut pas se te­nir dans le mo­ment où le re­le­vé vient d'être consul­té. Ni dans la ten­sion du re­proche, ni dans la dé­fense qui suit. Elle a be­soin d'un autre es­pace — choi­si, au calme, avec une in­ten­tion par­ta­gée."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Pas une réunion. Pas un au­dit. Plu­tôt un mo­ment qu'on dé­cide en­semble, hors de toute ur­gence, avec une seule ques­tion à l'en­trée :"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="&quot;Est-ce qu'on peut par­ler de ce que l'ar­gent re­pré­sente pour cha­cun de nous — pas de ce qu'on a dé­pen­sé, mais de ce qu'on veut construire ?&quot;"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ce dé­pla­ce­ment-là change tout. On ne parle plus de chiffres — on parle de va­leurs, de be­soins, de ce qu'on ima­gine pour la suite. Et de­puis cet en­droit-là, des choses de­viennent pos­sibles qui ne l'étaient pas dans la cui­sine, le sac en­core sur la table."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Quelques ques­tions pour struc­tu­rer cet échange :"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="&quot;Qu'est-ce que l'ar­gent re­pré­sente pour toi dans notre couple — concrè­te­ment et sym­bo­li­que­ment ?&quot;"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="&quot;Qu'est-ce qu'on n'a ja­mais vrai­ment dé­ci­dé en­semble — et qui mé­ri­te­rait qu'on le dé­cide ?&quot;"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <ITEXT CH="&quot;De quoi as-tu be­soin pour te sen­tir libre — et de quoi ai-je be­soin pour me sen­tir en sé­cu­ri­té ? Est-ce qu'on peut trou­ver quelque chose qui serve les deux ?&quot;"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <ITEXT CH="&quot;Est-ce qu'on peut pré­voir une en­ve­loppe pour cha­cun — de l'ar­gent dont on dis­pose sans avoir à se jus­ti­fier — et une en­ve­loppe com­mune pour les dé­ci­sions par­ta­gées ?&quot;"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ce n'est pas une né­go­cia­tion ga­gnant-per­dant. C'est deux per­sonnes qui cherchent en­semble un sys­tème qui res­pecte à la fois ce dont l'un a be­soin pour se sen­tir an­cré — et ce dont l'autre a be­soin pour se sen­tir vi­vant."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ni­veau 4 — Nom­mer le jeu en­semble (duo)"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Quelques jours après la scène, au calme :"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="&quot;Je réa­lise que quand on parle d'ar­gent, on parle ra­re­ment que d'ar­gent. Moi j'ai ten­dance à sur­veiller quand je me sens in­quiet — toi tu as ten­dance à dé­pen­ser quand tu as be­soin d'es­pace. Est-ce que ça te parle ?&quot;"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Pas une ac­cu­sa­tion. Une ob­ser­va­tion par­ta­gée — qui ouvre la pos­si­bi­li­té de par­ler de ce qui se passe vrai­ment."/>
                <trail PARENT="BODY" ALIGN="3"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="560.630551181103" YPOS="25471.5432569159" OwnPage="80" ItemID="468780976" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.519634868643" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="274197680" BACKITEM="468772480"/>
        <PAGEOBJECT XPOS="141.102992125984" YPOS="6413.28498919936" OwnPage="19" ItemID="468792304" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5290836875473" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle FONT="Algerian Regular" LANGUAGE="ee"/>
                <ITEXT CH="Ce dont on a vrai­ment be­soin — l'angle CNV"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <ITEXT CH="Quand on souffre dans cette scène, le ré­flexe na­tu­rel est de pen­ser que le pro­blème vient de l'autre. Qu'il ne fait pas as­sez. Qu'il ne com­prend pas. Qu'il fau­drait qu'il change."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ce ré­flexe est hu­main. Et il a un coût : tant qu'on at­tend que l'autre change pour al­ler mieux, on lui donne tout le pou­voir sur notre état. On se met en dé­pen­dance."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="La CNV pro­pose quelque chose de dif­fé­rent — et de plus exi­geant. Elle part du prin­cipe que mes be­soins m'ap­par­tiennent. Qu'ils ne sont pas la consé­quence de ce que l'autre fait ou ne fait pas. Et que je suis res­pon­sable de trou­ver com­ment les rem­plir."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ce n'est pas &quot;j'ai be­soin que tu fasses ta part&quot; — c'est une exi­gence dé­gui­sée en be­soin. C'est &quot;j'ai be­soin d'ef­fi­ca­ci­té — et voi­là com­ment je choi­sis de le rem­plir.&quot;"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="La dif­fé­rence est énorme. Dans le pre­mier cas, je suis en at­tente. Dans le se­cond, je suis en mou­ve­ment."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Un exemple concret. Ima­gi­nons que tu prennes en charge la cui­sine et la vais­selle la plu­part du temps. Tu pour­rais te dire — et ce se­rait lé­gi­time — &quot;c'est in­juste, il ne fait pas sa part.&quot; Ou tu pour­rais te dire : &quot;je choi­sis de faire ça parce que quand c'est fait ra­pi­de­ment et bien, ça me li­bère du temps et de l'éner­gie pour ce qui compte vrai­ment — un mo­ment de connexion avec l'autre, une soi­rée sans charge men­tale.&quot; Ce n'est plus une cor­vée su­bie. C'est un choix au ser­vice d'un be­soin que tu as iden­ti­fié."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ce dé­pla­ce­ment — de la plainte vers le choix — change quelque chose de pro­fond dans la fa­çon dont on vit la si­tua­tion."/>
                <trail PARENT="BODY" ALIGN="3"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="560.630551181102" YPOS="6413.28498919936" OwnPage="20" ItemID="468789472" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5290836875473" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="537279552" BACKITEM="-1">
            <StoryText>
                <DefaultStyle FONT="Algerian Regular" LANGUAGE="ee"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Exer­cice — iden­ti­fier son be­soin pro­fond"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Lis la liste sui­vante. Pour chaque be­soin, la ques­tion n'est pas &quot;est-ce que l'autre m'em­pêche de l'avoir ?&quot; mais &quot;est-ce que ce be­soin est vi­vant en moi — et com­ment est-ce que je choi­sis de le rem­plir ?&quot;"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Coche les deux ou trois qui ré­sonnent vrai­ment."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Une fois tes be­soins iden­ti­fiés, com­plète cette phrase pour cha­cun :"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="&quot;J'ai be­soin de __. Quand je me re­con­necte à ce be­soin, ce que je choi­sis de faire c'est __.&quot;"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Quelques exemples pour t'ai­der à dé­mar­rer :"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="&quot;J'ai be­soin d'ef­fi­ca­ci­té. Quand je me re­con­necte à ce be­soin, ce que je choi­sis de faire c'est prendre en charge les tâches que je fais vite et bien — et lâ­cher celles qui ne sont pas prio­ri­taires pour moi.&quot;"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <ITEXT CH="&quot;J'ai be­soin d'in­ti­mi­té. Quand je me re­con­necte à ce be­soin, ce que je choi­sis de faire c'est fi­nir ra­pi­de­ment ce qui doit être fait ce soir — pour avoir du temps et de l'éner­gie pour être vrai­ment pré­sent avec l'autre.&quot;"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <ITEXT CH="&quot;J'ai be­soin d'es­pace men­tal. Quand je me re­con­necte à ce be­soin, ce que je choi­sis de faire c'est no­ter les tâches quelque part pour ne plus les por­ter dans ma tête.&quot;"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ce qu'on ob­serve sou­vent en fai­sant cet exer­cice : la frus­tra­tion en­vers l'autre di­mi­nue. Pas parce qu'on a ré­so­lu le pro­blème de ré­par­ti­tion — mais parce qu'on a re­pris la main sur quelque chose. On n'est plus en at­tente. On est en mou­ve­ment."/>
                <trail PARENT="BODY" ALIGN="3"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="564.089125496481" YPOS="6545.97636959097" OwnPage="20" ItemID="468795136" PTYPE="2" WIDTH="286.530973451328" HEIGHT="322.840638283047" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="0.54" LOCALSCY="0.54" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" Pagenumber="0" PFILE="../../../../../../Users/Pascal/Downloads/besoin1.png" PRFILE="Embedded sRGB built-in" IRENDER="0" EPROF="Embedded sRGB built-in" path="M0 0 L286.531 0 L286.531 322.841 L0 322.841 L0 0 Z" copath="M0 0 L286.531 0 L286.531 322.841 L0 322.841 L0 0 Z" gXpos="564.089125496481" gYpos="6545.97636959097" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1"/>
        <PAGEOBJECT XPOS="141.102992125985" YPOS="10860.2119183332" OwnPage="33" ItemID="468797968" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5268789631399" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="537271056" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Avant l'ana­lyse — une chose im­por­tante"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Si tu te re­con­nais dans cette scène, c'est pro­ba­ble­ment parce que tu l'as vé­cue. Pas exac­te­ment comme ça — les mots changent, l'heure change. Mais cette soi­rée-là, ce si­lence-là, ce dî­ner où per­sonne ne se re­garde vrai­ment — tu sais ce que c'est."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Et si tu es ce­lui qui at­tend, tu sais aus­si ce que c'est de pas­ser la soi­rée à gé­rer, or­ga­ni­ser, te­nir — et de voir l'autre ren­trer sans sem­bler me­su­rer ce que ça re­pré­sente. La frus­tra­tion qui monte. Le re­proche qui sort — pas tou­jours sous la forme qu'on au­rait vou­lu."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ce que tu res­sens est réel. Ce n'est pas de la mau­vaise hu­meur. Ce n'est pas ir­ra­tion­nel."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Mais ce book­let va te pro­po­ser quelque chose d'un peu in­con­for­table : re­gar­der aus­si ce qui se passe de ton cô­té. Pas pour mi­ni­mi­ser ce que tu vis. Pas pour dire que tu as tort. Mais parce que c'est le seul en­droit de­puis le­quel tu peux vrai­ment chan­ger quelque chose."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="On ne peut pas chan­ger l'autre. On peut chan­ger ce qu'on fait — et ob­ser­ver com­ment la soi­rée se re­con­fi­gure."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ce qui se passe vrai­ment"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <ITEXT CH="La scène que tu viens de lire n'est pas une dis­pute sur les ho­raires de tra­vail. Ce qui se joue ici n'a presque rien à voir avec la réunion qui s'est éter­ni­sée."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Pen­dant qu'elle at­ten­dait, quelque chose s'est construit. Elle a gé­ré la soi­rée, les en­fants peut-être, le dî­ner, la charge men­tale or­di­naire d'un soir de se­maine. Et en pa­ral­lèle, sans qu'elle l'ait vrai­ment choi­si, une ac­cu­mu­la­tion s'est faite. Pas des pen­sées claires — plu­tôt quelque chose de dif­fus. L'in­cer­ti­tude sur l'heure de re­tour. Le sen­ti­ment de por­ter seule. Et quelque chose de plus pro­fond qui cherche une forme."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Quand la porte s'ouvre, ce quelque chose cherche une sor­tie. Et il sort par le che­min qu'il connaît."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="&quot;Tu t'en fous, c'est tout.&quot;"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ce n'est pas vrai­ment ce qu'elle vou­lait dire. For­mu­lé clai­re­ment, ça res­sem­ble­rait plu­tôt à : "/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="&quot;j'avais be­soin de toi ce soir, et en­core une fois je ne sa­vais pas à quelle heure tu ren­trais.&quot; "/>
                <para PARENT="narration" ALIGN="3"/>
                <ITEXT CH="Mais cette phrase-là est trop vul­né­rable. Alors elle ar­rive ha­billée en re­proche."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Et le re­proche ap­pelle la dé­fense. Et la dé­fense confirme ce qu'elle crai­gnait."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="De son cô­té, lui rentre épui­sé. Il n'a pas choi­si de ren­trer tard. Il a eu une mau­vaise jour­née. Et la pre­mière chose qu'il trouve en ren­trant, c'est une ac­cu­sa­tion. Lui aus­si a be­soin de quelque chose ce soir — d'être ac­cueilli, d'être vu, de souf­fler. Mais ces be­soins-là ne se­ront pas dits non plus."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Les deux ont rai­son sur ce qu'ils vivent. Au­cun des deux ne dit ce qu'il vit vrai­ment."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Le jeu qui se joue — sans que per­sonne ne l'ait dé­ci­dé"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Il y a trois rôles dans ce jeu. La "/>
                <ITEXT FONT="Times New Roman Bold" LANGUAGE="fr" CH="Vic­time"/>
                <ITEXT CH=" — ce­lui qui su­bit, qui at­tend, qui porte. Le "/>
                <ITEXT FONT="Times New Roman Bold" CH="Per­sé­cu­teur"/>
                <ITEXT CH=" — ce­lui qui ac­cuse, qui re­proche. Et le "/>
                <ITEXT FONT="Times New Roman Bold" CH="Sau­veur"/>
                <ITEXT CH=" — ce­lui qui ré­pare, qui lisse, qui fait comme si."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ce qui est par­ti­cu­liè­re­ment pié­geux dans cette scène, c'est que le jeu com­mence avant même que la porte s'ouvre."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Pen­dant l'at­tente, elle glisse pro­gres­si­ve­ment vers la "/>
                <ITEXT FONT="Times New Roman Bold" CH="Vic­time"/>
                <ITEXT CH=" — seule, in­cer­taine, por­tant ce qui au­rait pu être par­ta­gé. Ce glis­se­ment n'est pas conscient. C'est la si­tua­tion qui l'y amène."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Quand il rentre, elle bas­cule en "/>
                <ITEXT FONT="Times New Roman Bold" CH="Per­sé­cu­teur"/>
                <ITEXT CH=" — le re­proche sort, l'ac­cu­sa­tion ar­rive. Lui entre en "/>
                <ITEXT FONT="Times New Roman Bold" CH="Vic­time"/>
                <ITEXT CH=" — il su­bit, il se jus­ti­fie, il n'a pas choi­si de ren­trer tard."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Puis le coup de théâtre. &quot;Tu veux qu'on se dis­pute ?&quot; — il bas­cule en "/>
                <ITEXT FONT="Times New Roman Bold" CH="Per­sé­cu­teur"/>
                <ITEXT CH=", et elle de­vient "/>
                <ITEXT FONT="Times New Roman Bold" CH="Vic­time"/>
                <ITEXT CH=" du conflit qu'elle a elle-même dé­clen­ché. Le dî­ner si­len­cieux est la conclu­sion lo­gique : les deux ont per­du, les deux ont confir­mé ce qu'ils crai­gnaient."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ce qui est ré­vé­la­teur : elle était en "/>
                <ITEXT FONT="Times New Roman Bold" CH="Vic­time"/>
                <ITEXT CH=" avant qu'il dise un mot. La ru­mi­na­tion pen­dant l'at­tente, c'était dé­jà le dé­but du jeu. Avant qu'il rentre. Avant qu'il parle."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT FONT="Times New Roman Bold" CH="Vic­time"/>
                <ITEXT CH=" qui at­tend → "/>
                <ITEXT FONT="Times New Roman Bold" CH="Per­sé­cu­teur"/>
                <ITEXT CH=" à l'ar­ri­vée → "/>
                <ITEXT FONT="Times New Roman Bold" CH="Vic­time"/>
                <ITEXT CH=" dé­fen­sive → "/>
                <ITEXT FONT="Times New Roman Bold" CH="Per­sé­cu­teur"/>
                <ITEXT CH=" qui re­ferme → si­lence → les deux confirment ce qu'ils crai­gnaient"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ce que cha­cun y trouve — la par­tie dif­fi­cile"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ce sys­tème dure parce qu'il confirme quelque chose pour cha­cun."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Pour elle : &quot;"/>
                <ITEXT FONT="Times New Roman Italic" CH="il met son tra­vail avant nous."/>
                <ITEXT CH="&quot; Chaque re­tour tar­dif, chaque jus­ti­fi­ca­tion, chaque si­lence du dî­ner vient ali­men­ter cette convic­tion. Et cette convic­tion jus­ti­fie le re­proche sui­vant."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Pour lui : &quot;"/>
                <ITEXT FONT="Times New Roman Italic" CH="quoi que je fasse, ce n'est ja­mais as­sez"/>
                <ITEXT CH=".&quot; Chaque re­proche, même quand il est épui­sé et de bonne foi, confirme que ren­trer à la mai­son est un ter­rain mi­né. Et cette convic­tion jus­ti­fie le re­trait — qui ali­men­te­ra le pro­chain re­proche."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Les deux évitent la même chose — une conver­sa­tion vraie sur ce dont cha­cun a be­soin. Et cet évi­te­ment creuse dou­ce­ment la dis­tance que per­sonne ne veut."/>
                <trail PARENT="BODY" ALIGN="3"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="141.102992125985" YPOS="10224.9366427427" OwnPage="31" ItemID="468786640" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.527193923769" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <trail/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="560.630551181103" YPOS="10224.9366427427" OwnPage="32" ItemID="468803632" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.527193923769" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="La scène"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="En­trée de l'ap­par­te­ment, 20h30. Il rentre, vi­si­ble­ment fa­ti­gué. Elle est dans la cui­sine, dos tour­né."/>
                <para PARENT="narration" ALIGN="3"/>
                <ITEXT CH="Lui : &quot;Bon­soir. Dé­so­lé, réunion qui s'est éter­ni­sée.&quot;"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Si­lence. Elle conti­nue ce qu'elle fai­sait."/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Elle : &quot;Tu t'en fous, c'est tout.&quot;"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Lui : &quot;Quoi ? J'ai eu une jour­née de merde.&quot;"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Elle : &quot;Moi aus­si.&quot;"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Il pose ses af­faires, souffle."/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Lui : &quot;Tu veux qu'on se dis­pute, c'est ça ?&quot;"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Elle ne ré­pond pas. Le dî­ner se passe sans qu'on se re­garde vrai­ment."/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Tu te re­con­nais ?"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Cette scène, je la vis : ja­mais · par­fois · sou­vent"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Dans cette scène, tu res­sembles plu­tôt à : ce­lui qui rentre · ce­lui qui at­tend · les deux se­lon les mo­ments"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="560.630551181103" YPOS="9589.66136715211" OwnPage="30" ItemID="468806464" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5275088843981" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <ITEXT CH="Scène 2 — Le retour tardif"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <ITEXT CH="&quot;Dis-moi que je compte&quot;"/>
                <trail PARENT="Titre" ALIGN="1"/>
            </StoryText>
            <PageItemAttributes>
                <ItemAttribute Name="tdm" Type="string" Value="Scène 2 — Le retour tardif" Parameter="" Relationship="none" RelationshipTo="" AutoAddTo="none"/>
            </PageItemAttributes>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="141.102992125985" YPOS="9589.66136715211" OwnPage="29" ItemID="468809296" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5275088843981" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <trail/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="141.102992125985" YPOS="8954.38609156156" OwnPage="27" ItemID="468812128" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5278238450272" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="468800800" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Une ques­tion par soir — pas toutes à la fois, juste celle du jour :"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Lun­di : Au­jour­d'hui, dans cette scène, j'étais plu­tôt en train de sau­ver, d'ac­cu­ser, ou de su­bir ?"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Mar­di : Qu'est-ce que j'ai évi­té de res­sen­tir en re­pre­nant — ou en cé­dant ?"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Mer­cre­di : Quel be­soin était ac­ti­vé au­jour­d'hui — et com­ment est-ce que j'ai choi­si de le rem­plir ?"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Jeu­di : Qu'est-ce qui se se­rait pas­sé si j'avais fait au­tre­ment que d'ha­bi­tude — juste une fois ?"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ven­dre­di : Com­ment j'ai nour­ri mon En­fant Libre au­jour­d'hui — et qu'est-ce que ça a chan­gé, même lé­gè­re­ment ?"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Sa­me­di : Qu'est-ce que je confirme sur l'autre en ré­pé­tant ce sys­tème — et est-ce que c'est vrai­ment vrai ?"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Di­manche : Qu'est-ce que je veux gar­der de cette se­maine — et qu'est-ce que je veux re­gar­der dif­fé­rem­ment la se­maine pro­chaine ?"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Si vous vou­lez ex­plo­rer ça à deux"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <ITEXT CH="À faire au calme — pas après une dis­pute, pas en fin de soi­rée épui­sés. Un mo­ment où vous êtes tous les deux dis­po­nibles. Vingt mi­nutes."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Temps 1 — Ce que cha­cun vit vrai­ment (10 mi­nutes)"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Cha­cun prend une feuille et com­plète ces phrases seul, sans mon­trer à l'autre :"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="&quot;Dans notre fa­çon de gé­rer le foyer, ce qui m'épuise vrai­ment c'est...&quot;"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <ITEXT CH="&quot;Le be­soin que j'es­saie de rem­plir quand je gère les tâches comme je le fais, c'est...&quot;"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <ITEXT CH="&quot;Ce que je trouve dif­fi­cile à dire sur ce su­jet, c'est...&quot;"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Puis on par­tage. Cha­cun lit ce qu'il a écrit. L'autre écoute — sans in­ter­rompre, sans se dé­fendre, sans ex­pli­quer. Juste en­tendre."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ce n'est pas un dé­bat. C'est deux per­sonnes qui se montrent quelque chose de vrai."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Temps 2 — Un ac­cord qui res­pecte les deux (10 mi­nutes)"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Une seule ques­tion à ex­plo­rer en­semble :"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="&quot;Com­ment est-ce qu'on s'or­ga­nise d'une fa­çon qui nour­rit ce qui est im­por­tant pour cha­cun — et qui nous laisse tous les deux de l'éner­gie pour autre chose que les tâches ?&quot;"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Pas une liste de cor­vées. Un ac­cord vi­vant — qu'on peut ajus­ter, ré­vi­ser, tes­ter. Avec une règle : ce qui est dé­lé­gué ap­par­tient à ce­lui qui le fait. Sa fa­çon. Pas celle de l'autre."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="La scène sui­vante se passe à l'en­trée de l'ap­par­te­ment. Il est 20h30."/>
                <para PARENT="scene_page_subtitle" ALIGN="1"/>
                <ITEXT CH="Elle n'a rien dit en­core et pour­tant quelque chose a dé­jà com­men­cé."/>
                <trail PARENT="scene_page_subtitle" ALIGN="1"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="560.630551181103" YPOS="8954.38609156156" OwnPage="28" ItemID="468800800" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5278238450272" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="468812128"/>
        <PAGEOBJECT XPOS="141.102992125985" YPOS="8319.11081597101" OwnPage="25" ItemID="468826288" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5281388056563" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Nour­rir ton En­fant Libre — une pra­tique à part en­tière"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Il y a quelque chose que ce book­let va te ré­pé­ter dans chaque scène — parce que c'est une des clés les plus simples et les moins uti­li­sées."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Quand on est épui­sé, quand on porte trop, quand on contrôle parce qu'on a l'im­pres­sion que si on lâche tout s'ef­fondre — c'est sou­vent le signe qu'on a ou­blié de se nour­rir soi-même."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="En psy­cho­lo­gie, on parle de l'En­fant Libre — cette par­tie de toi qui joue, qui crée, qui res­sent, qui s'amuse sans ar­rière-pen­sée. Celle qui exis­tait avant que tu ap­prennes à être utile, res­pon­sable, rai­son­nable. Elle n'a pas dis­pa­ru. Elle at­tend juste d'avoir un peu de place."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Et voi­là ce qui est in­té­res­sant : quand l'En­fant Libre est nour­ri, le be­soin de contrô­ler di­mi­nue na­tu­rel­le­ment. Pas parce qu'on a dé­ci­dé de lâ­cher — mais parce qu'on a moins be­soin de te­nir. On est moins ten­du, moins à sur­veiller, moins à re­prendre. On a plus d'éner­gie pour être vrai­ment pré­sent — pour soi et pour l'autre."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Quelques exemples de ce qui nour­rit l'En­fant Libre :"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Faire quelque chose de créa­tif sans ob­jec­tif — des­si­ner, cui­si­ner pour le plai­sir, jar­di­ner, bri­co­ler. Bou­ger pour le plai­sir — dan­ser, mar­cher sans des­ti­na­tion, na­ger. Ap­prendre quelque chose juste parce que c'est in­té­res­sant — pas utile, pas pro­duc­tif, juste cu­rieux. Jouer — un jeu, un ins­tru­ment, un sport, n'im­porte quoi qui n'a pas de but autre que le plai­sir de jouer. Se re­po­ser vrai­ment — pas ré­cu­pé­rer pour mieux pro­duire après. Se re­po­ser parce que tu en as en­vie. Faire quelque chose de spon­ta­né — sans pla­ni­fier, sans op­ti­mi­ser, juste parce que l'en­vie est là."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Tra­cker En­fant Libre — 7 jours"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Chaque soir, une mi­nute. Pas un bi­lan — juste no­ter."/>
                <trail PARENT="BODY" ALIGN="3"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="560.630551181103" YPOS="8319.11081597101" OwnPage="26" ItemID="468817792" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5281388056563" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <para ALIGN="3"/>
                <para ALIGN="3"/>
                <para ALIGN="3"/>
                <para ALIGN="3"/>
                <para ALIGN="3"/>
                <para ALIGN="3"/>
                <para ALIGN="3"/>
                <para ALIGN="3"/>
                <para ALIGN="3"/>
                <para ALIGN="3"/>
                <para ALIGN="3"/>
                <para ALIGN="3"/>
                <para ALIGN="3"/>
                <para ALIGN="3"/>
                <para ALIGN="3"/>
                <ITEXT CH="La ques­tion de fin de se­maine :"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Les jours où j'ai nour­ri mon En­fant Libre — est-ce que j'avais plus ou moins en­vie de contrô­ler, de re­prendre, de por­ter ? Est-ce qu'il y a un lien ?"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Sui­vi quo­ti­dien — 7 jours"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Chaque soir, deux mi­nutes."/>
                <para PARENT="BODY" ALIGN="3"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="560.630551181103" YPOS="7683.83554038046" OwnPage="24" ItemID="468820624" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5284537662872" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="468823456"/>
        <PAGEOBJECT XPOS="141.102992125985" YPOS="7683.83554038046" OwnPage="23" ItemID="468823456" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5284537662872" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="468820624" BACKITEM="468814960"/>
        <PAGEOBJECT XPOS="560.630551181103" YPOS="7048.56026478991" OwnPage="22" ItemID="468814960" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5287687269172" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="468823456" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Les portes de sor­tie"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Porte 1 — Re­pé­rer son rôle dans le mo­ment"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="La pro­chaine fois que cette scène se dé­clenche, une seule ques­tion in­té­rieure — ra­pide, sans ana­lyse :"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="En ce mo­ment, je suis plu­tôt en train de sau­ver, d'ac­cu­ser, ou de su­bir ?"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Pas be­soin de ré­ponse éla­bo­rée. Juste nom­mer. Cette re­con­nais­sance crée un es­pace — même mi­nus­cule — entre ce qui se passe et ce qu'on fait."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Si tu es en train de sau­ver — re­prendre avant que l'autre ait fi­ni, re­faire ce qui a été fait — une pause. Une seule ques­tion : est-ce que c'est vrai­ment né­ces­saire, ou est-ce que ce n'est juste pas comme je l'au­rais fait ? Si c'est la deuxième rai­son : lais­ser. Cette fois."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Si tu es en train de su­bir — ne pas es­sayer, at­tendre que l'autre re­prenne — une pause aus­si. Est-ce que je ne sais vrai­ment pas — ou est-ce que j'ai ap­pris qu'es­sayer ne ser­vait à rien ? Si c'est la deuxième rai­son : une ten­ta­tive. Im­par­faite. Mais une ten­ta­tive."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Porte 2 — L'ex­pé­rience du lâ­cher (exer­cice so­lo)"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Cet exer­cice est pour ce­lui qui re­prend. Il de­mande un peu de cou­rage."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Cette se­maine, choi­sis une tâche — une seule — que tu dé­lègues vrai­ment. Pas en ex­pli­quant com­ment faire. Pas en vé­ri­fiant après. Juste : &quot;est-ce que tu peux t'oc­cu­per de ça cette se­maine ?&quot; Et lais­ser."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Peu im­porte si c'est fait dif­fé­rem­ment. Peu im­porte si ce n'est pas exac­te­ment comme tu l'au­rais fait."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Et note trois choses :"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="&quot;Ce qui a été fait, c'est...&quot; — nomme ce qui a été ac­com­pli. Vrai­ment ac­com­pli. Pas ce qui manque."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="&quot;Ce que ça m'a li­bé­ré, c'est...&quot; — qu'est-ce que tu as pu faire, ou ne pas faire, pen­dant ce temps ? Du re­pos ? Un mo­ment pour toi ? Juste souf­fler ?"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="&quot;Ce que j'ai eu en­vie de cor­ri­ger mais que j'ai lais­sé, c'est...&quot; — note la ré­sis­tance. Sans agir des­sus. Juste l'ob­ser­ver."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="L'ob­jec­tif n'est pas d'ac­cep­ter le désordre pour tou­jours. C'est de voir, une fois, ce que le contrôle coûte — et ce que le lâ­cher donne."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Porte 3 — Se re­con­nec­ter à son be­soin (so­lo)"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="La pro­chaine fois que la frus­tra­tion monte dans cette scène, avant de dire quoi que ce soit — une pause in­té­rieure."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Re­prends ta liste de be­soins iden­ti­fiés plus haut. Et com­plète men­ta­le­ment :"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="&quot;En ce mo­ment, le be­soin qui est ac­ti­vé en moi c'est __. Et ce que je choi­sis de faire pour le rem­plir, c'est __.&quot;"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ce dé­pla­ce­ment — même fait si­len­cieu­se­ment, même en trente se­condes — change quelque chose. On sort de la ré­ac­tion pour en­trer dans le choix."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Porte 4 — Pas­ser du re­proche au be­soin (duo)"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Si tu veux en par­ler à l'autre — et seule­ment si le mo­ment est calme, pas en sor­tie de ten­sion — une fa­çon dif­fé­rente d'ou­vrir la conver­sa­tion."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Au lieu de : &quot;tu ne fais ja­mais rien, c'est tou­jours moi qui fais tout.&quot;"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Es­sayer : &quot;j'ai réa­li­sé quelque chose. Ce qui m'épuise le plus, ce n'est pas les tâches elles-mêmes — c'est de les avoir toutes en tête en per­ma­nence. Est-ce qu'on peut cher­cher en­semble com­ment al­lé­ger ça ?&quot;"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ce n'est pas la même conver­sa­tion. La pre­mière est une ac­cu­sa­tion — elle ap­pelle une dé­fense. La deuxième est une in­vi­ta­tion — elle peut ap­pe­ler une ré­ponse."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Porte 5 — Construire quelque chose en­semble (duo)"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Une conver­sa­tion à avoir au calme, un soir où vous n'êtes pas épui­sés. Vingt mi­nutes."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Pas pour dé­ci­der qui fait quoi sur un ta­bleau. Pour com­prendre ce qui compte vrai­ment pour cha­cun — et construire quelque chose à par­tir de là."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Quelques ques­tions pour dé­mar­rer :"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="&quot;Dans notre foyer, qu'est-ce qui est vrai­ment im­por­tant pour toi — et qu'est-ce qui l'est moins ?&quot;"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="&quot;Qu'est-ce que tu pré­fères faire — et qu'est-ce que tu trouves vrai­ment pé­nible ?&quot;"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="&quot;Com­ment est-ce qu'on peut s'or­ga­ni­ser d'une fa­çon qui res­pecte ce qui compte pour cha­cun ?&quot;"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Et une règle im­pli­cite à po­ser en­semble, si pos­sible : ce qui est dé­lé­gué ap­par­tient à ce­lui qui le fait. Sa fa­çon. Pas la tienne. Le ré­sul­tat compte — pas le che­min pour y ar­ri­ver."/>
                <trail PARENT="BODY" ALIGN="3"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="568.354612222145" YPOS="8327.5860441781" OwnPage="26" ItemID="468829120" PTYPE="2" WIDTH="306.477876106195" HEIGHT="203.893805309734" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="0.54" LOCALSCY="0.54" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" Pagenumber="0" PFILE="../../../../../../Users/Pascal/Downloads/trackerchap1.png" PRFILE="Embedded sRGB built-in" IRENDER="0" EPROF="Embedded sRGB built-in" path="M0 0 L306.478 0 L306.478 203.894 L0 203.894 L0 0 Z" copath="M0 0 L306.478 0 L306.478 203.894 L0 203.894 L0 0 Z" gXpos="568.354612222145" gYpos="8327.5860441781" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1"/>
