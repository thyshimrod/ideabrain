        <PAGEOBJECT XPOS="577.257267089401" YPOS="2348.66521636123" OwnPage="6" ItemID="444982352" PTYPE="5" WIDTH="295.263379417221" HEIGHT="1" FRTYPE="0" CLIPEDIT="0" ROT="359.914137254786" PWIDTH="0.283464566929134" PCOLOR="bordeaux" SHADE="0" PCOLOR2="bordeaux" PLINEART="1" path="" gXpos="577.257267089402" gYpos="13148.3502557313" gWidth="0" gHeight="0" LAYER="0"/>
