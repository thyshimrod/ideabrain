        <PAGEOBJECT XPOS="560.630551181103" YPOS="1966.3580600655" OwnPage="6" ItemID="537225744" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5312884119576" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="537242736" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Ce que vous al­lez trou­ver ici — et ce que vous n'y trou­ve­rez pas"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Il y a une chose que la plu­part des livres sur le couple ne disent pas fran­che­ment."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Quand on souffre dans une re­la­tion, on ar­rive ra­re­ment avec un re­gard neutre sur ce qui se passe. On ar­rive avec sa propre dou­leur, sa propre fa­tigue, sa propre ver­sion de l'his­toire. Et cette ver­sion — même quand elle est sin­cère, même quand elle est lé­gi­time — est un prisme. Elle éclaire cer­taines choses, et elle en laisse d'autres dans l'ombre."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ce book­let part de là."/>
                <para PARENT="BODY" ALIGN="3" DIRECTION="0"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ce qu'il est"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Un ou­til de prise de conscience. Pas une thé­ra­pie. Pas un diag­nos­tic. Pas une fa­çon de prou­ver que tu as rai­son — ou que l'autre a tort."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Il pro­pose six scènes de la vie or­di­naire d'un couple. Des scènes que tout le monde re­con­naît, pré­ci­sé­ment parce qu'elles sont ba­nales. Et pour chaque scène, une in­vi­ta­tion à re­gar­der ce qui se passe vrai­ment — dans la dy­na­mique, dans les rôles, dans ce que cha­cun y trouve sans se l'avouer."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Le cadre théo­rique uti­li­sé est ce­lui de l'Ana­lyse Tran­sac­tion­nelle — les états du moi, les jeux psy­cho­lo­giques, le tri­angle de Karp­man. Tu n'as pas be­soin de connaître ces concepts pour uti­li­ser ce book­let. Ils sont ex­pli­qués au fil des scènes, dans le contexte où ils ap­pa­raissent."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ce qu'il n'est pas"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ce book­let n'est pas une thé­ra­pie de couple. Il ne rem­place pas un ac­com­pa­gne­ment in­di­vi­duel ou conjoint avec un pro­fes­sion­nel. Si ce que vous tra­ver­sez est pro­fond, dou­lou­reux, ou ins­tal­lé de­puis long­temps — ce que vous trou­ve­rez ici peut être un point de dé­part. Pas une so­lu­tion com­plète."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ce n'est pas non plus un ou­til pour convaincre l'autre. Si tu l'uti­lises pour lui mon­trer &quot;ce qu'il fait&quot;, tu se­ras pas­sé à cô­té de l'es­sen­tiel. Ce book­let est d'abord un mi­roir — et les mi­roirs re­gardent dans les deux sens."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="La chose la plus im­por­tante à com­prendre avant de com­men­cer"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ima­gine la scène sui­vante."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Elle lui re­proche de ne ja­mais par­ler de ce qu'il res­sent. Il se ferme un peu plus à chaque re­proche. Elle re­proche da­van­tage, parce qu'il se ferme. Il se ferme da­van­tage, parce qu'elle re­proche."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Qui a com­men­cé ? La ques­tion n'a pas de ré­ponse — parce qu'elle n'est pas la bonne ques­tion. Ce qui se passe ici n'est pas une faute. C'est une boucle. Et dans une boucle, il n'y a pas de cou­pable — il y a deux per­sonnes qui ali­mentent le même sys­tème, cha­cune à sa fa­çon, sans le voir."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="C'est ça, un jeu psy­cho­lo­gique. Les deux jouent. Tou­jours."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ce n'est pas in­tui­tif — sur­tout quand on souffre. Quand on est épui­sé, quand on porte ce qui de­vrait être par­ta­gé, quand on a l'im­pres­sion de faire des ef­forts que l'autre ne fait pas — le re­gard na­tu­rel est asy­mé­trique. On voit ce que l'autre fait. On voit beau­coup moins clai­re­ment ce qu'on fait soi-même pour que ça conti­nue."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ce n'est pas de la mau­vaise foi. C'est mé­ca­nique. La dou­leur, la charge men­tale, le désar­roi orientent l'at­ten­tion vers ce qui fait mal — pas vers ce à quoi on contri­bue."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ce book­let ne te de­mande pas de mi­ni­mi­ser ce que tu vis. Il te de­mande quelque chose de plus utile : com­prendre en quoi tu par­ti­cipes à ce qui se ré­pète. Pas pour t'ac­ca­bler. Parce que c'est le seul en­droit de­puis le­quel tu peux vrai­ment agir."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Com­ment uti­li­ser ce book­let"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT FONT="Times New Roman Bold" CH="En so­lo."/>
                <ITEXT CH=" C'est la fa­çon la plus na­tu­relle de com­men­cer. Tu lis les scènes, tu notes ce que tu re­con­nais, tu fais le sui­vi quo­ti­dien. Sans que l'autre le sache, sans en par­ler. Le tra­vail se fait en toi d'abord — et il pro­duit des ef­fets dans la re­la­tion, sou­vent sans qu'on ait be­soin de l'ex­pli­quer."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT FONT="Times New Roman Bold" CH="En duo."/>
                <ITEXT CH=" Si votre par­te­naire est ou­vert à ex­plo­rer ce­la avec toi, chaque scène pro­pose une ver­sion à deux — une conver­sa­tion courte, struc­tu­rée, hors des mo­ments de ten­sion. Ce n'est pas une thé­ra­pie de couple im­pro­vi­sée. C'est une fa­çon de re­gar­der en­semble ce qu'on re­garde ha­bi­tuel­le­ment sé­pa­ré­ment."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT FONT="Times New Roman Bold" CH="Avec un ac­com­pa­gnant."/>
                <ITEXT CH=" Si tu tra­vailles dé­jà avec un coach ou un thé­ra­peute, ce book­let peut ser­vir de sup­port entre les séances — pour ob­ser­ver, no­ter, ap­por­ter du concret à ce que vous ex­plo­rez en­semble."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Une der­nière chose."/>
                <para PARENT="book_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Les scènes que tu vas lire sont vo­lon­tai­re­ment or­di­naires. Rien de dra­ma­tique. Rien d'ex­cep­tion­nel. Ce sont les mo­ments que per­sonne ne re­marque — pré­ci­sé­ment parce qu'ils se ré­pètent."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="C'est là que les jeux vivent. Et c'est là qu'on peut com­men­cer à les voir."/>
                <trail PARENT="BODY" ALIGN="3"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="141.102992125984" YPOS="2601.63333565605" OwnPage="7" ItemID="537242736" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5309734513279" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="537245568" BACKITEM="537225744"/>
        <PAGEOBJECT XPOS="560.630551181103" YPOS="2601.63333565605" OwnPage="8" ItemID="537245568" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5309734513279" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="537239904" BACKITEM="537242736"/>
        <PAGEOBJECT XPOS="141.102992125984" YPOS="3236.9086112466" OwnPage="9" ItemID="537239904" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5306584906978" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="537245568"/>
        <PAGEOBJECT XPOS="560.630551181103" YPOS="3236.9086112466" OwnPage="10" ItemID="537234240" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5306584906978" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
