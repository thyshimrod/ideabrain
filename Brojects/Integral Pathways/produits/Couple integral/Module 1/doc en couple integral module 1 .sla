        <PAGEOBJECT XPOS="566.725039370079" YPOS="34388.2283464566" OwnPage="108" ItemID="285186624" PTYPE="2" WIDTH="317.472440944882" HEIGHT="155.906347989709" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="0.36" LOCALSCY="0.36" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" Pagenumber="0" PFILE="../../../../../../Users/Pascal/Downloads/etatchap6.png" PRFILE="Embedded sRGB built-in" IRENDER="0" EPROF="Embedded sRGB built-in" path="M0 0 L317.472 0 L317.472 155.906 L0 155.906 L0 0 Z" copath="M0 0 L317.472 0 L317.472 155.906 L0 155.906 L0 0 Z" gXpos="566.725039370079" gYpos="34388.2283464566" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1"/>
        <PAGEOBJECT XPOS="580.257267089401" YPOS="34702.7042714793" OwnPage="108" ItemID="285180960" PTYPE="5" WIDTH="295.263379417221" HEIGHT="1" FRTYPE="0" CLIPEDIT="0" ROT="359.914137254786" PWIDTH="0.283464566929134" PCOLOR="bordeaux" SHADE="0" PCOLOR2="bordeaux" PLINEART="1" path="" gXpos="580.257267089402" gYpos="13103.3341927392" gWidth="0" gHeight="0" LAYER="0"/>
        <PAGEOBJECT XPOS="162.729708034284" YPOS="35236.9795470699" OwnPage="109" ItemID="285192288" PTYPE="5" WIDTH="295.263379417221" HEIGHT="1" FRTYPE="0" CLIPEDIT="0" ROT="359.914137254786" PWIDTH="0.283464566929134" PCOLOR="bordeaux" SHADE="0" PCOLOR2="bordeaux" PLINEART="1" path="" gXpos="582.257267089402" gYpos="13002.3338777786" gWidth="0" gHeight="0" LAYER="0"/>
        <PAGEOBJECT XPOS="572.257267089401" YPOS="35026.9795470699" OwnPage="110" ItemID="285195120" PTYPE="5" WIDTH="295.263379417221" HEIGHT="1" FRTYPE="0" CLIPEDIT="0" ROT="359.914137254786" PWIDTH="0.283464566929134" PCOLOR="bordeaux" SHADE="0" PCOLOR2="bordeaux" PLINEART="1" path="" gXpos="572.257267089402" gYpos="12792.3338777786" gWidth="0" gHeight="0" LAYER="0"/>
        <PAGEOBJECT XPOS="576.257267089401" YPOS="35269.9795470699" OwnPage="110" ItemID="285189456" PTYPE="5" WIDTH="295.263379417221" HEIGHT="1" FRTYPE="0" CLIPEDIT="0" ROT="359.914137254786" PWIDTH="0.283464566929134" PCOLOR="bordeaux" SHADE="0" PCOLOR2="bordeaux" PLINEART="1" path="" gXpos="576.257267089402" gYpos="13035.3338777786" gWidth="0" gHeight="0" LAYER="0"/>
        <PAGEOBJECT XPOS="141.102992125985" YPOS="35635.9476663647" OwnPage="111" ItemID="285183792" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5145954985627" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="285197952" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Ce dont on a vrai­ment be­soin — l'angle CNV"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <ITEXT CH="Dans cette scène, les deux cherchent fon­da­men­ta­le­ment la même chose. Ils la cherchent de­puis des états dif­fé­rents, avec des stra­té­gies dif­fé­rentes — et c'est pour ça qu'ils se ratent."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="La même règle s'ap­plique dans les deux cas : un be­soin m'ap­par­tient. Il ne dé­pend pas de ce que l'autre fait ou ne fait pas. Je suis res­pon­sable de trou­ver com­ment le nour­rir — pas d'at­tendre que l'autre le de­vine."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ce que les deux cherchent — au fond"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Lis cette liste. Coche ce qui ré­sonne vrai­ment — quel que soit ton rôle dans la scène."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Si tu es ce­lui ou celle qui s'ap­proche"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Sous le geste, il y a quelque chose que tu n'as pas dit. Et ne pas le dire place l'autre dans une po­si­tion im­pos­sible — ré­pondre à chaud, de­puis son épui­se­ment, à une de­mande qu'il n'a pas eu le temps d'ac­cueillir."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Lis cette liste. Coche ce qui ré­sonne vrai­ment."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Une fois ton be­soin iden­ti­fié, com­plète cette phrase :"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="&quot;J'ai be­soin de __. Quand je me re­con­necte à ce be­soin, ce que je choi­sis de faire c'est __.&quot;"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Quelques exemples :"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="&quot;J'ai be­soin d'ex­pres­sion. Ce que je choi­sis de faire c'est nom­mer ce que je cherche plus tôt dans la soi­rée — pas à 23h dans le noir, mais dans un mo­ment où on est en­core dis­po­nibles tous les deux.&quot;"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <ITEXT CH="&quot;J'ai be­soin de lé­gè­re­té. Ce que je choi­sis de faire c'est pro­po­ser quelque chose de doux sans at­tendre de ré­ponse pré­cise — un câ­lin, une proxi­mi­té, quelque chose qui ne de­mande rien mais qui dit je suis là.&quot;"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <ITEXT CH="&quot;J'ai be­soin de cou­rage. Ce que je choi­sis de faire c'est dire ce que je cherche vrai­ment — pas du sexe né­ces­sai­re­ment, mais de la cha­leur, de la connexion — et lais­ser à l'autre la li­ber­té de trou­ver com­ment me re­joindre de­puis où il est.&quot;"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <ITEXT CH="Si tu es ce­lui ou celle qui dit non"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ce que tu vis n'est pas du re­jet. C'est un état — épui­se­ment, tête pleine, corps fer­mé. Un état réel, lé­gi­time, qui mé­rite d'être nom­mé sans culpa­bi­li­té. Et de­puis cet état-là, il y a peut-être en­core quelque chose de pos­sible — pas ce qui était de­man­dé, mais quelque chose."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Lis cette liste. Coche ce qui ré­sonne vrai­ment."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Une fois ton be­soin iden­ti­fié, com­plète cette phrase :"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="&quot;J'ai be­soin de __. Quand je me re­con­necte à ce be­soin, ce que je choi­sis de faire c'est __.&quot;"/>
                <para PARENT="narration" ALIGN="3"/>
                <ITEXT CH="Quelques exemples :"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="&quot;J'ai be­soin de re­pos. Ce que je choi­sis de faire c'est me don­ner la per­mis­sion d'être fa­ti­guée — et de le dire clai­re­ment, sans m'ex­cu­ser, sans mi­ni­mi­ser.&quot;"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <ITEXT CH="&quot;J'ai be­soin d'in­té­gri­té. Ce que je choi­sis de faire c'est ne pas ac­cep­ter par obli­ga­tion — et ne pas re­fu­ser sans pro­po­ser autre chose. Trou­ver ce qui est vrai pour moi ce soir, et le dire.&quot;"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <ITEXT CH="&quot;J'ai be­soin de clar­té. Ce que je choi­sis de faire c'est me de­man­der, avant que la si­tua­tion ar­rive, ce dont j'ai be­soin ce soir — et le nom­mer plus tôt, quand il est en­core temps de se re­joindre au­tre­ment.&quot;"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ces deux listes parlent de la même as­pi­ra­tion — être in­time, être proche, être trai­té avec dé­li­ca­tesse. Elles ne se ren­contrent pas dans la scène parce que per­sonne n'a trou­vé les mots au bon mo­ment. Mais elles peuvent se ren­con­trer ailleurs — plus tôt dans la soi­rée, dans un es­pace où les deux sont en­core dis­po­nibles pour dé­cou­vrir en­semble ce qui est pos­sible. Pas for­cé­ment ce qui était at­ten­du. Peut-être quelque chose de plus doux, de plus simple — et par­fois, de plus in­time en­core."/>
                <trail PARENT="BODY" ALIGN="3"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="560.630551181103" YPOS="35635.9476663647" OwnPage="112" ItemID="285197952" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5145954985627" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="285209280" BACKITEM="285183792"/>
        <PAGEOBJECT XPOS="141.102992125985" YPOS="36271.2229419553" OwnPage="113" ItemID="285209280" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5142805379354" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="285197952"/>
        <PAGEOBJECT XPOS="560.630551181103" YPOS="36271.2229419553" OwnPage="114" ItemID="285212112" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5142805379354" gWidth="0" gHeight="0" PSTYLE="BODY" LAYER="0" NEXTITEM="285206448" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="BODY"/>
                <ITEXT CH="Nour­rir ton En­fant Libre"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Il y a une ques­tion que beau­coup de lec­teurs se posent en ar­ri­vant à cette scène : "/>
                <ITEXT FONT="Times New Roman Italic" CH="com­ment faire pour que mon dé­sir soit sa­tis­fait ?"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="C'est une ques­tion hon­nête. Mais elle cherche la ré­ponse au mau­vais en­droit."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Le dé­sir n'est pas une fin en soi. C'est une stra­té­gie — une fa­çon de cher­cher quelque chose de plus pro­fond : la connexion, la joie, la vi­ta­li­té, la cer­ti­tude d'exis­ter pour l'autre d'une fa­çon qui n'ap­par­tient qu'à vous deux. Et quand ces be­soins-là sont nour­ris ailleurs dans le quo­ti­dien — pas uni­que­ment dans le lit, pas uni­que­ment dans les mo­ments in­tenses — le dé­sir re­trouve na­tu­rel­le­ment sa place. Ou en tout cas, son ab­sence pèse moins."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ce qui nour­rit ces be­soins-là n'est pas spec­ta­cu­laire. C'est sou­vent très simple."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Un fou rire dans la cui­sine. Une blague idiote qui ne fait rire que vous deux. Une sur­prise in­utile — pas un ca­deau, juste quelque chose d'in­at­ten­du qui dit j'ai pen­sé à toi. Un mo­ment de lé­gè­re­té qui n'est pas utile, pas pro­duc­tif, pas or­ga­ni­sé au­tour des en­fants ou des tâches ou de la té­lé — juste vi­vant. Une es­piè­gle­rie. Un jeu. Quelque chose qui sort de la rou­tine et qui dit"/>
                <ITEXT FONT="Times New Roman Italic" CH=" on est en­core deux per­sonnes qui s'amusent en­semble, pas seule­ment deux adultes qui gèrent."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ces mo­ments-là nour­rissent "/>
                <ITEXT FONT="Times New Roman Bold" CH="l'En­fant Libre"/>
                <ITEXT CH=" des deux. Et quand l"/>
                <ITEXT FONT="Times New Roman Bold" CH="'En­fant Libre"/>
                <ITEXT CH=" est nour­ri — quand la jour­née a eu de la lé­gè­re­té, de la connexion, de la joie par­ta­gée — le corps et la tête ar­rivent dif­fé­rem­ment à 23h. Pas né­ces­sai­re­ment avec plus de dé­sir. Mais avec moins de dis­tance. Moins de fa­tigue de l'autre. Plus de dis­po­ni­bi­li­té pour se re­joindre — d'une fa­çon ou d'une autre."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="La ques­tion n'est donc pas "/>
                <ITEXT FONT="Times New Roman Italic" CH="com­ment sa­tis­faire mon dé­sir ce soir ? C'est qu'est-ce qu'on s'est ac­cor­dé au­jour­d'hui — en­semble — qui n'était pas utile, pas obli­ga­toire, juste pour le plai­sir d'être en­semble ?"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="La ques­tion à se po­ser ce soir :"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Qu'est-ce qu'on a par­ta­gé au­jour­d'hui qui nous a fait sou­rire — ou rire, ou nous sur­prendre — en de­hors des tâches et des obli­ga­tions ?"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Et une ques­tion sup­plé­men­taire, propre à cette scène :"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Si le dé­sir est une fa­çon de cher­cher la connexion — quels autres che­mins vers cette connexion est-ce que je n'ai pas en­core ex­plo­rés ?"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Les che­mins vers l'in­ti­mi­té — au-de­là de la sexua­li­té"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <ITEXT CH="L'in­ti­mi­té dans un couple ne com­mence pas au lit. Elle se construit — ou s'érode — dans les gestes qui pré­cèdent. La fa­çon dont on se re­garde en ren­trant. La ques­tion po­sée avec cu­rio­si­té réelle — pas &quot;ça s'est bien pas­sé ?&quot; de fa­çade, mais &quot;qu'est-ce qui t'a pe­sé au­jour­d'hui ?&quot; Le contact phy­sique qui n'ap­pelle rien — une main po­sée, une épaule tou­chée en pas­sant, un front em­bras­sé sans in­ten­tion."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ces gestes-là nour­rissent quelque chose que la sexua­li­té seule ne peut pas nour­rir — la cer­ti­tude d'être vu, vou­lu, te­nu. Et ils créent les condi­tions dans les­quelles le dé­sir peut exis­ter na­tu­rel­le­ment — pas comme une de­mande, pas comme une per­for­mance, mais comme une ex­pres­sion de ce qui est dé­jà là."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Quelques pistes concrètes — pas des re­cettes, des di­rec­tions :"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT FONT="Times New Roman Bold Italic" CH="Nom­mer ce qu'on cherche, pas ce qu'on veut"/>
                <ITEXT CH=". Au lieu de &quot;"/>
                <ITEXT FONT="Times New Roman Italic" CH="tu as en­vie ?&quot; — &quot;j'ai en­vie d'être proche de toi ce soir."/>
                <ITEXT CH="&quot; La nuance est pe­tite. Ce qu'elle ouvre est dif­fé­rent."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT FONT="Times New Roman Bold Italic" CH="Trou­ver d'autres che­mins vers la connexion"/>
                <ITEXT CH=". Si la sexua­li­té est sous ten­sion, il y a d'autres lan­gages de l'in­ti­mi­té — la conver­sa­tion dans le noir, le contact sans at­tente, le ri­tuel par­ta­gé qui dit on est en­core nous. Ces che­mins-là ne rem­placent pas le dé­sir. Ils le pré­cèdent, sou­vent."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT FONT="Times New Roman Bold Italic" CH="Par­ler du su­jet hors du lit"/>
                <ITEXT CH=". La conver­sa­tion sur le dé­sir, le dé­ca­lage, ce dont cha­cun a be­soin — elle ne peut pas se te­nir à 23h, dans le noir, dans la vul­né­ra­bi­li­té du mo­ment. Elle a be­soin d'un autre es­pace — un di­manche ma­tin, une pro­me­nade, un mo­ment où les deux sont dis­po­nibles et en sé­cu­ri­té."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT FONT="Times New Roman Bold Italic" CH="Dis­tin­guer le re­fus de la per­sonne et le re­fus de l'acte."/>
                <ITEXT CH=" Ce soir, elle a dit non à quelque chose — pas à lui. Cette dis­tinc­tion, si elle peut se dire, change tout ce qui suit."/>
                <trail PARENT="BODY" ALIGN="3"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="141.102992125985" YPOS="36906.4982175458" OwnPage="115" ItemID="285206448" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5139655773081" gWidth="0" gHeight="0" PSTYLE="BODY" LAYER="0" NEXTITEM="285200784" BACKITEM="285212112"/>
        <PAGEOBJECT XPOS="560.630551181103" YPOS="36906.4982175458" OwnPage="116" ItemID="285200784" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5139655773081" gWidth="0" gHeight="0" PSTYLE="BODY" LAYER="0" NEXTITEM="-1" BACKITEM="285206448"/>
        <PAGEOBJECT XPOS="141.102992125985" YPOS="37541.7734931364" OwnPage="117" ItemID="285203616" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5136506166808" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="285214944" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Les portes de sor­tie"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ni­veau 1 — Re­pé­rer son rôle dans le tri­angle (so­lo — les deux par­te­naires)"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Dans le mo­ment, une seule ques­tion :"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Est-ce que je suis en train de de­man­der quelque chose — ou d'ex­pri­mer un be­soin ? Est-ce que je suis en train de re­fu­ser quelque chose — ou de pro­té­ger quelque chose ?"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="La dif­fé­rence entre de­man­der et ex­pri­mer un be­soin est réelle. De­man­der ap­pelle un oui ou un non. Ex­pri­mer un be­soin ouvre une conver­sa­tion."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ni­veau 2 — Nom­mer ce qu'on cherche vrai­ment (so­lo — les deux par­te­naires)"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Avant l'ap­proche, avant le re­fus — une ques­tion in­té­rieure :"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Qu'est-ce que je cherche vrai­ment là — du dé­sir, de la connexion, de la ten­dresse ? Et est-ce que ce che­min-là est le seul pour y ar­ri­ver ce soir ?"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Pas pour re­non­cer à ce qu'on cherche. Pour voir s'il y a un autre che­min — moins ex­po­sant, plus ac­ces­sible dans ce mo­ment pré­cis."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ni­veau 3 — Dire plus tôt ce dont on a be­soin (so­lo — les deux par­te­naires)"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ce qui manque dans cette scène, c'est une conver­sa­tion qui au­rait pu avoir lieu plus tôt. Pas une né­go­cia­tion — une ou­ver­ture simple."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="&quot;J'au­rais en­vie qu'on ait un mo­ment en­semble ce soir.&quot;"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Cette phrase, dite dans la soi­rée, change tout ce qui suit. Elle laisse à l'autre le temps d'y ré­pondre de­puis un en­droit dis­po­nible — pas de­puis l'épui­se­ment de 23h. Et elle ouvre la pos­si­bi­li­té de se re­joindre au­tre­ment — un câ­lin, une proxi­mi­té, quelque chose de doux qui n'exige rien mais qui dit on est en­core nous."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ni­veau 4 — Construire des ri­tuels d'in­ti­mi­té (duo — à ex­plo­rer en­semble)"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Une conver­sa­tion à avoir au calme, hors du lit, hors de toute ten­sion ré­cente :"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="&quot;Qu'est-ce qui te fait te sen­tir proche de moi — vrai­ment proche, pas juste pré­sent ? Et qu'est-ce qui crée de la dis­tance, même sans conflit ?&quot;"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Pas pour dé­ci­der d'un pro­gramme. Pour se connaître mieux sur ce ter­rain-là — et se don­ner des pistes qui ne passent pas uni­que­ment par la sexua­li­té."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ni­veau 5 — Par­ler du su­jet di­rec­te­ment (duo)"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="C'est la conver­sa­tion la plus dif­fi­cile — et la plus utile. Pas dans le mo­ment de ten­sion. Pas après un re­fus. Dans un es­pace neutre, dis­po­nible, sé­cu­ri­sant."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="&quot;Je réa­lise qu'on ne parle ja­mais vrai­ment de ça — de ce qu'on cherche, de ce qui nous manque, de ce qui crée de la dis­tance entre nous sur ce su­jet. Et je pense que ça nous coûte. Est-ce qu'on peut en par­ler ?&quot;"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Pas une confron­ta­tion. Une ou­ver­ture — de­puis "/>
                <ITEXT FONT="Times New Roman Bold" CH="l'Adulte"/>
                <ITEXT CH=", adres­sée à "/>
                <ITEXT FONT="Times New Roman Bold" CH="l'Adulte"/>
                <ITEXT CH=" de l'autre. Avec la conscience que ce su­jet-là de­mande plus de dou­ceur que n'im­porte quel autre."/>
                <trail PARENT="SUBTITLE" ALIGN="3"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="560.630551181103" YPOS="37541.7734931364" OwnPage="118" ItemID="285214944" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5136506166808" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="285203616"/>
        <PAGEOBJECT XPOS="141.102992125985" YPOS="38177.0487687269" OwnPage="119" ItemID="285217776" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="60.5133356560535" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="294158736" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Sui­vi — 7 jours"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <ITEXT CH="Chaque soir, 2 mi­nutes."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="La ques­tion du soir :"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Lun­di : Au­jour­d'hui, com­ment est-ce que j'ai créé de la connexion avec l'autre — au­tre­ment que par la sexua­li­té ?"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Mar­di : Quand j'ai cher­ché de la proxi­mi­té, quel che­min j'ai pris — et est-ce que c'était le plus adap­té à ce mo­ment ?"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Mer­cre­di : Qu'est-ce que j'au­rais pu dire plus tôt au­jour­d'hui — et que j'ai gar­dé pour moi ?"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Jeu­di : À quel mo­ment j'ai sen­ti qu'on était vrai­ment proches au­jour­d'hui — et qu'est-ce qui a créé ça ?"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ven­dre­di : Com­ment j'ai nour­ri mon En­fant Libre au­jour­d'hui — et qu'est-ce que ça a chan­gé dans ma dis­po­ni­bi­li­té pour l'autre ?"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Sa­me­di : Quelle croyance sur le dé­sir ou la sexua­li­té est-ce que je porte — et d'où vient-elle ?"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Di­manche : Si l'in­ti­mi­té n'était plus sous ten­sion entre nous — à quoi res­sem­ble­rait une soi­rée or­di­naire ?"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Ver­sion duo — échange en 2 temps"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="À faire dans un mo­ment de lé­gè­re­té et de connexion dé­jà pré­sente — pas après une ten­sion, pas dans la fa­tigue. 20 mi­nutes, dans un es­pace où les deux se sentent en sé­cu­ri­té."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <ITEXT CH="Temps 1 — Nos lan­gages de l'in­ti­mi­té (10 mi­nutes)"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Cha­cun com­plète ces phrases sé­pa­ré­ment, par écrit :"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="&quot;Ce qui me fait me sen­tir vrai­ment proche de toi, c'est...&quot; &quot;Ce qui crée de la dis­tance entre nous, même sans conflit, c'est...&quot; &quot;Ce dont j'au­rais be­soin plus sou­vent pour me sen­tir in­time avec toi — pas né­ces­sai­re­ment sexuel­le­ment — c'est...&quot;"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Puis on par­tage — cha­cun lit, l'autre écoute sans in­ter­rompre, sans cor­ri­ger, sans pro­po­ser. L'ob­jec­tif n'est pas de trou­ver une so­lu­tion. C'est d'en­tendre ce que l'in­ti­mi­té si­gni­fie vrai­ment pour l'autre — pas ce qu'on sup­po­sait."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Temps 2 — Un geste (10 mi­nutes)"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Une seule ques­tion à ex­plo­rer en­semble :"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="&quot;Quel est un geste concret — pe­tit, quo­ti­dien, ac­ces­sible — qui di­rait à l'autre qu'il compte pour moi d'une fa­çon qui lui ap­par­tient ?&quot;"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Pas un pro­gramme. Pas une pro­messe so­len­nelle. Juste un geste — à es­sayer cette se­maine, à ajus­ter, à gar­der si ça fait quelque chose."/>
                <trail PARENT="BODY" ALIGN="3"/>
            </StoryText>
        </PAGEOBJECT>
