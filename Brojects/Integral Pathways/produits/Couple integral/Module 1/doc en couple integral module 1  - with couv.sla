            <StoryText>
                <DefaultStyle/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <ITEXT CH="Scene 5 — Homework"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <ITEXT CH="&quot;The Bad Parent&quot;"/>
                <trail PARENT="Titre" ALIGN="1"/>
            </StoryText>
            <PageItemAttributes>
                <ItemAttribute Name="tdm" Type="string" Value="Scene 5 — Homework" Parameter="" Relationship="none" RelationshipTo="" AutoAddTo="none"/>
            </PageItemAttributes>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="141.102992125985" YPOS="28012.6443592782" OwnPage="87" ItemID="265117072" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="1331.06955612848" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Duo Version — Exchange in 2 Parts"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <ITEXT CH="To do outside any recent overspend — calmly, 20 minutes."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Part 1 — What Money Represents (10 minutes)"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Each person completes these sentences separately, in writing:"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="&quot;In our relationship, money represents for me...&quot; &quot;What I need to feel free / financially secure is...&quot; &quot;What I've never allowed myself — and would like to be able to give myself — is...&quot;"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Then you share — each person reads, the other listens without interrupting. The goal isn't to convince each other. It's to hear what money truly represents for the other person — beyond the numbers."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Part 2 — A Framework That Respects Both (10 minutes)"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="One question to explore together:"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="&quot;How do we build something that gives you security and gives me freedom — at the same time?&quot;"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Not an imposed rule. A proposal built together — that can be adjusted, tested, revised."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="The next scene enters even more delicate terrain — that of parenting. Two parents, a child who resists, and two ways of loving that don't speak to each other."/>
                <trail PARENT="scene_page_subtitle" ALIGN="1"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="560.630551181103" YPOS="28647.9196348688" OwnPage="90" ItemID="265105744" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="1331.06924116785" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="The Scene"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <ITEXT CH="Living room, 6:30 pm. The child is at the table with homework. She's beside him, tense. He comes in, puts his things down."/>
                <para PARENT="narration" ALIGN="3"/>
                <ITEXT CH="Her: &quot;He refused to do his homework again. I've been struggling with him for an hour.&quot;"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Him: &quot;Come on, let's go.&quot; (to the child, firm tone) &quot;Put the tablet down and get to work now.&quot;"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="The child complies, sulking. She waits until the child is out of earshot."/>
                <para PARENT="narration" ALIGN="3"/>
                <ITEXT CH="Her: &quot;You walk in and take over like that — in front of him.&quot;"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Him: &quot;He wasn't doing anything. You were negotiating for an hour.&quot;"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Her: &quot;I'm not negotiating. I'm trying to understand what's blocking him.&quot;"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Him: &quot;What's blocking him is there's no clear limit. If you set the limit, he respects it.&quot;"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Her: &quot;And what do you think cold authority builds?&quot;"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Silence. The child comes back to get his notebook. They go quiet. Facade smiles."/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Later, once the child is asleep:"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Him: &quot;I just wanted to help.&quot;"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Her: &quot;That's not how you help me.&quot;"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Do You Recognize Yourself?"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="I experience this scene: never · sometimes · often"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="In this scene, I'm more like: the one who sets the limit · the one who tries to understand · both depending on the moment"/>
                <trail PARENT="BODY" ALIGN="3"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="560.630551181103" YPOS="29283.1949104591" OwnPage="92" ItemID="265119904" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="1331.06892620722" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="265122736"/>
        <PAGEOBJECT XPOS="141.102992125985" YPOS="29283.1949104591" OwnPage="91" ItemID="265122736" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="1331.06892620722" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="265119904" BACKITEM="-1">
            <StoryText>
                <DefaultStyle LINESP="17"/>
                <ITEXT FONT="Arial Regular" LANGUAGE="frp" CH="Before the Analysis — One Important Thing"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT FONT="Arial Regular" LANGUAGE="frp" CH="If you recognize yourself in this scene, you probably know what it feels like to hold a course — and see it bypassed in thirty seconds."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT FONT="Arial Regular" LANGUAGE="frp" CH="You know what it's like to have thought through your approach. Not improvising — choosing. Choosing not to shout, to look for what's blocking, to try to understand the child rather than force them. And to see someone arrive, without context, without the path traveled, and resolve the situation the old way — with the firmness you had specifically decided to set aside. And it works. That's the hardest part to swallow."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT FONT="Arial Regular" LANGUAGE="frp" CH="And you might know the other side too: coming home into a tense situation, seeing someone you love exhausted, a child who resists, and feeling that reflex rise — I can fix this. Quickly. Simply. With what you know. Not out of contempt for what the other person was doing — out of genuine desire for it to stop. For everyone. Including yourself."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT FONT="Arial Regular" LANGUAGE="frp" CH="Both positions are honest. They're also both incomplete."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT FONT="Arial Regular" LANGUAGE="frp" CH="What this booklet will offer you is to look not at who has the better method — that question has no answer in the moment of tension — but at what each person was really activating in this scene, beyond the parenting. Because that's where something can change."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT FONT="Arial Regular" LANGUAGE="frp" CH="What's Really Happening"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <ITEXT FONT="Arial Regular" LANGUAGE="frp" CH="On the surface, it's a disagreement about how to get homework done. What's really happening is much more charged — and much older."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT FONT="Arial Regular" LANGUAGE="frp" CH="When two parents clash about parenting, they're rarely debating pedagogy. They're debating what a good parent is. And behind that question is another, deeper one that nobody articulates: "/>
                <ITEXT FONT="Arial Italic" LANGUAGE="frp" CH="am I a good parent"/>
                <ITEXT FONT="Arial Regular" LANGUAGE="frp" CH="? And behind that still: "/>
                <ITEXT FONT="Arial Italic" LANGUAGE="frp" CH="do I have worth in this role that matters more than anything?"/>
                <para PARENT="BODY" ALIGN="3" LINESP="15"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT FONT="Arial Regular" LANGUAGE="frp" CH="That's why these arguments hurt so much. It's not the disagreement about homework that's painful. It's the implicit implication — your way of doing things is wrong — that touches something identity-based. And something, often, very old."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT FONT="Arial Regular" LANGUAGE="frp" CH="What Comes from Further Back"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT FONT="Arial Regular" LANGUAGE="frp" CH="Each person arrives in parenthood with a history. With internalized images of what a parent is — how they set limits, how they console, how they demand, how they're present. These images come from childhood. They weren't chosen. They're there, active, often without our knowing."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT FONT="Arial Regular" LANGUAGE="frp" CH="He may have grown up in an environment where clear rules were synonymous with security. Where authority was love — not coldness. When he sets the limit, he's not thinking &quot;"/>
                <ITEXT FONT="Arial Italic" LANGUAGE="frp" CH="I'm taking power."/>
                <ITEXT FONT="Arial Regular" LANGUAGE="frp" CH="&quot; He's thinking &quot;"/>
                <ITEXT FONT="Arial Italic" LANGUAGE="frp" CH="I'm protecting"/>
                <ITEXT FONT="Arial Regular" LANGUAGE="frp" CH=".&quot;"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT FONT="Arial Regular" LANGUAGE="frp" CH="She may have grown up in an environment where authority was arbitrary, or absent, or hurtful. Where understanding what was happening for the child was what was missing. When she tries to understand what's blocking, she's not thinking &quot;"/>
                <ITEXT FONT="Arial Italic" LANGUAGE="frp" CH="I'm negotiating."/>
                <ITEXT FONT="Arial Regular" LANGUAGE="frp" CH="&quot; She's thinking &quot;"/>
                <ITEXT FONT="Arial Italic" LANGUAGE="frp" CH="I'm seeing."/>
                <ITEXT FONT="Arial Regular" LANGUAGE="frp" CH="&quot;"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT FONT="Arial Regular" LANGUAGE="frp" CH="Neither is wrong. They're reproducing — often without knowing it — what they received, or what they would have liked to receive. And when their two histories collide on the terrain of a child's homework, much more than homework is at stake."/>
                <trail PARENT="BODY" ALIGN="3"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="141.102992125985" YPOS="29918.4701860497" OwnPage="93" ItemID="265125568" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="1331.06861124659" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="253653392" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="The Ego States Present:"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="What's striking: both are operating from the Parent — him from the Normative, her from the Nurturing. Two forms of parental love. Two ways of being a good parent. Incompatible in the moment, not at heart."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="The Adult is absent on both sides. It can't be there because the scene is no longer about homework. It's about who is right to love the child the way they love them."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para ALIGN="3"/>
                <para ALIGN="3"/>
                <ITEXT CH="The Life Positions Present"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="In Transactional Analysis, a "/>
                <ITEXT FONT="Times New Roman Italic" CH="life position"/>
                <ITEXT CH=" is the deep conviction we carry about ourselves and the other — built early, rarely conscious, always active in moments of tension."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="He operates from something that resembles &quot;"/>
                <ITEXT FONT="Times New Roman Italic" CH="I'm OK — what you're doing isn't."/>
                <ITEXT CH="&quot; Not out of contempt — out of conviction that his way is right. It's a position of implicit superiority that shows in the unsolicited intervention, in &quot;"/>
                <ITEXT FONT="Times New Roman Italic" CH="if you set the limit, he respects it."/>
                <ITEXT CH="&quot;"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="She slides toward something that resembles &quot;"/>
                <ITEXT FONT="Times New Roman Italic" CH="I'm doing my best — and you come to show me it's not enough"/>
                <ITEXT CH=".&quot; A position that combines the legitimacy of her approach and the hurt of being discredited in front of the child."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="These positions aren't fixed. They move in the scene — he slides into &quot;"/>
                <ITEXT FONT="Times New Roman Italic" CH="I'm not OK"/>
                <ITEXT CH="&quot; when he says &quot;"/>
                <ITEXT FONT="Times New Roman Italic" CH="I just wanted to help"/>
                <ITEXT CH=",&quot; she regains the high ground when she challenges his cold authority. But their collision is enough to make the conversation impossible."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="The Karpman Drama Triangle — the Drama in Three Acts"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="This is where the scene reveals its full mechanics. What's particularly striking in this configuration is the speed at which the roles shift."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT FONT="Times New Roman Italic" CH="Act 1 — before he comes home."/>
                <ITEXT CH=" She's been struggling for an hour. She's exhausted, overwhelmed, alone facing the child's resistance. She's in "/>
                <ITEXT FONT="Times New Roman Bold" CH="Victim"/>
                <ITEXT CH=" mode — not in the weak sense, but in the technical sense: she's enduring a situation she no longer controls, and carrying it alone."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT FONT="Times New Roman Italic" CH="Act 2 — he comes home and intervenes"/>
                <ITEXT CH=". He sees the scene. His reflex is immediate — he enters as "/>
                <ITEXT FONT="Times New Roman Bold" CH="Rescuer"/>
                <ITEXT CH=". He takes over, sets the limit, gets the result. The child obeys. He's repaired what seemed broken."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="But something shifts. By becoming the "/>
                <ITEXT FONT="Times New Roman Bold" CH="Rescuer"/>
                <ITEXT CH=" of the situation, he implicitly becomes the "/>
                <ITEXT FONT="Times New Roman Bold" CH="Persecutor"/>
                <ITEXT CH=" of her — he bypassed her authority, in front of the child, without asking. What he experienced as a rescue, she experienced as a humiliation."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT FONT="Times New Roman Italic" CH="Act 3 — the twist"/>
                <ITEXT CH=". She counter-attacks: &quot;you walk in and take over like that.&quot; She shifts to "/>
                <ITEXT FONT="Times New Roman Bold" CH="Persecutor"/>
                <ITEXT CH=". He slides into "/>
                <ITEXT FONT="Times New Roman Bold" CH="Victim"/>
                <ITEXT CH=" — he tried to help, he's being criticized for it. And later, &quot;I just wanted to help&quot; says exactly this position: I am the "/>
                <ITEXT FONT="Times New Roman Bold" CH="victim"/>
                <ITEXT CH=" of your reaction to my help."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="She, who was "/>
                <ITEXT FONT="Times New Roman Bold" CH="Victim"/>
                <ITEXT CH=" at the start, ends up in the uncomfortable position of the one who hurt someone who meant well. The guilt is there, even if unnamed."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT FONT="Times New Roman Bold" CH="Victim"/>
                <ITEXT CH=" (her) → "/>
                <ITEXT FONT="Times New Roman Bold" CH="Rescuer"/>
                <ITEXT CH=" (him) → Implicit "/>
                <ITEXT FONT="Times New Roman Bold" CH="Persecutor"/>
                <ITEXT CH=" (him) → "/>
                <ITEXT FONT="Times New Roman Bold" CH="Victim"/>
                <ITEXT CH=" (her, discredited) → "/>
                <ITEXT FONT="Times New Roman Bold" CH="Persecutor"/>
                <ITEXT CH=" (her attacking) → "/>
                <ITEXT FONT="Times New Roman Bold" CH="Victim"/>
                <ITEXT CH=" (him, misunderstood) → diffuse guilt on both sides"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="The Hidden Benefit of the Drama"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="This triangle persists because it protects something — in each person, differently."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="For him: getting a quick result avoids having to enter into what had been happening for an hour. If it works, that's because it was the right way. And being the one who solves says something reassuring about his place in this household — he's useful, he matters."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="For her: naming what just happened protects the meaning of what she's building. Letting it go without saying anything would be allowing an entire path to be silently invalidated. The criticism isn't just anger — it's a way of saying "/>
                <ITEXT FONT="Times New Roman Italic" CH="what I do has value, even if you didn't see it."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Both protect something legitimate. And neither protects what most needs protecting — the space between them, from which a real conversation about parenting could one day take place."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="The &quot;Courtroom&quot; Game — Who Is the Better Parent?"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="What Berne calls &quot;"/>
                <ITEXT FONT="Times New Roman Italic" CH="Courtroom"/>
                <ITEXT CH="&quot; isn't a game of cruelty. It's a game of legitimacy — often unconscious, always revealing of what couldn't be said otherwise."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="The structure: a decision is made, contradicted, or judged. One takes the position of accuser — &quot;"/>
                <ITEXT FONT="Times New Roman Italic" CH="you were negotiating for an hour"/>
                <ITEXT CH="&quot; — and the other the position of defendant — &quot;"/>
                <ITEXT FONT="Times New Roman Italic" CH="I'm not negotiating, I'm trying to understand."/>
                <ITEXT CH="&quot; The real issue isn't the decision. It's the verdict: who is right to be the parent they are?"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="This game has a precise secondary benefit. For him: intervening and getting a quick result confirms his approach works. For her: resisting his intervention and pointing out its limits confirms she sees what he doesn't see."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Both are looking for the same thing — to be recognized as competent, loving, sufficient. And they're looking for it by opposing each other. It's not rational. It's human."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="The Alert Not to Miss"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <ITEXT CH="The exit from this game isn't to align on a single method — or to decide who is right between limit-setting and understanding."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Both approaches have value. The problem isn't the method — it's the disunity."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="The real question for him: &quot;"/>
                <ITEXT FONT="Times New Roman Italic" CH="what does it activate in me to see this scene when I come home — and why do I intervene before even asking what's happening?"/>
                <ITEXT CH="&quot;"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="The real question for her: &quot;"/>
                <ITEXT FONT="Times New Roman Italic" CH="what am I truly building — and how do I make it visible to the other person, other than in the moment of tension?"/>
                <ITEXT CH="&quot;"/>
                <trail PARENT="BODY" ALIGN="3"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="560.630551181103" YPOS="29918.4701860497" OwnPage="94" ItemID="253653392" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="1331.06861124659" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="253644896" BACKITEM="265125568"/>
        <PAGEOBJECT XPOS="560.630551181103" YPOS="30553.7454616403" OwnPage="96" ItemID="253656224" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="1331.06829628596" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="253644896"/>
        <PAGEOBJECT XPOS="141.102992125985" YPOS="30553.7454616403" OwnPage="95" ItemID="253644896" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="1331.06829628596" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="253656224" BACKITEM="253653392"/>
        <PAGEOBJECT XPOS="141.102992125985" YPOS="31189.0207372309" OwnPage="97" ItemID="253650560" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="1331.06798132533" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="253647728" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="What We Really Need — the NVC Angle"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="In this scene, the two protagonists aren't experiencing the same thing — and they don't have the same needs. What follows offers two separate readings. Not to designate who's right about the method. To allow each person to recognize what's activated in them — and find their own exit."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="The same rule applies in both cases: a need belongs to me. It doesn't depend on what the other person does or doesn't do. I am responsible for finding how to meet it — not for waiting for the other person to guess."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="If you're the one whose efforts were bypassed"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="What you express through the resistance and the criticism isn't stubbornness. It's information about what matters deeply to you — and about what disappears without leaving a trace when the result erases the path."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Read this list. Check what truly resonates."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Once your need is identified, complete this sentence:"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="&quot;I need __. When I reconnect to this "/>
                <ITEXT FONT="Times New Roman Italic" CH="n"/>
                <ITEXT CH="eed, what I choose to do is __.&quot;"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="A few examples:"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="&quot;I need meaning. What I choose to do is continue my approach — even wit"/>
                <ITEXT FONT="Tempus Sans ITC Regular" CH="h"/>
                <ITEXT CH="out immediate results — and observe what it builds over time, not just tonight.&quot;"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="&quot;I need integrity. What I choose to do is stay with what I believe is right for this child — and find a calm moment to share this path with the other person, not impose it, just make it visible.&quot;"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="&quot;I need growth. What I choose to do is name, for myself first, what I want to transmit — and what I don't want to reproduce. Not as a criticism of the other. As a compass for myself.&quot;"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="If you're the one who intervened"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="What you did wasn't contempt. It was a reflex — quick, efficient, inherited. But a reflex isn't a choice. And the question worth asking isn't &quot;did it work?&quot; It's &quot;what was activated in me — and what does that say about what I truly need?&quot;"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Read this list. Check what truly resonates."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Once your need is identified, complete this sentence:"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="&quot;I need __. When I reconnect to this need, what I choose to do is __.&quot;"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="A few examples:"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="&quot;I need inner peace. What I choose to do is give myself a moment to decompress when I come home — before entering into what's happening — so I don't intervene from exhaustion.&quot;"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="&quot;I need contribution. What I choose to do is ask the other person how I can help — before acting. Just that. Two seconds. Before.&quot;"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="&quot;I need self-confidence. What I choose to do is examine what my parenting automatisms carry — what they've given me, what they reproduce — without defending or wholesale rejecting them.&quot;"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="These two lists speak of the same aspiration — being a parent who acts from what they truly believe, not from reflex or fatigue. They don't meet in the scene. But they can meet calmly, when both have decided to speak not of method — but of what they truly want to build together."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="560.630551181103" YPOS="31189.0207372309" OwnPage="98" ItemID="253647728" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="1331.06798132533" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="253659056" BACKITEM="253650560"/>
        <PAGEOBJECT XPOS="560.630551181103" YPOS="31824.2960128215" OwnPage="100" ItemID="253661888" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="1331.06766636469" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Feeding Your Free Child"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="There is something operating in the background of this scene — worth naming."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Both arrive in this moment from their Parent. Him from the Normative — the rule, the limit, the efficiency. Her from the Nurturing — the understanding, the care, the patience. Two serious forms of love. Two ways of being there for this child that cost a lot — and that leave little room for anything else."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="What's rarely seen from the inside: the tension that builds in these moments isn't just the product of the interaction. It's also what we bring to it. When we're very focused on doing things right — on the result, on the method, on what's just — we arrive in the relationship with little breath. And that absence of breath is transmitted. To the child. To the other parent. It nourishes exactly what we wanted to avoid."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Feeding your Free Child isn't a way of being a less good parent. It's a way of taking care of yourself — so you arrive in the relationship differently. Not less demanding. Less tense. And that difference, the child senses before the words even arrive."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="It's not about changing the homework scene first. It's about asking what you allowed yourself today — outside your role as parent, outside the couple, outside what you must. A moment that belongs only to you. Not much. But something."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Because taking care of yourself is taking care of the relationship. Not instead of the demand — alongside it. And often, when you allow yourself this breath, the demand settles on its own — without having decided anything else."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="The question to ask yourself tonight:"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="What did I allow myself today — not to be useful, not to do things right — just for myself?"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="And an additional question, specific to this scene:"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Was the tension I experienced tonight only in the situation — or was I already bringing it with me when I walked into the room?"/>
                <trail PARENT="narration"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="141.102992125985" YPOS="31824.2960128215" OwnPage="99" ItemID="253659056" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="1331.06766636469" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="253647728"/>
        <PAGEOBJECT XPOS="141.102992125985" YPOS="32459.5712884121" OwnPage="101" ItemID="253676048" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="1331.06735140406" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="253673216" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="The Exits"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Level 1 — Notice your role in the triangle (solo — both partners)"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="One question, in the moment:"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="What role am I in right now — Victim, Rescuer, or Persecutor?"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="If you're "/>
                <ITEXT FONT="Times New Roman Bold" CH="Victim"/>
                <ITEXT CH=": what are you waiting for from the other — support, a solution? Can you ask for it directly rather than waiting?"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="If you're "/>
                <ITEXT FONT="Times New Roman Bold" CH="Rescuer"/>
                <ITEXT CH=": were you asked to intervene? Does your intervention serve the other — or does it first serve your need to be useful?"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="If you're "/>
                <ITEXT FONT="Times New Roman Bold" CH="Persecutor"/>
                <ITEXT CH=": what are you truly defending — a parenting method, or your legitimacy as a parent?"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Noticing the role doesn't make it disappear immediately. But it creates a space — a slight distance between reflex and reaction — from which something else becomes possible."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Level 2 — Observe from which place you're speaking (solo — both partners)"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="The next time this scene is triggered, a complementary question:"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Am I reacting to the child, or am I reacting to the other parent?"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="If the primary emotion is frustration toward the child — it's a parenting question. If the primary emotion is frustration toward the other — it's a couple question disguised as a parenting question. Both deserve a response. But not the same one."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Level 3 — Set a handover protocol (together — to build outside tension)"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="The handover scene is inevitable in any couple with children. What creates the problem is that it's never been discussed. It's improvised, in the moment, under tension."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="A conversation to have calmly, without the child:"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="&quot;When one of us is struggling — how do we hand over without bypassing each other? What does each of us need from the other in that moment?&quot;"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Not a rigid rule. A flexible agreement — a signal, a phrase, a gesture that says &quot;I need help&quot; or &quot;I'll take over, you breathe.&quot; Something chosen together, not imposed in the urgency."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Level 4 — Name the divergence in approach without making it a verdict (together)"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="&quot;I realize we've never really talked about our parenting approaches — what we want for them, what matters to each of us, what we received and what we want to reproduce or not. Can we do that — not to decide who's right, but to understand each other?&quot;"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="This conversation moves disagreements from the terrain of reaction to the terrain of choice. It allows each person to hear where the other is coming from — not as a threat, but as a history."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Level 5 — Name the game together (together)"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="A few days after the scene, calmly:"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="&quot;I think we sometimes replay something — not about the homework, but about who is the good parent. I jump in as Rescuer without being asked, and that puts you in an impossible position. I see that now. Can we talk about it?&quot;"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Not an accusation. A shared observation from the Adult — that opens the possibility of talking about what's really happening."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para ALIGN="3"/>
                <para ALIGN="3"/>
                <ITEXT CH="Tracking — 7 Days"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <ITEXT CH="Every evening, 2 minutes."/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <ITEXT CH="V = Victim · R = Rescuer · P = Persecutor"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <ITEXT CH="The evening question:"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Monday: "/>
                <ITEXT FONT="Times New Roman Italic" CH="Which role did I spend the most time in today — and what led me there?"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Tuesday: "/>
                <ITEXT FONT="Times New Roman Italic" CH="What was activated in me when I came home tonight — and where did it come from?"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Wednesday: "/>
                <ITEXT FONT="Times New Roman Italic" CH="At what moment did I see the other person's approach as a threat rather than a difference?"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Thursday: "/>
                <ITEXT FONT="Times New Roman Italic" CH="What has my history taught me about what a good parent is — and is it still playing out here?"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Friday: "/>
                <ITEXT FONT="Times New Roman Italic" CH="How did I nourish my Free Child today — and what did it change in my presence?"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Saturday: "/>
                <ITEXT FONT="Times New Roman Italic" CH="What did I allow myself this week — just for myself?"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Sunday: "/>
                <ITEXT FONT="Times New Roman Italic" CH="If we were truly a team in these moments — what would that look like concretely?"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Duo Version — Exchange in 2 Parts"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <ITEXT CH="To do outside any recent episode — calmly, without the child present, 20 minutes."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Part 1 — Our Parenting Histories (10 minutes)"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Each person completes these sentences separately, in writing:"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="&quot;What I received as an upbringing, and want to pass on, is...&quot; &quot;What I didn't receive, and try to give, is...&quot; &quot;What I need from you in the difficult moments with the children is...&quot;"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Then you share — each person reads, the other listens without interrupting. The goal isn't to decide on a common method. It's to hear where the other is coming from."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Part 2 — A Handover Agreement (10 minutes)"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="&quot;How do we support each other in these moments — without bypassing each other?&quot;"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Not a rigid protocol. A flexible, revisable agreement that says: we're a team. And when one is exhausted, the other takes over — in a way that respects what the other started."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="The last scene is the most silent of all. It takes place in the dark, at 11 pm. And what plays out in it lasted only thirty seconds."/>
                <para PARENT="scene_page_subtitle" ALIGN="1"/>
                <para ALIGN="3"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="560.630551181103" YPOS="32459.5712884121" OwnPage="102" ItemID="253673216" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="1331.06735140406" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="253667552" BACKITEM="253676048"/>
        <PAGEOBJECT XPOS="560.630551181103" YPOS="33094.8465640025" OwnPage="104" ItemID="253664720" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="1331.06703644344" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="253667552"/>
        <PAGEOBJECT XPOS="141.102992125985" YPOS="33094.8465640025" OwnPage="103" ItemID="253667552" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="1331.06703644344" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="253664720" BACKITEM="253673216"/>
        <PAGEOBJECT XPOS="560.630551181103" YPOS="33730.1218395932" OwnPage="106" ItemID="253670384" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="1331.06672148281" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <ITEXT CH="Scene 6 — The Bedroom"/>
                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="Titre" ALIGN="1"/>
                <ITEXT CH="&quot;Not Tonight&quot;"/>
                <trail PARENT="Titre" ALIGN="1"/>
            </StoryText>
            <PageItemAttributes>
                <ItemAttribute Name="tdm" Type="string" Value="Scene 6 — The Bedroom" Parameter="" Relationship="none" RelationshipTo="" AutoAddTo="none"/>
            </PageItemAttributes>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="560.630551181103" YPOS="34365.3971151837" OwnPage="108" ItemID="253690208" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="1331.06640652218" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="253687376" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FONT="Times New Roman Regular" CH="Before the Scene — A Few Words About What's Really at Stake"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT FONT="Times New Roman Regular" CH="This scene is different from the five before it. Not because it's more serious. Because it's closer."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT FONT="Times New Roman Regular" CH="Household tasks, return times, money, children — these are subjects you can put on the table, debate, negotiate. They have an external form. You can point to something concrete."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT FONT="Times New Roman Regular" CH="Sexuality in a couple doesn't have that form. It touches something that resists words — desire, vulnerability, the need to be wanted. And behind those words, something even more fundamental: "/>
                <ITEXT FONT="Times New Roman Italic" CH="do I matter to you? Do you see me — not as a roommate, not as the parent of our children, not as someone you share a budget with — but as someone you hold on to, specifically, intimately?"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT FONT="Times New Roman Regular" CH="That's why this subject is so hard to approach. Not because it's taboo — even though the modesty is real. Because it exposes something that can't be defended with arguments."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT FONT="Times New Roman Regular" CH="There's also a widespread belief, rarely articulated, that complicates everything: "/>
                <ITEXT FONT="Times New Roman Italic" CH="sexuality is what differentiates us from a friendship. If it disappears, what are we?"/>
                <ITEXT FONT="Times New Roman Regular" CH=" This belief transforms every refusal into an existential threat to the bond. And every request into a test of the state of the relationship."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT FONT="Times New Roman Regular" CH="It's not a truth. But it's a very active belief — and it deserves to be named before entering the scene."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT FONT="Times New Roman Regular" CH="One last thing. What most people are looking for when they seek physical intimacy isn't always what they're asking for. Behind sexual desire, there's often something simpler and deeper: warmth. Connection. The certainty of existing for the other in a way that belongs only to the two of you. Sex can be the path to that — or the only path you know to get there. But it's not the only route."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT FONT="Times New Roman Regular" CH="It's from that place that this scene deserves to be read."/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT FONT="Times New Roman Regular" CH="The Scene"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <ITEXT FONT="Times New Roman Regular" CH="Bedroom, 11 pm. They're in bed. The lights are off. He moves closer, places a hand on her shoulder."/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT FONT="Times New Roman Regular" CH="Him: (low voice) &quot;Are you asleep?&quot;"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT FONT="Times New Roman Regular" CH="Her: &quot;Not yet.&quot;"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT FONT="Times New Roman Regular" CH="A silence. He stays close."/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT FONT="Times New Roman Regular" CH="Her: &quot;I'm really tired tonight.&quot;"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT FONT="Times New Roman Regular" CH="Him: &quot;Yeah.&quot; (he turns to his side)"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT FONT="Times New Roman Regular" CH="Silence. Both lying with eyes open in the dark."/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT FONT="Times New Roman Regular" CH="Her: (after a moment) &quot;Are you angry?&quot;"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT FONT="Times New Roman Regular" CH="Him: &quot;No. Sleep well.&quot;"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT FONT="Times New Roman Regular" CH="She turns over. The silence settles — not peaceful. Each on their own side, each in their own head."/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT FONT="Times New Roman Regular" CH="Do You Recognize Yourself?"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT FONT="Times New Roman Regular" CH="I experience this scene: never · sometimes · often"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT FONT="Times New Roman Regular" CH="In this scene, I'm more like: the one who moves closer · the one who says no · both depending on the moment"/>
                <trail PARENT="BODY" ALIGN="3"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="141.102992125985" YPOS="35000.6723907743" OwnPage="109" ItemID="253687376" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="1331.06609156155" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="253690208"/>
        <PAGEOBJECT XPOS="560.630551181103" YPOS="35000.6723907743" OwnPage="110" ItemID="253678880" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="1331.06609156155" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="253693040" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Before the Analysis — One Important Thing"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <ITEXT CH="If you recognize yourself in this scene, you probably know what it feels like to want something — and not know how to say it."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="The silent approach at 11 pm isn't a request. It's an attempt. A gesture that hopes to be understood without having to expose itself further. And that way of not saying — of leaving the other person to guess — puts the other in a difficult position: responding in the heat of the moment, from exhaustion, to a request they didn't have time to receive. Often exhausted. Often already elsewhere in their head."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="The refusal that follows isn't always rejection. It's often the response of a body that has no more resource — not for this, not now. But because the request wasn't stated, the refusal can't be nuanced either. It arrives blunt, even when it's gentle. And in the silence that follows, each is left alone with what they didn't say."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="What was missing in this scene wasn't desire. It was a conversation — earlier in the evening, in a moment when both were still available. &quot;"/>
                <ITEXT FONT="Times New Roman Italic" CH="I'd love it if we had a moment together tonight."/>
                <ITEXT CH="&quot; That sentence opens something. It leaves the other free to respond — not from obligation or rejection, but from what's truly possible for them. Maybe not what was asked for. But maybe something — a hug, a closeness, a moment of warmth that asks for nothing but says we're still us."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Intimacy doesn't come down to sexuality. And it's often when we believe it's all or nothing that we end up with nothing."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <ITEXT CH="What's Really Happening"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <ITEXT CH="What happened in this scene lasted only thirty seconds. And yet both will take time to fall asleep."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="He didn't ask for something. He moved closer. That gesture — simple, silent, vulnerable — carried something he couldn't have easily articulated. Perhaps: I want you. I want to be close. I need to feel we're still us. Perhaps something even simpler: I want to touch you."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="She said no — gently, without brutality, with real tiredness. She didn't reject him. She refused something she didn't have the energy to give tonight. The nuance is real. But in the darkness, in the silence that followed, this nuance was lost."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="&quot;"/>
                <ITEXT FONT="Times New Roman Italic" CH="Are you angry?"/>
                <ITEXT CH="&quot; says she sensed something. Not anger — withdrawal. That withdrawal spoke to her more loudly than his words. And his &quot;no, sleep well&quot; — too short, too clean — confirmed what she feared: that he was hurt. That she'd done something wrong by simply being tired."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Nobody said what was really happening. Nobody had the words for it — not at 11 pm, not in the dark, not without risking something."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="A Word on Differences — Without Generalizing"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <ITEXT CH="There's a reality this scene carries without naming it: desire doesn't work the same way for everyone. And in many couples — not all, but many — there's a gap. One is more often the initiator, the other more often in withdrawal. This isn't about a lack of love. It's not a fatality either."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="This gap often comes from things that are both simple and deep. Fatigue accumulates differently. Stress cuts desire differently. The need for connection expresses itself differently — one through the body, the other through words, shared time, daily tenderness. What one reads as a signal of intimacy — "/>
                <ITEXT FONT="Times New Roman Italic" CH="he moves closer, he wants me"/>
                <ITEXT CH=" — the other sometimes reads as pressure — "/>
                <ITEXT FONT="Times New Roman Italic" CH="another request I don't have the energy to honor."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="These differences aren't flaws. They're languages that haven't yet found a common translator."/>
                <trail PARENT="BODY" ALIGN="3"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="141.102992125985" YPOS="35635.9476663648" OwnPage="111" ItemID="253693040" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="1331.06577660092" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="253678880"/>
        <PAGEOBJECT XPOS="560.630551181103" YPOS="35635.9476663648" OwnPage="112" ItemID="253684544" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="1331.06577660092" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="253681712" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="The Ego States Present:"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="What's striking here: both start from the Free Child — spontaneous, open, without calculation. And it's the Wounded Child that takes over, on both sides, in the silence that follows. The Adult — the one who could say &quot;"/>
                <ITEXT FONT="Times New Roman Italic" CH="I sensed you withdraw and I was afraid you were hurt"/>
                <ITEXT CH="&quot; or &quot;"/>
                <ITEXT FONT="Times New Roman Italic" CH="when you say no, something closes in me, not anger, more sadness"/>
                <ITEXT CH="&quot; — has no place in that moment."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="This isn't a lack of maturity. It's the nature of what's happening here. We don't talk about desire from the Adult. We live it from the Child — and that's precisely why the words are missing."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="The Karpman Drama Triangle — the Silent Drama"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="What makes this triangle particular is that it plays out almost entirely in silence. No shouts, no open criticism. And yet the roles are there — active, painful, as real as in the previous scenes."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT FONT="Times New Roman Italic" CH="Act 1 — the approach"/>
                <ITEXT CH=". He moves closer from a vulnerable place. He's in"/>
                <ITEXT FONT="Times New Roman Bold" CH=" Free Child"/>
                <ITEXT CH=" mode — spontaneous, open, without defense. That moment, before the response, is perhaps the most exposed of the scene."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT FONT="Times New Roman Italic" CH="Act 2 — the refusal"/>
                <ITEXT CH=". She says no — gently, honestly. She's not "/>
                <ITEXT FONT="Times New Roman Bold" CH="Persecutor"/>
                <ITEXT CH=". She's simply tired. But in the logic of the triangle, her refusal places her, despite herself, in a position where he becomes "/>
                <ITEXT FONT="Times New Roman Bold" CH="Victim"/>
                <ITEXT CH=" — not rejected violently, but left alone with something he had extended."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT FONT="Times New Roman Italic" CH="Act 3 — the withdrawal"/>
                <ITEXT CH=". He turns over. This silent withdrawal is a role shift. He slides into passive "/>
                <ITEXT FONT="Times New Roman Bold" CH="Persecutor"/>
                <ITEXT CH=" — not by intention, but by effect. His silence punishes without saying so. She senses it. And that's what makes her ask &quot;"/>
                <ITEXT FONT="Times New Roman Italic" CH="are you angry?"/>
                <ITEXT CH="&quot;"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT FONT="Times New Roman Italic" CH="Act 4 — the twist"/>
                <ITEXT CH=". She asks. She's now in "/>
                <ITEXT FONT="Times New Roman Bold" CH="Victim"/>
                <ITEXT CH=" mode — guilty of a hurt she didn't want, anxious about the reaction she provoked. He answers "/>
                <ITEXT FONT="Times New Roman Italic" CH="&quot;no, sleep well"/>
                <ITEXT CH="&quot; — and becomes the "/>
                <ITEXT FONT="Times New Roman Bold" CH="Rescuer"/>
                <ITEXT CH=" of facade, the one who says everything's fine so it stops. But both know everything isn't fine."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT FONT="Times New Roman Bold" CH="Free Child"/>
                <ITEXT CH=" (him) → "/>
                <ITEXT FONT="Times New Roman Bold" CH="Victim"/>
                <ITEXT CH=" of the refusal → Silent "/>
                <ITEXT FONT="Times New Roman Bold" CH="Persecutor"/>
                <ITEXT CH=" → Her as guilty "/>
                <ITEXT FONT="Times New Roman Bold" CH="Victim"/>
                <ITEXT CH=" → "/>
                <ITEXT FONT="Times New Roman Bold" CH="Rescuer"/>
                <ITEXT CH=" of facade (him) → painful silence on both sides"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="The Hidden Benefit of the Drama"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="This triangle persists because it protects something — in each person, differently."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="For him: not stating the request protects from something even more exposing than the body — the vulnerability of words. As long as the request remains a gesture, a silence, a physical approach, he doesn't have to say what he's truly looking for. And if it's refused, it's the gesture that's refused — not the words. Not what was behind them."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="For her: managing the guilt after the refusal is uncomfortable — but it's familiar territory. More familiar, at least, than the conversation about what she needs to want connection. What she would like — to be seen in her tiredness before being desired, to be met without pressure, to find another path toward closeness — is hard to articulate. So she doesn't articulate it. And guilt takes its place."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Both avoid the same thing — not intimacy, but the words that would allow it to be built differently. And that avoidance, repeated, slowly digs the distance that neither wants."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="The &quot;Let's You and Him Fight&quot; Game — and Its Silent Version"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="The game Berne describes under the name &quot;Let's You and Him Fight&quot; takes a particular form here. In its classic version, an external grievance is used to reject an intimate approach — transforming a vulnerability into a power struggle. Sexuality becomes a terrain for negotiation, even punishment."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="In this scene, there's no open grievance. But the structure is similar — and more insidious. The conflict doesn't express itself, it deposits. In the silent withdrawal. In the too-short &quot;sleep well.&quot; In the eyes open in the dark."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="This game has a precise secondary benefit: it allows you to avoid real intimacy — paradoxically — by asking for it or refusing it. Because real intimacy, the one made of true words in the dark, is even more exposing than the body."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="The Alert Not to Miss"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <ITEXT CH="The exit from this game isn't to make more effort — or to accept when you don't feel like it."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Accepting without real desire doesn't nourish intimacy. It creates a silent debt — on both sides."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="The real question for him isn't &quot;how do I get a yes more often?&quot; It's &quot;what am I truly looking for when I move closer — and can I say it differently, or earlier?&quot;"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="The real question for her isn't &quot;how do I refuse without hurting him?&quot; It's &quot;what do I need to feel available for connection — and do I know that myself?&quot;"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="These two questions point toward the same place: intimacy isn't an act. It's a state — that we build or let erode, in the daily gestures, well before 11 pm."/>
                <trail PARENT="BODY" ALIGN="3"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="141.102992125985" YPOS="36271.2229419554" OwnPage="113" ItemID="253681712" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="1331.0654616403" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="253707200" BACKITEM="253684544"/>
