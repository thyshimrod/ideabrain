        <PAGEOBJECT XPOS="575.257267089401" YPOS="33522.1537202982" OwnPage="104" ItemID="289925440" PTYPE="5" WIDTH="295.263379417221" HEIGHT="1" FRTYPE="0" CLIPEDIT="0" ROT="359.914137254786" PWIDTH="0.283464566929134" PCOLOR="bordeaux" SHADE="0" PCOLOR2="bordeaux" PLINEART="1" path="" gXpos="575.257267089402" gYpos="14463.8860037628" gWidth="0" gHeight="0" LAYER="0"/>
        <PAGEOBJECT XPOS="578.257267089401" YPOS="33444.1537202982" OwnPage="104" ItemID="289936768" PTYPE="5" WIDTH="295.263379417221" HEIGHT="1" FRTYPE="0" CLIPEDIT="0" ROT="359.914137254786" PWIDTH="0.283464566929134" PCOLOR="bordeaux" SHADE="0" PCOLOR2="bordeaux" PLINEART="1" path="" gXpos="578.257267089402" gYpos="14385.8860037628" gWidth="0" gHeight="0" LAYER="0"/>
        <PAGEOBJECT XPOS="156.729708034284" YPOS="35358.9795470699" OwnPage="109" ItemID="294219968" PTYPE="5" WIDTH="295.263379417221" HEIGHT="1" FRTYPE="0" CLIPEDIT="0" ROT="359.914137254786" PWIDTH="0.283464566929134" PCOLOR="bordeaux" SHADE="0" PCOLOR2="bordeaux" PLINEART="1" path="" gXpos="576.257267089402" gYpos="14394.885058881" gWidth="0" gHeight="0" LAYER="0"/>
        <PAGEOBJECT XPOS="575.257267089401" YPOS="35387.9795470699" OwnPage="110" ItemID="294211472" PTYPE="5" WIDTH="295.263379417221" HEIGHT="1" FRTYPE="0" CLIPEDIT="0" ROT="359.914137254786" PWIDTH="0.283464566929134" PCOLOR="bordeaux" SHADE="0" PCOLOR2="bordeaux" PLINEART="1" path="" gXpos="575.257267089402" gYpos="14423.885058881" gWidth="0" gHeight="0" LAYER="0"/>
        <PAGEOBJECT XPOS="164.729708034284" YPOS="35847.2548226605" OwnPage="111" ItemID="294222800" PTYPE="5" WIDTH="295.263379417221" HEIGHT="1" FRTYPE="0" CLIPEDIT="0" ROT="359.914137254786" PWIDTH="0.283464566929134" PCOLOR="bordeaux" SHADE="0" PCOLOR2="bordeaux" PLINEART="1" path="" gXpos="584.257267089402" gYpos="14247.8847439204" gWidth="0" gHeight="0" LAYER="0"/>
        <PAGEOBJECT XPOS="563.725039370079" YPOS="35669.7788976378" OwnPage="112" ItemID="294214304" PTYPE="2" WIDTH="334.811023622047" HEIGHT="177.078740157536" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="0.39" LOCALSCY="0.39" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" Pagenumber="0" PFILE="images/en/besoinchap6.png" PRFILE="Embedded sRGB built-in" IRENDER="0" EPROF="Embedded sRGB built-in" path="M0 0 L334.811 0 L334.811 177.079 L0 177.079 L0 0 Z" copath="M0 0 L334.811 0 L334.811 177.079 L0 177.079 L0 0 Z" gXpos="563.725039370079" gYpos="35669.7788976378" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1"/>
        <PAGEOBJECT XPOS="580.257267089401" YPOS="36016.2548226605" OwnPage="112" ItemID="294225632" PTYPE="5" WIDTH="295.263379417221" HEIGHT="1" FRTYPE="0" CLIPEDIT="0" ROT="359.914137254786" PWIDTH="0.283464566929134" PCOLOR="bordeaux" SHADE="0" PCOLOR2="bordeaux" PLINEART="1" path="" gXpos="580.257267089402" gYpos="14416.8847439204" gWidth="0" gHeight="0" LAYER="0"/>
        <PAGEOBJECT XPOS="164.729708034284" YPOS="36557.5300982511" OwnPage="113" ItemID="294228464" PTYPE="5" WIDTH="295.263379417221" HEIGHT="1" FRTYPE="0" CLIPEDIT="0" ROT="359.914137254786" PWIDTH="0.283464566929134" PCOLOR="bordeaux" SHADE="0" PCOLOR2="bordeaux" PLINEART="1" path="" gXpos="584.257267089402" gYpos="14322.8844289598" gWidth="0" gHeight="0" LAYER="0"/>
        <PAGEOBJECT XPOS="572.257267089401" YPOS="36322.5300982511" OwnPage="114" ItemID="294217136" PTYPE="5" WIDTH="295.263379417221" HEIGHT="1" FRTYPE="0" CLIPEDIT="0" ROT="359.914137254786" PWIDTH="0.283464566929134" PCOLOR="bordeaux" SHADE="0" PCOLOR2="bordeaux" PLINEART="1" path="" gXpos="572.257267089402" gYpos="14087.8844289598" gWidth="0" gHeight="0" LAYER="0"/>
        <PAGEOBJECT XPOS="573.257267089401" YPOS="36548.5300982511" OwnPage="114" ItemID="294234128" PTYPE="5" WIDTH="295.263379417221" HEIGHT="1" FRTYPE="0" CLIPEDIT="0" ROT="359.914137254786" PWIDTH="0.283464566929134" PCOLOR="bordeaux" SHADE="0" PCOLOR2="bordeaux" PLINEART="1" path="" gXpos="573.257267089402" gYpos="14313.8844289598" gWidth="0" gHeight="0" LAYER="0"/>
        <PAGEOBJECT XPOS="141.102992125985" YPOS="36906.4982175458" OwnPage="115" ItemID="294239792" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="1331.06514667967" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="294242624" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="What We Really Need — the NVC Angle"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="In this scene, both are fundamentally looking for the same thing. They look for it from different states, with different strategies — and that's why they miss each other."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="The same rule applies in both cases: a need belongs to me. It doesn't depend on what the other person does or doesn't do. I am responsible for finding how to meet it — not for waiting for the other person to guess."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="What Both Are Looking For — at Bottom"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Read this list. Check what truly resonates — whatever your role in the scene."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="If you're the one who moved closer"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Beneath the gesture, there's something you didn't say. And not saying it puts the other in an impossible position — responding in the heat of the moment, from exhaustion, to a request they didn't have time to receive."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Read this list. Check what truly resonates."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Once your need is identified, complete this sentence:"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="&quot;I need __. When I reconnect to this need, what I choose to do is __.&quot;"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="A few examples:"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="&quot;I need expression. What I choose to do is name what I'm looking for earlier in the evening — not at 11 pm in the dark, but in a moment when we're both still available.&quot;"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <ITEXT CH="&quot;I need lightness. What I choose to do is suggest something gentle without waiting for a precise response — a hug, a closeness, something that asks for nothing but says I'm here.&quot;"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <ITEXT CH="&quot;I need courage. What I choose to do is say what I'm truly looking for — not necessarily sex, but warmth, connection — and leave the other person free to find how to meet me from where they are.&quot;"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="If you're the one who said no"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="What you're experiencing isn't rejection. It's a state — exhaustion, a full head, a closed body. A real, legitimate state, that deserves to be named without guilt. And from that state, there might still be something possible — not what was asked for, but something."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Read this list. Check what truly resonates."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Once your need is identified, complete this sentence:"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="&quot;I need __. When I reconnect to this need, what I choose to do is __.&quot;"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="A few examples:"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="&quot;I need rest. What I choose to do is give myself permission to be tired — and say it clearly, without apologizing, without minimizing.&quot;"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <ITEXT CH="&quot;I need integrity. What I choose to do is not accept out of obligation — and not refuse without suggesting something else. Find what's true for me tonight, and say it.&quot;"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="narration" ALIGN="3"/>
                <ITEXT CH="&quot;I need clarity. What I choose to do is ask myself, before the situation arrives, what I need tonight — and name it earlier, when there's still time to find each other differently.&quot;"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="These two lists speak of the same aspiration — being intimate, being close, being treated with delicacy. They don't meet in the scene because nobody found the words at the right moment. But they can meet elsewhere — earlier in the evening, in a space where both are still available to discover together what's possible. Not necessarily what was expected. Perhaps something gentler, simpler — and sometimes, more intimate still."/>
                <trail PARENT="BODY" ALIGN="3"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="560.630551181103" YPOS="36906.4982175458" OwnPage="116" ItemID="294242624" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="1331.06514667967" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="294231296" BACKITEM="294239792"/>
        <PAGEOBJECT XPOS="141.102992125985" YPOS="37541.7734931364" OwnPage="117" ItemID="294231296" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="1331.06483171904" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="294242624"/>
        <PAGEOBJECT XPOS="560.630551181103" YPOS="37541.7734931364" OwnPage="118" ItemID="294245456" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="1331.06483171904" gWidth="0" gHeight="0" PSTYLE="BODY" LAYER="0" NEXTITEM="294248288" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="BODY"/>
                <ITEXT CH="Feeding Your Free Child"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para ALIGN="3"/>
                <ITEXT CH="There's a question many readers ask when they arrive at this scene: "/>
                <ITEXT FONT="Times New Roman Italic" CH="how do I get my desire satisfied?"/>
                <para ALIGN="3"/>
                <para ALIGN="3"/>
                <ITEXT CH="It's an honest question. But it's looking for the answer in the wrong place."/>
                <para ALIGN="3"/>
                <para ALIGN="3"/>
                <ITEXT CH="Desire isn't an end in itself. It's a strategy — a way of looking for something deeper: connection, joy, vitality, the certainty of existing for the other in a way that belongs only to the two of you. And when those needs are nourished elsewhere in daily life — not only in bed, not only in intense moments — desire naturally finds its place again. Or at least, its absence weighs less."/>
                <para ALIGN="3"/>
                <para ALIGN="3"/>
                <ITEXT CH="What nourishes those needs isn't spectacular. It's often very simple."/>
                <para ALIGN="3"/>
                <para ALIGN="3"/>
                <ITEXT CH="A burst of laughter in the kitchen. A silly joke that only makes the two of you laugh. A pointless surprise — not a gift, just something unexpected that says "/>
                <ITEXT FONT="Times New Roman Italic" CH="I thought of you"/>
                <ITEXT CH=". A moment of lightness that's not useful, not productive, not organized around the children or the tasks or the television — just alive. A bit of mischief. A game. Something that steps outside the routine and says "/>
                <ITEXT FONT="Times New Roman Italic" CH="we're still two people who have fun together, not just two adults who manage."/>
                <para ALIGN="3"/>
                <para ALIGN="3"/>
                <ITEXT CH="These moments nourish the Free Child of both. And when the Free Child is nourished — when the day had lightness, connection, shared joy — the body and mind arrive differently at 11 pm. Not necessarily with more desire. But with less distance. Less fatigue with the other. More availability to find each other — one way or another."/>
                <para ALIGN="3"/>
                <para ALIGN="3"/>
                <ITEXT CH="The question therefore isn't "/>
                <ITEXT FONT="Times New Roman Italic" CH="how do I get my desire satisfied tonight? It's what did we allow ourselves today — together — that wasn't useful, wasn't obligatory, just for the pleasure of being together?"/>
                <para ALIGN="3"/>
                <para ALIGN="3"/>
                <ITEXT CH="The question to ask yourself tonight:"/>
                <para ALIGN="3"/>
                <para ALIGN="3"/>
                <ITEXT CH="What did we share today that made us smile — or laugh, or surprise us — outside the tasks and the obligations?"/>
                <para PARENT="narration" ALIGN="3"/>
                <para ALIGN="3"/>
                <ITEXT CH="And an additional question, specific to this scene:"/>
                <para ALIGN="3"/>
                <para ALIGN="3"/>
                <ITEXT CH="If desire is a way of looking for connection — what other paths toward that connection haven't I yet explored?"/>
                <para PARENT="narration" ALIGN="3"/>
                <para ALIGN="3"/>
                <para ALIGN="3"/>
                <ITEXT CH="Paths Toward Intimacy — Beyond Sexuality"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <ITEXT CH="Intimacy in a couple doesn't begin in bed. It's built — or eroded — in the gestures that come before. The way you look at each other when you come home. The question asked with real curiosity — not the facade &quot;"/>
                <ITEXT FONT="Times New Roman Italic" CH="did things go well?"/>
                <ITEXT CH="&quot; but &quot;"/>
                <ITEXT FONT="Times New Roman Italic" CH="what weighed on you today?"/>
                <ITEXT CH="&quot; Physical contact that asks for nothing — a hand placed, a shoulder touched in passing, a forehead kissed without intention."/>
                <para ALIGN="3"/>
                <para ALIGN="3"/>
                <ITEXT CH="These gestures nourish something that sexuality alone can't nourish — the certainty of being seen, wanted, held. And they create the conditions in which desire can exist naturally — not as a demand, not as a performance, but as an expression of what's already there."/>
                <para ALIGN="3"/>
                <para ALIGN="3"/>
                <ITEXT CH="A few concrete leads — not recipes, directions:"/>
                <para ALIGN="3"/>
                <para ALIGN="3"/>
                <ITEXT CH="Name what you're looking for, not what you want. Instead of &quot;"/>
                <ITEXT FONT="Times New Roman Italic" CH="do you feel like it?"/>
                <ITEXT CH="&quot; — &quot;"/>
                <ITEXT FONT="Times New Roman Italic" CH="I'd love to be close to you tonight."/>
                <ITEXT CH="&quot; The nuance is small. What it opens is different."/>
                <para ALIGN="3"/>
                <para ALIGN="3"/>
                <ITEXT FONT="Times New Roman Italic" CH="Find other paths toward connection"/>
                <ITEXT CH=". If sexuality is under tension, there are other languages of intimacy — the conversation in the dark, contact without expectation, the shared ritual that says "/>
                <ITEXT FONT="Times New Roman Italic" CH="we're still us"/>
                <ITEXT CH=". These paths don't replace desire. They often precede it."/>
                <para ALIGN="3"/>
                <para ALIGN="3"/>
                <ITEXT FONT="Times New Roman Italic" CH="Talk about the subject outside the bedroom"/>
                <ITEXT CH=". The conversation about desire, the gap, what each needs — it can't happen at 11 pm, in the dark, in the vulnerability of the moment. It needs another space — a Sunday morning, a walk, a moment when both are available and safe."/>
                <para ALIGN="3"/>
                <para ALIGN="3"/>
                <ITEXT FONT="Times New Roman Italic" CH="Distinguish the refusal of the person from the refusal of the act"/>
                <ITEXT CH=". Tonight, she said no to something — not to him. This distinction, if it can be said, changes everything that follows."/>
                <trail ALIGN="3"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="141.102992125985" YPOS="38177.048768727" OwnPage="119" ItemID="294248288" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="1331.06451675841" gWidth="0" gHeight="0" PSTYLE="BODY" LAYER="0" NEXTITEM="294236960" BACKITEM="294245456"/>
        <PAGEOBJECT XPOS="560.630551181103" YPOS="38177.048768727" OwnPage="120" ItemID="294236960" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="1331.06451675841" gWidth="0" gHeight="0" PSTYLE="BODY" LAYER="0" NEXTITEM="-1" BACKITEM="294248288"/>
        <PAGEOBJECT XPOS="141.102992125985" YPOS="38812.3240443176" OwnPage="121" ItemID="294251120" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="1331.06420179779" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="294262448" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="The Exits"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Level 1 — Notice your role in the triangle (solo — both partners)"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="In the moment, one question:"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Am I asking for something — or expressing a need? Am I refusing something — or protecting something?"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="The difference between asking and expressing a need is real. Asking calls for a yes or a no. Expressing a need opens a conversation."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Level 2 — Name what you're truly looking for (solo — both partners)"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Before the approach, before the refusal — an internal question:"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="What am I truly looking for right now — desire, connection, tenderness? And is this path the only way to get there tonight?"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Not to give up what you're looking for. To see if there's another path — less exposing, more accessible in this precise moment."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Level 3 — Say what you need earlier (solo — both partners)"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="What's missing in this scene is a conversation that could have happened earlier. Not a negotiation — a simple opening."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="&quot;I'd love it if we had a moment together tonight.&quot;"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="That sentence, said in the evening, changes everything that follows. It leaves the other time to respond from an available place — not from 11 pm exhaustion. And it opens the possibility of finding each other differently — a hug, a closeness, something gentle that asks for nothing but says "/>
                <ITEXT FONT="Times New Roman Bold" CH="we're still us"/>
                <ITEXT CH="."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Level 4 — Build intimacy rituals (together — to explore together)"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="A conversation to have calmly, outside the bedroom, outside any recent tension:"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="&quot;What makes you feel close to me — truly close, not just present? And what creates distance, even without conflict?&quot;"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Not to decide on a program. To know each other better on this terrain — and give yourselves leads that don't go exclusively through sexuality."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Level 5 — Talk about the subject directly (together)"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="This is the most difficult conversation — and the most useful. Not in the moment of tension. Not after a refusal. In a neutral, available, safe space."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="&quot;I realize we never really talk about this — about what we're looking for, about what we're missing, about what creates distance between us on this subject. And I think it's costing us something. Can we talk about it?&quot;"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Not a confrontation. An opening — from the Adult, addressed to the other's Adult. With the awareness that this subject demands more gentleness than any other."/>
                <trail PARENT="BODY" ALIGN="3"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="560.630551181103" YPOS="38812.3240443176" OwnPage="122" ItemID="294262448" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="1331.06420179779" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="294251120"/>
        <PAGEOBJECT XPOS="141.102992125985" YPOS="39447.5993199081" OwnPage="123" ItemID="294253952" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="1331.06388683716" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="294256784" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Tracking — 7 Days"/>
                <para PARENT="narration" ALIGN="3"/>
                <ITEXT CH="Every evening, 2 minutes."/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="The evening question:"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Monday:"/>
                <ITEXT FONT="Times New Roman Italic" CH=" Today, how did I create connection with the other — other than through sexuality?"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Tuesday: "/>
                <ITEXT FONT="Times New Roman Italic" CH="When I sought closeness, what path did I take — and was it the most suited to that moment?"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Wednesday: "/>
                <ITEXT FONT="Times New Roman Italic" CH="What could I have said earlier today — and kept to myself?"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Thursday: "/>
                <ITEXT FONT="Times New Roman Italic" CH="At what moment did I feel we were truly close today — and what created that?"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Friday: "/>
                <ITEXT FONT="Times New Roman Italic" CH="How did I nourish my Free Child today — and what did it change in my availability for the other?"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Saturday: "/>
                <ITEXT FONT="Times New Roman Italic" CH="What belief about desire or sexuality do I carry — and where does it come from?"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Sunday: "/>
                <ITEXT FONT="Times New Roman Italic" CH="If intimacy were no longer under tension between us — what would an ordinary evening look like?"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Duo Version — Exchange in 2 Parts"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <ITEXT CH="To do in a moment of lightness and connection already present — not after a tension, not when tired. 20 minutes, in a space where both feel safe."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Part 1 — Our Languages of Intimacy (10 minutes)"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Each person completes these sentences separately, in writing:"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="&quot;What makes me feel truly close to you is...&quot; &quot;What creates distance between us, even without conflict, is...&quot; &quot;What I would need more often to feel intimate with you — not necessarily sexually — is...&quot;"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Then you share — each person reads, the other listens without interrupting, without correcting, without suggesting. The goal isn't to find a solution. It's to hear what intimacy truly means for the other — not what we assumed."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Part 2 — A Gesture (10 minutes)"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="One question to explore together:"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="&quot;What is one concrete gesture — small, daily, accessible — that would tell the other person they matter to me in a way that belongs to them?&quot;"/>
                <para PARENT="narration" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="Not a program. Not a solemn promise. Just a gesture — to try this week, to adjust, to keep if it does something."/>
                <trail PARENT="BODY" ALIGN="3"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="560.630551181103" YPOS="39447.5993199081" OwnPage="124" ItemID="294256784" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="1331.06388683716" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="294253952"/>
