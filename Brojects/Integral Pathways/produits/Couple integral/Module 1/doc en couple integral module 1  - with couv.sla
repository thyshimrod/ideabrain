        <PAGEOBJECT XPOS="577.257267089401" YPOS="32862.8784447076" OwnPage="102" ItemID="289911280" PTYPE="5" WIDTH="295.263379417221" HEIGHT="1" FRTYPE="0" CLIPEDIT="0" ROT="359.914137254786" PWIDTH="0.283464566929134" PCOLOR="bordeaux" SHADE="0" PCOLOR2="bordeaux" PLINEART="1" path="" gXpos="577.257267089402" gYpos="14439.8863187233" gWidth="0" gHeight="0" LAYER="0"/>
        <PAGEOBJECT XPOS="147.567001602676" YPOS="33223.7219037001" OwnPage="103" ItemID="289928272" PTYPE="2" WIDTH="324.102919657167" HEIGHT="125.396836457334" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="0.39" LOCALSCY="0.39" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" Pagenumber="0" PFILE="images/en/tracker1chap5.png" PRFILE="Embedded sRGB built-in" IRENDER="0" EPROF="Embedded sRGB built-in" path="M0 0 L324.103 0 L324.103 125.397 L0 125.397 L0 0 Z" copath="M0 0 L324.103 0 L324.103 125.397 L0 125.397 L0 0 Z" gXpos="147.567001602676" gYpos="33223.7219037001" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1"/>
