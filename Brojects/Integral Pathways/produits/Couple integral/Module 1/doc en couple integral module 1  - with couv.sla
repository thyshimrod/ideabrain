        <PAGEOBJECT XPOS="581.257267089401" YPOS="38843.6312006133" OwnPage="122" ItemID="299057280" PTYPE="5" WIDTH="295.263379417221" HEIGHT="1" FRTYPE="0" CLIPEDIT="0" ROT="359.914137254786" PWIDTH="0.283464566929134" PCOLOR="bordeaux" SHADE="0" PCOLOR2="bordeaux" PLINEART="1" path="" gXpos="581.257267089402" gYpos="14067.8831691173" gWidth="0" gHeight="0" LAYER="0"/>
        <PAGEOBJECT XPOS="577.257267089401" YPOS="39004.6312006133" OwnPage="122" ItemID="299077104" PTYPE="5" WIDTH="295.263379417221" HEIGHT="1" FRTYPE="0" CLIPEDIT="0" ROT="359.914137254786" PWIDTH="0.283464566929134" PCOLOR="bordeaux" SHADE="0" PCOLOR2="bordeaux" PLINEART="1" path="" gXpos="577.257267089402" gYpos="14228.8831691173" gWidth="0" gHeight="0" LAYER="0"/>
        <PAGEOBJECT XPOS="144.637798062853" YPOS="39485.4090195806" OwnPage="123" ItemID="299079936" PTYPE="2" WIDTH="330.745174552296" HEIGHT="136.291974078478" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="0.39" LOCALSCY="0.39" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" Pagenumber="0" PFILE="images/en/trackerchap6.png" PRFILE="Embedded sRGB built-in" IRENDER="0" EPROF="Embedded sRGB built-in" path="M0 0 L330.745 0 L330.745 136.292 L0 136.292 L0 0 Z" copath="M0 0 L330.745 0 L330.745 136.292 L0 136.292 L0 0 Z" gXpos="144.637798062853" gYpos="39485.4090195806" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1"/>
        <PAGEOBJECT XPOS="568.257267089401" YPOS="39518.9064762038" OwnPage="124" ItemID="299082768" PTYPE="5" WIDTH="295.263379417221" HEIGHT="1" FRTYPE="0" CLIPEDIT="0" ROT="359.914137254786" PWIDTH="0.283464566929134" PCOLOR="bordeaux" SHADE="0" PCOLOR2="bordeaux" PLINEART="1" path="" gXpos="568.257267089402" gYpos="14107.8828541566" gWidth="0" gHeight="0" LAYER="0"/>
        <PAGEOBJECT XPOS="574.257267089401" YPOS="39718.9064762038" OwnPage="124" ItemID="299074272" PTYPE="5" WIDTH="295.263379417221" HEIGHT="1" FRTYPE="0" CLIPEDIT="0" ROT="359.914137254786" PWIDTH="0.283464566929134" PCOLOR="bordeaux" SHADE="0" PCOLOR2="bordeaux" PLINEART="1" path="" gXpos="574.257267089402" gYpos="14307.8828541566" gWidth="0" gHeight="0" LAYER="0"/>
        <PAGEOBJECT XPOS="560.630551181103" YPOS="40082.8745954985" OwnPage="126" ItemID="299071440" PTYPE="4" WIDTH="337.322834645669" HEIGHT="513.070866141732" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" copath="M0 0 L337.323 0 L337.323 513.071 L0 513.071 L0 0 Z" gXpos="560.630551181103" gYpos="1331.06357187653" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="One Last Thing"/>
                <para PARENT="scene_page_subtitle" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="This booklet has traversed six scenes. Arguments about dishes, late returns, difficult calls, overspent budgets, resistant homework, silent nights."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="None of these scenes was really about what it seemed to be."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="The household tasks were about who carries what — and why. The late return was about the need to exist for the other. The call with her mother was about being heard, not advised. The money was about freedom and trust. The homework was about legitimacy and history. And this last scene — perhaps the simplest of all in its form, perhaps the most charged in its substance — was about one thing: "/>
                <ITEXT FONT="Times New Roman Italic" CH="do I matter to you, in a way that belongs only to us?"/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="It's not a question we ask. It's a question we play — in the silences, the withdrawals, the taking back of control, the unsolicited solutions, the nights with eyes open in the dark."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="This booklet doesn't resolve this question. It offers something more modest and more useful: to begin seeing it. Because seeing a game is already being less entirely its prisoner."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT CH="What comes next — if you want to go further — is the conversation. The one that hasn't happened yet. The one that begins with &quot;"/>
                <ITEXT FONT="Times New Roman Italic" CH="I'm going to tell you something that's hard to put into words"/>
                <ITEXT CH="&quot; — and that happens in a moment when both are ready to hear."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para PARENT="BODY" ALIGN="3"/>
                <ITEXT FONT="Times New Roman Bold" CH="That moment, only you can choose."/>
                <para PARENT="BODY" ALIGN="3"/>
                <para ALIGN="3"/>
                <ITEXT CH="Furthermore, while I truly want you to become self-reliant in this quest for an &quot;"/>
                <ITEXT FONT="Times New Roman Italic" CH="improved"/>
                <ITEXT CH="&quot; relationship, it's often very difficult to resolve these issues while being deeply involved in the relationship yourself. External support is often a way to gain awareness and make the discussion more amicable. Please feel free to contact me to discuss this further or to receive guidance. I would be happy to respond."/>
                <trail PARENT="BODY" ALIGN="3"/>
            </StoryText>
        </PAGEOBJECT>
