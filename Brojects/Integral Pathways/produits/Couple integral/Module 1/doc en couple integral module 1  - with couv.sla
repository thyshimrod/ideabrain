                <para PARENT="Titre" ALIGN="1"/>
                <para PARENT="book_subtitle" ALIGN="1"/>
                <para PARENT="book_subtitle" ALIGN="1"/>
                <para PARENT="book_subtitle" ALIGN="1"/>
                <para PARENT="book_subtitle" ALIGN="1"/>
                <para PARENT="book_subtitle" ALIGN="1"/>
                <para PARENT="book_subtitle" ALIGN="1"/>
                <para PARENT="book_subtitle" ALIGN="1"/>
                <para PARENT="book_subtitle"/>
