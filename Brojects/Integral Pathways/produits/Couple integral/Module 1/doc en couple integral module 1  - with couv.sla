        <PAGEOBJECT XPOS="559.177621071702" YPOS="31413.315768936" OwnPage="98" ItemID="289916944" PTYPE="2" WIDTH="332.044247787611" HEIGHT="116.152354539812" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="0.39" LOCALSCY="0.39" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" Pagenumber="0" PFILE="images/en/need2chap5.png" PRFILE="Embedded sRGB built-in" IRENDER="0" EPROF="Embedded sRGB built-in" path="M0 0 L332.044 0 L332.044 116.152 L0 116.152 L0 0 Z" copath="M0 0 L332.044 0 L332.044 116.152 L0 116.152 L0 0 Z" gXpos="559.177621071702" gYpos="31413.315768936" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1"/>
        <PAGEOBJECT XPOS="158.729708034284" YPOS="31924.6031691171" OwnPage="99" ItemID="289905616" PTYPE="5" WIDTH="295.263379417221" HEIGHT="1" FRTYPE="0" CLIPEDIT="0" ROT="359.914137254786" PWIDTH="0.283464566929134" PCOLOR="bordeaux" SHADE="0" PCOLOR2="bordeaux" PLINEART="1" path="" gXpos="578.257267089402" gYpos="14136.886633684" gWidth="0" gHeight="0" LAYER="0"/>
        <PAGEOBJECT XPOS="157.729708034284" YPOS="32772.8784447076" OwnPage="101" ItemID="289922608" PTYPE="5" WIDTH="295.263379417221" HEIGHT="1" FRTYPE="0" CLIPEDIT="0" ROT="359.914137254786" PWIDTH="0.283464566929134" PCOLOR="bordeaux" SHADE="0" PCOLOR2="bordeaux" PLINEART="1" path="" gXpos="577.257267089402" gYpos="14349.8863187233" gWidth="0" gHeight="0" LAYER="0"/>
