                <para PARENT="book_subtitle" ALIGN="1"/>
                <para PARENT="book_subtitle" ALIGN="1"/>
                <ITEXT FONT="Arial Regular" FONTSIZE="12" CH="Six scenes from the ordinary life of a couple."/>
